// The base 8086 instruction set (the always-present ISA), decoded by every x86 CPU model.
//
// Each instruction lists its encoding and disassembly first, then `=> <semantics>` (or a
// `{ ... }` block). This covers the register/immediate/implicit forms the bit-field encoding
// expresses directly; memory operands (ModR/M mod != 11) come with the variable-length
// decoder, so the register-to-register (mod = 11) forms are encoded here.

// Evaluate an x86 condition code (the low nibble of a Jcc opcode): bits [3:1] pick the flag
// test, bit 0 negates it. So 0x74 (cc=0100) is ZF, 0x75 (cc=0101) is !ZF, etc.
macro eval_cc ( cc ) : #i1 %result =
	( cc[3:1] == 0 ? flags.O
	: cc[3:1] == 1 ? flags.C
	: cc[3:1] == 2 ? flags.Z
	: cc[3:1] == 3 ? ( flags.C | flags.Z )
	: cc[3:1] == 4 ? flags.S
	: cc[3:1] == 5 ? flags.P
	: cc[3:1] == 6 ? ( flags.S ^ flags.O )
	:                ( flags.Z | ( flags.S ^ flags.O ) ) )
	^ cc[0:0] ;

// ---- data movement -------------------------------------------------------

insn mov : encode #i24 ( op:5 = 0x17, reg:3 -> dst[ gpr16 ], imm:16 -> src )		// 0xB8+r iw
	     |  #i16 ( op:8 = 0x89, mod:2, reg:3 -> src[ gpr16 ], rm:3 -> dst @modrm16 )	// 0x89 /r  MOV r/m16, r16
	     |  #i16 ( op:8 = 0x8B, mod:2, reg:3 -> dst[ gpr16 ], rm:3 -> src @modrm16 ),	// 0x8B /r  MOV r16, r/m16
	disasm ( mnemonic : "mov", size : word, operands : dst, src )
	=> dst = src;

insn movb : encode #i16 ( op:5 = 0x16, reg:3 -> dst[ gpr8 ], imm:8 -> src )		// 0xB0+r ib
	     |  #i16 ( op:8 = 0x88, mod:2, reg:3 -> src[ gpr8 ], rm:3 -> dst @modrm8 )	// 0x88 /r  MOV r/m8, r8
	     |  #i16 ( op:8 = 0x8A, mod:2, reg:3 -> dst[ gpr8 ], rm:3 -> src @modrm8 ),	// 0x8A /r  MOV r8, r/m8
	disasm ( mnemonic : "mov", size : byte, operands : dst, src )
	=> dst = src;

insn xchg : encode #i16 ( op:8 = 0x87, mod:2, reg:3 -> src[ gpr16 ], rm:3 -> dst @modrm16 ),	// 0x87 /r
	disasm ( mnemonic : "xchg", size : word, operands : dst, src )
	{ #i16 tmp = dst ; dst = src ; src = tmp ; }

// ---- ALU --------------------------------------------------------------------
//
// Each ALU op has three word forms: the register/memory /r form, and the two
// immediate-to-r/m forms of the grouped opcodes 0x81 and 0x83, where the ModR/M
// `reg` field is an opcode EXTENSION (/digit) selecting which operation it is:
//
//     0x81 /digit iw   -- r/m16, imm16
//     0x83 /digit ib   -- r/m16, imm8 sign-extended to 16 bits  (`sx`)
//
//     /0 add  /1 or  /2 adc  /3 sbb  /4 and  /5 sub  /6 xor  /7 cmp
//
// The immediate sits AFTER the (variable-length) ModR/M displacement, so it is a
// tail field -- the decoder appends it once the addressing mode's bytes are known.

insn add : encode #i16 ( op:8 = 0x01, mod:2, reg:3 -> src[ gpr16 ], rm:3 -> dst @modrm16 )	// 0x01 /r
	     |  #i16 ( op:8 = 0x81, mod:2, reg:3 = 0, rm:3 -> dst @modrm16, imm:16 -> src )	// 0x81 /0 iw
	     |  #i16 ( op:8 = 0x83, mod:2, reg:3 = 0, rm:3 -> dst @modrm16, imm:8 -> src sx ),	// 0x83 /0 ib
	disasm ( mnemonic : "add", size : word, operands : dst, src )
	=> dst = %CC ( dst + src );

insn or : encode #i16 ( op:8 = 0x09, mod:2, reg:3 -> src[ gpr16 ], rm:3 -> dst @modrm16 )	// 0x09 /r
	    |  #i16 ( op:8 = 0x81, mod:2, reg:3 = 1, rm:3 -> dst @modrm16, imm:16 -> src )	// 0x81 /1 iw
	    |  #i16 ( op:8 = 0x83, mod:2, reg:3 = 1, rm:3 -> dst @modrm16, imm:8 -> src sx ),	// 0x83 /1 ib
	disasm ( mnemonic : "or", size : word, operands : dst, src )
	=> dst = %CC ( dst | src );

insn adc : encode #i16 ( op:8 = 0x11, mod:2, reg:3 -> src[ gpr16 ], rm:3 -> dst @modrm16 )	// 0x11 /r
	     |  #i16 ( op:8 = 0x81, mod:2, reg:3 = 2, rm:3 -> dst @modrm16, imm:16 -> src )	// 0x81 /2 iw
	     |  #i16 ( op:8 = 0x83, mod:2, reg:3 = 2, rm:3 -> dst @modrm16, imm:8 -> src sx ),	// 0x83 /2 ib
	disasm ( mnemonic : "adc", size : word, operands : dst, src )
	=> dst = %CC ( dst + src + flags.C );

insn sbb : encode #i16 ( op:8 = 0x19, mod:2, reg:3 -> src[ gpr16 ], rm:3 -> dst @modrm16 )	// 0x19 /r
	     |  #i16 ( op:8 = 0x81, mod:2, reg:3 = 3, rm:3 -> dst @modrm16, imm:16 -> src )	// 0x81 /3 iw
	     |  #i16 ( op:8 = 0x83, mod:2, reg:3 = 3, rm:3 -> dst @modrm16, imm:8 -> src sx ),	// 0x83 /3 ib
	disasm ( mnemonic : "sbb", size : word, operands : dst, src )
	=> dst = %CC ( dst - src - flags.C );

insn and : encode #i16 ( op:8 = 0x21, mod:2, reg:3 -> src[ gpr16 ], rm:3 -> dst @modrm16 )	// 0x21 /r
	     |  #i16 ( op:8 = 0x81, mod:2, reg:3 = 4, rm:3 -> dst @modrm16, imm:16 -> src )	// 0x81 /4 iw
	     |  #i16 ( op:8 = 0x83, mod:2, reg:3 = 4, rm:3 -> dst @modrm16, imm:8 -> src sx ),	// 0x83 /4 ib
	disasm ( mnemonic : "and", size : word, operands : dst, src )
	=> dst = %CC ( dst & src );

insn sub : encode #i16 ( op:8 = 0x29, mod:2, reg:3 -> src[ gpr16 ], rm:3 -> dst @modrm16 )	// 0x29 /r
	     |  #i16 ( op:8 = 0x81, mod:2, reg:3 = 5, rm:3 -> dst @modrm16, imm:16 -> src )	// 0x81 /5 iw
	     |  #i16 ( op:8 = 0x83, mod:2, reg:3 = 5, rm:3 -> dst @modrm16, imm:8 -> src sx ),	// 0x83 /5 ib
	disasm ( mnemonic : "sub", size : word, operands : dst, src )
	=> dst = %CC ( dst - src );

insn xor : encode #i16 ( op:8 = 0x31, mod:2, reg:3 -> src[ gpr16 ], rm:3 -> dst @modrm16 )	// 0x31 /r
	     |  #i16 ( op:8 = 0x81, mod:2, reg:3 = 6, rm:3 -> dst @modrm16, imm:16 -> src )	// 0x81 /6 iw
	     |  #i16 ( op:8 = 0x83, mod:2, reg:3 = 6, rm:3 -> dst @modrm16, imm:8 -> src sx ),	// 0x83 /6 ib
	disasm ( mnemonic : "xor", size : word, operands : dst, src )
	=> dst = %CC ( dst ^ src );

insn cmp : encode #i16 ( op:8 = 0x39, mod:2, reg:3 -> src[ gpr16 ], rm:3 -> dst @modrm16 )	// 0x39 /r
	     |  #i16 ( op:8 = 0x81, mod:2, reg:3 = 7, rm:3 -> dst @modrm16, imm:16 -> src )	// 0x81 /7 iw
	     |  #i16 ( op:8 = 0x83, mod:2, reg:3 = 7, rm:3 -> dst @modrm16, imm:8 -> src sx ),	// 0x83 /7 ib
	disasm ( mnemonic : "cmp", size : word, operands : dst, src )
	=> %CC ( dst - src );							// sets flags, no write-back

insn test : encode #i16 ( op:8 = 0x85, mod:2, reg:3 -> src[ gpr16 ], rm:3 -> dst @modrm16 )	// 0x85 /r
	     |  #i16 ( op:8 = 0xF7, mod:2, reg:3 = 0, rm:3 -> dst @modrm16, imm:16 -> src ),	// 0xF7 /0 iw
	disasm ( mnemonic : "test", size : word, operands : dst, src )
	=> %CC ( dst & src );							// sets flags, no write-back

// ---- unary r/m group: 0xF7 /digit (word) ----------------------------------
//
// The other grouped opcode whose ModR/M `reg` field is an opcode extension:
//
//     /0 test (above)  /2 not  /3 neg  /4 mul  /5 imul  /6 div  /7 idiv
//
// MUL/DIV use the implicit AX (and DX for the upper half) -- the 16x16 product
// is 32 bits wide (DX:AX), and the 32-bit dividend DX:AX divides by the operand.
// The operands are widened to 32 bits ([ #i32 .. ] zero-extends, %S sign-extends)
// so the full product / dividend survives, then sliced back into AX and DX.

insn not : encode #i16 ( op:8 = 0xF7, mod:2, reg:3 = 2, rm:3 -> dst @modrm16 ),		// 0xF7 /2
	disasm ( mnemonic : "not", size : word, operands : dst )
	=> dst = ~ dst;								// one's complement, no flags

insn neg : encode #i16 ( op:8 = 0xF7, mod:2, reg:3 = 3, rm:3 -> dst @modrm16 ),		// 0xF7 /3
	disasm ( mnemonic : "neg", size : word, operands : dst )
	=> dst = %CC ( 0 - dst );						// two's complement, sets flags

insn mul : encode #i16 ( op:8 = 0xF7, mod:2, reg:3 = 4, rm:3 -> src @modrm16 ),		// 0xF7 /4
	disasm ( mnemonic : "mul", size : word, operands : src )
	{ #i32 p = [ #i32 ax ] * [ #i32 src ] ;					// unsigned 16x16 -> 32
	  ax = p[ 15:0 ] ; dx = p[ 31:16 ] ;					// DX:AX = product
	  flags.C = p[ 31:16 ] != 0 ; flags.O = p[ 31:16 ] != 0 ; }		// CF=OF if upper half used

insn imul : encode #i16 ( op:8 = 0xF7, mod:2, reg:3 = 5, rm:3 -> src @modrm16 ),	// 0xF7 /5
	disasm ( mnemonic : "imul", size : word, operands : src )
	{ #i32 p = %S ( [ #i32 ax ] ) * %S ( [ #i32 src ] ) ;			// signed 16x16 -> 32
	  ax = p[ 15:0 ] ; dx = p[ 31:16 ] ; }					// DX:AX = product

insn div : encode #i16 ( op:8 = 0xF7, mod:2, reg:3 = 6, rm:3 -> src @modrm16 ),		// 0xF7 /6
	disasm ( mnemonic : "div", size : word, operands : src )
	{ #i32 n = ( dx : ax ) ;						// unsigned DX:AX / r/m16
	  ax = [ #i16 n / [ #i32 src ] ] ;					// quotient -> AX
	  dx = [ #i16 n % [ #i32 src ] ] ; }					// remainder -> DX

insn idiv : encode #i16 ( op:8 = 0xF7, mod:2, reg:3 = 7, rm:3 -> src @modrm16 ),	// 0xF7 /7
	disasm ( mnemonic : "idiv", size : word, operands : src )
	{ #i32 n = ( dx : ax ) ;						// signed DX:AX / r/m16
	  ax = [ #i16 %S ( n / [ #i32 src ] ) ] ;				// quotient -> AX
	  dx = [ #i16 %S ( n % [ #i32 src ] ) ] ; }				// remainder -> DX

// ---- increment / decrement -----------------------------------------------

insn inc : encode #i8 ( op:5 = 0x08, reg:3 -> dst[ gpr16 ] ),			// 0x40+r
	disasm ( mnemonic : "inc", size : word, operands : dst )
	=> dst = %CC ( dst + 1, !C );

insn dec : encode #i8 ( op:5 = 0x09, reg:3 -> dst[ gpr16 ] ),			// 0x48+r
	disasm ( mnemonic : "dec", size : word, operands : dst )
	=> dst = %CC ( dst - 1, !C );

// ---- stack ---------------------------------------------------------------

insn push : encode #i8 ( op:5 = 0x0A, reg:3 -> src[ gpr16 ] ),			// 0x50+r  PUSH r16
	disasm ( mnemonic : "push", size : word, operands : src )
	=> @i8086_push ( src );

insn pop : encode #i8 ( op:5 = 0x0B, reg:3 -> dst[ gpr16 ] ),			// 0x58+r  POP r16
	disasm ( mnemonic : "pop", size : word, operands : dst )
	=> dst = @i8086_pop ();

// ---- flag operations -----------------------------------------------------

insn clc : encode #i8 ( op:8 = 0xF8 ), disasm ( mnemonic : "clc" ) => flags.C = 0;		// 0xF8
insn stc : encode #i8 ( op:8 = 0xF9 ), disasm ( mnemonic : "stc" ) => flags.C = 1;		// 0xF9
insn cmc : encode #i8 ( op:8 = 0xF5 ), disasm ( mnemonic : "cmc" ) => flags.C = flags.C ^ 1;	// 0xF5
insn cld : encode #i8 ( op:8 = 0xFC ), disasm ( mnemonic : "cld" ) => flags.D = 0;		// 0xFC
insn std : encode #i8 ( op:8 = 0xFD ), disasm ( mnemonic : "std" ) => flags.D = 1;		// 0xFD
insn cli : encode #i8 ( op:8 = 0xFA ), disasm ( mnemonic : "cli" ) => flags.I = 0;		// 0xFA
insn sti : encode #i8 ( op:8 = 0xFB ), disasm ( mnemonic : "sti" ) => flags.I = 1;		// 0xFB

insn nop : encode #i8 ( op:8 = 0x90 ), disasm ( mnemonic : "nop" );		// 0x90 (XCHG AX,AX)
insn hlt : encode #i8 ( op:8 = 0xF4 ), disasm ( mnemonic : "hlt" ) => @trap ( 0 );	// 0xF4 wait-on-interrupt

// ---- control flow --------------------------------------------------------

jump insn jmp : type branch, encode #i16 ( op:8 = 0xEB, disp:8 -> src rel ),	// 0xEB cb  JMP rel8
	disasm ( mnemonic : "jmp", operands : src )
	{ @i8086_jump( src ); }

jump insn jcc : type branch, condition @eval_cc ( cond ),			// 0x70..0x7F cb  Jcc rel8
	encode #i16 ( op:4 = 0x7, tttn:4 -> cond, disp:8 -> src rel ),
	disasm ( mnemonic : "jcc", operands : src )
	{ @i8086_jump ( src ); }

jump insn ncall : type call, encode #i24 ( op:8 = 0xE8, disp:16 -> src rel ),	// 0xE8 cw  CALL rel16
	disasm ( mnemonic : "call", operands : src )
	{ @i8086_push ( ip ); @i8086_jump ( src ); }

jump insn nret : type return, encode #i8 ( op:8 = 0xC3 ),			// 0xC3  RET (near)
	disasm ( mnemonic : "ret" )
	{ @i8086_jump ( @i8086_pop () ); }
