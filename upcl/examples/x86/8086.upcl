// The base 8086 instruction set (the always-present ISA). Decoded and executed by every
// x86 CPU model.

// Evaluate an x86 condition code (the low nibble of a Jcc opcode): bits [3:1] pick the flag
// test, bit 0 negates it. So 0x74 (cc=0100) is ZF, 0x75 (cc=0101) is !ZF, etc.
macro eval_cc ( cc ) : #i1 %result =
	( cc[3:1] == 0 ? flags.O
	: cc[3:1] == 1 ? flags.C
	: cc[3:1] == 2 ? flags.Z
	: cc[3:1] == 3 ? ( flags.C | flags.Z )
	: cc[3:1] == 4 ? flags.S
	: cc[3:1] == 5 ? flags.P
	: cc[3:1] == 6 ? ( flags.S ^ flags.O )
	:                ( flags.Z | ( flags.S ^ flags.O ) ) )
	^ cc[0:0] ;

insn mov : dst = src
	encode #i24 ( op:5 = 0x17, reg:3 -> dst[ gpr16 ], imm:16 -> src ),	// 0xB8+r iw
	disasm ( mnemonic : "mov", size : word, operands : dst, src );

insn inc : dst = %CC ( dst + 1, !C )
	encode #i8 ( op:5 = 0x08, reg:3 -> dst[ gpr16 ] ),			// 0x40+r
	disasm ( mnemonic : "inc", size : word, operands : dst );

insn dec : dst = %CC ( dst - 1, !C )
	encode #i8 ( op:5 = 0x09, reg:3 -> dst[ gpr16 ] ),			// 0x48+r
	disasm ( mnemonic : "dec", size : word, operands : dst );

insn hlt : encode #i8 ( op:8 = 0xF4 ), disasm ( mnemonic : "hlt" );	// 0xF4

jump insn jmp : type branch, encode #i16 ( op:8 = 0xEB, disp:8 -> src rel ),	// 0xEB cb
	disasm ( mnemonic : "jmp", operands : src )
	{ @i8086_jump( src ); }

jump insn jcc : type branch, condition @eval_cc ( cond ),			// 0x70..0x7F cb
	encode #i16 ( op:4 = 0x7, tttn:4 -> cond, disp:8 -> src rel ),
	disasm ( mnemonic : "jcc", operands : src )
	{ @i8086_jump ( src ); }

jump insn ncall : type call, encode #i24 ( op:8 = 0xE8, disp:16 -> src rel ),	// 0xE8 cw
	disasm ( mnemonic : "call", operands : src )
	{ @i8086_push ( ip ); @i8086_jump ( src ); }

jump insn nret : type return, encode #i8 ( op:8 = 0xC3 ),			// 0xC3
	disasm ( mnemonic : "ret" )
	{ @i8086_jump ( @i8086_pop () ); }
