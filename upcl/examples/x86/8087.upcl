// Intel 8087 numeric coprocessor (feature `fpu`). The 8087 shares the 8086 instruction stream:
// its instructions are the ESC group (0xD8-0xDF) followed by a ModR/M byte. It owns an eight-deep
// register stack of 80-bit extended-precision values; ST(0) is the top, ST(i) the i-th below it.
//
// The stack is TOP-relative -- ST(i) is the physical register st[(ftop + i) & 7] -- so a push
// pre-decrements ftop and a pop post-increments it, both modulo 8. ftop starts at 0, so the first
// push lands in st[7]. This is the authentic 8087 rotating stack (not a data-shuffling imitation):
// the runtime-indexed register access st[expr] selects the physical register at run time.
//
// This first cut covers the load/store, constant, and arithmetic core; the comparison/transcendental
// groups, the control instructions (FINIT/FLDCW/FSTSW), and the m32/m64/m80 real memory formats
// (which need the float-width memory casts) come next.

// Push a value onto the register stack: pre-decrement the top (mod 8), then write ST(0).
macro fpu_push ( value ) {
	ftop = ( ftop - 1 ) & 7 ;
	st[ ftop ] = value ;
}

feature fpu {

	// ---- constants ----------------------------------------------------------

	insn fld1 : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 5, rm:3 = 0 ),	// 0xD9 E8
		disasm ( mnemonic : "fld1" )
		=> @fpu_push ( [ #f80 1 ] );

	insn fldz : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 5, rm:3 = 6 ),	// 0xD9 EE
		disasm ( mnemonic : "fldz" )
		=> @fpu_push ( [ #f80 0 ] );

	// The on-chip transcendental constants (loaded to double precision here, widened to 80 bits).
	insn fldpi  : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 5, rm:3 = 3 ),	// 0xD9 EB  pi
		disasm ( mnemonic : "fldpi" )
		=> @fpu_push ( [ #f80 3.14159265358979323846 ] );

	insn fldl2t : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 5, rm:3 = 1 ),	// 0xD9 E9  log2(10)
		disasm ( mnemonic : "fldl2t" )
		=> @fpu_push ( [ #f80 3.32192809488736234787 ] );

	insn fldl2e : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 5, rm:3 = 2 ),	// 0xD9 EA  log2(e)
		disasm ( mnemonic : "fldl2e" )
		=> @fpu_push ( [ #f80 1.44269504088896340736 ] );

	insn fldlg2 : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 5, rm:3 = 4 ),	// 0xD9 EC  log10(2)
		disasm ( mnemonic : "fldlg2" )
		=> @fpu_push ( [ #f80 0.30102999566398119521 ] );

	insn fldln2 : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 5, rm:3 = 5 ),	// 0xD9 ED  ln(2)
		disasm ( mnemonic : "fldln2" )
		=> @fpu_push ( [ #f80 0.69314718055994530942 ] );

	// ---- unary operations on ST(0) -----------------------------------------

	insn fchs  : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 4, rm:3 = 0 ),	// 0xD9 E0
		disasm ( mnemonic : "fchs" )
		=> st[ ftop ] = - st[ ftop ];

	insn fabs  : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 4, rm:3 = 1 ),	// 0xD9 E1
		disasm ( mnemonic : "fabs" )
		=> st[ ftop ] = @fabs ( st[ ftop ] );

	insn fsqrt : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 7, rm:3 = 2 ),	// 0xD9 FA
		disasm ( mnemonic : "fsqrt" )
		=> st[ ftop ] = @fsqrt ( st[ ftop ] );

	// ---- transcendentals (the original 8087's value-bearing functions) ------
	// These are the genuine 8087 set: F2XM1, FYL2X, FPTAN, FPATAN, FYL2XP1.
	// (FSIN/FCOS/FSINCOS arrived only with the 387.) Each works on the stack top,
	// and the y*log2 / arctangent forms compute into ST(1) and pop, so the result
	// is written into st[(ftop + 1) & 7] -- the register that becomes the new top --
	// before ftop is advanced.

	// F2XM1: ST(0) = 2**ST(0) - 1.  0xD9 F0
	insn f2xm1 : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 6, rm:3 = 0 ),
		disasm ( mnemonic : "f2xm1" )
		=> st[ ftop ] = @f2xm1 ( st[ ftop ] );

	// FYL2X: ST(1) = ST(1) * log2(ST(0)), then pop.  0xD9 F1
	insn fyl2x : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 6, rm:3 = 1 ),
		disasm ( mnemonic : "fyl2x" )
		{ st[ ( ftop + 1 ) & 7 ] = st[ ( ftop + 1 ) & 7 ] * @flog2 ( st[ ftop ] ) ;
		  ftop = ( ftop + 1 ) & 7 ; }

	// FPTAN: ST(0) = tan(ST(0)), then push 1.0 (so ST(1)/ST(0) is the tangent).  0xD9 F2
	insn fptan : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 6, rm:3 = 2 ),
		disasm ( mnemonic : "fptan" )
		{ st[ ftop ] = @ftan ( st[ ftop ] ) ;
		  @fpu_push ( [ #f80 1 ] ) ; }

	// FPATAN: ST(1) = atan(ST(1) / ST(0)), then pop.  0xD9 F3
	insn fpatan : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 6, rm:3 = 3 ),
		disasm ( mnemonic : "fpatan" )
		{ st[ ( ftop + 1 ) & 7 ] = @fatan2 ( st[ ( ftop + 1 ) & 7 ], st[ ftop ] ) ;
		  ftop = ( ftop + 1 ) & 7 ; }

	// FYL2XP1: ST(1) = ST(1) * log2(ST(0) + 1.0), then pop.  0xD9 F9
	insn fyl2xp1 : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 7, rm:3 = 1 ),
		disasm ( mnemonic : "fyl2xp1" )
		{ st[ ( ftop + 1 ) & 7 ] = st[ ( ftop + 1 ) & 7 ] * @flog2 ( st[ ftop ] + [ #f80 1 ] ) ;
		  ftop = ( ftop + 1 ) & 7 ; }

	// ---- register loads / stores -------------------------------------------

	// FLD ST(i): push a copy of ST(i).  0xD9 C0+i  (read ST(i) before the push moves the top)
	insn fld_st : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 0, rm:3 -> sti ),
		disasm ( mnemonic : "fld", operands : sti )
		{ #f80 v = st[ ( ftop + sti ) & 7 ] ; @fpu_push ( v ) ; }

	// FXCH ST(i): exchange ST(0) and ST(i).  0xD9 C8+i
	insn fxch : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 1, rm:3 -> sti ),
		disasm ( mnemonic : "fxch", operands : sti )
		{ #f80 v = st[ ftop ] ;
		  st[ ftop ] = st[ ( ftop + sti ) & 7 ] ;
		  st[ ( ftop + sti ) & 7 ] = v ; }

	// FILD m16int: load a 16-bit integer from memory, convert to floating point, push.  0xDF /0
	insn fild : encode #i16 ( op:8 = 0xDF, mod:2, reg:3 = 0, rm:3 -> src @modrm16 ),
		disasm ( mnemonic : "fild", size : word, operands : src )
		=> @fpu_push ( [ #f80 src ] );

	// FIST m16int: store ST(0), truncated to a 16-bit integer, to memory.  0xDF /2
	insn fist : encode #i16 ( op:8 = 0xDF, mod:2, reg:3 = 2, rm:3 -> dst @modrm16 ),
		disasm ( mnemonic : "fist", size : word, operands : dst )
		=> dst = [ #i16 st[ ftop ] ];

	// FISTP m16int: FIST, then pop.  0xDF /3
	insn fistp : encode #i16 ( op:8 = 0xDF, mod:2, reg:3 = 3, rm:3 -> dst @modrm16 ),
		disasm ( mnemonic : "fistp", size : word, operands : dst )
		{ dst = [ #i16 st[ ftop ] ] ; ftop = ( ftop + 1 ) & 7 ; }

	// ---- memory reals: FLD / FST / FSTP m32real (0xD9 /0,/2,/3), m64real (0xDD /0,/2,/3) --------
	//
	// The ModR/M gives only the effective address (@lea); the real is read or written at its own
	// width through `#f32`/`#f64 %M[..]` (raw IEEE bytes), widening to / narrowing from the 80-bit
	// stack. mod=11 (a register operand) is the more-specific FLD ST(i) form above, so these only
	// match a memory operand.

	insn fld_m32 : encode #i16 ( op:8 = 0xD9, mod:2, reg:3 = 0, rm:3 -> src @modrm16 ),	// 0xD9 /0
		disasm ( mnemonic : "fld", operands : src )
		=> @fpu_push ( [ #f80 #f32 %M[ @lea ( src ) ] ] );

	insn fld_m64 : encode #i16 ( op:8 = 0xDD, mod:2, reg:3 = 0, rm:3 -> src @modrm16 ),	// 0xDD /0
		disasm ( mnemonic : "fld", operands : src )
		=> @fpu_push ( [ #f80 #f64 %M[ @lea ( src ) ] ] );

	insn fst_m32 : encode #i16 ( op:8 = 0xD9, mod:2, reg:3 = 2, rm:3 -> dst @modrm16 ),	// 0xD9 /2
		disasm ( mnemonic : "fst", operands : dst )
		=> #f32 %M[ @lea ( dst ) ] = st[ ftop ];

	insn fstp_m32 : encode #i16 ( op:8 = 0xD9, mod:2, reg:3 = 3, rm:3 -> dst @modrm16 ),	// 0xD9 /3
		disasm ( mnemonic : "fstp", operands : dst )
		{ #f32 %M[ @lea ( dst ) ] = st[ ftop ] ; ftop = ( ftop + 1 ) & 7 ; }

	insn fst_m64 : encode #i16 ( op:8 = 0xDD, mod:2, reg:3 = 2, rm:3 -> dst @modrm16 ),	// 0xDD /2
		disasm ( mnemonic : "fst", operands : dst )
		=> #f64 %M[ @lea ( dst ) ] = st[ ftop ];

	insn fstp_m64 : encode #i16 ( op:8 = 0xDD, mod:2, reg:3 = 3, rm:3 -> dst @modrm16 ),	// 0xDD /3
		disasm ( mnemonic : "fstp", operands : dst )
		{ #f64 %M[ @lea ( dst ) ] = st[ ftop ] ; ftop = ( ftop + 1 ) & 7 ; }

	// ---- arithmetic: ST(0) = ST(0) op ST(i)  (0xD8 /digit) ------------------

	insn fadd : encode #i16 ( op:8 = 0xD8, mod:2 = 3, reg:3 = 0, rm:3 -> sti ),	// 0xD8 C0+i
		disasm ( mnemonic : "fadd", operands : sti )
		=> st[ ftop ] = st[ ftop ] + st[ ( ftop + sti ) & 7 ];

	insn fmul : encode #i16 ( op:8 = 0xD8, mod:2 = 3, reg:3 = 1, rm:3 -> sti ),	// 0xD8 C8+i
		disasm ( mnemonic : "fmul", operands : sti )
		=> st[ ftop ] = st[ ftop ] * st[ ( ftop + sti ) & 7 ];

	insn fsub : encode #i16 ( op:8 = 0xD8, mod:2 = 3, reg:3 = 4, rm:3 -> sti ),	// 0xD8 E0+i
		disasm ( mnemonic : "fsub", operands : sti )
		=> st[ ftop ] = st[ ftop ] - st[ ( ftop + sti ) & 7 ];

	insn fdiv : encode #i16 ( op:8 = 0xD8, mod:2 = 3, reg:3 = 6, rm:3 -> sti ),	// 0xD8 F0+i
		disasm ( mnemonic : "fdiv", operands : sti )
		=> st[ ftop ] = st[ ftop ] / st[ ( ftop + sti ) & 7 ];

	// ---- arithmetic with pop: ST(i) = ST(i) op ST(0); pop  (0xDE /digit) ----

	insn faddp : encode #i16 ( op:8 = 0xDE, mod:2 = 3, reg:3 = 0, rm:3 -> sti ),	// 0xDE C0+i
		disasm ( mnemonic : "faddp", operands : sti )
		{ st[ ( ftop + sti ) & 7 ] = st[ ( ftop + sti ) & 7 ] + st[ ftop ] ; ftop = ( ftop + 1 ) & 7 ; }

	insn fmulp : encode #i16 ( op:8 = 0xDE, mod:2 = 3, reg:3 = 1, rm:3 -> sti ),	// 0xDE C8+i
		disasm ( mnemonic : "fmulp", operands : sti )
		{ st[ ( ftop + sti ) & 7 ] = st[ ( ftop + sti ) & 7 ] * st[ ftop ] ; ftop = ( ftop + 1 ) & 7 ; }

	// ---- compares: set the condition codes C3/C2/C0 (greater=000, less=001, equal=100) ----------

	insn fcom : encode #i16 ( op:8 = 0xD8, mod:2 = 3, reg:3 = 2, rm:3 -> sti ),	// 0xD8 D0+i
		disasm ( mnemonic : "fcom", operands : sti )
		{ fc0 = st[ ftop ] < st[ ( ftop + sti ) & 7 ] ;
		  fc3 = st[ ftop ] == st[ ( ftop + sti ) & 7 ] ;
		  fc2 = 0 ; }

	insn fcomp : encode #i16 ( op:8 = 0xD8, mod:2 = 3, reg:3 = 3, rm:3 -> sti ),	// 0xD8 D8+i
		disasm ( mnemonic : "fcomp", operands : sti )
		{ fc0 = st[ ftop ] < st[ ( ftop + sti ) & 7 ] ;
		  fc3 = st[ ftop ] == st[ ( ftop + sti ) & 7 ] ;
		  fc2 = 0 ; ftop = ( ftop + 1 ) & 7 ; }

	// FTST: compare ST(0) with 0.0.  0xD9 E4
	insn ftst : encode #i16 ( op:8 = 0xD9, mod:2 = 3, reg:3 = 4, rm:3 = 4 ),
		disasm ( mnemonic : "ftst" )
		{ fc0 = st[ ftop ] < [ #f80 0 ] ; fc3 = st[ ftop ] == [ #f80 0 ] ; fc2 = 0 ; }

	// FSTSW / FNSTSW m16: assemble the status word from TOP and the condition codes, store it.
	// (The 8087 has no FSTSW AX -- that direct form is an 80287 addition -- so this goes to memory.)
	insn fstsw : encode #i16 ( op:8 = 0xDD, mod:2, reg:3 = 7, rm:3 -> dst @modrm16 ),	// 0xDD /7
		disasm ( mnemonic : "fstsw", operands : dst )
		{ fsw = ( fc3 << 14 ) | ( ftop << 11 ) | ( fc2 << 10 ) | ( fc0 << 8 ) ;
		  dst = fsw ; }

	// ---- control -----------------------------------------------------------

	// FNINIT: initialise the coprocessor -- empty the stack (TOP = 0), clear the status word and
	// condition codes, and load the default control word (round-to-nearest, all exceptions masked).
	insn fninit : encode #i16 ( op:8 = 0xDB, mod:2 = 3, reg:3 = 4, rm:3 = 3 ),	// 0xDB E3
		disasm ( mnemonic : "fninit" )
		{ ftop = 0 ; fsw = 0 ; fcw = 0x37F ; fc0 = 0 ; fc2 = 0 ; fc3 = 0 ; }

	// FLDCW m16 / FNSTCW m16: load and store the control word.  0xD9 /5, 0xD9 /7
	insn fldcw : encode #i16 ( op:8 = 0xD9, mod:2, reg:3 = 5, rm:3 -> src @modrm16 ),
		disasm ( mnemonic : "fldcw", operands : src )
		=> fcw = src;

	insn fnstcw : encode #i16 ( op:8 = 0xD9, mod:2, reg:3 = 7, rm:3 -> dst @modrm16 ),
		disasm ( mnemonic : "fnstcw", operands : dst )
		=> dst = fcw;
}
