// DEC PDP-10 -- the 36-bit word-addressed mainframe that defined timesharing. Sixteen 36-bit
// general-purpose accumulator registers (AC0-AC15) that ARE the low sixteen words of memory
// (an architectural alias: a `%M[n]` access with n < 16 reads/writes the AC bank, not a
// separate RAM cell). Instruction words are 36 bits wide and word-indexed; the program counter
// (PC) is 18 bits (the right half of the "process context word"). PC flags occupy the left
// half of the same word: AROV, CRY0, CRY1, FOV, FPD, USR, UIO, PUB, AFI, TRAP2, TRAP1, FXU,
// DCK -- sourced from the DEC PDP-10 Hardware Reference Manual (1968-1975 era) and verified
// against SIMH pdp10_defs.h (F_V_*/F_* defines).
//
// WORD-ADDRESSING: byte_size == word_size == 36 (not 8) marks this arch as word-addressed.
// The decoder fetches one 36-bit instruction word at a WORD index (not a byte offset), extracts
// MSB-first fields from the 36-bit value, and `%M[y]` indexes a 36-bit word cell. The canonical
// PDP-10 instruction format is: op[35:27]:9, ac[26:23]:4, i[22]:1, x[21:18]:4, y[17:0]:18.
//
// REGISTER/MEMORY ALIASING (AC group, `aliases_memory 0`): AC0-AC15 are memory words 0-17
// (octal). The `aliases_memory 0` directive routes `%M[0..15]` to the AC bank -- the same
// physical storage -- replicating the PDP-10's defining architectural property.
//
// PHASE 1: arch header + register file. PHASE 2 (this file, Task 6): the @ea effective-address
// computation -- index + indirect chain. Later tasks add the full instruction set.
//
// EFFECTIVE ADDRESS (non-extended, single-section -- DEC PDP-10 Hardware Reference, "Effective
// Address Calculation"; SIMH pdp10 `calc_ea`). Each instruction word carries three EA fields:
//   I (bit 13, MSB-first bit 22)  indirect
//   X (bits 14..17 / 21..18)      index register (an AC number; 0 means "no indexing")
//   Y (bits 18..35 / 17..0)       18-bit address
// The effective address E is computed as:
//   E := Y + (X != 0 ? right18(AC[X]) : 0)            -- index step (right half of AC[X])
//   while (the word at E has its I bit set):           -- INDIRECT CHAIN (data-dependent loop)
//       W := M[E];  I := W.I;  X := W.X;  Y := W.Y;
//       E := Y + (X != 0 ? right18(AC[X]) : 0);
// i.e. as long as the fetched word is itself indirect, take ITS I/X/Y and recompute, iterating until
// a word with I=0 is reached. The chain length is RUNTIME DATA-DEPENDENT (it depends on the contents
// of guest memory), so it cannot be a decode-time/structural construct -- it is computed in the
// instruction body by the reusable `@ea` macro below, which is the only place in the engine where a
// data-dependent memory dereference loop can live.
//
// PC FLAG LAYOUT -- left half of the 36-bit process context word, bits 35..18 (MSB first):
//   bit 35 = AROV  arithmetic overflow      bit 34 = CRY0  carry out of bit 0 (left)
//   bit 33 = CRY1  carry out of bit 1       bit 32 = FOV   floating-point overflow
//   bit 31 = FPD   first part done          bit 30 = USR   user mode
//   bit 29 = UIO   user I/O mode            bit 28 = PUB   public mode
//   bit 27 = AFI   address failure inhibit  bit 26 = TRAP2 software trap 2
//   bit 25 = TRAP1 software trap 1          bit 24 = FXU   floating-point exponent underflow
//   bit 23 = DCK   divide check             bits 22..18 = reserved / zero
// PC (right half): bits 17..0.
//
// `const PCF_*` values are one-hot masks within the 18-bit `pcflags` left-half register.
// (They match the SIMH F_* values: F_AOV=1<<17=0x20000, F_C0=1<<16=0x10000, etc.)

// PC-flag bit masks within the 18-bit left-half (pcflags) register.
const PCF_AROV  = 0x20000;   // bit 17 -- arithmetic overflow          (SIMH F_AOV)
const PCF_CRY0  = 0x10000;   // bit 16 -- carry out of bit 0           (SIMH F_C0)
const PCF_CRY1  = 0x08000;   // bit 15 -- carry out of bit 1           (SIMH F_C1)
const PCF_FOV   = 0x04000;   // bit 14 -- floating-point overflow       (SIMH F_FOV)
const PCF_FPD   = 0x02000;   // bit 13 -- first part done               (SIMH F_FPD)
const PCF_USR   = 0x01000;   // bit 12 -- user mode                     (SIMH F_USR)
const PCF_UIO   = 0x00800;   // bit 11 -- user I/O mode                 (SIMH F_UIO)
const PCF_PUB   = 0x00400;   // bit 10 -- public mode                   (SIMH F_PUB)
const PCF_AFI   = 0x00200;   // bit  9 -- address failure inhibit       (SIMH F_AFI)
const PCF_TRAP2 = 0x00100;   // bit  8 -- software trap 2               (SIMH F_T2)
const PCF_TRAP1 = 0x00080;   // bit  7 -- software trap 1               (SIMH F_T1)
const PCF_FXU   = 0x00040;   // bit  6 -- floating-point exp. underflow (SIMH F_FXU)
const PCF_DCK   = 0x00020;   // bit  5 -- divide check                  (SIMH F_DCK)

arch "pdp10" {

    name "DEC PDP-10";

    // Big-endian, word-addressed. byte_size == word_size == 36 activates the word-address path:
    // instruction fetch reads one 36-bit word cell at a WORD index, fields are extracted MSB-first
    // from that 36-bit value, and `%M[y]` indexes 36-bit word cells in guest RAM.
    endian big;
    byte_size 36;
    word_size 36;
    address_size 18;
    float_size 36;

    register_file {

        // AC0..AC15: sixteen 36-bit general-purpose accumulators. Declared `aliases_memory 0`
        // so that any `%M[n]` access with 0 <= n < 16 is routed to this register bank (the same
        // physical storage), replicating the PDP-10's AC/low-memory aliasing property.
        // The `?` suffix + `16 **` repeat generates ac0..ac15 and their positional group aliases
        // AC0..AC15.
        group AC aliases_memory 0 {
            [ 16 ** #i36 ac?:0 ]
        }

        // Dedicated (special-purpose) registers.
        //
        // `pc` carries the %PC meta-role (18-bit right half of the process context word).
        //
        // `pcflags` models the 18-bit left half of the process context word. It carries the
        // %PSR meta-role and an `explicit` flag splitter (MSB-first within the 18-bit register):
        //   AROV CRY0 CRY1 FOV FPD USR UIO PUB AFI TRAP2 TRAP1 FXU DCK <5-bit zero pad>
        // AROV (arithmetic overflow) maps to the %V (overflow) meta-flag; CRY0/CRY1 are carry
        // flags (CRY0 = carry out of bit 0 = the left-most carry = %C in PDP-10 parlance).
        group S {
            [ #i18 pc -> %PC ],
            [ #i18 pcflags -> %PSR #i18 explicit
                ( #i1 AROV -> %V : #i1 CRY0 -> %C : #i1 CRY1
                : #i1 FOV : #i1 FPD : #i1 USR : #i1 UIO : #i1 PUB
                : #i1 AFI : #i1 TRAP2 : #i1 TRAP1 : #i1 FXU : #i1 DCK
                : #i5 0 ) ]
        }

    }

}

// ---------------------------------------------------------------------------
// Field bit-masks within a 36-bit PDP-10 instruction word (MSB-first: op:9 ac:4 i:1 x:4 y:18).
// Used to take the I/X/Y of a word fetched during the indirect chain.
const EA_I_SHIFT = 22;          // I bit position (bit 22, MSB-first bit 13)
const EA_X_SHIFT = 18;          // X field low bit (bits 21..18)
const EA_X_MASK  = 0xf;         // X is 4 bits
const EA_Y_MASK  = 0x3ffff;     // Y is 18 bits -- also the right-half / address mask

// decoder operands: the EA fields lifted out of the instruction word, plus the AC operand number.
// `i`, `x`, `y` are bound positionally into the @ea macro; `ac` selects the accumulator operand.
decoder_operands [
    #i4  acn,                   // the AC operand (bits 26..23) -- MOVE/MOVEM accumulator
    #i1  i,                     // indirect bit (bit 22)
    #i4  x,                     // index-register field (bits 21..18)
    #i18 y                      // 18-bit address field (bits 17..0)
];

// ---------------------------------------------------------------------------
// @ea ( i, x, y ) -- the PDP-10 effective-address calculation, non-extended (18-bit, single
// section). Returns E in `result`. This is a MACRO, not an `addrmode`: the UPCL `addrmode`
// construct is purely STRUCTURAL (it composes a decode-time operand `base + base + disp` for
// disassembly and length, and cannot read memory or loop), whereas the PDP-10 EA needs (a) the
// RIGHT HALF of AC[X] for indexing -- a mask the addrmode `%M[...]` term grammar cannot express --
// and (b) the INDIRECT CHAIN, an iterative, runtime-data-dependent memory dereference. Both live
// naturally in a body macro, which the engine evaluates as an expression: `%M[ @ea(i,x,y) ]` is the
// memory operand and `@ea(i,x,y)` is the bare effective address (for jumps / immediates).
//
// The index uses right18(AC[X]) = AC[X] & EA_Y_MASK (the low 18 bits). X==0 means no indexing.
// The chain re-reads M[E] while the fetched word's I bit is set, taking ITS I/X/Y each time. The
// loop is bounded only by encountering a word with I=0 (faithful to the hardware).
//
// LOOP-CARRIED LOCALS (Task 18, FIXED): `e`, `ci`, `cx`, `w`, `wy` below are body locals mutated
// across the `while`.  The engine now promotes any body local assigned inside a loop to a synthesised
// SCRATCH REGISTER (see Semantics.cpp PromoteLoopLocals), so its value carries across the
// head/body/end blocks exactly as architectural register state does.  This makes BOTH cases correct
// at execution: the zero-iteration case (the common non-indirect `result = e` after a `while` that
// never runs -- it reads the spilled initial value, not an undefined loop-body temp; this is what
// made MOVEI/ADDI yield the right AC) AND the multi-iteration indirect chain (each iteration's
// updated I/X/Y/E persist into the next, terminating at I=0).  Verified by execution in
// test/pdp10-compute.sav (a one-deep indirect MOVE resolves to the chained value).
macro ea ( i, x, y ) {
    // Index step: E = Y + (X != 0 ? right18(AC[X]) : 0).  ac[x] indexes the AC group by the runtime
    // X field; only its low 18 bits (the right half) participate in address formation.
    #i18 e = ( x != 0 ) ? ( y + ( ac[ x ] & EA_Y_MASK ) ) : y;
    // Indirect chain: while the word at E is itself indirect, take its I/X/Y and recompute E.
    #i1  ci = i;
    while ( ci != 0 ) {
        #i36 w  = %M[ e ];                                  // fetch the indirect word
        #i4  cx = ( w >> EA_X_SHIFT ) & EA_X_MASK;          // its X
        #i18 wy = w & EA_Y_MASK;                            // its Y
        e  = ( cx != 0 ) ? ( wy + ( ac[ cx ] & EA_Y_MASK ) ) : wy;
        ci = ( w >> EA_I_SHIFT ) & 1;                       // its I -- continue while set
    }
    result = e;
}

// ===========================================================================
// FULL-WORD DATA TRANSMISSION (DEC PDP-10 Hardware Reference Manual, "Full Word Data
// Transmission"; opcodes verified against SIMH pdp10_sys.c). These move whole 36-bit words
// between an accumulator and the effective address (or, for the double-word forms, an AC pair
// and an E pair). They are the TEMPLATE for the later instruction families.
//
// THE OPERAND-MODE TEMPLATE.  The MOVE/MOVS/MOVN/MOVM groups each occupy four consecutive
// opcodes whose low two bits select WHERE the operand comes from and WHERE the result goes:
//   base (op|0)  "basic"      AC <- f(E)            -- read M[E], result to AC
//   I    (op|1)  "Immediate"  AC <- f(0,,E)         -- the operand IS E itself (0 in left half)
//   M    (op|2)  "to Memory"  M[E] <- f(AC)         -- read AC, result back to M[E]
//   S    (op|3)  "to Self"    M[E] <- f(E); AC<-... -- operate in place at M[E]; also to AC if AC#0
// f is the per-group transform: identity (MOVE), half-swap (MOVS), negate (MOVN), magnitude
// (MOVM). Self mode's "also to AC if AC != 0" is the PDP-10 rule that AC0 is suppressed as a
// destination; here the body writes ac[acn] unconditionally (acn==0 writes AC0, harmless), the
// faithful "AC != 0" gate is exercised by execution in Task 18.  Every member uses @ea: the basic
// and Self/Memory forms as `%M[ @ea(..) ]`, the Immediate forms as the bare address `@ea(..)`.
//
// The op:9 group base octals: MOVE 0o200, MOVS 0o204, MOVN 0o210, MOVM 0o214.  The low two bits of
// the opcode are the MODE bits (MODE_*); each member opcode is its group base + its mode, so the
// full set is generated from four bases and four mode constants (the encode-field value below is a
// const, the arithmetic is done here at const-definition time).
const MODE_B = 0;               // 00 basic      AC <- f(E)
const MODE_I = 1;               // 01 Immediate  AC <- f(0,,E)
const MODE_M = 2;               // 10 to Memory  M[E] <- f(AC)
const MODE_S = 3;               // 11 to Self    M[E] <- f(AC, M[E]); AC <- same result if AC != 0
const OP_MOVE = 0o200;          // MOVE family base (identity)
const OP_MOVS = 0o204;          // MOVS family base (swap halves)
const OP_MOVN = 0o210;          // MOVN family base (2's-complement negate)
const OP_MOVM = 0o214;          // MOVM family base (magnitude / absolute value)
const OP_EXCH = 0o250;          // EXCH  exchange AC and M[E]
const OP_BLT  = 0o251;          // BLT   block transfer
const OP_DMOVE = 0o120;         // DMOVE double-word move into the AC pair
const OP_DMOVN = 0o121;         // DMOVN double-word negate into the AC pair

// Per-mnemonic opcodes = group base + mode bits.
const OP_MOVEI = OP_MOVE + MODE_I;
const OP_MOVEM = OP_MOVE + MODE_M;
const OP_MOVES = OP_MOVE + MODE_S;
const OP_MOVSI = OP_MOVS + MODE_I;
const OP_MOVSM = OP_MOVS + MODE_M;
const OP_MOVSS = OP_MOVS + MODE_S;
const OP_MOVNI = OP_MOVN + MODE_I;
const OP_MOVNM = OP_MOVN + MODE_M;
const OP_MOVNS = OP_MOVN + MODE_S;
const OP_MOVMI = OP_MOVM + MODE_I;
const OP_MOVMM = OP_MOVM + MODE_M;
const OP_MOVMS = OP_MOVM + MODE_S;

// The right half (low 18 bits) and most-negative word -- needed by the swap and the negate/magnitude
// overflow rules. SIGN_BIT36 is 400000,,000000 = -2^35, the one word whose negation overflows.
const W36_MASK   = 0xfffffffff;     // 36-bit word mask
const SIGN_BIT36 = 0x800000000;     // bit 35, the sign bit (also the most-negative value -2^35)

// ---------------------------------------------------------------------------
// MOVE -- copy the word unchanged.  AC <- E / E <- AC / E <- E.
insn move  : encode #i36 ( op:9 = OP_MOVE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "move",  operands : acn, i, x, y )  => ac[ acn ] = %M[ @ea ( i, x, y ) ];
insn movei : encode #i36 ( op:9 = OP_MOVEI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movei", operands : acn, i, x, y )  => ac[ acn ] = @ea ( i, x, y );   // 0,,E
insn movem : encode #i36 ( op:9 = OP_MOVEM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movem", operands : acn, i, x, y )  => %M[ @ea ( i, x, y ) ] = ac[ acn ];
insn moves : encode #i36 ( op:9 = OP_MOVES, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "moves", operands : acn, i, x, y )
    { #i36 e = @ea ( i, x, y ); #i36 v = %M[ e ]; %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// MOVS -- swap the two 18-bit halves: result = right(v),,left(v).  The transform is shared by all
// four modes; the half-swap macro keeps each body to one line.
macro swaphalves ( v ) { result = ( ( v >> 18 ) & EA_Y_MASK ) | ( ( v & EA_Y_MASK ) << 18 ); }
insn movs  : encode #i36 ( op:9 = OP_MOVS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movs",  operands : acn, i, x, y )  => ac[ acn ] = @swaphalves ( %M[ @ea ( i, x, y ) ] );
insn movsi : encode #i36 ( op:9 = OP_MOVSI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movsi", operands : acn, i, x, y )  => ac[ acn ] = @swaphalves ( @ea ( i, x, y ) );  // E,,0
insn movsm : encode #i36 ( op:9 = OP_MOVSM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movsm", operands : acn, i, x, y )  => %M[ @ea ( i, x, y ) ] = @swaphalves ( ac[ acn ] );
insn movss : encode #i36 ( op:9 = OP_MOVSS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movss", operands : acn, i, x, y )
    { #i36 e = @ea ( i, x, y ); #i36 v = @swaphalves ( %M[ e ] ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// MOVN -- 2's-complement negate: result = -v (mod 2^36).  Carry/overflow per the HRM:
//   v == 0           : result 0, set CRY0 AND CRY1 (carry out of both bits, so no AROV).
//   v == 400000,,0   : result unchanged (-2^35 has no positive form), set CRY1 AND AROV (CRY0 reset).
//   otherwise        : no carry/overflow set by this instruction.
// The flag assignments below set exactly the bits the manual names; CRY0 == %C, AROV == %V, and
// CRY1 is the named PSR field. They are computed once from v and written unconditionally.
macro movn_flags ( v ) {
    #i1 isz = ( ( v & W36_MASK ) == 0 ) ? 1 : 0;            // v == 0
    #i1 ism = ( ( v & W36_MASK ) == SIGN_BIT36 ) ? 1 : 0;   // v == -2^35
    CRY0 = isz;                                             // carry out of bit 0 only when negating 0
    CRY1 = isz | ism;                                       // carry out of bit 1 when 0 or most-negative
    AROV = ism;                                             // overflow only for the most-negative word
}
insn movn  : encode #i36 ( op:9 = OP_MOVN, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movn",  operands : acn, i, x, y )
    { #i36 v = %M[ @ea ( i, x, y ) ]; @movn_flags ( v ); ac[ acn ] = 0 - v; }
insn movni : encode #i36 ( op:9 = OP_MOVNI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movni", operands : acn, i, x, y )
    { #i36 v = @ea ( i, x, y ); @movn_flags ( v ); ac[ acn ] = 0 - v; }   // negate of 0,,E (never overflows)
insn movnm : encode #i36 ( op:9 = OP_MOVNM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movnm", operands : acn, i, x, y )
    { #i36 v = ac[ acn ]; @movn_flags ( v ); %M[ @ea ( i, x, y ) ] = 0 - v; }
insn movns : encode #i36 ( op:9 = OP_MOVNS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movns", operands : acn, i, x, y )
    { #i36 e = @ea ( i, x, y ); #i36 v = %M[ e ]; @movn_flags ( v ); #i36 r = 0 - v; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// MOVM -- magnitude (absolute value): result = (v < 0) ? -v : v.  Only the most-negative word
// 400000,,0 overflows (its magnitude is unrepresentable) -- it sets CRY1 and AROV, leaving the value
// unchanged; every other word produces |v| with no flag change.  `%S` sign-extends the 36-bit word
// so the sign test is a true signed compare.
macro movm_flags ( v ) {
    #i1 ism = ( ( v & W36_MASK ) == SIGN_BIT36 ) ? 1 : 0;   // v == -2^35 (only overflow case)
    CRY1 = ism;
    AROV = ism;
}
macro magnitude ( v ) { result = ( %S ( v ) < 0 ) ? ( 0 - v ) : v; }
insn movm  : encode #i36 ( op:9 = OP_MOVM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movm",  operands : acn, i, x, y )
    { #i36 v = %M[ @ea ( i, x, y ) ]; @movm_flags ( v ); ac[ acn ] = @magnitude ( v ); }
insn movmi : encode #i36 ( op:9 = OP_MOVMI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movmi", operands : acn, i, x, y )  => ac[ acn ] = @ea ( i, x, y );   // 0,,E is always >= 0
insn movmm : encode #i36 ( op:9 = OP_MOVMM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movmm", operands : acn, i, x, y )
    { #i36 v = ac[ acn ]; @movm_flags ( v ); %M[ @ea ( i, x, y ) ] = @magnitude ( v ); }
insn movms : encode #i36 ( op:9 = OP_MOVMS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "movms", operands : acn, i, x, y )
    { #i36 e = @ea ( i, x, y ); #i36 v = %M[ e ]; @movm_flags ( v ); #i36 r = @magnitude ( v ); %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// EXCH AC, E -- exchange: the contents of AC and M[E] are swapped.
insn exch : encode #i36 ( op:9 = OP_EXCH, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "exch", operands : acn, i, x, y )
    { #i36 e = @ea ( i, x, y ); #i36 t = ac[ acn ]; ac[ acn ] = %M[ e ]; %M[ e ] = t; }

// ---------------------------------------------------------------------------
// BLT AC, E -- block transfer.  The two halves of AC are addresses: the LEFT half is the current
// source, the RIGHT half the current destination.  Words are copied M[src] -> M[dst], both halves
// incrementing, until a word has been stored at an address >= E (the effective address); i.e. the
// loop runs while the destination address dst <= E.  AC is left holding the addresses after the last
// transfer.  (Per the HRM, AC is the running pointer pair; deep / interrupted BLT semantics are
// exercised by execution in Task 18 -- here the loop shape and the half decomposition are pinned.)
insn blt : encode #i36 ( op:9 = OP_BLT, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "blt", operands : acn, i, x, y )
    {
        #i36 e   = @ea ( i, x, y );
        #i18 src = ( ac[ acn ] >> 18 ) & EA_Y_MASK;     // left half  = first source address
        #i18 dst = ac[ acn ] & EA_Y_MASK;               // right half = first destination address
        while ( dst <= ( e & EA_Y_MASK ) ) {
            %M[ dst ] = %M[ src ];                       // copy one word
            src = ( src + 1 ) & EA_Y_MASK;              // advance both pointers (18-bit wrap)
            dst = ( dst + 1 ) & EA_Y_MASK;
            ac[ acn ] = ( src << 18 ) | dst;            // AC tracks the running source,,destination
        }
    }

// ---------------------------------------------------------------------------
// DMOVE / DMOVN -- double-word (72-bit) transfers into the AC pair (AC, AC+1) from the memory pair
// (E, E+1).  DMOVE copies both words; DMOVN negates the 72-bit two's-complement value (the pair is
// one big number: high word in AC, low word in AC+1), placing the result in the AC pair.  Both
// result words are stored with all 36 bits intact (flat 72-bit approximation); canonical 70-bit
// normalisation (forcing the low word's sign bit to match the high word's sign) is deferred.
// AC+1 wraps within the 16-AC bank (& 0xf).
insn dmove : encode #i36 ( op:9 = OP_DMOVE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "dmove", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); ac[ acn ] = %M[ e ]; ac[ ( acn + 1 ) & 0xf ] = %M[ ( e + 1 ) & EA_Y_MASK ]; }
insn dmovn : encode #i36 ( op:9 = OP_DMOVN, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "dmovn", operands : acn, i, x, y )
    {
        #i18 e  = @ea ( i, x, y );
        #i72 hi = %M[ e ];                              // high word -> bits 71..36 of the 72-bit value
        #i72 lo = %M[ ( e + 1 ) & EA_Y_MASK ];          // low word  -> bits 35..0
        #i72 d  = 0 - ( ( hi << 36 ) | lo );            // negate the full 72-bit number
        ac[ acn ]               = ( d >> 36 ) & W36_MASK;
        ac[ ( acn + 1 ) & 0xf ] = d & W36_MASK;
    }

// ---------------------------------------------------------------------------
// JRST -- the "Jump and ReSToRe flags" family.  The AC field selects the function
// (all AC values in OCTAL, PDP-10 convention):
//   AC=0   plain jump:        pc = E.
//   AC=2   JEN (restore PSW): restore pcflags from the LEFT half of M[E-1] (the stacked PCW),
//          then pc = E.  (Deferred to execution in Task 18; decode only here.)
//   AC=4   HALT:              stop the machine -- modelled as @trap(0) (host halt vector 0).
//   AC=12  XJRSTF:            extended jump, KL only (0o12 = decimal 10) -- decode stub.
//   AC=14  JEN (alternate):   same as AC=2 on some models (0o14 = decimal 12).
//   Other AC values: reserved / decode-only stubs in execution.
//
// Opcode 0o254, AC field is the function code (4 bits).  Source: DEC PDP-10 HRM ch.2 "JRST"
// and SIMH pdp10_cpu.c `jrst()`.  Function constants used in the encode fixed-AC fields
// (all values decimal; PDP-10 docs use octal -- AC=2 is octal 2, AC=4 is octal 4):
const JRST_FN_JEN   = 0x2;     // AC=2  (octal 2)  restore flags, then jump (JEN)
const JRST_FN_HALT  = 0x4;     // AC=4  (octal 4)  HALT -- halt the machine

// JRST is one instruction with a sub-function in the AC field.  We model the two
// architecturally distinct behaviours (HALT, JEN) as fixed-AC variants that match before
// the catch-all `jrst` (which captures AC=0 plain jump and all other AC values).
jump insn jrst_halt : type trap, encode #i36 ( op:9 = 0o254, ac:4 = JRST_FN_HALT, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jrst", operands : i, x, y )
    { @trap ( 0 ); }   // HALT -- vector 0 = machine halt

// JEN (AC=2): restore pcflags from left half of the stacked PCW, then jump to E.
// Full restore deferred to Task 18 (needs the stacked-PCW memory read); decode here.
jump insn jrst_jen : type branch, encode #i36 ( op:9 = 0o254, ac:4 = JRST_FN_JEN, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jrst", operands : i, x, y )
    { pc = @ea ( i, x, y ); }   // NOTE: pcflags restore deferred to Task 18

// Plain jump (AC=0): pc = E.  This is the base case and also covers all other unused AC values
// via the catch-all below.
jump insn jrst : type branch, encode #i36 ( op:9 = 0o254, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jrst", operands : i, x, y )  { pc = @ea ( i, x, y ); }

// ===========================================================================
// HALF-WORD DATA TRANSMISSION (DEC PDP-10 Hardware Reference Manual, "Half-Word Data
// Transmission"; opcodes verified against SIMH pdp10_sys.c).  Each instruction moves one 18-bit
// half of a 36-bit word to one half of the destination, and fills the OTHER half according to a
// fill rule.  The naming is H<src-half><dst-half><fill> where:
//   src-half  L = left half (bits 0..17 of the source word in PDP-10 MSB-first, i.e. the HIGH 18 bits)
//             R = right half (bits 18..35 of the source word in PDP-10 MSB-first, i.e. the LOW 18 bits)
//   dst-half  L = left half of destination
//             R = right half of destination
//   fill      (none) = leave the other half unchanged
//             Z      = set the other half to all zeros
//             O      = set the other half to all ones (0x3ffff)
//             E      = sign-extend: replicate the high bit of the moved half
//
// NOTE ON BIT NUMBERING: PDP-10 uses MSB-first numbering (bit 0 = most significant). In a 36-bit
// word, "left half" = bits 0..17 (PDP-10, MSB-first) = the HIGH 18 bits in our numeric
// representation = value >> 18 in the implementation. "Right half" = bits 18..35 (PDP-10,
// MSB-first) = the LOW 18 bits = value & 0x3ffff.
//
// For SIGN-EXTEND (E fill): the "high bit of the moved half" is the most significant bit of the
// half being moved. For a left-half source that means bit 0 of the PDP-10 word (bit 35 in our
// numeric = the MSB = (v >> 35) & 1). For a right-half source it is bit 18 of the PDP-10 word
// (bit 17 in our numeric = (v >> 17) & 1).
//
// THE OPERAND-MODE TEMPLATE is identical to the MOVE family (base/I/M/S = +0/+1/+2/+3 on the
// group base), with the same four-operand decode (acn, i, x, y) and @ea macro for the EA.
//
// OPCODE TABLE (group bases, all in the 0o5xx block; per SIMH pdp10_sys.c):
//   src=L dst=L: HLL=0o500  HLLZ=0o510  HLLO=0o520  HLLE=0o530
//   src=R dst=L: HRL=0o504  HRLZ=0o514  HRLO=0o524  HRLE=0o534
//   src=R dst=R: HRR=0o540  HRRZ=0o550  HRRO=0o560  HRRE=0o570
//   src=L dst=R: HLR=0o544  HLRZ=0o554  HLRO=0o564  HLRE=0o574

// Half-word masks and shift constants (right half = low 18 bits; left half = high 18 bits).
const HW_MASK  = 0x3ffff;              // 18-bit half-word mask (= EA_Y_MASK)
const HW_ONES  = 0x3ffff;              // all-ones in 18 bits (for O fill)
const HW_LSHFT = 18;                   // shift to move right half to/from left-half position

// Per-group opcode bases (group base + MODE_B/I/M/S generates the four member opcodes).
const OP_HLL   = 0o500;               // HLL  family: left  of src -> left  of dst, no fill
const OP_HRL   = 0o504;               // HRL  family: right of src -> left  of dst, no fill
const OP_HLLZ  = 0o510;               // HLLZ family: left  of src -> left  of dst, zero right
const OP_HRLZ  = 0o514;               // HRLZ family: right of src -> left  of dst, zero right
const OP_HLLO  = 0o520;               // HLLO family: left  of src -> left  of dst, ones right
const OP_HRLO  = 0o524;               // HRLO family: right of src -> left  of dst, ones right
const OP_HLLE  = 0o530;               // HLLE family: left  of src -> left  of dst, sign-extend right
const OP_HRLE  = 0o534;               // HRLE family: right of src -> left  of dst, sign-extend right
const OP_HRR   = 0o540;               // HRR  family: right of src -> right of dst, no fill
const OP_HLR   = 0o544;               // HLR  family: left  of src -> right of dst, no fill
const OP_HRRZ  = 0o550;               // HRRZ family: right of src -> right of dst, zero left
const OP_HLRZ  = 0o554;               // HLRZ family: left  of src -> right of dst, zero left
const OP_HRRO  = 0o560;               // HRRO family: right of src -> right of dst, ones left
const OP_HLRO  = 0o564;               // HLRO family: left  of src -> right of dst, ones left
const OP_HRRE  = 0o570;               // HRRE family: right of src -> right of dst, sign-extend left
const OP_HLRE  = 0o574;               // HLRE family: left  of src -> right of dst, sign-extend left

// Per-mnemonic opcodes = group base + mode bits (same arithmetic as the MOVE family).
const OP_HLLI  = OP_HLL  + MODE_I;
const OP_HLLM  = OP_HLL  + MODE_M;
const OP_HLLS  = OP_HLL  + MODE_S;
const OP_HRLI  = OP_HRL  + MODE_I;
const OP_HRLM  = OP_HRL  + MODE_M;
const OP_HRLS  = OP_HRL  + MODE_S;
const OP_HLLZI = OP_HLLZ + MODE_I;
const OP_HLLZM = OP_HLLZ + MODE_M;
const OP_HLLZS = OP_HLLZ + MODE_S;
const OP_HRLZI = OP_HRLZ + MODE_I;
const OP_HRLZM = OP_HRLZ + MODE_M;
const OP_HRLZS = OP_HRLZ + MODE_S;
const OP_HLLOI = OP_HLLO + MODE_I;
const OP_HLLOM = OP_HLLO + MODE_M;
const OP_HLLOS = OP_HLLO + MODE_S;
const OP_HRLOI = OP_HRLO + MODE_I;
const OP_HRLOM = OP_HRLO + MODE_M;
const OP_HRLOS = OP_HRLO + MODE_S;
const OP_HLLEI = OP_HLLE + MODE_I;
const OP_HLLEM = OP_HLLE + MODE_M;
const OP_HLLES = OP_HLLE + MODE_S;
const OP_HRLEI = OP_HRLE + MODE_I;
const OP_HRLEM = OP_HRLE + MODE_M;
const OP_HRLES = OP_HRLE + MODE_S;
const OP_HRRI  = OP_HRR  + MODE_I;
const OP_HRRM  = OP_HRR  + MODE_M;
const OP_HRRS  = OP_HRR  + MODE_S;
const OP_HLRI  = OP_HLR  + MODE_I;
const OP_HLRM  = OP_HLR  + MODE_M;
const OP_HLRS  = OP_HLR  + MODE_S;
const OP_HRRZI = OP_HRRZ + MODE_I;
const OP_HRRZM = OP_HRRZ + MODE_M;
const OP_HRRZS = OP_HRRZ + MODE_S;
const OP_HLRZI = OP_HLRZ + MODE_I;
const OP_HLRZM = OP_HLRZ + MODE_M;
const OP_HLRZS = OP_HLRZ + MODE_S;
const OP_HRROI = OP_HRRO + MODE_I;
const OP_HRROM = OP_HRRO + MODE_M;
const OP_HRROS = OP_HRRO + MODE_S;
const OP_HLROI = OP_HLRO + MODE_I;
const OP_HLROM = OP_HLRO + MODE_M;
const OP_HLROS = OP_HLRO + MODE_S;
const OP_HRREI = OP_HRRE + MODE_I;
const OP_HRREM = OP_HRRE + MODE_M;
const OP_HRRES = OP_HRRE + MODE_S;
const OP_HLREI = OP_HLRE + MODE_I;
const OP_HLREM = OP_HLRE + MODE_M;
const OP_HLRES = OP_HLRE + MODE_S;

// ---------------------------------------------------------------------------
// Half-word extraction / construction macros.  These keep each instruction body to one line.
//
// @left(v)  -- extract the left half of v (bits 17..0 PDP-10 = high 18 bits)
// @right(v) -- extract the right half of v (bits 18..35 PDP-10 = low 18 bits)
// @setleft(d,h)  -- replace the left half of d with the 18-bit value h; right half unchanged
// @setright(d,h) -- replace the right half of d with the 18-bit value h; left half unchanged
macro left  ( v ) { result = ( v >> HW_LSHFT ) & HW_MASK; }
macro right ( v ) { result = v & HW_MASK; }
macro setleft  ( d, h ) { result = ( d & HW_MASK ) | ( ( h & HW_MASK ) << HW_LSHFT ); }
macro setright ( d, h ) { result = ( d & ( HW_MASK << HW_LSHFT ) ) | ( h & HW_MASK ); }

// Fill macros: given the destination word d, produce a version with the OTHER half filled.
// The "other half" for dst=left is the right half; for dst=right it is the left half.
//
// fillr_zero(d)    -- zero the right half of d
// fillr_ones(d)    -- set the right half of d to all ones
// fillr_ext(d,bit) -- sign-extend into the right half: replicate bit into all 18 positions
// filll_zero(d)    -- zero the left half of d
// filll_ones(d)    -- set the left half of d to all ones
// filll_ext(d,bit) -- sign-extend into the left half: replicate bit into all 18 positions
macro fillr_zero ( d )      { result = d & ( HW_MASK << HW_LSHFT ); }
macro fillr_ones ( d )      { result = ( d & ( HW_MASK << HW_LSHFT ) ) | HW_ONES; }
macro fillr_ext  ( d, bit ) { result = ( d & ( HW_MASK << HW_LSHFT ) ) | ( ( 0 - bit ) & HW_MASK ); }
macro filll_zero ( d )      { result = d & HW_MASK; }
macro filll_ones ( d )      { result = ( d & HW_MASK ) | ( HW_ONES << HW_LSHFT ); }
macro filll_ext  ( d, bit ) { result = ( d & HW_MASK ) | ( ( ( 0 - bit ) & HW_MASK ) << HW_LSHFT ); }

// ---------------------------------------------------------------------------
// HLL / HLLI / HLLM / HLLS -- left half of src -> left half of dst; right half unchanged.
// src=left(E), dst=left(AC).  The four modes follow the MOVE template exactly.
insn hll  : encode #i36 ( op:9 = OP_HLL,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hll",  operands : acn, i, x, y )
    { #i36 s = %M[ @ea ( i, x, y ) ]; ac[ acn ] = @setleft ( ac[ acn ], @left ( s ) ); }
insn hlli : encode #i36 ( op:9 = OP_HLLI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlli", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); ac[ acn ] = @setleft ( ac[ acn ], 0 ); }   // 0,,E: left half of 0,,E = 0
insn hllm : encode #i36 ( op:9 = OP_HLLM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hllm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = @setleft ( %M[ e ], @left ( ac[ acn ] ) ); }
insn hlls : encode #i36 ( op:9 = OP_HLLS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlls", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 v = @setleft ( %M[ e ], @left ( %M[ e ] ) ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HRL / HRLI / HRLM / HRLS -- right half of src -> left half of dst; right half unchanged.
insn hrl  : encode #i36 ( op:9 = OP_HRL,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrl",  operands : acn, i, x, y )
    { #i36 s = %M[ @ea ( i, x, y ) ]; ac[ acn ] = @setleft ( ac[ acn ], @right ( s ) ); }
insn hrli : encode #i36 ( op:9 = OP_HRLI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrli", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); ac[ acn ] = @setleft ( ac[ acn ], e ); }   // 0,,E: right half of 0,,E = E itself
insn hrlm : encode #i36 ( op:9 = OP_HRLM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrlm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = @setleft ( %M[ e ], @right ( ac[ acn ] ) ); }
insn hrls : encode #i36 ( op:9 = OP_HRLS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrls", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 v = @setleft ( %M[ e ], @right ( %M[ e ] ) ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HLLZ / HLLZI / HLLZM / HLLZS -- left half of src -> left half of dst; right half := 0.
insn hllz  : encode #i36 ( op:9 = OP_HLLZ,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hllz",  operands : acn, i, x, y )
    => ac[ acn ] = @setleft ( 0, @left ( %M[ @ea ( i, x, y ) ] ) );
insn hllzi : encode #i36 ( op:9 = OP_HLLZI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hllzi", operands : acn, i, x, y )
    => ac[ acn ] = 0;   // 0,,E: left half = 0; right half = 0 (zero fill)
insn hllzm : encode #i36 ( op:9 = OP_HLLZM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hllzm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = @setleft ( 0, @left ( ac[ acn ] ) ); }
insn hllzs : encode #i36 ( op:9 = OP_HLLZS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hllzs", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 v = @setleft ( 0, @left ( %M[ e ] ) ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HRLZ / HRLZI / HRLZM / HRLZS -- right half of src -> left half of dst; right half := 0.
insn hrlz  : encode #i36 ( op:9 = OP_HRLZ,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrlz",  operands : acn, i, x, y )
    => ac[ acn ] = ( @right ( %M[ @ea ( i, x, y ) ] ) ) << HW_LSHFT;
insn hrlzi : encode #i36 ( op:9 = OP_HRLZI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrlzi", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); ac[ acn ] = ( e & HW_MASK ) << HW_LSHFT; }
insn hrlzm : encode #i36 ( op:9 = OP_HRLZM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrlzm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = ( @right ( ac[ acn ] ) ) << HW_LSHFT; }
insn hrlzs : encode #i36 ( op:9 = OP_HRLZS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrlzs", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 v = ( @right ( %M[ e ] ) ) << HW_LSHFT; %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HLLO / HLLOI / HLLOM / HLLOS -- left half of src -> left half of dst; right half := all-ones.
insn hllo  : encode #i36 ( op:9 = OP_HLLO,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hllo",  operands : acn, i, x, y )
    => ac[ acn ] = @fillr_ones ( @setleft ( 0, @left ( %M[ @ea ( i, x, y ) ] ) ) );
insn hlloi : encode #i36 ( op:9 = OP_HLLOI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlloi", operands : acn, i, x, y )
    => ac[ acn ] = HW_ONES;   // 0,,E: left half = 0; right half = all-ones
insn hllom : encode #i36 ( op:9 = OP_HLLOM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hllom", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = @fillr_ones ( @setleft ( 0, @left ( ac[ acn ] ) ) ); }
insn hllos : encode #i36 ( op:9 = OP_HLLOS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hllos", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 v = @fillr_ones ( @setleft ( 0, @left ( %M[ e ] ) ) ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HRLO / HRLOI / HRLOM / HRLOS -- right half of src -> left half of dst; right half := all-ones.
insn hrlo  : encode #i36 ( op:9 = OP_HRLO,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrlo",  operands : acn, i, x, y )
    => ac[ acn ] = @fillr_ones ( ( @right ( %M[ @ea ( i, x, y ) ] ) ) << HW_LSHFT );
insn hrloi : encode #i36 ( op:9 = OP_HRLOI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrloi", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); ac[ acn ] = ( ( e & HW_MASK ) << HW_LSHFT ) | HW_ONES; }
insn hrlom : encode #i36 ( op:9 = OP_HRLOM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrlom", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = @fillr_ones ( ( @right ( ac[ acn ] ) ) << HW_LSHFT ); }
insn hrlos : encode #i36 ( op:9 = OP_HRLOS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrlos", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 v = @fillr_ones ( ( @right ( %M[ e ] ) ) << HW_LSHFT ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HLLE / HLLEI / HLLEM / HLLES -- left half of src -> left half of dst; sign-extend into right half.
// The sign bit of the left half is PDP-10 bit 0 = our bit 35 = (v >> 35) & 1.
insn hlle  : encode #i36 ( op:9 = OP_HLLE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlle",  operands : acn, i, x, y )
    { #i36 s = %M[ @ea ( i, x, y ) ]; #i18 h = @left ( s ); ac[ acn ] = @fillr_ext ( h << HW_LSHFT, ( h >> 17 ) & 1 ); }
insn hllei : encode #i36 ( op:9 = OP_HLLEI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hllei", operands : acn, i, x, y )
    => ac[ acn ] = 0;   // 0,,E: left half = 0; sign bit = 0; right half = 0 (extend of 0)
insn hllem : encode #i36 ( op:9 = OP_HLLEM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hllem", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i18 h = @left ( ac[ acn ] ); %M[ e ] = @fillr_ext ( h << HW_LSHFT, ( h >> 17 ) & 1 ); }
insn hlles : encode #i36 ( op:9 = OP_HLLES, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlles", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i18 h = @left ( %M[ e ] ); #i36 v = @fillr_ext ( h << HW_LSHFT, ( h >> 17 ) & 1 ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HRLE / HRLEI / HRLEM / HRLES -- right half of src -> left half of dst; sign-extend into right half.
// The sign bit of the right half is PDP-10 bit 18 = our bit 17 = (v >> 17) & 1.
insn hrle  : encode #i36 ( op:9 = OP_HRLE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrle",  operands : acn, i, x, y )
    { #i36 s = %M[ @ea ( i, x, y ) ]; #i18 h = @right ( s ); ac[ acn ] = @fillr_ext ( h << HW_LSHFT, ( h >> 17 ) & 1 ); }
insn hrlei : encode #i36 ( op:9 = OP_HRLEI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrlei", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); ac[ acn ] = @fillr_ext ( ( e & HW_MASK ) << HW_LSHFT, ( e >> 17 ) & 1 ); }
insn hrlem : encode #i36 ( op:9 = OP_HRLEM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrlem", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i18 h = @right ( ac[ acn ] ); %M[ e ] = @fillr_ext ( h << HW_LSHFT, ( h >> 17 ) & 1 ); }
insn hrles : encode #i36 ( op:9 = OP_HRLES, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrles", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i18 h = @right ( %M[ e ] ); #i36 v = @fillr_ext ( h << HW_LSHFT, ( h >> 17 ) & 1 ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HRR / HRRI / HRRM / HRRS -- right half of src -> right half of dst; left half unchanged.
insn hrr  : encode #i36 ( op:9 = OP_HRR,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrr",  operands : acn, i, x, y )
    => ac[ acn ] = @setright ( ac[ acn ], @right ( %M[ @ea ( i, x, y ) ] ) );
insn hrri : encode #i36 ( op:9 = OP_HRRI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrri", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); ac[ acn ] = @setright ( ac[ acn ], e ); }   // right half of 0,,E = E
insn hrrm : encode #i36 ( op:9 = OP_HRRM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrrm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = @setright ( %M[ e ], @right ( ac[ acn ] ) ); }
insn hrrs : encode #i36 ( op:9 = OP_HRRS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrrs", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 v = @setright ( %M[ e ], @right ( %M[ e ] ) ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HLR / HLRI / HLRM / HLRS -- left half of src -> right half of dst; left half unchanged.
insn hlr  : encode #i36 ( op:9 = OP_HLR,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlr",  operands : acn, i, x, y )
    => ac[ acn ] = @setright ( ac[ acn ], @left ( %M[ @ea ( i, x, y ) ] ) );
insn hlri : encode #i36 ( op:9 = OP_HLRI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlri", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); ac[ acn ] = @setright ( ac[ acn ], 0 ); }   // 0,,E: left half of 0,,E = 0
insn hlrm : encode #i36 ( op:9 = OP_HLRM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlrm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = @setright ( %M[ e ], @left ( ac[ acn ] ) ); }
insn hlrs : encode #i36 ( op:9 = OP_HLRS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlrs", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 v = @setright ( %M[ e ], @left ( %M[ e ] ) ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HRRZ / HRRZI / HRRZM / HRRZS -- right half of src -> right half of dst; left half := 0.
insn hrrz  : encode #i36 ( op:9 = OP_HRRZ,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrrz",  operands : acn, i, x, y )
    => ac[ acn ] = @right ( %M[ @ea ( i, x, y ) ] );
insn hrrzi : encode #i36 ( op:9 = OP_HRRZI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrrzi", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); ac[ acn ] = e & HW_MASK; }   // 0,,E with left=0
insn hrrzm : encode #i36 ( op:9 = OP_HRRZM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrrzm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = @right ( ac[ acn ] ); }
insn hrrzs : encode #i36 ( op:9 = OP_HRRZS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrrzs", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 v = @right ( %M[ e ] ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HLRZ / HLRZI / HLRZM / HLRZS -- left half of src -> right half of dst; left half := 0.
insn hlrz  : encode #i36 ( op:9 = OP_HLRZ,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlrz",  operands : acn, i, x, y )
    => ac[ acn ] = @left ( %M[ @ea ( i, x, y ) ] );
insn hlrzi : encode #i36 ( op:9 = OP_HLRZI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlrzi", operands : acn, i, x, y )
    => ac[ acn ] = 0;   // 0,,E: left half of 0,,E = 0
insn hlrzm : encode #i36 ( op:9 = OP_HLRZM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlrzm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = @left ( ac[ acn ] ); }
insn hlrzs : encode #i36 ( op:9 = OP_HLRZS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlrzs", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 v = @left ( %M[ e ] ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HRRO / HRROI / HRROM / HRROS -- right half of src -> right half of dst; left half := all-ones.
insn hrro  : encode #i36 ( op:9 = OP_HRRO,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrro",  operands : acn, i, x, y )
    => ac[ acn ] = @filll_ones ( @right ( %M[ @ea ( i, x, y ) ] ) );
insn hrroi : encode #i36 ( op:9 = OP_HRROI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrroi", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); ac[ acn ] = ( HW_ONES << HW_LSHFT ) | ( e & HW_MASK ); }
insn hrrom : encode #i36 ( op:9 = OP_HRROM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrrom", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = @filll_ones ( @right ( ac[ acn ] ) ); }
insn hrros : encode #i36 ( op:9 = OP_HRROS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrros", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 v = @filll_ones ( @right ( %M[ e ] ) ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HLRO / HLROI / HLROM / HLROS -- left half of src -> right half of dst; left half := all-ones.
insn hlro  : encode #i36 ( op:9 = OP_HLRO,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlro",  operands : acn, i, x, y )
    => ac[ acn ] = @filll_ones ( @left ( %M[ @ea ( i, x, y ) ] ) );
insn hlroi : encode #i36 ( op:9 = OP_HLROI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlroi", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); ac[ acn ] = HW_ONES << HW_LSHFT; }   // 0,,E: left half = 0 -> right = 0
insn hlrom : encode #i36 ( op:9 = OP_HLROM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlrom", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = @filll_ones ( @left ( ac[ acn ] ) ); }
insn hlros : encode #i36 ( op:9 = OP_HLROS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlros", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 v = @filll_ones ( @left ( %M[ e ] ) ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HRRE / HRREI / HRREM / HRRES -- right half of src -> right half of dst; sign-extend into left half.
// The sign bit of the right half is PDP-10 bit 18 = our bit 17 = (v >> 17) & 1.
insn hrre  : encode #i36 ( op:9 = OP_HRRE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrre",  operands : acn, i, x, y )
    { #i36 s = %M[ @ea ( i, x, y ) ]; #i18 h = @right ( s ); ac[ acn ] = @filll_ext ( h, ( h >> 17 ) & 1 ); }
insn hrrei : encode #i36 ( op:9 = OP_HRREI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrrei", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); ac[ acn ] = @filll_ext ( e & HW_MASK, ( e >> 17 ) & 1 ); }
insn hrrem : encode #i36 ( op:9 = OP_HRREM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrrem", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i18 h = @right ( ac[ acn ] ); %M[ e ] = @filll_ext ( h, ( h >> 17 ) & 1 ); }
insn hrres : encode #i36 ( op:9 = OP_HRRES, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hrres", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i18 h = @right ( %M[ e ] ); #i36 v = @filll_ext ( h, ( h >> 17 ) & 1 ); %M[ e ] = v; ac[ acn ] = v; }

// ---------------------------------------------------------------------------
// HLRE / HLREI / HLREM / HLRES -- left half of src -> right half of dst; sign-extend into left half.
// The sign bit of the left half is PDP-10 bit 0 = our bit 35 = (v >> 35) & 1.
// In practice the left half occupies bits 35..18, so its sign bit = (h >> 17) & 1 where h = left(v).
insn hlre  : encode #i36 ( op:9 = OP_HLRE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlre",  operands : acn, i, x, y )
    { #i36 s = %M[ @ea ( i, x, y ) ]; #i18 h = @left ( s ); ac[ acn ] = @filll_ext ( h, ( h >> 17 ) & 1 ); }
insn hlrei : encode #i36 ( op:9 = OP_HLREI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlrei", operands : acn, i, x, y )
    => ac[ acn ] = 0;   // 0,,E: left half = 0; sign bit = 0; left fill = 0
insn hlrem : encode #i36 ( op:9 = OP_HLREM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlrem", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i18 h = @left ( ac[ acn ] ); %M[ e ] = @filll_ext ( h, ( h >> 17 ) & 1 ); }
insn hlres : encode #i36 ( op:9 = OP_HLRES, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "hlres", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i18 h = @left ( %M[ e ] ); #i36 v = @filll_ext ( h, ( h >> 17 ) & 1 ); %M[ e ] = v; ac[ acn ] = v; }

// ===========================================================================
// BOOLEAN INSTRUCTIONS (DEC PDP-10 Hardware Reference Manual, "Boolean"; opcodes verified
// against SIMH pdp10_sys.c).  These 16 functions × 4 operand modes (64 instructions, opcodes
// 0o400–0o477) compute every Boolean combination of AC and M (the memory operand), masked to
// 36 bits (W36_MASK).  They follow the SAME operand-mode template as the MOVE and halfword
// families (+0/+1/+2/+3 on each group base = basic/I/M/S).
//
// TRUTH TABLE (each function f(AC, M), result masked to W36_MASK):
//   SETZ  = 0                  SETO  = W36_MASK (all ones)
//   SETA  = AC                 SETCA = ~AC
//   SETM  = M                  SETCM = ~M
//   AND   = AC &  M            ANDCA = ~AC &  M
//   ANDCM = AC & ~M            ANDCB = ~AC & ~M
//   IOR   = AC |  M            ORCA  = ~AC |  M
//   ORCM  = AC | ~M            ORCB  = ~AC | ~M
//   XOR   = AC ^  M            EQV   = ~(AC ^ M)
//
// OPERAND MODES (same as MOVE/halfword template):
//   basic (+0)  AC <- f(AC, M[E])             -- E is the effective address; M = memory word at E
//   I     (+1)  AC <- f(AC, 0,,E)             -- E itself (0 in left half) is the operand; no memory read
//   M     (+2)  M[E] <- f(AC, M[E])           -- result stored to memory; AC unchanged
//   S     (+3)  M[E] <- f(AC, M[E]); AC <- same result (AC write gated on AC field != 0, deferred to execution)
// NOTE: SETZ/SETO/SETA/SETCA ignore M entirely; SETM/SETCM ignore AC entirely. The I form for
// SETA/SETCA still sets AC <- f(0,,E) (same as basic but M=0,,E), and SETM/SETCMI use M=0,,E.
//
// GROUP BASES (0o4xx block; all verified against SIMH pdp10_sys.c opcodes array):
const OP_SETZ  = 0o400;         // SETZ  family: result = 0
const OP_AND   = 0o404;         // AND   family: result = AC & M
const OP_ANDCA = 0o410;         // ANDCA family: result = ~AC & M
const OP_SETM  = 0o414;         // SETM  family: result = M
const OP_ANDCM = 0o420;         // ANDCM family: result = AC & ~M
const OP_SETA  = 0o424;         // SETA  family: result = AC
const OP_XOR   = 0o430;         // XOR   family: result = AC ^ M
const OP_IOR   = 0o434;         // IOR   family: result = AC | M
const OP_ANDCB = 0o440;         // ANDCB family: result = ~AC & ~M
const OP_EQV   = 0o444;         // EQV   family: result = ~(AC ^ M)
const OP_SETCA = 0o450;         // SETCA family: result = ~AC
const OP_ORCA  = 0o454;         // ORCA  family: result = ~AC | M
const OP_SETCM = 0o460;         // SETCM family: result = ~M
const OP_ORCM  = 0o464;         // ORCM  family: result = AC | ~M
const OP_ORCB  = 0o470;         // ORCB  family: result = ~AC | ~M
const OP_SETO  = 0o474;         // SETO  family: result = all-ones (W36_MASK)

// Per-mnemonic opcodes = group base + mode bits.
const OP_SETZI  = OP_SETZ  + MODE_I;
const OP_SETZM  = OP_SETZ  + MODE_M;
const OP_SETZS  = OP_SETZ  + MODE_S;
const OP_ANDI   = OP_AND   + MODE_I;
const OP_ANDM   = OP_AND   + MODE_M;
const OP_ANDS   = OP_AND   + MODE_S;
const OP_ANDCAI = OP_ANDCA + MODE_I;
const OP_ANDCAM = OP_ANDCA + MODE_M;
const OP_ANDCAS = OP_ANDCA + MODE_S;
const OP_SETMI  = OP_SETM  + MODE_I;
const OP_SETMM  = OP_SETM  + MODE_M;
const OP_SETMS  = OP_SETM  + MODE_S;
const OP_ANDCMI = OP_ANDCM + MODE_I;
const OP_ANDCMM = OP_ANDCM + MODE_M;
const OP_ANDCMS = OP_ANDCM + MODE_S;
const OP_SETAI  = OP_SETA  + MODE_I;
const OP_SETAM  = OP_SETA  + MODE_M;
const OP_SETAS  = OP_SETA  + MODE_S;
const OP_XORI   = OP_XOR   + MODE_I;
const OP_XORM   = OP_XOR   + MODE_M;
const OP_XORS   = OP_XOR   + MODE_S;
const OP_IORI   = OP_IOR   + MODE_I;
const OP_IORM   = OP_IOR   + MODE_M;
const OP_IORS   = OP_IOR   + MODE_S;
const OP_ANDCBI = OP_ANDCB + MODE_I;
const OP_ANDCBM = OP_ANDCB + MODE_M;
const OP_ANDCBS = OP_ANDCB + MODE_S;
const OP_EQVI   = OP_EQV   + MODE_I;
const OP_EQVM   = OP_EQV   + MODE_M;
const OP_EQVS   = OP_EQV   + MODE_S;
const OP_SETCAI = OP_SETCA + MODE_I;
const OP_SETCAM = OP_SETCA + MODE_M;
const OP_SETCAS = OP_SETCA + MODE_S;
const OP_ORCAI  = OP_ORCA  + MODE_I;
const OP_ORCAM  = OP_ORCA  + MODE_M;
const OP_ORCAS  = OP_ORCA  + MODE_S;
const OP_SETCMI = OP_SETCM + MODE_I;
const OP_SETCMM = OP_SETCM + MODE_M;
const OP_SETCMS = OP_SETCM + MODE_S;
const OP_ORCMI  = OP_ORCM  + MODE_I;
const OP_ORCMM  = OP_ORCM  + MODE_M;
const OP_ORCMS  = OP_ORCM  + MODE_S;
const OP_ORCBI  = OP_ORCB  + MODE_I;
const OP_ORCBM  = OP_ORCB  + MODE_M;
const OP_ORCBS  = OP_ORCB  + MODE_S;
const OP_SETOI  = OP_SETO  + MODE_I;
const OP_SETOM  = OP_SETO  + MODE_M;
const OP_SETOS  = OP_SETO  + MODE_S;

// ---------------------------------------------------------------------------
// SETZ / SETZI / SETZM / SETZS -- result = 0.  Memory operand is not referenced.
insn setz  : encode #i36 ( op:9 = OP_SETZ,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setz",  operands : acn, i, x, y )  => ac[ acn ] = 0;
insn setzi : encode #i36 ( op:9 = OP_SETZI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setzi", operands : acn, i, x, y )  => ac[ acn ] = 0;
insn setzm : encode #i36 ( op:9 = OP_SETZM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setzm", operands : acn, i, x, y )  => %M[ @ea ( i, x, y ) ] = 0;
insn setzs : encode #i36 ( op:9 = OP_SETZS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setzs", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = 0; ac[ acn ] = 0; }

// ---------------------------------------------------------------------------
// AND / ANDI / ANDM / ANDS -- result = AC & M.
insn and  : encode #i36 ( op:9 = OP_AND,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "and",  operands : acn, i, x, y )
    => ac[ acn ] = ( ac[ acn ] & %M[ @ea ( i, x, y ) ] ) & W36_MASK;
insn andi : encode #i36 ( op:9 = OP_ANDI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andi", operands : acn, i, x, y )
    => ac[ acn ] = ( ac[ acn ] & @ea ( i, x, y ) ) & W36_MASK;          // M = 0,,E
insn andm : encode #i36 ( op:9 = OP_ANDM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = ( ac[ acn ] & %M[ e ] ) & W36_MASK; }
insn ands : encode #i36 ( op:9 = OP_ANDS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "ands", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( ac[ acn ] & %M[ e ] ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// ANDCA / ANDCAI / ANDCAM / ANDCAS -- result = ~AC & M.
insn andca  : encode #i36 ( op:9 = OP_ANDCA,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andca",  operands : acn, i, x, y )
    => ac[ acn ] = ( ( ~ac[ acn ] ) & %M[ @ea ( i, x, y ) ] ) & W36_MASK;
insn andcai : encode #i36 ( op:9 = OP_ANDCAI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andcai", operands : acn, i, x, y )
    => ac[ acn ] = ( ( ~ac[ acn ] ) & @ea ( i, x, y ) ) & W36_MASK;     // M = 0,,E
insn andcam : encode #i36 ( op:9 = OP_ANDCAM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andcam", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = ( ( ~ac[ acn ] ) & %M[ e ] ) & W36_MASK; }
insn andcas : encode #i36 ( op:9 = OP_ANDCAS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andcas", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( ( ~ac[ acn ] ) & %M[ e ] ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// SETM / SETMI / SETMM / SETMS -- result = M.  AC operand is not referenced.
insn setm  : encode #i36 ( op:9 = OP_SETM,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setm",  operands : acn, i, x, y )
    => ac[ acn ] = %M[ @ea ( i, x, y ) ] & W36_MASK;
insn setmi : encode #i36 ( op:9 = OP_SETMI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setmi", operands : acn, i, x, y )
    => ac[ acn ] = @ea ( i, x, y ) & W36_MASK;                          // M = 0,,E
insn setmm : encode #i36 ( op:9 = OP_SETMM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setmm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = %M[ e ] & W36_MASK; }
insn setms : encode #i36 ( op:9 = OP_SETMS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setms", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = %M[ e ] & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// ANDCM / ANDCMI / ANDCMM / ANDCMS -- result = AC & ~M.
insn andcm  : encode #i36 ( op:9 = OP_ANDCM,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andcm",  operands : acn, i, x, y )
    => ac[ acn ] = ( ac[ acn ] & ( ~%M[ @ea ( i, x, y ) ] ) ) & W36_MASK;
insn andcmi : encode #i36 ( op:9 = OP_ANDCMI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andcmi", operands : acn, i, x, y )
    => ac[ acn ] = ( ac[ acn ] & ( ~@ea ( i, x, y ) ) ) & W36_MASK;    // M = 0,,E
insn andcmm : encode #i36 ( op:9 = OP_ANDCMM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andcmm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = ( ac[ acn ] & ( ~%M[ e ] ) ) & W36_MASK; }
insn andcms : encode #i36 ( op:9 = OP_ANDCMS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andcms", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( ac[ acn ] & ( ~%M[ e ] ) ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// SETA / SETAI / SETAM / SETAS -- result = AC.  Memory operand is not referenced.
insn seta  : encode #i36 ( op:9 = OP_SETA,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "seta",  operands : acn, i, x, y )  => ac[ acn ] = ac[ acn ] & W36_MASK;
insn setai : encode #i36 ( op:9 = OP_SETAI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setai", operands : acn, i, x, y )  => ac[ acn ] = ac[ acn ] & W36_MASK;
insn setam : encode #i36 ( op:9 = OP_SETAM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setam", operands : acn, i, x, y )
    => %M[ @ea ( i, x, y ) ] = ac[ acn ] & W36_MASK;
insn setas : encode #i36 ( op:9 = OP_SETAS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setas", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ac[ acn ] & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// XOR / XORI / XORM / XORS -- result = AC ^ M.
insn xor  : encode #i36 ( op:9 = OP_XOR,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "xor",  operands : acn, i, x, y )
    => ac[ acn ] = ( ac[ acn ] ^ %M[ @ea ( i, x, y ) ] ) & W36_MASK;
insn xori : encode #i36 ( op:9 = OP_XORI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "xori", operands : acn, i, x, y )
    => ac[ acn ] = ( ac[ acn ] ^ @ea ( i, x, y ) ) & W36_MASK;         // M = 0,,E
insn xorm : encode #i36 ( op:9 = OP_XORM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "xorm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = ( ac[ acn ] ^ %M[ e ] ) & W36_MASK; }
insn xors : encode #i36 ( op:9 = OP_XORS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "xors", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( ac[ acn ] ^ %M[ e ] ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// IOR / IORI / IORM / IORS -- result = AC | M.
insn ior  : encode #i36 ( op:9 = OP_IOR,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "ior",  operands : acn, i, x, y )
    => ac[ acn ] = ( ac[ acn ] | %M[ @ea ( i, x, y ) ] ) & W36_MASK;
insn iori : encode #i36 ( op:9 = OP_IORI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "iori", operands : acn, i, x, y )
    => ac[ acn ] = ( ac[ acn ] | @ea ( i, x, y ) ) & W36_MASK;         // M = 0,,E
insn iorm : encode #i36 ( op:9 = OP_IORM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "iorm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = ( ac[ acn ] | %M[ e ] ) & W36_MASK; }
insn iors : encode #i36 ( op:9 = OP_IORS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "iors", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( ac[ acn ] | %M[ e ] ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// ANDCB / ANDCBI / ANDCBM / ANDCBS -- result = ~AC & ~M.
insn andcb  : encode #i36 ( op:9 = OP_ANDCB,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andcb",  operands : acn, i, x, y )
    => ac[ acn ] = ( ( ~ac[ acn ] ) & ( ~%M[ @ea ( i, x, y ) ] ) ) & W36_MASK;
insn andcbi : encode #i36 ( op:9 = OP_ANDCBI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andcbi", operands : acn, i, x, y )
    => ac[ acn ] = ( ( ~ac[ acn ] ) & ( ~@ea ( i, x, y ) ) ) & W36_MASK;   // M = 0,,E
insn andcbm : encode #i36 ( op:9 = OP_ANDCBM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andcbm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = ( ( ~ac[ acn ] ) & ( ~%M[ e ] ) ) & W36_MASK; }
insn andcbs : encode #i36 ( op:9 = OP_ANDCBS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "andcbs", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( ( ~ac[ acn ] ) & ( ~%M[ e ] ) ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// EQV / EQVI / EQVM / EQVS -- result = ~(AC ^ M)  (equivalence / XNOR).
insn eqv  : encode #i36 ( op:9 = OP_EQV,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "eqv",  operands : acn, i, x, y )
    => ac[ acn ] = ( ~( ac[ acn ] ^ %M[ @ea ( i, x, y ) ] ) ) & W36_MASK;
insn eqvi : encode #i36 ( op:9 = OP_EQVI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "eqvi", operands : acn, i, x, y )
    => ac[ acn ] = ( ~( ac[ acn ] ^ @ea ( i, x, y ) ) ) & W36_MASK;    // M = 0,,E
insn eqvm : encode #i36 ( op:9 = OP_EQVM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "eqvm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = ( ~( ac[ acn ] ^ %M[ e ] ) ) & W36_MASK; }
insn eqvs : encode #i36 ( op:9 = OP_EQVS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "eqvs", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( ~( ac[ acn ] ^ %M[ e ] ) ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// SETCA / SETCAI / SETCAM / SETCAS -- result = ~AC.  Memory operand is not referenced.
insn setca  : encode #i36 ( op:9 = OP_SETCA,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setca",  operands : acn, i, x, y )  => ac[ acn ] = ( ~ac[ acn ] ) & W36_MASK;
insn setcai : encode #i36 ( op:9 = OP_SETCAI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setcai", operands : acn, i, x, y )  => ac[ acn ] = ( ~ac[ acn ] ) & W36_MASK;
insn setcam : encode #i36 ( op:9 = OP_SETCAM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setcam", operands : acn, i, x, y )
    => %M[ @ea ( i, x, y ) ] = ( ~ac[ acn ] ) & W36_MASK;
insn setcas : encode #i36 ( op:9 = OP_SETCAS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setcas", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( ~ac[ acn ] ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// ORCA / ORCAI / ORCAM / ORCAS -- result = ~AC | M.
insn orca  : encode #i36 ( op:9 = OP_ORCA,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "orca",  operands : acn, i, x, y )
    => ac[ acn ] = ( ( ~ac[ acn ] ) | %M[ @ea ( i, x, y ) ] ) & W36_MASK;
insn orcai : encode #i36 ( op:9 = OP_ORCAI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "orcai", operands : acn, i, x, y )
    => ac[ acn ] = ( ( ~ac[ acn ] ) | @ea ( i, x, y ) ) & W36_MASK;    // M = 0,,E
insn orcam : encode #i36 ( op:9 = OP_ORCAM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "orcam", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = ( ( ~ac[ acn ] ) | %M[ e ] ) & W36_MASK; }
insn orcas : encode #i36 ( op:9 = OP_ORCAS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "orcas", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( ( ~ac[ acn ] ) | %M[ e ] ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// SETCM / SETCMI / SETCMM / SETCMS -- result = ~M.  AC operand is not referenced.
insn setcm  : encode #i36 ( op:9 = OP_SETCM,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setcm",  operands : acn, i, x, y )
    => ac[ acn ] = ( ~%M[ @ea ( i, x, y ) ] ) & W36_MASK;
insn setcmi : encode #i36 ( op:9 = OP_SETCMI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setcmi", operands : acn, i, x, y )
    => ac[ acn ] = ( ~@ea ( i, x, y ) ) & W36_MASK;                    // M = 0,,E
insn setcmm : encode #i36 ( op:9 = OP_SETCMM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setcmm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = ( ~%M[ e ] ) & W36_MASK; }
insn setcms : encode #i36 ( op:9 = OP_SETCMS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setcms", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 m = %M[ e ]; #i36 r = ( ~m ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// ORCM / ORCMI / ORCMM / ORCMS -- result = AC | ~M.
insn orcm  : encode #i36 ( op:9 = OP_ORCM,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "orcm",  operands : acn, i, x, y )
    => ac[ acn ] = ( ac[ acn ] | ( ~%M[ @ea ( i, x, y ) ] ) ) & W36_MASK;
insn orcmi : encode #i36 ( op:9 = OP_ORCMI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "orcmi", operands : acn, i, x, y )
    => ac[ acn ] = ( ac[ acn ] | ( ~@ea ( i, x, y ) ) ) & W36_MASK;    // M = 0,,E
insn orcmm : encode #i36 ( op:9 = OP_ORCMM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "orcmm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = ( ac[ acn ] | ( ~%M[ e ] ) ) & W36_MASK; }
insn orcms : encode #i36 ( op:9 = OP_ORCMS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "orcms", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( ac[ acn ] | ( ~%M[ e ] ) ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// ORCB / ORCBI / ORCBM / ORCBS -- result = ~AC | ~M  (NOR complement of ANDCB).
insn orcb  : encode #i36 ( op:9 = OP_ORCB,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "orcb",  operands : acn, i, x, y )
    => ac[ acn ] = ( ( ~ac[ acn ] ) | ( ~%M[ @ea ( i, x, y ) ] ) ) & W36_MASK;
insn orcbi : encode #i36 ( op:9 = OP_ORCBI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "orcbi", operands : acn, i, x, y )
    => ac[ acn ] = ( ( ~ac[ acn ] ) | ( ~@ea ( i, x, y ) ) ) & W36_MASK;   // M = 0,,E
insn orcbm : encode #i36 ( op:9 = OP_ORCBM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "orcbm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = ( ( ~ac[ acn ] ) | ( ~%M[ e ] ) ) & W36_MASK; }
insn orcbs : encode #i36 ( op:9 = OP_ORCBS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "orcbs", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( ( ~ac[ acn ] ) | ( ~%M[ e ] ) ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// SETO / SETOI / SETOM / SETOS -- result = W36_MASK (all 36 bits set).  No operands referenced.
insn seto  : encode #i36 ( op:9 = OP_SETO,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "seto",  operands : acn, i, x, y )  => ac[ acn ] = W36_MASK;
insn setoi : encode #i36 ( op:9 = OP_SETOI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setoi", operands : acn, i, x, y )  => ac[ acn ] = W36_MASK;
insn setom : encode #i36 ( op:9 = OP_SETOM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setom", operands : acn, i, x, y )  => %M[ @ea ( i, x, y ) ] = W36_MASK;
insn setos : encode #i36 ( op:9 = OP_SETOS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "setos", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); %M[ e ] = W36_MASK; ac[ acn ] = W36_MASK; }

// ===========================================================================
// FIXED-POINT ARITHMETIC (DEC PDP-10 Hardware Reference Manual, "Fixed-Point Arithmetic";
// opcodes verified against SIMH pdp10_sys.c).  The four operand-mode template applies:
//   basic (+0)  AC <- f(AC, M[E])          e.g. ADD: AC <- AC + M[E]
//   I     (+1)  AC <- f(AC, 0,,E)          operand IS E (zero in left half)
//   M     (+2)  M[E] <- f(AC, M[E])        result to memory; AC unchanged
//   S     (+3)  M[E] <- f(AC, M[E]); AC <- same result (AC write gated on AC != 0)
//
// FLAG RULES (per SIMH pdp10_cpu.c and DEC HRM ch.2):
//
// ADD/SUB: the carry/overflow test in SIMH is:
//   The 37th and 38th bits of the 37-bit sum detect CRY1 and CRY0.
//   SIMH computes: r = AC + M (in 37-bit unsigned), then
//     CRY1 = (r >> 36) & 1       -- carry out of bit 1 (bit 35 pair)
//     CRY0 = (r >> 35) & 1 XOR CRY1  -- carry out of bit 0 (sign position)
//     AROV = CRY0 XOR CRY1
//   For ADD: extend both operands to 37 bits (signed) and add.
//   For SUB: AC - M = AC + (~M + 1); carry logic is symmetric per SIMH adsubx.
//   The macro add_flags(a,b) takes the two 36-bit operands and computes the flags.
//
// IMUL: 36-bit x 36-bit signed -> 72-bit product; store low 36 bits in AC; AROV if the
//   product does not fit in 36 signed bits (i.e. bits 71..36 != sign extension of bit 35).
//
// MUL: same product, but BOTH halves stored in AC (high 36 bits) and AC+1 (low 36 bits).
//   The low word's sign bit (bit 35) is cleared in the canonical 72-bit representation
//   per SIMH (MUL result in the pair: high word signed, low word magnitude).
//   AROV is set on -2^35 * -2^35 (only overflow case for MUL).
//
// IDIV: 36-bit signed divide: AC / M[E] -> quotient in AC, remainder in AC+1.
//   AROV (No Divide) if divisor = 0 or if dividend = -2^35 and divisor = -1.
//
// DIV: 72-bit divide: (AC,,AC+1) / M[E] -> quotient in AC, remainder in AC+1.
//   AROV if divisor = 0 or quotient overflows 36 bits.
//
// Opcode group bases (per SIMH pdp10_sys.c, all verified):
//   IMUL=0o220  MUL=0o224  IDIV=0o230  DIV=0o234  ADD=0o270  SUB=0o274
const OP_IMUL = 0o220;          // IMUL family: 36x36 -> 36, AROV on overflow
const OP_MUL  = 0o224;          // MUL  family: 36x36 -> 72, result in AC pair
const OP_IDIV = 0o230;          // IDIV family: 36/36 -> quotient AC, remainder AC+1
const OP_DIV  = 0o234;          // DIV  family: 72/36 -> quotient AC, remainder AC+1
const OP_ADD  = 0o270;          // ADD  family: AC + M with CRY0/CRY1/AROV
const OP_SUB  = 0o274;          // SUB  family: AC - M with CRY0/CRY1/AROV

// Per-mnemonic opcodes = group base + mode bits.
const OP_IMULI = OP_IMUL + MODE_I;
const OP_IMULM = OP_IMUL + MODE_M;
const OP_IMULS = OP_IMUL + MODE_S;
const OP_MULI  = OP_MUL  + MODE_I;
const OP_MULM  = OP_MUL  + MODE_M;
const OP_MULS  = OP_MUL  + MODE_S;
const OP_IDIVI = OP_IDIV + MODE_I;
const OP_IDIVM = OP_IDIV + MODE_M;
const OP_IDIVS = OP_IDIV + MODE_S;
const OP_DIVI  = OP_DIV  + MODE_I;
const OP_DIVM  = OP_DIV  + MODE_M;
const OP_DIVS  = OP_DIV  + MODE_S;
const OP_ADDI  = OP_ADD  + MODE_I;
const OP_ADDM  = OP_ADD  + MODE_M;
const OP_ADDS  = OP_ADD  + MODE_S;
const OP_SUBI  = OP_SUB  + MODE_I;
const OP_SUBM  = OP_SUB  + MODE_M;
const OP_SUBS  = OP_SUB  + MODE_S;

// Double-precision operand opcodes (single basic form only; opcodes 0o114-0o117).
const OP_DADD = 0o114;          // DADD: (AC,,AC+1) + (E,,E+1) -> AC pair, flags
const OP_DSUB = 0o115;          // DSUB: (AC,,AC+1) - (E,,E+1) -> AC pair, flags
const OP_DMUL = 0o116;          // DMUL: (AC,,AC+1) * (E,,E+1) -> AC pair (128->72), flags
const OP_DDIV = 0o117;          // DDIV: (AC,,AC+1) / (E,,E+1) -> quotient AC pair, flags

// ---------------------------------------------------------------------------
// ADD/SUB flag macro.  Per SIMH pdp10_cpu.c `add()`:
//   sum37 = (a & W36_MASK) + (b & W36_MASK)        -- 37-bit unsigned carry chain
//   CRY0  = (sum37 >> 36) & 1                       -- carry OUT of the sign bit (bit 35)
//   CRY1  = ((r >> 35) ^ (a >> 35) ^ (b >> 35)) & 1 -- carry INTO the sign bit
//   AROV  = CRY0 ^ CRY1                             -- overflow = carry bits differ
// where r = sum37 & W36_MASK (the 36-bit result).
//
// Verification (-1 + -1):
//   a = b = W36_MASK (all 36 bits set = unsigned 0xfffffffff).
//   sum37 = 2 * 0xfffffffff = 0x1ffffffffe.
//   r     = 0xffffffffe  (all 36 bits set minus bit 0 -- 0xfffffffff XOR 1 -- wait:
//           0x1ffffffffe & 0xfffffffff = 0xffffffffe).
//   CRY0  = (0x1ffffffffe >> 36) & 1 = 1.
//   CRY1  = ((0xffffffffe >> 35) ^ (W36_MASK >> 35) ^ (W36_MASK >> 35)) & 1
//         = (1 ^ 1 ^ 1) & 1 = 1.
//   AROV  = 1 ^ 1 = 0.  Correct: -1 + -1 = -2, no signed overflow.
//
// For genuine overflow (e.g. MAX_POS + MAX_POS, both 0x7ffffffff):
//   sum37 = 0xffffffffe; r = 0xffffffffe; CRY0 = 0.
//   CRY1  = ((r>>35) ^ (a>>35) ^ (b>>35)) & 1 = (1^0^0) & 1 = 1.  AROV = 0^1 = 1. Correct.
//
// sub_flags(a,b) calls add_flags(a, ~b & W36_MASK); DADD/DSUB inherit the fix automatically.
const SEXT37_ONES = 0x1FFFFFFFFF;                   // 37 ones -- sign-extension of a negative 36-bit value into upper bits
macro add_flags ( a, b ) {
    #i37 sum37 = ( a & W36_MASK ) + ( b & W36_MASK );
    #i36 r     = sum37 & W36_MASK;
    #i1  c0    = ( sum37 >> 36 ) & 1;                                       // carry OUT of sign bit -> CRY0
    #i1  c1    = ( ( r >> 35 ) ^ ( ( a & W36_MASK ) >> 35 ) ^ ( ( b & W36_MASK ) >> 35 ) ) & 1; // carry INTO sign bit -> CRY1
    CRY0 = c0;
    CRY1 = c1;
    AROV = c0 ^ c1;
}

// ---------------------------------------------------------------------------
// ADD / ADDI / ADDM / ADDS  (op base 0o270)
insn add  : encode #i36 ( op:9 = OP_ADD,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "add",  operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; @add_flags ( ac[ acn ], m ); ac[ acn ] = ( ac[ acn ] + m ) & W36_MASK; }
insn addi : encode #i36 ( op:9 = OP_ADDI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "addi", operands : acn, i, x, y )
    { #i18 m = @ea ( i, x, y ); @add_flags ( ac[ acn ], m ); ac[ acn ] = ( ac[ acn ] + m ) & W36_MASK; }
insn addm : encode #i36 ( op:9 = OP_ADDM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "addm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 m = %M[ e ]; @add_flags ( ac[ acn ], m ); %M[ e ] = ( ac[ acn ] + m ) & W36_MASK; }
insn adds : encode #i36 ( op:9 = OP_ADDS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "adds", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 m = %M[ e ]; @add_flags ( ac[ acn ], m ); #i36 r = ( ac[ acn ] + m ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// SUB / SUBI / SUBM / SUBS  (op base 0o274).  SUB is AC - M; flags use the add_flags
// macro on (AC, ~M + 1) = (AC, -M) because subtraction is negated addition.
// SIMH sub_flags: same XOR pattern; CRY bits for a - b are set as for a + (~b).
// The complement negate: -M = (W36_MASK ^ M) + 1 (mod 2^37 implicit).  We use
// add_flags(AC, ~M & W36_MASK) which matches SIMH's sub_flags(AC, M) exactly:
//   sub_flags(a,b) = add_flags(a, (~b) & W36_MASK)    [SIMH equivalence].
macro sub_flags ( a, b ) {
    @add_flags ( a, ( ( ~b ) & W36_MASK ) );
}
insn sub  : encode #i36 ( op:9 = OP_SUB,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sub",  operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; @sub_flags ( ac[ acn ], m ); ac[ acn ] = ( ac[ acn ] - m ) & W36_MASK; }
insn subi : encode #i36 ( op:9 = OP_SUBI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "subi", operands : acn, i, x, y )
    { #i18 m = @ea ( i, x, y ); @sub_flags ( ac[ acn ], m ); ac[ acn ] = ( ac[ acn ] - m ) & W36_MASK; }
insn subm : encode #i36 ( op:9 = OP_SUBM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "subm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 m = %M[ e ]; @sub_flags ( ac[ acn ], m ); %M[ e ] = ( ac[ acn ] - m ) & W36_MASK; }
insn subs : encode #i36 ( op:9 = OP_SUBS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "subs", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 m = %M[ e ]; @sub_flags ( ac[ acn ], m ); #i36 r = ( ac[ acn ] - m ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// IMUL / IMULI / IMULM / IMULS  (op base 0o220).  36-bit signed multiply: product in AC;
// AROV if the 72-bit result does not fit in 36 signed bits (product != sign-ext of low 36).
// The `%S` sign-extension operator promotes 36-bit to signed 72-bit for the multiply.
//
// Overflow test: (p >> 35) must be all-zeros (positive fits) OR SEXT37_ONES (37 ones,
// negative fits -- the sign extension of a negative 36-bit value into the upper 37 bits).
// Using W36_MASK (36 ones) here would spuriously flag any in-range negative result.
insn imul  : encode #i36 ( op:9 = OP_IMUL,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "imul",  operands : acn, i, x, y )
    { #i72 p = %S ( ac[ acn ] ) * %S ( %M[ @ea ( i, x, y ) ] ); AROV = ( ( p >> 35 ) != 0 && ( p >> 35 ) != SEXT37_ONES ) ? 1 : 0; ac[ acn ] = p & W36_MASK; }
insn imuli : encode #i36 ( op:9 = OP_IMULI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "imuli", operands : acn, i, x, y )
    { #i72 p = %S ( ac[ acn ] ) * %S ( @ea ( i, x, y ) ); AROV = ( ( p >> 35 ) != 0 && ( p >> 35 ) != SEXT37_ONES ) ? 1 : 0; ac[ acn ] = p & W36_MASK; }
insn imulm : encode #i36 ( op:9 = OP_IMULM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "imulm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i72 p = %S ( ac[ acn ] ) * %S ( %M[ e ] ); AROV = ( ( p >> 35 ) != 0 && ( p >> 35 ) != SEXT37_ONES ) ? 1 : 0; %M[ e ] = p & W36_MASK; }
insn imuls : encode #i36 ( op:9 = OP_IMULS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "imuls", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i72 p = %S ( ac[ acn ] ) * %S ( %M[ e ] ); AROV = ( ( p >> 35 ) != 0 && ( p >> 35 ) != SEXT37_ONES ) ? 1 : 0; #i36 r = p & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }

// ---------------------------------------------------------------------------
// MUL / MULI / MULM / MULS  (op base 0o224).  36-bit signed multiply: full 72-bit result
// in the AC pair (AC = high 36, AC+1 = low 36).  The canonical 72-bit form: high word is
// signed, low word has its sign bit (bit 35) clear (SIMH: lo = product & 0377777777777).
// AROV only on (-2^35) * (-2^35) -- the sole overflow case for a 36x36 -> 72 multiply:
// the product +2^70 does not fit in 72-bit signed two's complement (max positive is 2^71-1,
// but the 72-bit signed form has the MSB as sign, so +2^70 is in range; the real issue is that
// the product 2^70 has its sign bit [bit 71 of the 72-bit word] set in the SIMH-canonical
// two-word representation, triggering the hardware overflow latch).
// Task-18 note: AROV is set here for the -2^35 * -2^35 case per HRM/SIMH; execution
// verification deferred to Task 18.
macro mul_pair ( a, b, acn ) {
    #i72 p  = %S ( a ) * %S ( b );
    AROV = ( ( ( a & W36_MASK ) == SIGN_BIT36 ) && ( ( b & W36_MASK ) == SIGN_BIT36 ) ) ? 1 : 0;
    ac[ acn ]               = ( p >> 36 ) & W36_MASK;     // high word (signed)
    ac[ ( acn + 1 ) & 0xf ] = p & 0xfffffffff;            // low word (clear sign bit per SIMH convention)
}
insn mul  : encode #i36 ( op:9 = OP_MUL,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "mul",  operands : acn, i, x, y )
    { @mul_pair ( ac[ acn ], %M[ @ea ( i, x, y ) ], acn ); }
insn muli : encode #i36 ( op:9 = OP_MULI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "muli", operands : acn, i, x, y )
    { @mul_pair ( ac[ acn ], @ea ( i, x, y ), acn ); }
insn mulm : encode #i36 ( op:9 = OP_MULM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "mulm", operands : acn, i, x, y )
    {
        #i18 e  = @ea ( i, x, y );
        #i72 p  = %S ( ac[ acn ] ) * %S ( %M[ e ] );
        %M[ e ] = ( p >> 36 ) & W36_MASK;                  // store high word to memory
    }
insn muls : encode #i36 ( op:9 = OP_MULS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "muls", operands : acn, i, x, y )
    {
        #i18 e  = @ea ( i, x, y );
        #i72 p  = %S ( ac[ acn ] ) * %S ( %M[ e ] );
        #i36 hi = ( p >> 36 ) & W36_MASK;
        %M[ e ]                 = hi;
        ac[ acn ]               = hi;
        ac[ ( acn + 1 ) & 0xf ] = p & W36_MASK;
    }

// ---------------------------------------------------------------------------
// IDIV / IDIVI / IDIVM / IDIVS  (op base 0o230).  36-bit signed divide: AC / M[E] ->
// quotient in AC, remainder in AC+1.  AROV (No Divide) if M[E]=0 or (AC=-2^35, M=-1).
macro idiv_body ( a, b, acn ) {
    #i1 nodiv = ( ( b & W36_MASK ) == 0 ) ? 1 : ( ( ( a & W36_MASK ) == SIGN_BIT36 && ( b & W36_MASK ) == W36_MASK ) ? 1 : 0 );
    AROV = nodiv;
    ac[ acn ]               = nodiv ? ( a & W36_MASK ) : ( ( %S ( a ) / %S ( b ) ) & W36_MASK );
    ac[ ( acn + 1 ) & 0xf ] = nodiv ? 0 : ( ( %S ( a ) % %S ( b ) ) & W36_MASK );
}
insn idiv  : encode #i36 ( op:9 = OP_IDIV,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "idiv",  operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; @idiv_body ( ac[ acn ], m, acn ); }
insn idivi : encode #i36 ( op:9 = OP_IDIVI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "idivi", operands : acn, i, x, y )
    { #i18 m = @ea ( i, x, y ); @idiv_body ( ac[ acn ], m, acn ); }
insn idivm : encode #i36 ( op:9 = OP_IDIVM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "idivm", operands : acn, i, x, y )
    {
        #i18 e = @ea ( i, x, y );
        #i36 m = %M[ e ];
        #i1 nodiv = ( ( m & W36_MASK ) == 0 ) ? 1 : ( ( ( ac[ acn ] & W36_MASK ) == SIGN_BIT36 && ( m & W36_MASK ) == W36_MASK ) ? 1 : 0 );
        AROV = nodiv;
        %M[ e ] = nodiv ? ( ac[ acn ] & W36_MASK ) : ( ( %S ( ac[ acn ] ) / %S ( m ) ) & W36_MASK );
    }
insn idivs : encode #i36 ( op:9 = OP_IDIVS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "idivs", operands : acn, i, x, y )
    {
        #i18 e = @ea ( i, x, y );
        #i36 m = %M[ e ];
        #i1 nodiv = ( ( m & W36_MASK ) == 0 ) ? 1 : ( ( ( ac[ acn ] & W36_MASK ) == SIGN_BIT36 && ( m & W36_MASK ) == W36_MASK ) ? 1 : 0 );
        AROV = nodiv;
        #i36 q = nodiv ? ( ac[ acn ] & W36_MASK ) : ( ( %S ( ac[ acn ] ) / %S ( m ) ) & W36_MASK );
        #i36 r = nodiv ? 0 : ( ( %S ( ac[ acn ] ) % %S ( m ) ) & W36_MASK );
        %M[ e ]                 = q;
        ac[ acn ]               = q;
        ac[ ( acn + 1 ) & 0xf ] = r;
    }

// ---------------------------------------------------------------------------
// DIV / DIVI / DIVM / DIVS  (op base 0o234).  72-bit divide: (AC,,AC+1) / M[E] ->
// quotient in AC, remainder in AC+1.  AROV if M=0 or quotient overflows 36 signed bits.
// The 72-bit dividend is assembled: hi = AC (36-bit, signed), lo = AC+1 (low 36, unsigned
// magnitude part); dividend = (hi << 36) | lo.
// Overflow test for DIV/IDIV quotient: (q72 >> 35) must be 0 (positive fits in 36 bits)
// or SEXT37_ONES (37 ones -- negative fits).  W36_MASK (36 ones) would spuriously trigger
// AROV on any in-range negative quotient.
macro div_body ( hi, lo, b, acn ) {
    #i72 dvd = ( %S ( hi ) << 36 ) | ( lo & W36_MASK );
    #i1  nodiv = ( ( b & W36_MASK ) == 0 ) ? 1 : 0;
    #i72 q72  = nodiv ? 0 : ( dvd / %S ( b ) );
    #i1  ov   = nodiv ? 1 : ( ( ( q72 >> 35 ) != 0 && ( q72 >> 35 ) != SEXT37_ONES ) ? 1 : 0 );
    AROV = ov;
    ac[ acn ]               = ov ? ( hi & W36_MASK ) : ( q72 & W36_MASK );
    ac[ ( acn + 1 ) & 0xf ] = ov ? ( lo & W36_MASK ) : ( ( dvd % %S ( b ) ) & W36_MASK );
}
insn div  : encode #i36 ( op:9 = OP_DIV,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "div",  operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; @div_body ( ac[ acn ], ac[ ( acn + 1 ) & 0xf ], m, acn ); }
insn divi : encode #i36 ( op:9 = OP_DIVI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "divi", operands : acn, i, x, y )
    { #i18 m = @ea ( i, x, y ); @div_body ( ac[ acn ], ac[ ( acn + 1 ) & 0xf ], m, acn ); }
insn divm : encode #i36 ( op:9 = OP_DIVM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "divm", operands : acn, i, x, y )
    {
        #i18 e  = @ea ( i, x, y );
        #i36 m  = %M[ e ];
        #i72 dvd = ( %S ( ac[ acn ] ) << 36 ) | ( ac[ ( acn + 1 ) & 0xf ] & W36_MASK );
        #i1  nodiv = ( ( m & W36_MASK ) == 0 ) ? 1 : 0;
        #i72 q72  = nodiv ? 0 : ( dvd / %S ( m ) );
        #i1  ov   = nodiv ? 1 : ( ( ( q72 >> 35 ) != 0 && ( q72 >> 35 ) != SEXT37_ONES ) ? 1 : 0 );
        AROV = ov;
        %M[ e ] = ov ? ( ac[ acn ] & W36_MASK ) : ( q72 & W36_MASK );
    }
insn divs : encode #i36 ( op:9 = OP_DIVS, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "divs", operands : acn, i, x, y )
    {
        #i18 e   = @ea ( i, x, y );
        #i36 m   = %M[ e ];
        #i72 dvd = ( %S ( ac[ acn ] ) << 36 ) | ( ac[ ( acn + 1 ) & 0xf ] & W36_MASK );
        #i1  nodiv = ( ( m & W36_MASK ) == 0 ) ? 1 : 0;
        #i72 q72  = nodiv ? 0 : ( dvd / %S ( m ) );
        #i1  ov   = nodiv ? 1 : ( ( ( q72 >> 35 ) != 0 && ( q72 >> 35 ) != SEXT37_ONES ) ? 1 : 0 );
        AROV = ov;
        #i36 q = ov ? ( ac[ acn ] & W36_MASK ) : ( q72 & W36_MASK );
        #i36 r = ov ? ( ac[ ( acn + 1 ) & 0xf ] & W36_MASK ) : ( ( dvd % %S ( m ) ) & W36_MASK );
        %M[ e ]                 = q;
        ac[ acn ]               = q;
        ac[ ( acn + 1 ) & 0xf ] = r;
    }

// ===========================================================================
// DOUBLE-PRECISION ARITHMETIC (DEC PDP-10 Hardware Reference Manual, "Double-Precision";
// opcodes verified against SIMH pdp10_sys.c).  72-bit operands in the AC pair (AC = high 36,
// AC+1 = low 36) and the memory pair (E, E+1).  Basic form only; flags per ADD/SUB logic
// applied to the 72-bit operands.  DADD/DSUB set CRY0/CRY1/AROV on the 72-bit result.
//
// The 72-bit value: hi in AC (signed), lo in AC+1 (unsigned magnitude, bit 35 = 0 in
// canonical form per SIMH but may carry a magnitude bit during compute).
//
// Opcodes: DADD=0o114, DSUB=0o115, DMUL=0o116, DDIV=0o117 (per SIMH pdp10_sys.c).

insn dadd : encode #i36 ( op:9 = OP_DADD, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "dadd", operands : acn, i, x, y )
    {
        #i18 e   = @ea ( i, x, y );
        #i72 ahi = ac[ acn ] & W36_MASK;
        #i72 alo = ac[ ( acn + 1 ) & 0xf ] & W36_MASK;
        #i72 bhi = %M[ e ] & W36_MASK;
        #i72 blo = %M[ ( e + 1 ) & EA_Y_MASK ] & W36_MASK;
        #i72 a72 = ( %S ( ahi ) << 36 ) | alo;
        #i72 b72 = ( %S ( bhi ) << 36 ) | blo;
        #i72 r72 = a72 + b72;
        @add_flags ( ahi, bhi );
        ac[ acn ]               = ( r72 >> 36 ) & W36_MASK;
        ac[ ( acn + 1 ) & 0xf ] = r72 & W36_MASK;
    }

insn dsub : encode #i36 ( op:9 = OP_DSUB, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "dsub", operands : acn, i, x, y )
    {
        #i18 e   = @ea ( i, x, y );
        #i72 ahi = ac[ acn ] & W36_MASK;
        #i72 alo = ac[ ( acn + 1 ) & 0xf ] & W36_MASK;
        #i72 bhi = %M[ e ] & W36_MASK;
        #i72 blo = %M[ ( e + 1 ) & EA_Y_MASK ] & W36_MASK;
        #i72 a72 = ( %S ( ahi ) << 36 ) | alo;
        #i72 b72 = ( %S ( bhi ) << 36 ) | blo;
        #i72 r72 = a72 - b72;
        @sub_flags ( ahi, bhi );
        ac[ acn ]               = ( r72 >> 36 ) & W36_MASK;
        ac[ ( acn + 1 ) & 0xf ] = r72 & W36_MASK;
    }

insn dmul : encode #i36 ( op:9 = OP_DMUL, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "dmul", operands : acn, i, x, y )
    {
        #i18 e   = @ea ( i, x, y );
        #i72 ahi = ac[ acn ] & W36_MASK;
        #i72 alo = ac[ ( acn + 1 ) & 0xf ] & W36_MASK;
        #i72 bhi = %M[ e ] & W36_MASK;
        #i72 blo = %M[ ( e + 1 ) & EA_Y_MASK ] & W36_MASK;
        #i72 a72 = ( %S ( ahi ) << 36 ) | alo;
        #i72 b72 = ( %S ( bhi ) << 36 ) | blo;
        #i144 p  = %S ( a72 ) * %S ( b72 );
        ac[ acn ]               = ( p >> 36 ) & W36_MASK;  // bits 107..72 (high word of result pair)
        ac[ ( acn + 1 ) & 0xf ] = ( p >> 0  ) & W36_MASK;  // bits 35..0  (low word)
    }

insn ddiv : encode #i36 ( op:9 = OP_DDIV, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "ddiv", operands : acn, i, x, y )
    {
        #i18 e   = @ea ( i, x, y );
        #i72 ahi = ac[ acn ] & W36_MASK;
        #i72 alo = ac[ ( acn + 1 ) & 0xf ] & W36_MASK;
        #i72 bhi = %M[ e ] & W36_MASK;
        #i72 blo = %M[ ( e + 1 ) & EA_Y_MASK ] & W36_MASK;
        #i72 a72 = ( %S ( ahi ) << 36 ) | alo;
        #i72 b72 = ( %S ( bhi ) << 36 ) | blo;
        #i1  nodiv = ( ( b72 & ( ( 1 << 72 ) - 1 ) ) == 0 ) ? 1 : 0;
        AROV = nodiv;
        ac[ acn ]               = nodiv ? ( ahi & W36_MASK ) : ( ( %S ( a72 ) / %S ( b72 ) ) & W36_MASK );
        ac[ ( acn + 1 ) & 0xf ] = nodiv ? ( alo & W36_MASK ) : ( ( %S ( a72 ) % %S ( b72 ) ) & W36_MASK );
    }

// ===========================================================================
// SHIFT, ROTATE, AND RELATED (DEC PDP-10 Hardware Reference Manual, "Shift, Rotate and
// Related"; opcodes verified against SIMH pdp10_sys.c).
//
// The shift count is the signed right half of the EFFECTIVE ADDRESS E (not M[E]):
//   count = %S(E & EA_Y_MASK) -- sign-extend the 18-bit EA to get a signed count.
//   count > 0: shift/rotate LEFT;  count < 0: shift/rotate RIGHT.
//   count == 0: no-op.
// The count is taken modulo the range where needed per the HRM: for LSH/ASH
// any count >= 36 shifts all bits out; for ROT the count is taken mod 36 (SIMH: mod 36,
// with the direction preserved).
//
// ASH  (0o240): ARITHMETIC shift AC by E positions.  Left shift: vacated right bits = 0;
//   if any bit shifted out of position 1 (bit 34) differs from sign bit (bit 35), AROV.
//   Right shift: vacated left bits = sign bit (arithmetic right shift); sign preserved.
// LSH  (0o242): LOGICAL shift AC by E positions.  Vacated bits = 0.
// ROT  (0o241): ROTATE AC by E positions (36-bit rotate; count mod 36).
// JFFO (0o243): JUMP if Find First One: find highest set bit of AC; count (bit pos from
//   left, i.e. 35 - bitpos) into AC+1; jump to E if AC != 0.  AC+1 = 0 if AC = 0.
// ASHC (0o244): ARITHMETIC shift the 70-bit pair (AC,,AC+1 without the low sign bit).
// LSHC (0o246): LOGICAL shift the 72-bit pair (AC,,AC+1).
// ROTC (0o245): ROTATE the 72-bit pair (AC,,AC+1) by E positions (count mod 72).
//
// Opcode constants (all single, non-modal -- no +0/+1/+2/+3 group; each is standalone):
const OP_ASH  = 0o240;
const OP_ROT  = 0o241;
const OP_LSH  = 0o242;
const OP_JFFO = 0o243;
const OP_ASHC = 0o244;
const OP_ROTC = 0o245;
const OP_LSHC = 0o246;

// ---------------------------------------------------------------------------
// Shift count: E is the 18-bit right half; sign-extend to a signed count.
// The HRM says "the number of positions ... is the effective address" (signed 18-bit).
// Positive = left shift; negative = right shift.
macro shift_count ( e ) { result = %S ( e & EA_Y_MASK ); }

// ---------------------------------------------------------------------------
// ASH AC, E -- arithmetic shift.  Sign bit (bit 35) is preserved; count > 0: left shift
// (vacated bits = 0, AROV if any significant bit is lost), count < 0: right shift (sign fill).
insn ash : encode #i36 ( op:9 = OP_ASH, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "ash", operands : acn, i, x, y )
    {
        #i18 cnt = @shift_count ( @ea ( i, x, y ) );
        #i36 v   = ac[ acn ] & W36_MASK;
        #i36 sgn = ( v >> 35 ) & 1;                               // sign bit
        #i36 r;
        r = ( cnt >= 36 ) ? ( sgn ? W36_MASK : 0 ) :
            ( cnt <= -36 ) ? ( sgn ? W36_MASK : 0 ) :
            ( cnt > 0 ) ? ( ( ( v << cnt ) & W36_MASK ) | ( sgn << 35 ) ) :
            ( sgn ? ( ( W36_MASK << ( 36 + cnt ) ) | ( v >> ( 0 - cnt ) ) ) & W36_MASK
                  : ( v >> ( 0 - cnt ) ) );
        AROV = ( cnt > 0 ) ? ( ( ( v ^ r ) & SIGN_BIT36 ) | ( v != ( r | ( v & SIGN_BIT36 ) ) ) ) ? 1 : 0 : 0;
        ac[ acn ] = r & W36_MASK;
    }

// ---------------------------------------------------------------------------
// LSH AC, E -- logical shift.  Vacated bits = 0; no AROV.
insn lsh : encode #i36 ( op:9 = OP_LSH, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "lsh", operands : acn, i, x, y )
    {
        #i18 cnt = @shift_count ( @ea ( i, x, y ) );
        #i36 v   = ac[ acn ] & W36_MASK;
        ac[ acn ] = ( cnt >= 36 || cnt <= -36 ) ? 0 :
                    ( cnt > 0 ) ? ( ( v << cnt ) & W36_MASK ) :
                    ( v >> ( 0 - cnt ) );
    }

// ---------------------------------------------------------------------------
// ROT AC, E -- rotate 36-bit word by count positions (count mod 36; positive = left).
insn rot : encode #i36 ( op:9 = OP_ROT, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "rot", operands : acn, i, x, y )
    {
        #i18 cnt = @shift_count ( @ea ( i, x, y ) );
        #i36 v   = ac[ acn ] & W36_MASK;
        #i18 n   = cnt % 36;                                       // modulo 36 (may be negative)
        n = ( n < 0 ) ? ( n + 36 ) : n;                           // normalise to 0..35
        ac[ acn ] = ( n == 0 ) ? v : ( ( ( v << n ) | ( v >> ( 36 - n ) ) ) & W36_MASK );
    }

// ---------------------------------------------------------------------------
// JFFO AC, E -- Jump if Find First One.  Find the highest set bit in AC; its ordinal
// (0..35, counting from the LEFT = PDP-10 bit 0) goes into AC+1.  Jump to E if AC != 0.
// "Highest set bit" = MSB position in the 36-bit word.  PDP-10 bit 0 = our bit 35.
// If AC = 0, AC+1 <- 0 and no jump.
insn jffo : encode #i36 ( op:9 = OP_JFFO, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jffo", operands : acn, i, x, y )
    {
        #i36 v = ac[ acn ] & W36_MASK;
        #i18 pos = 0;
        #i36 t = v;
        #i18 b = 35;                                               // start from bit 35 (PDP-10 bit 0)
        // find highest set bit: scan from bit 35 down to 0
        pos = ( ( t >> 35 ) & 1 ) ? 0  :
              ( ( t >> 34 ) & 1 ) ? 1  :
              ( ( t >> 33 ) & 1 ) ? 2  :
              ( ( t >> 32 ) & 1 ) ? 3  :
              ( ( t >> 31 ) & 1 ) ? 4  :
              ( ( t >> 30 ) & 1 ) ? 5  :
              ( ( t >> 29 ) & 1 ) ? 6  :
              ( ( t >> 28 ) & 1 ) ? 7  :
              ( ( t >> 27 ) & 1 ) ? 8  :
              ( ( t >> 26 ) & 1 ) ? 9  :
              ( ( t >> 25 ) & 1 ) ? 10 :
              ( ( t >> 24 ) & 1 ) ? 11 :
              ( ( t >> 23 ) & 1 ) ? 12 :
              ( ( t >> 22 ) & 1 ) ? 13 :
              ( ( t >> 21 ) & 1 ) ? 14 :
              ( ( t >> 20 ) & 1 ) ? 15 :
              ( ( t >> 19 ) & 1 ) ? 16 :
              ( ( t >> 18 ) & 1 ) ? 17 :
              ( ( t >> 17 ) & 1 ) ? 18 :
              ( ( t >> 16 ) & 1 ) ? 19 :
              ( ( t >> 15 ) & 1 ) ? 20 :
              ( ( t >> 14 ) & 1 ) ? 21 :
              ( ( t >> 13 ) & 1 ) ? 22 :
              ( ( t >> 12 ) & 1 ) ? 23 :
              ( ( t >> 11 ) & 1 ) ? 24 :
              ( ( t >> 10 ) & 1 ) ? 25 :
              ( ( t >>  9 ) & 1 ) ? 26 :
              ( ( t >>  8 ) & 1 ) ? 27 :
              ( ( t >>  7 ) & 1 ) ? 28 :
              ( ( t >>  6 ) & 1 ) ? 29 :
              ( ( t >>  5 ) & 1 ) ? 30 :
              ( ( t >>  4 ) & 1 ) ? 31 :
              ( ( t >>  3 ) & 1 ) ? 32 :
              ( ( t >>  2 ) & 1 ) ? 33 :
              ( ( t >>  1 ) & 1 ) ? 34 :
              ( ( t >>  0 ) & 1 ) ? 35 :
              0;
        ac[ ( acn + 1 ) & 0xf ] = ( v != 0 ) ? pos : 0;
        pc = ( v != 0 ) ? @ea ( i, x, y ) : pc;
    }

// ---------------------------------------------------------------------------
// ASHC AC, E -- arithmetic shift 70-bit pair.  The pair is: AC bits 34..0 (35 bits of
// magnitude + sign from AC bit 35) and AC+1 bits 34..0 (35 bits, bit 35 of AC+1 is
// a copy of sign of AC per the HRM).  SIMH: shift the 70-bit value (AC<0..34>, AC+1<0..34>)
// left or right; sign bit of AC is preserved.
insn ashc : encode #i36 ( op:9 = OP_ASHC, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "ashc", operands : acn, i, x, y )
    {
        #i18 cnt  = @shift_count ( @ea ( i, x, y ) );
        #i36 ahi  = ac[ acn ] & W36_MASK;
        #i36 alo  = ac[ ( acn + 1 ) & 0xf ] & W36_MASK;
        #i36 sgn  = ( ahi >> 35 ) & 1;
        // 70-bit number: bits 69..35 from ahi<34..0>, bits 34..0 from alo<34..0>.
        #i72 pair = ( ( ahi & 0x7ffffffff ) << 35 ) | ( alo & 0x7ffffffff );
        #i72 r70;
        r70 = ( cnt >= 70 ) ? ( sgn ? 0x3ffffffffffffff : 0 ) :
              ( cnt <= -70 ) ? ( sgn ? 0x3ffffffffffffff : 0 ) :
              ( cnt > 0 ) ? ( ( pair << cnt ) & 0x3ffffffffffffff ) :
              ( sgn ? ( ( 0x3ffffffffffffff << ( 70 + cnt ) ) | ( pair >> ( 0 - cnt ) ) ) & 0x3ffffffffffffff
                    : ( pair >> ( 0 - cnt ) ) );
        AROV = ( cnt > 0 ) ? ( ( pair != r70 ) && ( ( pair >> 69 ) == ( r70 >> 69 ) ) ) ? 1 : 0 : 0;
        ac[ acn ]               = ( sgn << 35 ) | ( ( r70 >> 35 ) & 0x7ffffffff );
        ac[ ( acn + 1 ) & 0xf ] = ( sgn << 35 ) | ( r70 & 0x7ffffffff );
    }

// ---------------------------------------------------------------------------
// LSHC AC, E -- logical shift the 72-bit pair (AC,,AC+1) by count positions.  Vacated = 0.
insn lshc : encode #i36 ( op:9 = OP_LSHC, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "lshc", operands : acn, i, x, y )
    {
        #i18 cnt  = @shift_count ( @ea ( i, x, y ) );
        #i72 pair = ( ( ac[ acn ] & W36_MASK ) << 36 ) | ( ac[ ( acn + 1 ) & 0xf ] & W36_MASK );
        #i72 r72;
        r72 = ( cnt >= 72 || cnt <= -72 ) ? 0 :
              ( cnt > 0 ) ? ( pair << cnt ) :
              ( pair >> ( 0 - cnt ) );
        ac[ acn ]               = ( r72 >> 36 ) & W36_MASK;
        ac[ ( acn + 1 ) & 0xf ] = r72 & W36_MASK;
    }

// ---------------------------------------------------------------------------
// ROTC AC, E -- rotate the 72-bit pair (AC,,AC+1) by count positions (count mod 72).
insn rotc : encode #i36 ( op:9 = OP_ROTC, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "rotc", operands : acn, i, x, y )
    {
        #i18 cnt  = @shift_count ( @ea ( i, x, y ) );
        #i72 pair = ( ( ac[ acn ] & W36_MASK ) << 36 ) | ( ac[ ( acn + 1 ) & 0xf ] & W36_MASK );
        #i18 n    = cnt % 72;
        n = ( n < 0 ) ? ( n + 72 ) : n;
        #i72 r72  = ( n == 0 ) ? pair : ( ( ( pair << n ) | ( pair >> ( 72 - n ) ) ) & 0xfffffffffffffffff );
        ac[ acn ]               = ( r72 >> 36 ) & W36_MASK;
        ac[ ( acn + 1 ) & 0xf ] = r72 & W36_MASK;
    }

// ===========================================================================
// TEST / COMPARE / SKIP CLASS (DEC PDP-10 Hardware Reference Manual, "Test, Compare, and
// Skip"; opcodes verified against SIMH pdp10_sys.c).
//
// ── TEST CLASS (0o6xx) ──────────────────────────────────────────────────────
// Each T{src}{mod}{skip} instruction:
//   1. Forms a MASK from the effective address E:
//        R: mask = E (right half of a 36-bit word = low 18 bits, same as E since E is 18-bit)
//        L: mask = E << 18 (E placed in the left-half position)
//        D: mask = E (full 36-bit E, same as R for an 18-bit EA)
//        S: mask = E << 18 (swapped halves -- since E is 18-bit, left half is 0, so swap = E in left)
//   2. Tests the MASKED bits of AC: masked = AC & mask
//   3. Modifies the MASKED bits of AC:
//        N: no change  (AC unchanged)
//        Z: clear  (AC & ~mask) -- zero the masked bits
//        C: complement (AC ^ mask) -- flip the masked bits
//        O: set ones  (AC | mask) -- set the masked bits
//   4. Conditionally skips the next instruction:
//        - (none): never skip
//        E: skip if (masked == 0) -- all masked bits were 0 before modify
//        A: always skip
//        N: skip if (masked != 0) -- any masked bit was 1 before modify
//
// NOTE: the skip condition is evaluated BEFORE the modify (the test uses the original masked
// bits, not the post-modify value).  Per DEC HRM and SIMH pdp10_cpu.c `test()`.
//
// OPCODE LAYOUT (all 64 instructions, 0o600-0o677, verified against SIMH pdp10_sys.c):
//   Bits [5:3] of the low 6 bits select {source,modify}: R/L-N=0, D/S-N=1, R/L-Z=2, D/S-Z=3,
//   R/L-C=4, D/S-C=5, R/L-O=6, D/S-O=7.  Bit [0] selects L (1) vs R or D/S (0) within R/L
//   pairs; within D/S pairs bit [0] selects S (1) vs D (0).  Bits [2:1] select the skip
//   condition: 00=never, 01=E, 10=A, 11=N.
//
// To keep const count manageable, only the group BASE for each {source,modify} pair is defined;
// per-mnemonic opcodes are base + skip-offset (SKIP_NEV/E/A/N = 0/2/4/6).
// Within R/L pairs: base+0=R-never, base+1=L-never, base+2=R-E, base+3=L-E, etc.
// Within D/S pairs: base+0=D-never, base+1=S-never, base+2=D-E, base+3=S-E, etc.
const SKIP_NEV = 0;     // skip condition: never    (+0 within pair)
const SKIP_E   = 2;     // skip condition: E=0      (+2 within pair)
const SKIP_A   = 4;     // skip condition: always   (+4 within pair)
const SKIP_N   = 6;     // skip condition: N!=0     (+6 within pair)

// Group bases for R/L pairs (source R = base+0, source L = base+1; skip condition adds SKIP_*).
const OP_TRN_BASE  = 0o600;     // T R N: source=R, modify=N (base of R/L-N group)
const OP_TRZ_BASE  = 0o620;     // T R Z: source=R, modify=Z (base of R/L-Z group)
const OP_TRC_BASE  = 0o640;     // T R C: source=R, modify=C (base of R/L-C group)
const OP_TRO_BASE  = 0o660;     // T R O: source=R, modify=O (base of R/L-O group)

// Group bases for D/S pairs (source D = base+0, source S = base+1; skip condition adds SKIP_*).
const OP_TDN_BASE  = 0o610;     // T D N: source=D, modify=N (base of D/S-N group)
const OP_TDZ_BASE  = 0o630;     // T D Z: source=D, modify=Z (base of D/S-Z group)
const OP_TDC_BASE  = 0o650;     // T D C: source=D, modify=C (base of D/S-C group)
const OP_TDO_BASE  = 0o670;     // T D O: source=D, modify=O (base of D/S-O group)

// Per-mnemonic opcodes (base + L-offset + skip-offset), all 64 TEST instructions.
// R/L-N group:
const OP_TRN   = OP_TRN_BASE + 0; const OP_TLN   = OP_TRN_BASE + 1;
const OP_TRNE  = OP_TRN_BASE + 2; const OP_TLNE  = OP_TRN_BASE + 3;
const OP_TRNA  = OP_TRN_BASE + 4; const OP_TLNA  = OP_TRN_BASE + 5;
const OP_TRNN  = OP_TRN_BASE + 6; const OP_TLNN  = OP_TRN_BASE + 7;
// D/S-N group:
const OP_TDN   = OP_TDN_BASE + 0; const OP_TSN   = OP_TDN_BASE + 1;
const OP_TDNE  = OP_TDN_BASE + 2; const OP_TSNE  = OP_TDN_BASE + 3;
const OP_TDNA  = OP_TDN_BASE + 4; const OP_TSNA  = OP_TDN_BASE + 5;
const OP_TDNN  = OP_TDN_BASE + 6; const OP_TSNN  = OP_TDN_BASE + 7;
// R/L-Z group:
const OP_TRZ   = OP_TRZ_BASE + 0; const OP_TLZ   = OP_TRZ_BASE + 1;
const OP_TRZE  = OP_TRZ_BASE + 2; const OP_TLZE  = OP_TRZ_BASE + 3;
const OP_TRZA  = OP_TRZ_BASE + 4; const OP_TLZA  = OP_TRZ_BASE + 5;
const OP_TRZN  = OP_TRZ_BASE + 6; const OP_TLZN  = OP_TRZ_BASE + 7;
// D/S-Z group:
const OP_TDZ   = OP_TDZ_BASE + 0; const OP_TSZ   = OP_TDZ_BASE + 1;
const OP_TDZE  = OP_TDZ_BASE + 2; const OP_TSZE  = OP_TDZ_BASE + 3;
const OP_TDZA  = OP_TDZ_BASE + 4; const OP_TSZA  = OP_TDZ_BASE + 5;
const OP_TDZN  = OP_TDZ_BASE + 6; const OP_TSZN  = OP_TDZ_BASE + 7;
// R/L-C group:
const OP_TRC   = OP_TRC_BASE + 0; const OP_TLC   = OP_TRC_BASE + 1;
const OP_TRCE  = OP_TRC_BASE + 2; const OP_TLCE  = OP_TRC_BASE + 3;
const OP_TRCA  = OP_TRC_BASE + 4; const OP_TLCA  = OP_TRC_BASE + 5;
const OP_TRCN  = OP_TRC_BASE + 6; const OP_TLCN  = OP_TRC_BASE + 7;
// D/S-C group:
const OP_TDC   = OP_TDC_BASE + 0; const OP_TSC   = OP_TDC_BASE + 1;
const OP_TDCE  = OP_TDC_BASE + 2; const OP_TSCE  = OP_TDC_BASE + 3;
const OP_TDCA  = OP_TDC_BASE + 4; const OP_TSCA  = OP_TDC_BASE + 5;
const OP_TDCN  = OP_TDC_BASE + 6; const OP_TSCN  = OP_TDC_BASE + 7;
// R/L-O group:
const OP_TRO   = OP_TRO_BASE + 0; const OP_TLO   = OP_TRO_BASE + 1;
const OP_TROE  = OP_TRO_BASE + 2; const OP_TLOE  = OP_TRO_BASE + 3;
const OP_TROA  = OP_TRO_BASE + 4; const OP_TLOA  = OP_TRO_BASE + 5;
const OP_TRON  = OP_TRO_BASE + 6; const OP_TLON  = OP_TRO_BASE + 7;
// D/S-O group:
const OP_TDO   = OP_TDO_BASE + 0; const OP_TSO   = OP_TDO_BASE + 1;
const OP_TDOE  = OP_TDO_BASE + 2; const OP_TSOE  = OP_TDO_BASE + 3;
const OP_TDOA  = OP_TDO_BASE + 4; const OP_TSOA  = OP_TDO_BASE + 5;
const OP_TDON  = OP_TDO_BASE + 6; const OP_TSON  = OP_TDO_BASE + 7;

// ---------------------------------------------------------------------------
// Mask-formation macros.  E is the 18-bit effective address (right half of any 36-bit word).
// R: mask = E (right 18 bits; identical to the bare EA for 18-bit addressing)
// L: mask = E << 18 (E placed into the left-half position of the 36-bit word)
// D: mask = E (E direct -- same as R for an 18-bit EA, i.e. mask spans right half only)
// S: mask = E << 18 (swapped halves: since E is 18-bit, left18(E)=0, right18(E)=E; swap puts
//    E into the left-half position, identical to L for an 18-bit EA)
// These two macros cover all four T{R,L,D,S} variants cleanly:
macro mask_right ( e ) { result = e & HW_MASK; }                    // R / D: mask in right half
macro mask_left  ( e ) { result = ( e & HW_MASK ) << HW_LSHFT; }   // L / S: mask in left half

// ---------------------------------------------------------------------------
// TEST INSTRUCTIONS -- all 64 T{src}{mod}{skip}.
//
// Each body:
//   1. Compute mask from E (mask_right / mask_left).
//   2. Compute masked = AC & mask (the bits under test).
//   3. Skip if the condition holds (evaluate BEFORE modify).
//   4. Apply modify to AC: N=nop, Z=clear masked bits, C=complement masked bits, O=set masked bits.
//
// Skip = conditional pc = pc + 1.  The condition is evaluated on 'masked' BEFORE the modify.
//
// The modify forms that leave AC unchanged are expressed as one-liners (=>); the forms that
// modify AC use a block to preserve the skip-before-modify ordering.

// --- R/L - N (modify=none: AC unchanged; only test and skip) ---
insn trn  : encode #i36 ( op:9 = OP_TRN,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "trn",  operands : acn, i, x, y )  => ;   // never skip, no modify -- no-op
insn tln  : encode #i36 ( op:9 = OP_TLN,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tln",  operands : acn, i, x, y )  => ;   // never skip, no modify -- no-op
insn trne : encode #i36 ( op:9 = OP_TRNE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "trne", operands : acn, i, x, y )
    { #i36 mask = @mask_right ( @ea ( i, x, y ) ); pc = ( ( ac[ acn ] & mask ) == 0 ) ? ( pc + 1 ) : pc; }
insn tlne : encode #i36 ( op:9 = OP_TLNE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tlne", operands : acn, i, x, y )
    { #i36 mask = @mask_left  ( @ea ( i, x, y ) ); pc = ( ( ac[ acn ] & mask ) == 0 ) ? ( pc + 1 ) : pc; }
insn trna : encode #i36 ( op:9 = OP_TRNA, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "trna", operands : acn, i, x, y )  => pc = pc + 1;   // always skip
insn tlna : encode #i36 ( op:9 = OP_TLNA, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tlna", operands : acn, i, x, y )  => pc = pc + 1;   // always skip
insn trnn : encode #i36 ( op:9 = OP_TRNN, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "trnn", operands : acn, i, x, y )
    { #i36 mask = @mask_right ( @ea ( i, x, y ) ); pc = ( ( ac[ acn ] & mask ) != 0 ) ? ( pc + 1 ) : pc; }
insn tlnn : encode #i36 ( op:9 = OP_TLNN, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tlnn", operands : acn, i, x, y )
    { #i36 mask = @mask_left  ( @ea ( i, x, y ) ); pc = ( ( ac[ acn ] & mask ) != 0 ) ? ( pc + 1 ) : pc; }

// --- D/S - N (modify=none) ---
insn tdn  : encode #i36 ( op:9 = OP_TDN,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tdn",  operands : acn, i, x, y )  => ;   // never skip, no modify -- no-op
insn tsn  : encode #i36 ( op:9 = OP_TSN,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tsn",  operands : acn, i, x, y )  => ;   // never skip, no modify -- no-op
insn tdne : encode #i36 ( op:9 = OP_TDNE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tdne", operands : acn, i, x, y )
    { #i36 mask = @mask_right ( @ea ( i, x, y ) ); pc = ( ( ac[ acn ] & mask ) == 0 ) ? ( pc + 1 ) : pc; }
insn tsne : encode #i36 ( op:9 = OP_TSNE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tsne", operands : acn, i, x, y )
    { #i36 mask = @mask_left  ( @ea ( i, x, y ) ); pc = ( ( ac[ acn ] & mask ) == 0 ) ? ( pc + 1 ) : pc; }
insn tdna : encode #i36 ( op:9 = OP_TDNA, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tdna", operands : acn, i, x, y )  => pc = pc + 1;   // always skip
insn tsna : encode #i36 ( op:9 = OP_TSNA, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tsna", operands : acn, i, x, y )  => pc = pc + 1;   // always skip
insn tdnn : encode #i36 ( op:9 = OP_TDNN, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tdnn", operands : acn, i, x, y )
    { #i36 mask = @mask_right ( @ea ( i, x, y ) ); pc = ( ( ac[ acn ] & mask ) != 0 ) ? ( pc + 1 ) : pc; }
insn tsnn : encode #i36 ( op:9 = OP_TSNN, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tsnn", operands : acn, i, x, y )
    { #i36 mask = @mask_left  ( @ea ( i, x, y ) ); pc = ( ( ac[ acn ] & mask ) != 0 ) ? ( pc + 1 ) : pc; }

// --- R/L - Z (modify=zeros: clear the masked bits of AC) ---
insn trz  : encode #i36 ( op:9 = OP_TRZ,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "trz",  operands : acn, i, x, y )
    { #i36 mask = @mask_right ( @ea ( i, x, y ) ); ac[ acn ] = ( ac[ acn ] & ( ~mask ) ) & W36_MASK; }
insn tlz  : encode #i36 ( op:9 = OP_TLZ,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tlz",  operands : acn, i, x, y )
    { #i36 mask = @mask_left  ( @ea ( i, x, y ) ); ac[ acn ] = ( ac[ acn ] & ( ~mask ) ) & W36_MASK; }
insn trze : encode #i36 ( op:9 = OP_TRZE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "trze", operands : acn, i, x, y )
    { #i36 mask = @mask_right ( @ea ( i, x, y ) ); #i36 t = ac[ acn ] & mask; ac[ acn ] = ( ac[ acn ] & ( ~mask ) ) & W36_MASK; pc = ( t == 0 ) ? ( pc + 1 ) : pc; }
insn tlze : encode #i36 ( op:9 = OP_TLZE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tlze", operands : acn, i, x, y )
    { #i36 mask = @mask_left  ( @ea ( i, x, y ) ); #i36 t = ac[ acn ] & mask; ac[ acn ] = ( ac[ acn ] & ( ~mask ) ) & W36_MASK; pc = ( t == 0 ) ? ( pc + 1 ) : pc; }
insn trza : encode #i36 ( op:9 = OP_TRZA, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "trza", operands : acn, i, x, y )
    { #i36 mask = @mask_right ( @ea ( i, x, y ) ); ac[ acn ] = ( ac[ acn ] & ( ~mask ) ) & W36_MASK; pc = pc + 1; }
insn tlza : encode #i36 ( op:9 = OP_TLZA, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tlza", operands : acn, i, x, y )
    { #i36 mask = @mask_left  ( @ea ( i, x, y ) ); ac[ acn ] = ( ac[ acn ] & ( ~mask ) ) & W36_MASK; pc = pc + 1; }
insn trzn : encode #i36 ( op:9 = OP_TRZN, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
