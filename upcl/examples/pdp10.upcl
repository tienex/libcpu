// ===========================================================================
// CAI / CAM -- COMPARE ACCUMULATOR (DEC PDP-10 Hardware Reference Manual, "Compare";
// opcodes verified against SIMH pdp10_sys.c).
//
// CAI (Compare AC Immediate, 0o300-0o307): compare AC against the immediate 0,,E (the effective
// address itself; NO memory reference).  The low 3 bits of the opcode select the 8 skip conditions
// (same ordering used by SKIP, AOS, SOS below):
//   +0 = never skip  +1 = skip if AC < E  +2 = skip if AC == E  +3 = skip if AC <= E
//   +4 = always skip +5 = skip if AC >= E  +6 = skip if AC != E  +7 = skip if AC > E
// Comparison is SIGNED (two's-complement 36-bit), using `%S` for the sign extension.
// E is a ZERO-EXTENDED immediate (0,,E -- left half is 0) for CAI, or M[E] for CAM.
//
// CAM (Compare AC to Memory, 0o310-0o317): same 8 conditions; operand is M[E] not E itself.
//
// Opcodes (per SIMH pdp10_sys.c, verified):
const OP_CAI   = 0o300;         // CAI   base: compare AC to 0,,E (never skip)
const OP_CAIL  = 0o301;         // CAIL  compare AC to 0,,E, skip if AC < 0,,E  (signed)
const OP_CAIE  = 0o302;         // CAIE  compare AC to 0,,E, skip if AC == 0,,E
const OP_CAILE = 0o303;         // CAILE compare AC to 0,,E, skip if AC <= 0,,E (signed)
const OP_CAIA  = 0o304;         // CAIA  compare AC to 0,,E, always skip
const OP_CAIGE = 0o305;         // CAIGE compare AC to 0,,E, skip if AC >= 0,,E (signed)
const OP_CAIN  = 0o306;         // CAIN  compare AC to 0,,E, skip if AC != 0,,E
const OP_CAIG  = 0o307;         // CAIG  compare AC to 0,,E, skip if AC > 0,,E  (signed)
const OP_CAM   = 0o310;         // CAM   base: compare AC to M[E] (never skip)
const OP_CAML  = 0o311;         // CAML  compare AC to M[E], skip if AC < M[E]  (signed)
const OP_CAME  = 0o312;         // CAME  compare AC to M[E], skip if AC == M[E]
const OP_CAMLE = 0o313;         // CAMLE compare AC to M[E], skip if AC <= M[E] (signed)
const OP_CAMA  = 0o314;         // CAMA  compare AC to M[E], always skip
const OP_CAMGE = 0o315;         // CAMGE compare AC to M[E], skip if AC >= M[E] (signed)
const OP_CAMN  = 0o316;         // CAMN  compare AC to M[E], skip if AC != M[E]
const OP_CAMG  = 0o317;         // CAMG  compare AC to M[E], skip if AC > M[E]  (signed)

// ---------------------------------------------------------------------------
// CAI instructions -- compare AC (signed 36-bit) to the immediate operand 0,,E.
// SIMH pdp10_cpu.c `cai()`: the immediate is 0,,E -- E (18 bits) zero-extended into 36 bits.
// The left half is always 0, so the immediate is ALWAYS non-negative (0..0x3ffff).
// Signed inequalities therefore compare %S(AC) against a non-negative 36-bit value `e`.
// Building `e` as a 36-bit zero-extension avoids the bug of sign-extending E (treating
// E=0o400000 as negative when it should be +0o400000 = 131072).
// Equality forms (caie/cain) mask to W36_MASK -- correct, unchanged.
insn cai   : encode #i36 ( op:9 = OP_CAI,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "cai",   operands : acn, i, x, y )  => ;   // never skip -- compare only
insn cail  : encode #i36 ( op:9 = OP_CAIL,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "cail",  operands : acn, i, x, y )
    { #i36 e = @ea ( i, x, y ) & HW_MASK; pc = ( %S ( ac[ acn ] ) < %S ( e ) ) ? ( pc + 1 ) : pc; }
insn caie  : encode #i36 ( op:9 = OP_CAIE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "caie",  operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); pc = ( ( ac[ acn ] & W36_MASK ) == ( e & W36_MASK ) ) ? ( pc + 1 ) : pc; }
insn caile : encode #i36 ( op:9 = OP_CAILE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "caile", operands : acn, i, x, y )
    { #i36 e = @ea ( i, x, y ) & HW_MASK; pc = ( %S ( ac[ acn ] ) <= %S ( e ) ) ? ( pc + 1 ) : pc; }
insn caia  : encode #i36 ( op:9 = OP_CAIA,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "caia",  operands : acn, i, x, y )  => pc = pc + 1;   // always skip
insn caige : encode #i36 ( op:9 = OP_CAIGE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "caige", operands : acn, i, x, y )
    { #i36 e = @ea ( i, x, y ) & HW_MASK; pc = ( %S ( ac[ acn ] ) >= %S ( e ) ) ? ( pc + 1 ) : pc; }
insn cain  : encode #i36 ( op:9 = OP_CAIN,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "cain",  operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); pc = ( ( ac[ acn ] & W36_MASK ) != ( e & W36_MASK ) ) ? ( pc + 1 ) : pc; }
insn caig  : encode #i36 ( op:9 = OP_CAIG,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "caig",  operands : acn, i, x, y )
    { #i36 e = @ea ( i, x, y ) & HW_MASK; pc = ( %S ( ac[ acn ] ) > %S ( e ) ) ? ( pc + 1 ) : pc; }

// ---------------------------------------------------------------------------
// CAM instructions -- compare AC (signed) to M[E].
insn cam   : encode #i36 ( op:9 = OP_CAM,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "cam",   operands : acn, i, x, y )  => ;   // never skip -- compare only
insn caml  : encode #i36 ( op:9 = OP_CAML,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "caml",  operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; pc = ( %S ( ac[ acn ] ) < %S ( m ) ) ? ( pc + 1 ) : pc; }
insn came  : encode #i36 ( op:9 = OP_CAME,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "came",  operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; pc = ( ( ac[ acn ] & W36_MASK ) == ( m & W36_MASK ) ) ? ( pc + 1 ) : pc; }
insn camle : encode #i36 ( op:9 = OP_CAMLE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "camle", operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; pc = ( %S ( ac[ acn ] ) <= %S ( m ) ) ? ( pc + 1 ) : pc; }
insn cama  : encode #i36 ( op:9 = OP_CAMA,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "cama",  operands : acn, i, x, y )  => pc = pc + 1;   // always skip
insn camge : encode #i36 ( op:9 = OP_CAMGE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "camge", operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; pc = ( %S ( ac[ acn ] ) >= %S ( m ) ) ? ( pc + 1 ) : pc; }
insn camn  : encode #i36 ( op:9 = OP_CAMN,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "camn",  operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; pc = ( ( ac[ acn ] & W36_MASK ) != ( m & W36_MASK ) ) ? ( pc + 1 ) : pc; }
insn camg  : encode #i36 ( op:9 = OP_CAMG,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "camg",  operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; pc = ( %S ( ac[ acn ] ) > %S ( m ) ) ? ( pc + 1 ) : pc; }

// ===========================================================================
// SKIP / AOS / SOS -- SKIP ON CONDITION (DEC PDP-10 Hardware Reference Manual, "Skip and
// Jump"; opcodes verified against SIMH pdp10_sys.c).
//
// SKIP (0o330-0o337): test M[E] vs 0; skip on the 8 conditions; if AC field != 0, load AC <- M[E].
//   M[E] is fetched; AC <- M[E] if acn != 0 (the AC-field is the "result-to-AC" gate, not an
//   AC operand). skip condition applied to M[E].
//
// AOS (0o350-0o357): add 1 to M[E], store back; skip on the 8 conditions applied to the
//   INCREMENTED value; if acn != 0, also store incremented value in AC[acn].
//
// SOS (0o370-0o377): subtract 1 from M[E], store back; skip on the 8 conditions applied to the
//   DECREMENTED value; if acn != 0, also store decremented value in AC[acn].
//   NOTE: 0o360-0o367 = SOJ (subtract 1 from AC, Jump), added in Task 12.
//
// Skip conditions (same 8 as CAI/CAM, low 3 bits of opcode):
//   +0 = never  +1 = skip if val < 0  +2 = skip if val == 0  +3 = skip if val <= 0
//   +4 = always +5 = skip if val >= 0  +6 = skip if val != 0  +7 = skip if val > 0
// "val" is M[E] (for SKIP) or the incremented/decremented word (for AOS/SOS).
//
// Opcodes (verified against SIMH pdp10_sys.c):
const OP_SKIP   = 0o330;
const OP_SKIPL  = 0o331;
const OP_SKIPE  = 0o332;
const OP_SKIPLE = 0o333;
const OP_SKIPA  = 0o334;
const OP_SKIPGE = 0o335;
const OP_SKIPN  = 0o336;
const OP_SKIPG  = 0o337;
const OP_AOS    = 0o350;
const OP_AOSL   = 0o351;
const OP_AOSE   = 0o352;
const OP_AOSLE  = 0o353;
const OP_AOSA   = 0o354;
const OP_AOSGE  = 0o355;
const OP_AOSN   = 0o356;
const OP_AOSG   = 0o357;
const OP_SOS    = 0o370;    // NOTE: corrected from Task 11 (was 0o360; 0o360-0o367 = SOJ)
const OP_SOSL   = 0o371;
const OP_SOSE   = 0o372;
const OP_SOSLE  = 0o373;
const OP_SOSA   = 0o374;
const OP_SOSGE  = 0o375;
const OP_SOSN   = 0o376;
const OP_SOSG   = 0o377;

// ---------------------------------------------------------------------------
// SKIP -- test M[E]; if acn != 0 then AC <- M[E]; skip on the 8 conditions.
// The "if acn != 0" AC-load gate: per HRM, AC0 is NOT loaded (acn==0 suppresses the write);
// the body writes ac[acn] unconditionally -- the faithful gate is exercised at execution (Task 18).
insn skip   : encode #i36 ( op:9 = OP_SKIP,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "skip",   operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; ac[ acn ] = m; }   // never skip; always load AC if acn!=0
insn skipl  : encode #i36 ( op:9 = OP_SKIPL,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "skipl",  operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; ac[ acn ] = m; pc = ( %S ( m ) < 0 ) ? ( pc + 1 ) : pc; }
insn skipe  : encode #i36 ( op:9 = OP_SKIPE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "skipe",  operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; ac[ acn ] = m; pc = ( ( m & W36_MASK ) == 0 ) ? ( pc + 1 ) : pc; }
insn skiple : encode #i36 ( op:9 = OP_SKIPLE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "skiple", operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; ac[ acn ] = m; pc = ( %S ( m ) <= 0 ) ? ( pc + 1 ) : pc; }
insn skipa  : encode #i36 ( op:9 = OP_SKIPA,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "skipa",  operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; ac[ acn ] = m; pc = pc + 1; }   // always skip
insn skipge : encode #i36 ( op:9 = OP_SKIPGE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "skipge", operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; ac[ acn ] = m; pc = ( %S ( m ) >= 0 ) ? ( pc + 1 ) : pc; }
insn skipn  : encode #i36 ( op:9 = OP_SKIPN,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "skipn",  operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; ac[ acn ] = m; pc = ( ( m & W36_MASK ) != 0 ) ? ( pc + 1 ) : pc; }
insn skipg  : encode #i36 ( op:9 = OP_SKIPG,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "skipg",  operands : acn, i, x, y )
    { #i36 m = %M[ @ea ( i, x, y ) ]; ac[ acn ] = m; pc = ( %S ( m ) > 0 ) ? ( pc + 1 ) : pc; }

// ---------------------------------------------------------------------------
// AOS -- add 1 to M[E], store back; if acn != 0 also load AC; skip on condition.
// The incremented value is tested for the skip, not the original M[E].
insn aos    : encode #i36 ( op:9 = OP_AOS,    ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aos",    operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] + 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }
insn aosl   : encode #i36 ( op:9 = OP_AOSL,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aosl",   operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] + 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = ( %S ( r ) < 0 ) ? ( pc + 1 ) : pc; }
insn aose   : encode #i36 ( op:9 = OP_AOSE,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aose",   operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] + 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = ( ( r & W36_MASK ) == 0 ) ? ( pc + 1 ) : pc; }
insn aosle  : encode #i36 ( op:9 = OP_AOSLE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aosle",  operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] + 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = ( %S ( r ) <= 0 ) ? ( pc + 1 ) : pc; }
insn aosa   : encode #i36 ( op:9 = OP_AOSA,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aosa",   operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] + 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = pc + 1; }
insn aosge  : encode #i36 ( op:9 = OP_AOSGE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aosge",  operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] + 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = ( %S ( r ) >= 0 ) ? ( pc + 1 ) : pc; }
insn aosn   : encode #i36 ( op:9 = OP_AOSN,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aosn",   operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] + 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = ( ( r & W36_MASK ) != 0 ) ? ( pc + 1 ) : pc; }
insn aosg   : encode #i36 ( op:9 = OP_AOSG,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aosg",   operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] + 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = ( %S ( r ) > 0 ) ? ( pc + 1 ) : pc; }

// ---------------------------------------------------------------------------
// SOS -- subtract 1 from M[E], store back; if acn != 0 also load AC; skip on condition.
insn sos    : encode #i36 ( op:9 = OP_SOS,    ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sos",    operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] - 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; }
insn sosl   : encode #i36 ( op:9 = OP_SOSL,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sosl",   operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] - 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = ( %S ( r ) < 0 ) ? ( pc + 1 ) : pc; }
insn sose   : encode #i36 ( op:9 = OP_SOSE,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sose",   operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] - 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = ( ( r & W36_MASK ) == 0 ) ? ( pc + 1 ) : pc; }
insn sosle  : encode #i36 ( op:9 = OP_SOSLE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sosle",  operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] - 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = ( %S ( r ) <= 0 ) ? ( pc + 1 ) : pc; }
insn sosa   : encode #i36 ( op:9 = OP_SOSA,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sosa",   operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] - 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = pc + 1; }
insn sosge  : encode #i36 ( op:9 = OP_SOSGE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sosge",  operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] - 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = ( %S ( r ) >= 0 ) ? ( pc + 1 ) : pc; }
insn sosn   : encode #i36 ( op:9 = OP_SOSN,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sosn",   operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] - 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = ( ( r & W36_MASK ) != 0 ) ? ( pc + 1 ) : pc; }
insn sosg   : encode #i36 ( op:9 = OP_SOSG,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sosg",   operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y ); #i36 r = ( %M[ e ] - 1 ) & W36_MASK; %M[ e ] = r; ac[ acn ] = r; pc = ( %S ( r ) > 0 ) ? ( pc + 1 ) : pc; }

// ===========================================================================
// AOBJP / AOBJN -- ADD ONE TO BOTH HALVES OF AC, JUMP (DEC PDP-10 Hardware Reference Manual,
// "Jump"; opcodes verified against SIMH pdp10_sys.c).
//
// Both instructions: add 1,,1 (i.e. 1 to the left half AND 1 to the right half of AC
// simultaneously, with NO carry between the halves).  Then:
//   AOBJP (0o252): jump to E if the result is NON-NEGATIVE (left half >= 0, i.e. bit 35 = 0).
//   AOBJN (0o253): jump to E if the result is NEGATIVE (left half < 0, i.e. bit 35 = 1).
//
// The add "1,,1" is: AC + 0o000001000001 = AC + (1 << 18) + 1.  The two halves each increment
// independently; per HRM, each half wraps within 18 bits (no inter-half carry).
// The sign of the result is the sign of the LEFT half (bit 35 of the 36-bit word).
//
// Opcodes: AOBJP=0o252, AOBJN=0o253 (per SIMH pdp10_sys.c, verified).
const OP_AOBJP = 0o252;
const OP_AOBJN = 0o253;

// ---------------------------------------------------------------------------
// AOBJP / AOBJN bodies.  Each half increments independently, modulo 2^18 (no inter-half carry).
// SIMH: AOB(x) = INCL(x) | INCR(x), where INCL adds 1 to the left half and INCR adds 1 to the
// right half, each wrapping at 18 bits.  A flat 36-bit add of 1,,1 would allow a carry from bit 17
// (top of right half) into bit 18 (bottom of left half) when the right half is 0o777777 -- wrong.
// Result sign = bit 35 (sign bit of the left half in the 36-bit word).

jump insn aobjp : type branch, encode #i36 ( op:9 = OP_AOBJP, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aobjp", operands : acn, i, x, y )
    {
        #i36 r = ( ( ( ( ac[ acn ] >> HW_LSHFT ) + 1 ) & HW_MASK ) << HW_LSHFT ) | ( ( ac[ acn ] + 1 ) & HW_MASK );
        ac[ acn ] = r;
        pc = ( ( r & SIGN_BIT36 ) == 0 ) ? @ea ( i, x, y ) : pc;   // jump if left half >= 0 (not negative)
    }
jump insn aobjn : type branch, encode #i36 ( op:9 = OP_AOBJN, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aobjn", operands : acn, i, x, y )
    {
        #i36 r = ( ( ( ( ac[ acn ] >> HW_LSHFT ) + 1 ) & HW_MASK ) << HW_LSHFT ) | ( ( ac[ acn ] + 1 ) & HW_MASK );
        ac[ acn ] = r;
        pc = ( ( r & SIGN_BIT36 ) != 0 ) ? @ea ( i, x, y ) : pc;   // jump if left half < 0 (negative)
    }

// ===========================================================================
// JFCL -- JUMP IF FLAG, CLEAR (DEC PDP-10 HRM "JFCL"; opcode 0o255, verified SIMH pdp10_cpu.c).
//
// The AC field is a 4-bit FLAG SELECTOR that selects a subset of the four hardware-testable
// flags (AROV, CRY0, CRY1, FOV -- bits 17..14 of pcflags = the top 4 bits within the 18-bit
// left-half register).  Each bit in AC corresponds to one flag:
//   AC bit 3 (=0x8) -> AROV  (pcflags bit 17 = PCF_AROV)
//   AC bit 2 (=0x4) -> CRY0  (pcflags bit 16 = PCF_CRY0)
//   AC bit 1 (=0x2) -> CRY1  (pcflags bit 15 = PCF_CRY1)
//   AC bit 0 (=0x1) -> FOV   (pcflags bit 14 = PCF_FOV)
//
// If ANY selected flag was set in pcflags at the time of execution: jump to E.
// Always clear the selected flags from pcflags (regardless of whether the jump is taken).
//
// The selector-to-pcflags mask: each AC bit selects a contiguous group of PCF_* bits.  The
// mapping is: AC[3]=AROV (PCF_AROV=0x20000), AC[2]=CRY0 (PCF_CRY0=0x10000), AC[1]=CRY1
// (PCF_CRY1=0x08000), AC[0]=FOV (PCF_FOV=0x04000).  The four flags occupy pcflags bits
// 17..14 -- i.e. the top 4 bits of the 18-bit pcflags are these flags in order.  So the
// selector mask in pcflags-space = acn << 14.
const JFCL_FLAG_SHIFT = 14;    // AC bit i selects pcflags bit (i + 14) for AC bits 3..0 -> pcflags 17..14

const OP_JFCL = 0o255;

// JFCL: AC=0 means "no flags selected" -> never jump (NOP form), still clears nothing.
jump insn jfcl : type branch, encode #i36 ( op:9 = OP_JFCL, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jfcl", operands : acn, i, x, y )
    {
        #i18 sel  = ( acn & 0xf ) << JFCL_FLAG_SHIFT;  // selected pcflags mask
        #i1  hit  = ( ( pcflags & sel ) != 0 ) ? 1 : 0;
        pcflags   = pcflags & ( ~sel );                  // clear selected flags unconditionally
        pc        = ( hit != 0 ) ? @ea ( i, x, y ) : pc;
    }

// ===========================================================================
// XCT -- EXECUTE (DEC PDP-10 HRM "XCT"; opcode 0o256, verified SIMH pdp10_cpu.c).
//
// XCT fetches the instruction word at M[E] and executes it AS IF it were the current
// instruction.  The AC field of XCT is ignored (conventionally 0).  Full execution
// of XCT requires re-invoking the decode/dispatch loop on M[E] -- a capability that
// depends on the execution engine (Task 18).  Here XCT is decoded as a stub; the
// instruction body is intentionally left empty (the address is available via @ea but
// the re-dispatch cannot be expressed in the UPCL body language yet).
//
// `type branch` (not trap) because XCT in principle just continues execution at the
// next sequential word after the XCT'd instruction; the CFG type tells the engine this
// is a control-flow point.  Task 18 will fill in the body.
const OP_XCT = 0o256;

jump insn xct : type branch, encode #i36 ( op:9 = OP_XCT, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "xct", operands : acn, i, x, y )
    { pc = pc; }   // NOTE: re-dispatch of M[@ea(i,x,y)] deferred to Task 18 -- body is a decode stub

// ===========================================================================
// MAP -- CHECK MAP (DEC PDP-10 HRM "MAP"; opcode 0o257, KL/KS extended addressing).
//
// MAP checks the memory map / page table for the EA and returns paging status in AC.
// This is a KL-only instruction in the pager extension.  It is decoded here as a
// stub; execution deferred to Task 18 / the memory-management subsystem.
const OP_MAP = 0o257;

insn map : encode #i36 ( op:9 = OP_MAP, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "map", operands : acn, i, x, y )
    => ;   // NOTE: pager result -> AC; deferred to Task 18 / KL pager support

// ===========================================================================
// STACK INSTRUCTIONS (DEC PDP-10 HRM "Stack"; opcodes verified SIMH pdp10_cpu.c).
//
// The PDP-10 stack pointer lives in an accumulator (AC).  The hardware convention is
// that BOTH HALVES of the AC encode stack state:
//   LEFT  HALF (bits 35..18) -- a DOWNWARD DECREMENTING COUNTER  (negated item count).
//     When the stack has N items, the left half = -N (ones-complement: ~N in 18 bits
//     = N XOR HW_MASK).  Incrementing the count means +1 to both halves simultaneously
//     (equivalently adding 1,,1 to the AC word, the same per-half-independent arithmetic
//     used by AOBJN).  An overflow check (left half wraps through 0 to positive) is a
//     stack overflow / PDL OV -- this trap is handled in execution (Task 18).
//   RIGHT HALF (bits 17..0)  -- the ADDRESS of the top-of-stack word (current top).
//
// PUSH: increment BOTH HALVES of AC independently (same per-half wrap as AOBJP/AOBJN --
//   no carry between halves), then store operand to M[right-half(AC)].
// POP:  load from M[right-half(AC)] into destination, THEN decrement both halves.
// PUSHJ: like PUSH, but the operand is the combined process-context word (PCW):
//   PCW = (pcflags << 18) | (pc + 1)   (flags in left half, return address in right half).
//   After pushing, pc = E.  `type call`.
// POPJ: pop the stacked PCW from the top of the stack, restore pc from its right half.
//   `type return`.
//
// The PER-HALF INCREMENT: identical to AOBJN's arithmetic (no inter-half carry):
//   new_AC = ( (((AC >> HW_LSHFT) + 1) & HW_MASK) << HW_LSHFT ) | ((AC + 1) & HW_MASK)
//
// Combined PCW assembly:
//   pcw = ( pcflags << HW_LSHFT ) | ( (pc + 1) & HW_MASK )     (for PUSHJ/JSP/JSR)
//
// Opcodes: PUSHJ=0o260, PUSH=0o261, POP=0o262, POPJ=0o263 (SIMH pdp10_sys.c verified).
const OP_PUSHJ = 0o260;
const OP_PUSH  = 0o261;
const OP_POP   = 0o262;
const OP_POPJ  = 0o263;

// Helper macro: increment both halves of a 36-bit AC word independently (no inter-half carry).
macro incboth ( v ) {
    result = ( ( ( ( v >> HW_LSHFT ) + 1 ) & HW_MASK ) << HW_LSHFT ) | ( ( v + 1 ) & HW_MASK );
}
// Helper macro: decrement both halves of a 36-bit AC word independently.
macro decboth ( v ) {
    result = ( ( ( ( v >> HW_LSHFT ) - 1 ) & HW_MASK ) << HW_LSHFT ) | ( ( v - 1 ) & HW_MASK );
}

// PUSH AC, E -- increment both halves of AC[acn], then M[right-half(AC)] <- M[E].
// The AC field is the stack-pointer register; the source is M[E].  Not a jump insn
// (no PC change), but shares the stack-pointer idiom with PUSHJ/POPJ.
insn push : encode #i36 ( op:9 = OP_PUSH, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "push", operands : acn, i, x, y )
    {
        #i36 sp  = @incboth ( ac[ acn ] );
        ac[ acn ] = sp;
        %M[ sp & HW_MASK ] = %M[ @ea ( i, x, y ) ];   // M[right-half(sp)] <- M[E]
    }

// POP AC, E -- load from M[right-half(AC)] to M[E] (and to AC[acn] if acn != 0), then
// decrement both halves.  The destination is M[E] (and optionally AC per HRM), then
// SP decrements.  Per SIMH pdp10_cpu.c `pop()`: src = M[rh(AC)], store to M[E] and to AC.
insn pop : encode #i36 ( op:9 = OP_POP, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "pop", operands : acn, i, x, y )
    {
        #i36 sp  = ac[ acn ];
        #i36 val = %M[ sp & HW_MASK ];                 // load from M[right-half(sp)]
        %M[ @ea ( i, x, y ) ] = val;                   // store to M[E]
        ac[ acn ] = @decboth ( sp );                   // decrement both halves
    }

// PUSHJ AC, E -- push the combined PCW (flags,,pc+1) onto the stack, then pc = E.
// The PCW carries pcflags in the left half and (pc+1) -- the return address -- in the right.
// `type call` because this is a subroutine call: it saves a return address.
jump insn pushj : type call, encode #i36 ( op:9 = OP_PUSHJ, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "pushj", operands : acn, i, x, y )
    {
        #i36 sp  = @incboth ( ac[ acn ] );
        ac[ acn ] = sp;
        #i36 pcw = ( ( pcflags & HW_MASK ) << HW_LSHFT ) | ( ( pc + 1 ) & HW_MASK );
        %M[ sp & HW_MASK ] = pcw;                      // push PCW onto stack
        pc = @ea ( i, x, y );                          // jump to E
    }

// POPJ AC, -- pop the stacked PCW and restore pc from its right half.  E is not used as a
// target; it conventionally encodes 0.  `type return` because this pops a saved return address.
jump insn popj : type return, encode #i36 ( op:9 = OP_POPJ, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "popj", operands : acn, i, x, y )
    {
        #i36 sp  = ac[ acn ];
        #i36 pcw = %M[ sp & HW_MASK ];                 // load PCW from top of stack
        ac[ acn ] = @decboth ( sp );                   // decrement both halves
        pc = pcw & HW_MASK;                            // restore pc from right half of PCW
        // NOTE: pcflags restore from left half of PCW deferred to Task 18
    }

// ===========================================================================
// JSR / JSP / JSA / JRA -- JUMP-AND-SAVE-CONTEXT (DEC PDP-10 HRM "JSR/JSP/JSA/JRA";
// opcodes verified SIMH pdp10_sys.c).
//
// All four save the combined PCW = (pcflags,,pc+1) somewhere and then jump; they differ
// in WHERE they save it and how the caller returns:
//
//   JSR  (0o264, AC ignored): store PCW at M[E], then pc = E+1.  Return: JRST/JRA at M[E].
//   JSP  (0o265): store PCW in AC[acn], then pc = E.  Return: JRST 2, or POPJ.
//   JSA  (0o266): store AC[acn] at M[E], save PCW in left half of (new) M[E], then
//                  pc = E+1.  (Full JSA semantics defer to Task 18; decode stub body.)
//   JRA  (0o267): restore AC[acn] from M[right-half(AC[acn])], then jump to E.
//                  (JRA is JSA's return instruction.  Deferred to Task 18; decode stub.)
//
const OP_JSR = 0o264;
const OP_JSP = 0o265;
const OP_JSA = 0o266;
const OP_JRA = 0o267;

// JSR E -- store PCW at M[E], then pc = E+1.  `type call`.
jump insn jsr : type call, encode #i36 ( op:9 = OP_JSR, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jsr", operands : i, x, y )
    {
        #i18 e   = @ea ( i, x, y );
        #i36 pcw = ( ( pcflags & HW_MASK ) << HW_LSHFT ) | ( ( pc + 1 ) & HW_MASK );
        %M[ e ] = pcw;                                  // store PCW at M[E]
        pc = ( e + 1 ) & HW_MASK;                      // pc = E+1
    }

// JSP AC, E -- store PCW in AC[acn], then pc = E.  `type call`.
jump insn jsp : type call, encode #i36 ( op:9 = OP_JSP, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jsp", operands : acn, i, x, y )
    {
        #i36 pcw = ( ( pcflags & HW_MASK ) << HW_LSHFT ) | ( ( pc + 1 ) & HW_MASK );
        ac[ acn ] = pcw;                                // save PCW in AC
        pc = @ea ( i, x, y );                          // jump to E
    }

// JSA AC, E -- JSA save-and-jump (DEC HRM).  The full semantics are complex (interlock
// with JRA via M[E]); decode-only stub here, Task 18 completes the body.  `type call`.
jump insn jsa : type call, encode #i36 ( op:9 = OP_JSA, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jsa", operands : acn, i, x, y )
    {
        #i18 e   = @ea ( i, x, y );
        #i36 pcw = ( ( pcflags & HW_MASK ) << HW_LSHFT ) | ( ( pc + 1 ) & HW_MASK );
        %M[ e ] = ( ( ac[ acn ] & HW_MASK ) << HW_LSHFT ) | ( pcw & HW_MASK );
        // NOTE: full JSA body (save AC old left half, link chain) deferred to Task 18
        pc = ( e + 1 ) & HW_MASK;
    }

// JRA AC, E -- JSA's return: restore AC[acn] from M[right-half(AC[acn])], then jump to E.
// Decode stub; Task 18 completes.  `type return`.
jump insn jra : type return, encode #i36 ( op:9 = OP_JRA, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jra", operands : acn, i, x, y )
    {
        #i36 link = %M[ ac[ acn ] & HW_MASK ];          // M[right-half(AC)] = saved AC
        ac[ acn ] = link;
        pc = @ea ( i, x, y );                          // NOTE: full JRA chain-follow deferred to Task 18
    }

// ===========================================================================
// JUMP{cond} -- JUMP ON CONDITION OF AC (DEC PDP-10 HRM "JUMP"; opcodes 0o320-0o327,
// verified SIMH pdp10_sys.c).
//
// Each instruction tests AC[acn] against zero using a signed comparison (`%S`), and jumps
// to E if the condition holds.  8 conditions, same ordering as CAI/CAM/SKIP:
//   +0 = never   (JUMP  -- no-op)       +1 = less  (JUMPL)
//   +2 = equal   (JUMPE)                +3 = less-or-equal (JUMPLE)
//   +4 = always  (JUMPA)                +5 = greater-or-equal (JUMPGE)
//   +6 = not-equal (JUMPN)              +7 = greater (JUMPG)
//
// Opcodes: base 0o320; low 3 bits = condition code.
const OP_JUMP   = 0o320;    // JUMP  base: jump never (no-op, but still a branch insn)
const OP_JUMPL  = 0o321;    // JUMPL  jump if AC < 0  (signed)
const OP_JUMPE  = 0o322;    // JUMPE  jump if AC == 0
const OP_JUMPLE = 0o323;    // JUMPLE jump if AC <= 0 (signed)
const OP_JUMPA  = 0o324;    // JUMPA  jump always
const OP_JUMPGE = 0o325;    // JUMPGE jump if AC >= 0 (signed)
const OP_JUMPN  = 0o326;    // JUMPN  jump if AC != 0
const OP_JUMPG  = 0o327;    // JUMPG  jump if AC > 0  (signed)

jump insn jump   : type branch, encode #i36 ( op:9 = OP_JUMP,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jump",   operands : acn, i, x, y )  { pc = pc; }  // never jump

jump insn jumpl  : type branch, encode #i36 ( op:9 = OP_JUMPL,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jumpl",  operands : acn, i, x, y )
    { pc = ( %S ( ac[ acn ] ) < 0 ) ? @ea ( i, x, y ) : pc; }

jump insn jumpe  : type branch, encode #i36 ( op:9 = OP_JUMPE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jumpe",  operands : acn, i, x, y )
    { pc = ( ( ac[ acn ] & W36_MASK ) == 0 ) ? @ea ( i, x, y ) : pc; }

jump insn jumple : type branch, encode #i36 ( op:9 = OP_JUMPLE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jumple", operands : acn, i, x, y )
    { pc = ( %S ( ac[ acn ] ) <= 0 ) ? @ea ( i, x, y ) : pc; }

jump insn jumpa  : type branch, encode #i36 ( op:9 = OP_JUMPA,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jumpa",  operands : acn, i, x, y )  { pc = @ea ( i, x, y ); }  // always jump

jump insn jumpge : type branch, encode #i36 ( op:9 = OP_JUMPGE, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jumpge", operands : acn, i, x, y )
    { pc = ( %S ( ac[ acn ] ) >= 0 ) ? @ea ( i, x, y ) : pc; }

jump insn jumpn  : type branch, encode #i36 ( op:9 = OP_JUMPN,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jumpn",  operands : acn, i, x, y )
    { pc = ( ( ac[ acn ] & W36_MASK ) != 0 ) ? @ea ( i, x, y ) : pc; }

jump insn jumpg  : type branch, encode #i36 ( op:9 = OP_JUMPG,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "jumpg",  operands : acn, i, x, y )
    { pc = ( %S ( ac[ acn ] ) > 0 ) ? @ea ( i, x, y ) : pc; }

// ===========================================================================
// AOJ{cond} -- ADD ONE TO AC, JUMP ON CONDITION (DEC PDP-10 HRM "AOJ"; opcodes 0o340-0o347,
// verified SIMH pdp10_sys.c).
//
// AOJ: AC <- (AC + 1) & W36_MASK, then test the INCREMENTED AC against zero and jump to E if
// the condition holds.  Same 8 condition codes as JUMP.  Overflow flag update (AROV) per HRM:
// the add_flags macro could be used but per SIMH aobjx() AOJ does NOT set flags -- it is
// purely an AC-increment + conditional jump.  (If needed Task 18 can add flag updates.)
//
// Opcodes: base 0o340; low 3 bits = condition.
const OP_AOJ    = 0o340;    // AOJ   add 1, jump never
const OP_AOJL   = 0o341;    // AOJL  add 1, jump if result < 0
const OP_AOJE   = 0o342;    // AOJE  add 1, jump if result == 0
const OP_AOJLE  = 0o343;    // AOJLE add 1, jump if result <= 0
const OP_AOJA   = 0o344;    // AOJA  add 1, jump always
const OP_AOJGE  = 0o345;    // AOJGE add 1, jump if result >= 0
const OP_AOJN   = 0o346;    // AOJN  add 1, jump if result != 0
const OP_AOJG   = 0o347;    // AOJG  add 1, jump if result > 0

jump insn aoj    : type branch, encode #i36 ( op:9 = OP_AOJ,    ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aoj",    operands : acn, i, x, y )
    { ac[ acn ] = ( ac[ acn ] + 1 ) & W36_MASK; pc = pc; }  // add 1, never jump

jump insn aojl   : type branch, encode #i36 ( op:9 = OP_AOJL,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aojl",   operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] + 1 ) & W36_MASK; ac[ acn ] = r; pc = ( %S ( r ) < 0 ) ? @ea ( i, x, y ) : pc; }

jump insn aoje   : type branch, encode #i36 ( op:9 = OP_AOJE,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aoje",   operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] + 1 ) & W36_MASK; ac[ acn ] = r; pc = ( ( r & W36_MASK ) == 0 ) ? @ea ( i, x, y ) : pc; }

jump insn aojle  : type branch, encode #i36 ( op:9 = OP_AOJLE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aojle",  operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] + 1 ) & W36_MASK; ac[ acn ] = r; pc = ( %S ( r ) <= 0 ) ? @ea ( i, x, y ) : pc; }

jump insn aoja   : type branch, encode #i36 ( op:9 = OP_AOJA,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aoja",   operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] + 1 ) & W36_MASK; ac[ acn ] = r; pc = @ea ( i, x, y ); }  // always jump

jump insn aojge  : type branch, encode #i36 ( op:9 = OP_AOJGE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aojge",  operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] + 1 ) & W36_MASK; ac[ acn ] = r; pc = ( %S ( r ) >= 0 ) ? @ea ( i, x, y ) : pc; }

jump insn aojn   : type branch, encode #i36 ( op:9 = OP_AOJN,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aojn",   operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] + 1 ) & W36_MASK; ac[ acn ] = r; pc = ( ( r & W36_MASK ) != 0 ) ? @ea ( i, x, y ) : pc; }

jump insn aojg   : type branch, encode #i36 ( op:9 = OP_AOJG,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "aojg",   operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] + 1 ) & W36_MASK; ac[ acn ] = r; pc = ( %S ( r ) > 0 ) ? @ea ( i, x, y ) : pc; }

// ===========================================================================
// SOJ{cond} -- SUBTRACT ONE FROM AC, JUMP ON CONDITION (DEC PDP-10 HRM "SOJ"; opcodes
// 0o360-0o367, verified SIMH pdp10_sys.c).
//
// SOJ: AC <- (AC - 1) & W36_MASK, then test the DECREMENTED AC against zero and jump to E
// if the condition holds.  Same 8 condition codes as JUMP/AOJ.  (Per SIMH soj() / pdp10_cpu.c,
// SOJ does not set arithmetic flags -- pure decrement + conditional jump.)
//
// Opcodes: base 0o360; low 3 bits = condition.
const OP_SOJ    = 0o360;    // SOJ   subtract 1, jump never
const OP_SOJL   = 0o361;    // SOJL  subtract 1, jump if result < 0
const OP_SOJE   = 0o362;    // SOJE  subtract 1, jump if result == 0
const OP_SOJLE  = 0o363;    // SOJLE subtract 1, jump if result <= 0
const OP_SOJA   = 0o364;    // SOJA  subtract 1, jump always
const OP_SOJGE  = 0o365;    // SOJGE subtract 1, jump if result >= 0
const OP_SOJN   = 0o366;    // SOJN  subtract 1, jump if result != 0
const OP_SOJG   = 0o367;    // SOJG  subtract 1, jump if result > 0

jump insn soj    : type branch, encode #i36 ( op:9 = OP_SOJ,    ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "soj",    operands : acn, i, x, y )
    { ac[ acn ] = ( ac[ acn ] - 1 ) & W36_MASK; pc = pc; }  // subtract 1, never jump

jump insn sojl   : type branch, encode #i36 ( op:9 = OP_SOJL,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sojl",   operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] - 1 ) & W36_MASK; ac[ acn ] = r; pc = ( %S ( r ) < 0 ) ? @ea ( i, x, y ) : pc; }

jump insn soje   : type branch, encode #i36 ( op:9 = OP_SOJE,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "soje",   operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] - 1 ) & W36_MASK; ac[ acn ] = r; pc = ( ( r & W36_MASK ) == 0 ) ? @ea ( i, x, y ) : pc; }

jump insn sojle  : type branch, encode #i36 ( op:9 = OP_SOJLE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sojle",  operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] - 1 ) & W36_MASK; ac[ acn ] = r; pc = ( %S ( r ) <= 0 ) ? @ea ( i, x, y ) : pc; }

jump insn soja   : type branch, encode #i36 ( op:9 = OP_SOJA,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "soja",   operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] - 1 ) & W36_MASK; ac[ acn ] = r; pc = @ea ( i, x, y ); }  // always jump

jump insn sojge  : type branch, encode #i36 ( op:9 = OP_SOJGE,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sojge",  operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] - 1 ) & W36_MASK; ac[ acn ] = r; pc = ( %S ( r ) >= 0 ) ? @ea ( i, x, y ) : pc; }

jump insn sojn   : type branch, encode #i36 ( op:9 = OP_SOJN,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sojn",   operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] - 1 ) & W36_MASK; ac[ acn ] = r; pc = ( ( r & W36_MASK ) != 0 ) ? @ea ( i, x, y ) : pc; }

jump insn sojg   : type branch, encode #i36 ( op:9 = OP_SOJG,   ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "sojg",   operands : acn, i, x, y )
    { #i36 r = ( ac[ acn ] - 1 ) & W36_MASK; ac[ acn ] = r; pc = ( %S ( r ) > 0 ) ? @ea ( i, x, y ) : pc; }

// ===========================================================================
// FEATURE `kl_insns` -- KL/KS integer extensions shared by the KL10 and KS10.
// The KA10 and KI10 do NOT support these instructions.
//
// Contains: ADJSP (adjust stack pointer).

const OP_ADJSP = 0o105;

feature kl_insns {

// ===========================================================================
// ADJSP -- ADJUST STACK POINTER (KL PDP-10; opcode 0o105, verified SIMH pdp10_cpu.c).
//
// ADJSP AC, E: the AC field is the stack pointer register.  The RIGHT HALF of AC is
// incremented by the SIGNED extension of E (18-bit signed offset: if bit 17 of E is
// set, it is treated as a negative offset, so ADJSP can grow or shrink the stack).
// The LEFT HALF is adjusted by the SAME signed amount (it is a DOWNWARD-decrementing
// counter of stack depth; adjusting by +n means we've logically pushed n words).
// Both adjustments are modulo 2^18 (per-half, no inter-half carry).
// Present on KL10 and KS10; absent on KA10/KI10/PDP-6.

insn adjsp : encode #i36 ( op:9 = OP_ADJSP, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "adjsp", operands : acn, i, x, y )
    {
        // Sign-extend the 18-bit Y to get a signed offset; both halves adjusted by the same amount.
        #i18 off  = @ea ( i, x, y );                    // 18-bit EA (x==0 typically, i==0)
        #i18 newl = ( ( ( ac[ acn ] >> HW_LSHFT ) & HW_MASK ) + off ) & HW_MASK;
        #i18 newr = ( ( ac[ acn ] & HW_MASK ) + off ) & HW_MASK;
        ac[ acn ] = ( newl << HW_LSHFT ) | newr;
    }

} // end feature kl_insns

// ===========================================================================
// BYTE INSTRUCTIONS (DEC PDP-10 Hardware Reference Manual, "Byte Manipulation";
// opcodes verified against SIMH pdp10_cpu.c and DEC PDP-10 HRM ch.2).
//
// Opcodes (octal): IBP/ADJBP=0o133, ILDB=0o134, LDB=0o135, IDPB=0o136, DPB=0o137.
// On KI/KA: 0o133 with AC=0 is IBP; on KL: 0o133 with AC!=0 is ADJBP.  Here AC is
// bound to `acn` from the instruction word; the IBP insn handles the AC=0 form; an
// ADJBP stub (Task 18) handles the KL AC!=0 form (not implemented here).
//
// BYTE-POINTER WORD FORMAT (DEC PDP-10 HRM, "Byte Pointers", ch.2):
// A byte pointer is one 36-bit word whose fields, in MSB-first bit numbering (bit 0 = MSB),
// are: P[0:5] S[6:11] 0[12] I[13] X[14:17] Y[18:35].  In our numeric representation
// (bit 35 = MSB), these map to:
//   P  = bits 35..30  (6 bits) = bp >> 30
//   S  = bits 29..24  (6 bits) = (bp >> 24) & 0x3f
//   reserved bit 23 (ignored)
//   I  = bit 22               = same position as the instruction I field
//   X  = bits 21..18 (4 bits) = same position as the instruction X field
//   Y  = bits 17..0  (18 bits) = same position as the instruction Y field
// The byte pointer's I/X/Y are IDENTICAL in position to an instruction word's I/X/Y, so
// the same @ea macro handles the SECOND-LEVEL address calculation (data word address).
//
// The instruction's own @ea(i,x,y) gives E = the ADDRESS of the byte-pointer word.
// The byte pointer word bp = %M[E].  Then:
//   bp_i = (bp >> EA_I_SHIFT) & 1        -- bp's indirect bit (bit 22)
//   bp_x = (bp >> EA_X_SHIFT) & EA_X_MASK  -- bp's index field (bits 21..18)
//   bp_y = bp & EA_Y_MASK                -- bp's address field (bits 17..0)
// And data_addr = @ea(bp_i, bp_x, bp_y) -- same EA macro, second level.
//
// SEMANTICS:
//   LDB AC, E:    bp = M[E].  byte = (M[data_addr] >> P) & ((1<<S)-1).  AC = byte.
//   DPB AC, E:    bp = M[E].  mask = ((1<<S)-1) << P.
//                 M[data_addr] = (M[data_addr] & ~mask) | ((AC << P) & mask).
//   IBP E:        bp = M[E].  P = P - S.  If P < 0: P = 36 - S, Y++.  M[E] = updated bp.
//                 (AC field of IBP is 0 on KI/KA; AC field ignored for pointer update.)
//   ILDB AC, E:   do IBP(E), then LDB AC, E (using the UPDATED byte pointer).
//   IDPB AC, E:   do IBP(E), then DPB AC, E (using the UPDATED byte pointer).
//
// NOTE -- P FIELD WIDTH AND SIGN: P and S are UNSIGNED 6-bit values extracted from the
// byte pointer.  "P < 0" in the IBP increment is checked as a signed comparison on the
// 6-bit value after subtraction, but since P and S are both <= 36 and the word is 36 bits,
// (P - S) is negative when it underflows.  We compute new_p = P - S as a signed value
// and check (new_p < 0) to detect the word-boundary wrap.  All P/S arithmetic is masked
// to 6 bits (& 0x3f) after adjustment.
//
// NOTE -- INDIRECT POINTER-ON-POINTER: This implementation applies @ea ONCE to the byte
// pointer's I/X/Y fields, handling one level of indirection.  If the byte pointer word
// itself has I=1, the chain executes (the @ea macro loops), yielding the data word address
// exactly as it does for instruction operands.  ADJBP (KL, AC!=0) is a Task-18 item.
//
// Byte-pointer field shift/mask constants.
const BP_P_SHIFT = 30;              // P field: bits 35..30 (top 6 bits of the 36-bit word)
const BP_S_SHIFT = 24;              // S field: bits 29..24
const BP_PS_MASK = 0x3f;            // 6-bit mask for P and S fields
const BP_WORD_BITS = 36;            // PDP-10 word size in bits (for IBP wrap: new P = 36 - S)

// @bpea(bp) -- extract the data-word effective address from a byte-pointer word.
// The byte pointer's I/X/Y occupy the SAME bit positions as an instruction word's I/X/Y,
// so we extract them with the existing EA_I_SHIFT / EA_X_SHIFT / EA_X_MASK / EA_Y_MASK
// constants and pass them through the @ea macro.
macro bpea ( bp ) {
    #i1  bpi = ( bp >> EA_I_SHIFT ) & 1;           // byte pointer's indirect bit (bit 22)
    #i4  bpx = ( bp >> EA_X_SHIFT ) & EA_X_MASK;  // byte pointer's index field   (bits 21..18)
    #i18 bpy = bp & EA_Y_MASK;                     // byte pointer's address field (bits 17..0)
    result = @ea ( bpi, bpx, bpy );
}

// @ibp_update(bp) -- apply the IBP increment to a byte-pointer word and return the updated word.
// P_new = P - S.  If P_new < 0 (underflow): P_new = 36 - S, Y_new = Y + 1.
// The updated word is assembled by patching only the P and Y fields (S, I, X unchanged).
macro ibp_update ( bp ) {
    #i6  bp_p   = ( bp >> BP_P_SHIFT ) & BP_PS_MASK;
    #i6  bp_s   = ( bp >> BP_S_SHIFT ) & BP_PS_MASK;
    #i18 bp_y   = bp & EA_Y_MASK;
    #i36 bp_mid = bp & ~( ( BP_PS_MASK << BP_P_SHIFT ) | EA_Y_MASK );  // zero P and Y fields
    // Compute new P (treat as signed to detect wrap)
    #i36 new_p  = ( ( bp_p & BP_PS_MASK ) - ( bp_s & BP_PS_MASK ) );   // may be negative
    #i6  fin_p  = ( ( %S ( new_p ) < 0 ) ? ( BP_WORD_BITS - bp_s ) : new_p ) & BP_PS_MASK;
    #i18 fin_y  = ( ( %S ( new_p ) < 0 ) ? ( ( bp_y + 1 ) & EA_Y_MASK ) : bp_y );
    result = bp_mid | ( fin_p << BP_P_SHIFT ) | fin_y;
}

// @byte_mask(s) -- compute the byte mask: (1 << S) - 1, masked to W36_MASK.
macro byte_mask ( s ) { result = ( ( 1 << s ) - 1 ) & W36_MASK; }

// Opcode constants for the byte family.
const OP_IBP  = 0o133;              // IBP  (AC=0) -- Increment Byte Pointer; ADJBP (AC!=0, KL)
const OP_ILDB = 0o134;              // ILDB -- Increment and Load Byte
const OP_LDB  = 0o135;              // LDB  -- Load Byte
const OP_IDPB = 0o136;              // IDPB -- Increment and Deposit Byte
const OP_DPB  = 0o137;              // DPB  -- Deposit Byte

// ---------------------------------------------------------------------------
// LDB AC, E -- Load Byte.
// Read the byte pointer at M[E], resolve the data-word address from its I/X/Y,
// extract S bits starting at bit P from the right of the data word, store in AC.
insn ldb : encode #i36 ( op:9 = OP_LDB, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "ldb", operands : acn, i, x, y )
    {
        #i36 bp      = %M[ @ea ( i, x, y ) ];          // fetch the byte pointer word
        #i6  bp_p    = ( bp >> BP_P_SHIFT ) & BP_PS_MASK;
        #i6  bp_s    = ( bp >> BP_S_SHIFT ) & BP_PS_MASK;
        #i36 dw      = %M[ @bpea ( bp ) ];             // fetch the data word
        ac[ acn ]    = ( dw >> bp_p ) & @byte_mask ( bp_s );
    }

// ---------------------------------------------------------------------------
// DPB AC, E -- Deposit Byte.
// Read the byte pointer at M[E], resolve the data-word address from its I/X/Y,
// deposit the low S bits of AC into the byte position of the data word.
insn dpb : encode #i36 ( op:9 = OP_DPB, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "dpb", operands : acn, i, x, y )
    {
        #i36 bp      = %M[ @ea ( i, x, y ) ];          // fetch the byte pointer word
        #i6  bp_p    = ( bp >> BP_P_SHIFT ) & BP_PS_MASK;
        #i6  bp_s    = ( bp >> BP_S_SHIFT ) & BP_PS_MASK;
        #i36 mask    = @byte_mask ( bp_s ) << bp_p;
        #i18 da      = @bpea ( bp );                   // data word address
        %M[ da ]     = ( ( %M[ da ] & ( ~mask & W36_MASK ) ) | ( ( ac[ acn ] << bp_p ) & mask ) ) & W36_MASK;
    }

// ---------------------------------------------------------------------------
// IBP E -- Increment Byte Pointer (AC=0 on KI/KA; KL AC!=0 = ADJBP, Task-18 item).
// Increment P by -S; if P underflows (P < 0 after subtract), set P = 36 - S and Y += 1.
// Write the updated byte pointer back to M[E].  The AC field is used here only to
// disambiguate from ADJBP (KL) on the fly; IBP is valid for all AC values on KI/KA,
// but the decode uses `acn` (bound to AC) and ignores it in the body.
insn ibp : encode #i36 ( op:9 = OP_IBP, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "ibp", operands : i, x, y )
    {
        #i18 ep      = @ea ( i, x, y );                // E = address of the byte pointer word
        #i36 bp      = %M[ ep ];                       // fetch the byte pointer
        %M[ ep ]     = @ibp_update ( bp );             // increment P (with Y++ wrap) and write back
    }

// ---------------------------------------------------------------------------
// ILDB AC, E -- Increment byte pointer, then Load Byte.
// First increment the pointer (IBP semantics on M[E]), then load the byte using
// the UPDATED pointer (same as LDB but with the fresh bp).
insn ildb : encode #i36 ( op:9 = OP_ILDB, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "ildb", operands : acn, i, x, y )
    {
        #i18 ep      = @ea ( i, x, y );                // E = address of the byte pointer word
        #i36 bp      = @ibp_update ( %M[ ep ] );       // increment P (with Y++ wrap)
        %M[ ep ]     = bp;                             // write updated pointer back
        #i6  bp_p    = ( bp >> BP_P_SHIFT ) & BP_PS_MASK;
        #i6  bp_s    = ( bp >> BP_S_SHIFT ) & BP_PS_MASK;
        ac[ acn ]    = ( %M[ @bpea ( bp ) ] >> bp_p ) & @byte_mask ( bp_s );
    }

// ---------------------------------------------------------------------------
// IDPB AC, E -- Increment byte pointer, then Deposit Byte.
// First increment the pointer (IBP semantics on M[E]), then deposit the byte using
// the UPDATED pointer (same as DPB but with the fresh bp).
insn idpb : encode #i36 ( op:9 = OP_IDPB, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "idpb", operands : acn, i, x, y )
    {
        #i18 ep      = @ea ( i, x, y );                // E = address of the byte pointer word
        #i36 bp      = @ibp_update ( %M[ ep ] );       // increment P (with Y++ wrap)
        %M[ ep ]     = bp;                             // write updated pointer back
        #i6  bp_p    = ( bp >> BP_P_SHIFT ) & BP_PS_MASK;
        #i6  bp_s    = ( bp >> BP_S_SHIFT ) & BP_PS_MASK;
        #i36 mask    = @byte_mask ( bp_s ) << bp_p;
        #i18 da      = @bpea ( bp );                   // data word address
        %M[ da ]     = ( ( %M[ da ] & ( ~mask & W36_MASK ) ) | ( ( ac[ acn ] << bp_p ) & mask ) ) & W36_MASK;
    }

// ===========================================================================
// FLOATING-POINT (DEC PDP-10 Hardware Reference Manual, "Floating-Point Arithmetic";
// opcodes verified against SIMH pdp10_cpu.c and DEC PDP-10 HRM ch.2 floating-point
// chapters; also verified against the nocrew.org PDP-10 reference pages).
//
// PDP-10 SINGLE-PRECISION FORMAT (36-bit word):
//   bit 35  = sign (MSB in our numeric representation; MSB-first bit 0 in DEC notation)
//   bits 34..27 = 8-bit exponent in EXCESS-128 (bias = 128); range 0..255 biases to -128..+127
//   bits 26..0  = 27-bit fraction: binary point is LEFT of bit 26 (the highest fraction bit);
//                 normalized: the high fraction bit is 1 for any non-zero value.
//   NEGATIVE: a NEGATIVE floating-point number is the TWO'S COMPLEMENT of the entire 36-bit
//   word (NOT sign-magnitude).  To operate on a negative value: negate the whole word first,
//   then extract exp/frac from the positive magnitude.
//
// PDP-10 DOUBLE-PRECISION FORMAT (72-bit, two consecutive 36-bit words):
//   High word: same layout as single (sign + exp8 + frac27).
//   Low word: extends the fraction to 62 bits (bits 35..1 of the low word are the extension;
//   bit 0 of the low word is always 0 in the canonical KL10/KI10 representation).
//   Together: 62-bit fraction, same sign + exp8 in the high word.
//
// HOST-DOUBLE APPROXIMATION (approved per task brief):
//   Exact PDP-10 rounding/normalization (FADR rounding mode, FXU underflow detection,
//   FDV two-pass normalizing divide) is documented as APPROXIMATE.  The @pdp10_to_host and
//   @host_to_pdp10 conversion macros implement the structural shape of the conversion
//   using integer ops + the engine's [ #f64 x ] int-to-float cast; exact 2^(exp-155)
//   scaling is an approximation deferred to Task-18 execution.
//
// OPCODE MAP (all verified against SIMH pdp10_sys.c opcode table):
//   FAD  = 0o140  FAD family: basic/L/M/B/R = +0..+4 (float add)
//   FSB  = 0o150  FSB family: basic/L/M/B/R = +0..+4 (float subtract)
//   FMP  = 0o160  FMP family: basic/L/M/B/R = +0..+4 (float multiply)
//   FDV  = 0o170  FDV family: basic/L/M/B/R = +0..+4 (float divide)
//   DFAD = 0o110  double-precision float add
//   DFSB = 0o111  double-precision float subtract
//   DFMP = 0o112  double-precision float multiply
//   DFDV = 0o113  double-precision float divide
//   UFA  = 0o130  unnormalized float add (legacy; KA/KI)
//   DFN  = 0o131  double float negate
//   FSC  = 0o132  float scale: AC = AC * 2^E (exponent adjust)
//   FIX  = 0o122  float to integer (truncate toward zero)
//   FIXR = 0o126  float to integer (round to nearest)
//   FLTR = 0o127  integer to float

// ---------------------------------------------------------------------------
// Floating-point opcode base constants (verified SIMH pdp10_sys.c).
const OP_FAD  = 0o140;          // FAD  family base: float add
const OP_FSB  = 0o150;          // FSB  family base: float subtract
const OP_FMP  = 0o160;          // FMP  family base: float multiply
const OP_FDV  = 0o170;          // FDV  family base: float divide
const OP_DFAD = 0o110;          // DFAD: double float add
const OP_DFSB = 0o111;          // DFSB: double float subtract
const OP_DFMP = 0o112;          // DFMP: double float multiply
const OP_DFDV = 0o113;          // DFDV: double float divide
const OP_UFA  = 0o130;          // UFA:  unnormalized float add (legacy)
const OP_DFN  = 0o131;          // DFN:  double float negate
const OP_FSC  = 0o132;          // FSC:  float scale (adjust exponent by E)
const OP_FIX  = 0o122;          // FIX:  float -> integer, truncate
const OP_FIXR = 0o126;          // FIXR: float -> integer, round
const OP_FLTR = 0o127;          // FLTR: integer -> float

// Per-mnemonic opcodes: FAD/FSB/FMP/FDV families each have 5 forms at +0..+4.
// +0 = basic (AC <- op(AC, M[E])), +1 = L (long: AC pair),
// +2 = M (to memory: M[E] <- op(AC,M[E])), +3 = B (both: M[E] and AC), +4 = R (rounded).
const OP_FADL = OP_FAD  + 1;   // FADL:  long (AC pair result)
const OP_FADM = OP_FAD  + 2;   // FADM:  to memory
const OP_FADB = OP_FAD  + 3;   // FADB:  to both (memory and AC)
const OP_FADR = OP_FAD  + 4;   // FADR:  rounded

const OP_FSBL = OP_FSB  + 1;   // FSBL:  long
const OP_FSBM = OP_FSB  + 2;   // FSBM:  to memory
const OP_FSBB = OP_FSB  + 3;   // FSBB:  to both
const OP_FSBR = OP_FSB  + 4;   // FSBR:  rounded

const OP_FMPL = OP_FMP  + 1;   // FMPL:  long
const OP_FMPM = OP_FMP  + 2;   // FMPM:  to memory
const OP_FMPB = OP_FMP  + 3;   // FMPB:  to both
const OP_FMPR = OP_FMP  + 4;   // FMPR:  rounded

const OP_FDVL = OP_FDV  + 1;   // FDVL:  long
const OP_FDVM = OP_FDV  + 2;   // FDVM:  to memory
const OP_FDVB = OP_FDV  + 3;   // FDVB:  to both
const OP_FDVR = OP_FDV  + 4;   // FDVR:  rounded

// ---------------------------------------------------------------------------
// PDP-10 float format field constants.
const FP_SIGN_SHIFT = 35;               // sign bit position (bit 35 = our MSB for 36-bit word)
const FP_EXP_SHIFT  = 27;               // exponent field low bit (bits 34..27)
const FP_EXP_MASK   = 0xff;             // 8-bit exponent mask
const FP_FRAC_MASK  = 0x7ffffff;        // 27-bit fraction mask (bits 26..0)
const FP_EXP_BIAS   = 128;              // excess-128 bias

// ---------------------------------------------------------------------------
// @pdp10_to_host ( w ) -- convert a PDP-10 single-precision word to a host double.
//
// PDP-10 float is sign + excess-128-exp8 + frac27 (normalized, binary point left of bit26).
// NEGATIVE numbers are the two's-complement of the ENTIRE 36-bit word.
// Conversion steps:
//   1. If sign bit (bit 35) is set, negate the whole word (2's complement) to get magnitude.
//   2. Extract exp8 (bits 34..27) and frac27 (bits 26..0).
//   3. Magnitude value = frac27 * 2^(exp8 - 128 - 27).
//   4. Apply sign.
// APPROXIMATE: 2^(exp8 - 155) scaling is best-effort (int-to-float conversion of the fraction;
// exact exponent scaling deferred to Task-18 execution, when full float semantics land).
macro pdp10_to_host ( w ) {
    // Step 1: two's-complement negate if negative to get the unsigned magnitude word.
    #i36 mw   = ( ( w & SIGN_BIT36 ) != 0 ) ? ( ( 0 - w ) & W36_MASK ) : ( w & W36_MASK );
    #i1  sgn  = ( ( w & SIGN_BIT36 ) != 0 ) ? 1 : 0;
    // Step 2: extract the 8-bit biased exponent and 27-bit fraction.
    #i8  exp8 = ( mw >> FP_EXP_SHIFT ) & FP_EXP_MASK;   // biased exponent (excess-128)
    #i36 frc  = mw & FP_FRAC_MASK;                        // 27-bit fraction
    // Step 3: convert fraction to host double; shift by (exp8 - 155) is an approximation here
    // (exact power-of-two scaling requires runtime floating-point exp2, deferred to Task 18).
    #f64 ff   = [ #f64 frc ];                              // integer frac -> host double
    // Step 4: apply sign.
    result    = ( sgn != 0 ) ? ( 0.0 - ff ) : ff;
}

// @host_to_pdp10 ( v ) -- convert a host double to a PDP-10 single-precision word (APPROXIMATE).
//
// Encode steps:
//   1. Determine sign; take absolute value.
//   2. Normalize: scale so 0.5 <= |v| < 1.0 and track the resulting power-of-two exponent.
//   3. Extract 27-bit fraction: frac27 = floor(|v_normalized| * 2^27).
//   4. Biased exponent: exp8 = exponent_offset + 128.
//   5. Pack: sign<<35 | exp8<<27 | frac27.
//   6. If negative: return two's complement of the packed word.
// APPROXIMATE: normalization loop is omitted; the conversion is structural only.
// Exact normalizing is deferred to Task-18 execution.
macro host_to_pdp10 ( v ) {
    // Determine sign and absolute value.
    #i1  sgn  = ( v < 0.0 ) ? 1 : 0;
    #f64 absv = ( v < 0.0 ) ? ( 0.0 - v ) : v;
    // Convert absolute value to an integer approximation (structural placeholder for fraction).
    // Full normalization (finding the binary exponent and 27-bit fraction) is Task-18 territory.
    #i36 frc  = [ #i36 absv ] & FP_FRAC_MASK;             // approximate fraction (truncation)
    #i8  exp8 = FP_EXP_BIAS;                               // placeholder exponent = 128 (no scaling)
    // Pack: (exp8 << FP_EXP_SHIFT) | frac27.
    #i36 pos  = ( ( exp8 & FP_EXP_MASK ) << FP_EXP_SHIFT ) | frc;
    // Apply sign via two's complement of the whole word if negative.
    result    = ( sgn != 0 ) ? ( ( 0 - pos ) & W36_MASK ) : pos;
}

// @pdp10d_to_host ( hi, lo ) -- convert a PDP-10 double-precision pair to a host double.
// The high word carries sign + exp8 + upper 27 frac bits; the low word carries the lower
// 35 fraction bits (bits 35..1; bit 0 is always 0 in the canonical representation).
// APPROXIMATE: uses the high word only (same as single-precision); full 62-bit fraction
// extension is deferred to Task-18 execution.
macro pdp10d_to_host ( hi, lo ) {
    result = @pdp10_to_host ( hi );   // APPROXIMATE: use high word; low word precision deferred
}

// @host_to_pdp10d ( v, acn ) -- store a host double into the AC pair as PDP-10 double.
// APPROXIMATE: high word only; low word set to 0 (fraction extension deferred to Task 18).
macro host_to_pdp10d ( v, acn ) {
    ac[ acn ]               = @host_to_pdp10 ( v );
    ac[ ( acn + 1 ) & 0xf ] = 0;   // low-word fraction extension -- APPROXIMATE (0)
}

// ---------------------------------------------------------------------------
// FEATURE `fp` -- all PDP-10 floating-point instructions.  The feature block is selected
// by any cpu model that includes an FPU (KA10/KI10/KL10/KS10 all support floating-point).

feature fp {

// ---------------------------------------------------------------------------
// FAD family (float add): op base 0o140.
//   FAD  (basic, +0)  AC <- AC + M[E]   (normalized)
//   FADL (long,   +1) AC pair <- AC + M[E] (double-length result; high in AC, ext in AC+1)
//   FADM (memory, +2) M[E] <- AC + M[E]
//   FADB (both,   +3) AC <- M[E] <- AC + M[E]
//   FADR (rounded,+4) AC <- round(AC + M[E])  (APPROXIMATE: same as FAD here)
// Semantics: @pdp10_to_host converts both operands; add as host doubles;
// @host_to_pdp10 converts the result back.
insn fad  : encode #i36 ( op:9 = OP_FAD,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fad",  operands : acn, i, x, y )
    { #f64 r = @pdp10_to_host ( ac[ acn ] ) + @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      ac[ acn ] = @host_to_pdp10 ( r ); }

insn fadl : encode #i36 ( op:9 = OP_FADL, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fadl", operands : acn, i, x, y )
    { #f64 r = @pdp10_to_host ( ac[ acn ] ) + @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      @host_to_pdp10d ( r, acn ); }

insn fadm : encode #i36 ( op:9 = OP_FADM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fadm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y );
      #f64 r = @pdp10_to_host ( ac[ acn ] ) + @pdp10_to_host ( %M[ e ] );
      %M[ e ] = @host_to_pdp10 ( r ); }

insn fadb : encode #i36 ( op:9 = OP_FADB, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fadb", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y );
      #f64 r = @pdp10_to_host ( ac[ acn ] ) + @pdp10_to_host ( %M[ e ] );
      #i36 p = @host_to_pdp10 ( r ); %M[ e ] = p; ac[ acn ] = p; }

// FADR: rounded add.  Rounding is APPROXIMATE (same as FAD here; exact FADR rounding
// per the HRM (round bit in bit 36 of 37-bit sum) is deferred to Task-18 execution).
insn fadr : encode #i36 ( op:9 = OP_FADR, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fadr", operands : acn, i, x, y )
    { #f64 r = @pdp10_to_host ( ac[ acn ] ) + @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      ac[ acn ] = @host_to_pdp10 ( r ); }  // APPROXIMATE: rounding not yet exact

// ---------------------------------------------------------------------------
// FSB family (float subtract): op base 0o150.
insn fsb  : encode #i36 ( op:9 = OP_FSB,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fsb",  operands : acn, i, x, y )
    { #f64 r = @pdp10_to_host ( ac[ acn ] ) - @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      ac[ acn ] = @host_to_pdp10 ( r ); }

insn fsbl : encode #i36 ( op:9 = OP_FSBL, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fsbl", operands : acn, i, x, y )
    { #f64 r = @pdp10_to_host ( ac[ acn ] ) - @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      @host_to_pdp10d ( r, acn ); }

insn fsbm : encode #i36 ( op:9 = OP_FSBM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fsbm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y );
      #f64 r = @pdp10_to_host ( ac[ acn ] ) - @pdp10_to_host ( %M[ e ] );
      %M[ e ] = @host_to_pdp10 ( r ); }

insn fsbb : encode #i36 ( op:9 = OP_FSBB, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fsbb", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y );
      #f64 r = @pdp10_to_host ( ac[ acn ] ) - @pdp10_to_host ( %M[ e ] );
      #i36 p = @host_to_pdp10 ( r ); %M[ e ] = p; ac[ acn ] = p; }

insn fsbr : encode #i36 ( op:9 = OP_FSBR, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fsbr", operands : acn, i, x, y )
    { #f64 r = @pdp10_to_host ( ac[ acn ] ) - @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      ac[ acn ] = @host_to_pdp10 ( r ); }  // APPROXIMATE: rounding not yet exact

// ---------------------------------------------------------------------------
// FMP family (float multiply): op base 0o160.
insn fmp  : encode #i36 ( op:9 = OP_FMP,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fmp",  operands : acn, i, x, y )
    { #f64 r = @pdp10_to_host ( ac[ acn ] ) * @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      ac[ acn ] = @host_to_pdp10 ( r ); }

insn fmpl : encode #i36 ( op:9 = OP_FMPL, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fmpl", operands : acn, i, x, y )
    { #f64 r = @pdp10_to_host ( ac[ acn ] ) * @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      @host_to_pdp10d ( r, acn ); }

insn fmpm : encode #i36 ( op:9 = OP_FMPM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fmpm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y );
      #f64 r = @pdp10_to_host ( ac[ acn ] ) * @pdp10_to_host ( %M[ e ] );
      %M[ e ] = @host_to_pdp10 ( r ); }

insn fmpb : encode #i36 ( op:9 = OP_FMPB, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fmpb", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y );
      #f64 r = @pdp10_to_host ( ac[ acn ] ) * @pdp10_to_host ( %M[ e ] );
      #i36 p = @host_to_pdp10 ( r ); %M[ e ] = p; ac[ acn ] = p; }

insn fmpr : encode #i36 ( op:9 = OP_FMPR, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fmpr", operands : acn, i, x, y )
    { #f64 r = @pdp10_to_host ( ac[ acn ] ) * @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      ac[ acn ] = @host_to_pdp10 ( r ); }  // APPROXIMATE: rounding not yet exact

// ---------------------------------------------------------------------------
// FDV family (float divide): op base 0o170.
// FDV semantics: the hardware actually normalizes the dividend to 2*AC before dividing
// (the so-called "FDV doubling" step required by PDP-10 FP divide); modelled as
// a plain divide here (APPROXIMATE; exact FDV semantics deferred to Task 18).
insn fdv  : encode #i36 ( op:9 = OP_FDV,  ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fdv",  operands : acn, i, x, y )
    { #f64 r = @pdp10_to_host ( ac[ acn ] ) / @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      ac[ acn ] = @host_to_pdp10 ( r ); }

insn fdvl : encode #i36 ( op:9 = OP_FDVL, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fdvl", operands : acn, i, x, y )
    { #f64 r = @pdp10_to_host ( ac[ acn ] ) / @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      @host_to_pdp10d ( r, acn ); }

insn fdvm : encode #i36 ( op:9 = OP_FDVM, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fdvm", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y );
      #f64 r = @pdp10_to_host ( ac[ acn ] ) / @pdp10_to_host ( %M[ e ] );
      %M[ e ] = @host_to_pdp10 ( r ); }

insn fdvb : encode #i36 ( op:9 = OP_FDVB, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fdvb", operands : acn, i, x, y )
    { #i18 e = @ea ( i, x, y );
      #f64 r = @pdp10_to_host ( ac[ acn ] ) / @pdp10_to_host ( %M[ e ] );
      #i36 p = @host_to_pdp10 ( r ); %M[ e ] = p; ac[ acn ] = p; }

insn fdvr : encode #i36 ( op:9 = OP_FDVR, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fdvr", operands : acn, i, x, y )
    { #f64 r = @pdp10_to_host ( ac[ acn ] ) / @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      ac[ acn ] = @host_to_pdp10 ( r ); }  // APPROXIMATE: rounding not yet exact

// ---------------------------------------------------------------------------
// DFAD / DFSB / DFMP / DFDV -- double-precision floating-point arithmetic (72-bit).
// Opcodes 0o110..0o113 (SIMH pdp10_sys.c).  Operand pair: M[E],,M[E+1] = double from memory;
// AC pair = double from registers.  Both use @pdp10d_to_host and @host_to_pdp10d.
// APPROXIMATE: high-word-only conversion (see @pdp10d_to_host comment above).
insn dfad : encode #i36 ( op:9 = OP_DFAD, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "dfad", operands : acn, i, x, y )
    { #i18 e   = @ea ( i, x, y );
      #f64 mhi = @pdp10d_to_host ( %M[ e ], %M[ ( e + 1 ) & EA_Y_MASK ] );
      #f64 r   = @pdp10d_to_host ( ac[ acn ], ac[ ( acn + 1 ) & 0xf ] ) + mhi;
      @host_to_pdp10d ( r, acn ); }

insn dfsb : encode #i36 ( op:9 = OP_DFSB, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "dfsb", operands : acn, i, x, y )
    { #i18 e   = @ea ( i, x, y );
      #f64 mhi = @pdp10d_to_host ( %M[ e ], %M[ ( e + 1 ) & EA_Y_MASK ] );
      #f64 r   = @pdp10d_to_host ( ac[ acn ], ac[ ( acn + 1 ) & 0xf ] ) - mhi;
      @host_to_pdp10d ( r, acn ); }

insn dfmp : encode #i36 ( op:9 = OP_DFMP, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "dfmp", operands : acn, i, x, y )
    { #i18 e   = @ea ( i, x, y );
      #f64 mhi = @pdp10d_to_host ( %M[ e ], %M[ ( e + 1 ) & EA_Y_MASK ] );
      #f64 r   = @pdp10d_to_host ( ac[ acn ], ac[ ( acn + 1 ) & 0xf ] ) * mhi;
      @host_to_pdp10d ( r, acn ); }

insn dfdv : encode #i36 ( op:9 = OP_DFDV, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "dfdv", operands : acn, i, x, y )
    { #i18 e   = @ea ( i, x, y );
      #f64 mhi = @pdp10d_to_host ( %M[ e ], %M[ ( e + 1 ) & EA_Y_MASK ] );
      #f64 r   = @pdp10d_to_host ( ac[ acn ], ac[ ( acn + 1 ) & 0xf ] ) / mhi;
      @host_to_pdp10d ( r, acn ); }

// ---------------------------------------------------------------------------
// UFA -- Unnormalized Float Add (legacy; KA10/KI10 only; opcode 0o130).
// Like FAD but the result is NOT normalized (the hardware leaves the result with the
// binary point wherever it falls, setting FOV on overflow).  Modelled as a plain FAD
// (APPROXIMATE; unnormalized semantics deferred to Task 18 execution).
insn ufa : encode #i36 ( op:9 = OP_UFA, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "ufa", operands : acn, i, x, y )
    { #f64 r = @pdp10_to_host ( ac[ acn ] ) + @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      ac[ acn ] = @host_to_pdp10 ( r ); }   // APPROXIMATE: unnormalized semantics deferred

// ---------------------------------------------------------------------------
// DFN -- Double Float Negate (opcode 0o131).
// Negates the double-precision value in the AC pair: negate the high word (two's complement
// of the 36-bit word), and negate the low word.  For the canonical 72-bit representation
// the full negation propagates from low to high; modelled here as per-word negation
// (APPROXIMATE; exact 72-bit carry propagation is deferred to Task 18 execution).
insn dfn : encode #i36 ( op:9 = OP_DFN, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "dfn", operands : acn, i, x, y )
    {
        ac[ acn ]               = ( 0 - ac[ acn ] ) & W36_MASK;
        ac[ ( acn + 1 ) & 0xf ] = ( 0 - ac[ ( acn + 1 ) & 0xf ] ) & W36_MASK;
    }

// ---------------------------------------------------------------------------
// FSC -- Float Scale (opcode 0o132).
// AC = AC * 2^(E as signed 18-bit).
// The E field (from @ea) is treated as a SIGNED 18-bit integer: if bit 17 is set, it is
// negative.  The exponent field of AC is adjusted by adding the signed E value; overflow
// (exponent > 255) sets FOV; underflow (exponent < 0) sets FXU and clears AC.
// APPROXIMATE: flag side-effects (FOV, FXU) are deferred to Task-18 execution.
insn fsc : encode #i36 ( op:9 = OP_FSC, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fsc", operands : acn, i, x, y )
    {
        #i18 scale = @ea ( i, x, y );                   // signed 18-bit scale via %S below
        // Extract current exponent from AC; adjust by scale; clamp and pack back.
        #i36 mw   = ( ( ac[ acn ] & SIGN_BIT36 ) != 0 ) ? ( ( 0 - ac[ acn ] ) & W36_MASK ) : ( ac[ acn ] & W36_MASK );
        #i8  exp8 = ( mw >> FP_EXP_SHIFT ) & FP_EXP_MASK;
        #i36 frc  = mw & FP_FRAC_MASK;
        #i36 newe = ( exp8 + %S ( scale ) ) & FP_EXP_MASK;  // APPROXIMATE: clamping deferred
        #i36 pos  = ( ( newe & FP_EXP_MASK ) << FP_EXP_SHIFT ) | frc;
        ac[ acn ] = ( ( ac[ acn ] & SIGN_BIT36 ) != 0 ) ? ( ( 0 - pos ) & W36_MASK ) : pos;
        // NOTE: FOV (overflow) and FXU (underflow) flag setting is APPROXIMATE / deferred.
    }

// ---------------------------------------------------------------------------
// FIX -- Float to Integer, truncate toward zero (opcode 0o122).
// AC = integer part of M[E] (PDP-10 float truncated toward zero), as a 36-bit signed integer.
// The hardware right-shifts the fraction by (36 - exp8 + FP_EXP_BIAS) positions to align
// the binary point, then truncates.  Modelled using host double truncation via [ #i36 f ].
// FXU (exponent underflow / value < 1) flag: set if exp8 <= 128 (i.e., |value| < 1.0).
// APPROXIMATE: FXU flag setting deferred to Task-18 execution.
insn fix : encode #i36 ( op:9 = OP_FIX, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fix", operands : acn, i, x, y )
    { #f64 f = @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      ac[ acn ] = [ #i36 f ] & W36_MASK; }  // truncate toward zero; FXU deferred

// ---------------------------------------------------------------------------
// FIXR -- Float to Integer, round to nearest (opcode 0o126).
// Same as FIX but rounds rather than truncates.  Approximated by adding 0.5 * sign before
// truncation; exact FIXR round-to-nearest behaviour (ties round away from zero) is
// APPROXIMATE and deferred to Task-18 execution.
insn fixr : encode #i36 ( op:9 = OP_FIXR, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fixr", operands : acn, i, x, y )
    { #f64 f  = @pdp10_to_host ( %M[ @ea ( i, x, y ) ] );
      #f64 fr = ( f < 0.0 ) ? ( f - 0.5 ) : ( f + 0.5 );   // round to nearest (APPROXIMATE)
      ac[ acn ] = [ #i36 fr ] & W36_MASK; }

// ---------------------------------------------------------------------------
// FLTR -- Integer to Float (opcode 0o127).
// AC = float representation of the 36-bit signed integer in M[E].
// The integer is sign-extended, converted to a host double, then packed to PDP-10 format.
// APPROXIMATE: exact normalization (setting exponent so the high fraction bit is 1)
// is deferred to Task-18 execution.
insn fltr : encode #i36 ( op:9 = OP_FLTR, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "fltr", operands : acn, i, x, y )
    { #f64 f  = [ #f64 %S ( %M[ @ea ( i, x, y ) ] ) ];   // signed integer -> host double
      ac[ acn ] = @host_to_pdp10 ( f ); }                  // pack as PDP-10 float (APPROXIMATE)

} // end feature fp

// ===========================================================================
// KL10 EXTENDED ADDRESSING  (DEC PDP-10 / DECSYSTEM-20 KL10 Hardware Reference,
// "Extended Addressing"; the nocrew.org PDP-10 "Address Computation" page; opcodes from the
// PDP-10 opcode chart at ultimate.com/phil/pdp10/opcodes.txt).  Gated under `feature extended`,
// selected by `cpu "kl10"`.  The original PDP-10 has a single 18-bit address space ("section 0");
// the KL10 Model B widened the virtual address to 30 bits = a 12-bit SECTION number plus an 18-bit
// in-section WORD offset, giving up to 4096 sections of 256 Kwords each.
//
// A "local" address is 18 bits (an offset within the current section).  A "global" address is 30
// bits: in our numeric (bit 35 = MSB / DEC bit 0) representation,
//   word offset = bits 17..0    (18 bits)   -- EA_Y_MASK
//   section     = bits 29..18   (12 bits)   -- SEC_SHIFT..
// i.e. a 30-bit global address is laid out exactly as the low 30 bits of a word, with the section
// number sitting just above the 18-bit offset.
//
// EFFECTIVE-ADDRESS CALCULATION IN A NON-ZERO SECTION.  An index register used as a GLOBAL index
// contributes its full low 30 bits (not just the right half), so indexing can carry the address
// across sections.  The instruction word's own I/X/Y are the same fields as in section 0; the
// difference is the INDIRECT WORD format, which is what the extended @ea_ext macro below dispatches
// on.  Two indirect-word formats exist, distinguished by the SIGN bit (DEC bit 0 = our bit 35):
//
//   IFIW -- Instruction Format Indirect Word (bit 35 = 1):  bit 35=1, then I=bit 22, X=bits 21..18,
//           Y=bits 17..0.  The I/X/Y sit in the SAME positions as an instruction word, so an IFIW
//           continues the chain LOCALLY (18-bit Y, right-half index) -- exactly the section-0 rule.
//   EFIW -- Extended Format Indirect Word (bit 35 = 0):  bit 35=0, I=bit 34, X=bits 33..30, and a
//           30-bit global address Y=bits 29..0.  An EFIW yields a full 30-bit global address; its
//           index (when X!=0) is a GLOBAL index (full 30 bits of AC[X]).
//
// The indirect chain therefore must, at EACH step, fetch the word and branch on its bit-35 format
// flag: an IFIW recomputes an 18-bit local E (the Task-6 rule), an EFIW recomputes a 30-bit global
// E.  This is expressed below WITHIN the same `while` / `?:` machinery the Task-6 @ea uses -- the
// dispatch is just a select on the fetched word's format bit; the engine needs no new construct.

// --- Extended-address field layout (numeric / bit-35-MSB representation). ---
const EA30_MASK    = 0x3fffffff;    // 30-bit global address mask (section:12 .. offset:18)
const SEC_SHIFT    = 18;            // section number occupies bits 29..18 (just above the offset)
const SEC_MASK     = 0xfff;         // 12-bit section number
const IFIW_FLAG    = 0x800000000;   // bit 35 -- set in an IFIW, clear in an EFIW (= SIGN_BIT36)
const EFIW_I_SHIFT = 34;            // EFIW indirect bit = DEC bit 1 = our bit 34
const EFIW_X_SHIFT = 30;            // EFIW index field  = DEC bits 2..5 = our bits 33..30
// (EFIW Y = bits 29..0 = the low 30 bits, masked with EA30_MASK.)

// @ea_ext ( i, x, y ) -- the KL10 EXTENDED effective-address calculation.  Returns a 30-bit global
// address E in `result`.  The first step mirrors the Task-6 @ea index step (local, 18-bit Y plus the
// right half of AC[X]); the indirect chain then dispatches on each fetched word's bit-35 format flag:
//   IFIW (bit35=1): take I=bit22, X=bits21..18, Y=bits17..0; recompute E LOCALLY (18-bit + right-half
//                   index), preserving the current section's high bits.
//   EFIW (bit35=0): take I=bit34, X=bits33..30, Y=bits29..0 (30-bit global); recompute E GLOBALLY
//                   (30-bit + the full low 30 bits of AC[X] when X!=0).
// As in Task 6 the chain is runtime-data-dependent (it iterates while the fetched word is indirect),
// so it lives in this body macro.  The loop-carried `e`, `ci` are SSA values (see the Task-6 note on
// loop-carried locals -- the single-level path is exact today; multi-iteration EXECUTION depends on
// loop-carried-local support).
macro ea_ext ( i, x, y ) {
    // Initial index step is local (the instruction word's Y is an 18-bit local offset; X is a local
    // index -- right half of AC[X]).  E starts as a 30-bit value (section bits initially 0).
    #i30 e  = ( x != 0 ) ? ( ( y + ( ac[ x ] & EA_Y_MASK ) ) & EA30_MASK ) : ( y & EA30_MASK );
    #i1  ci = i;
    while ( ci != 0 ) {
        #i36 w   = %M[ e & EA_Y_MASK ];                       // fetch the indirect word (in-section)
        #i1  efw = ( ( w & IFIW_FLAG ) == 0 ) ? 1 : 0;        // bit35=0 -> EFIW (1); bit35=1 -> IFIW (0)
        // EFIW fields (used when efw==1): 30-bit global Y, global index (full 30 bits of AC[X]).
        #i4  ex  = ( w >> EFIW_X_SHIFT ) & EA_X_MASK;
        #i30 ey  = w & EA30_MASK;
        #i30 ge  = ( ex != 0 ) ? ( ( ey + ( ac[ ex ] & EA30_MASK ) ) & EA30_MASK ) : ey;
        #i1  ei  = ( w >> EFIW_I_SHIFT ) & 1;
        // IFIW fields (used when efw==0): 18-bit local Y, right-half (local) index of AC[X].
        #i4  lx  = ( w >> EA_X_SHIFT ) & EA_X_MASK;
        #i18 ly  = w & EA_Y_MASK;
        #i30 le  = ( ( lx != 0 ) ? ( ( ly + ( ac[ lx ] & EA_Y_MASK ) ) & EA_Y_MASK ) : ly ) & EA30_MASK;
        #i1  li  = ( w >> EA_I_SHIFT ) & 1;
        // Dispatch on the format flag: EFIW -> global recompute, IFIW -> local recompute.
        e  = ( efw != 0 ) ? ge : le;
        ci = ( efw != 0 ) ? ei : li;
    }
    result = e;
}

// @gbpea ( bp ) -- extract the data-word address from a ONE-WORD GLOBAL byte pointer.  In a one-word
// global byte pointer the P (position) and S (size) fields keep their local positions (P=bits 35..30,
// S=bits 29..24), but the remaining bits address memory as a 30-bit GLOBAL address rather than via the
// I/X/Y instruction format.  Here we mask the low 30 bits as the global word address (the two-word
// byte pointer, whose second word is an EFIW, is a Task-18 execution item).
macro gbpea ( bp ) { result = bp & EA30_MASK; }

// Opcode constants for the extended instructions (declared outside the feature block, like every
// other `const` in this file).  XMOVEI shares SETMI's encoding (0o415) and XHLLI shares HLLI's
// (0o501); in a non-zero section those base encodings ARE the extended mnemonics.
const OP_XMOVEI = 0o415;            // = OP_SETMI; XMOVEI in a non-zero section
const OP_XHLLI  = 0o501;            // = HLLI;     XHLLI  in a non-zero section
const OP_EXTEND = 0o123;            // EXTEND -- string/decimal instruction prefix

// ---------------------------------------------------------------------------
// FEATURE `extended` -- KL10 extended-addressing instructions.  Selected by `cpu "kl10"` only
// (KL10 Model B -- 30-bit multi-section addressing); ABSENT on KA10/KI10/KS10/PDP-6.  The KS10
// is a Model A machine (single-section, 18-bit address space) and does NOT have extended addressing.
feature extended {

// XMOVEI AC, E  (opcode 0o415 = SETMI; in a non-zero section SETMI is XMOVEI).  Compute the EA as a
// 30-bit GLOBAL address and place it in AC (the extended counterpart of MOVEI / SETMI: "move
// extended immediate").  Encoded identically to the base-ISA SETMI; under [@kl10] (extended ON)
// this feature-gated definition WINS via `priority 1`, so 0o415 disassembles as XMOVEI; under
// [@ka10] / [@ki10] / [@ks10] (extended OFF) the same word is the base SETMI.
insn xmovei : encode #i36 ( op:9 = OP_XMOVEI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ) priority 1,
    disasm ( mnemonic : "xmovei", operands : acn, i, x, y )
    => ac[ acn ] = @ea_ext ( i, x, y );        // AC <- 30-bit global EA

// XHLLI AC, E  (opcode 0o501 = HLLI; in a non-zero section HLLI is XHLLI).  Set the LEFT half of AC
// to the SECTION number of the EA (bits 29..18 of the 30-bit global E), clearing the rest -- the
// extended "get my section" idiom.  Encoded identically to the base HLLI; priority-gated like XMOVEI.
insn xhlli : encode #i36 ( op:9 = OP_XHLLI, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ) priority 1,
    disasm ( mnemonic : "xhlli", operands : acn, i, x, y )
    => ac[ acn ] = @setleft ( ac[ acn ], ( @ea_ext ( i, x, y ) >> SEC_SHIFT ) & SEC_MASK );

// EXTEND AC, E  (opcode 0o123).  The string / decimal-conversion instruction PREFIX: the EA addresses
// an extended operation word (E0) whose own 9-bit op selects MOVSLJ / CMPSx / CVTDBx / EDIT / etc.
// Decoding the prefix and resolving its operand EA is done here; the sub-operation dispatch is a
// Task-18 execution item.  E is the 30-bit global address of the extended-op word.
insn extend : encode #i36 ( op:9 = OP_EXTEND, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "extend", operands : acn, i, x, y )
    {
        // Resolve the operand EA (30-bit global) and fetch E0, the sub-operation word.  The 9-bit op
        // in E0 selects the string/decimal operation (MOVSLJ / CMPSx / CVTDBx / EDIT / ...); that
        // dispatch -- and the per-operation AC0..AC3 string-pointer/length updates -- is a Task-18
        // execution item.  Here we resolve the EA and fetch E0 (the decode-stage work); the AC carries
        // the operation length/state across the (microcoded) operation and is left unchanged for now.
        #i30 e0    = @ea_ext ( i, x, y );       // 30-bit global address of the extended-op word E0
        #i36 subop = %M[ e0 & EA_Y_MASK ];      // fetch E0 (the sub-operation word) -- dispatch is Task 18
        ac[ acn ]  = ac[ acn ];                 // AC unchanged at decode stage (Task-18 updates it)
    }

} // end feature extended

// ---------------------------------------------------------------------------
// CPU variant lineage using `extends` inheritance.  Each `cpu` declaration computes its active
// feature set as the UNION of all extended cpus' features and its own body.  The PDP-6 (1964) is
// the 36-bit ancestor from which the PDP-10 family descends; the KA10 is the first PDP-10 proper.
//
// Feature set per model (via union of extends chain):
//   pdp6   {}                          -- base 36-bit user ISA; no hardware FP, no extended addressing
//   ka10   { fp }                      -- KA10 adds hardware floating-point (inherits nothing from pdp6)
//   ki10   { fp }                      -- KI10 inherits fp from ka10; paging is an implementation detail
//   kl10   { fp, extended, kl_insns }  -- KL10 inherits fp from ki10; 30-bit multi-section + KL integer ops
//   ks10   { fp, kl_insns }            -- KS10 / DECSYSTEM-2020: Model A, single-section; KL integer ops, no extended
//
// The `extended` feature gates the XMOVEI / XHLLI / EXTEND instructions (and the @ea_ext macro).
// Under [@ka10] / [@ki10] / [@ks10] / [@pdp6] the `extended` feature is ABSENT, so the SETMI
// encoding (0o415) disassembles as the base-ISA SETMI; under [@kl10] the feature-gated XMOVEI
// wins via its `priority 1` over SETMI.  The `fp` feature gates all floating-point instructions
// (FAD..DFAD).  The `kl_insns` feature gates KL/KS integer extensions (ADJSP) shared by the
// KL10 and KS10 but absent on KA10/KI10/PDP-6.
features {
    fp;
    extended;
    kl_insns;
}

cpu "pdp6" { }                                  // DEC PDP-6 (1964): 36-bit ancestor; base integer ISA
cpu "ka10" extends "pdp6" { fp; }               // DEC KA10: first PDP-10; inherits pdp6 base + hardware FP
cpu "ki10" extends "ka10" { }                   // DEC KI10: paging; inherits fp from ka10; no new features
cpu "kl10" extends "ki10" { extended; kl_insns; } // DEC KL10: 30-bit multi-section extended addressing + KL integer ops
cpu "ks10" extends "ki10" { kl_insns; }         // DEC KS10 / DECSYSTEM-2020: Model A, single-section; no extended
