    { #i36 mask = @mask_right ( @ea ( i, x, y ) ); #i36 t = ac[ acn ] & mask; ac[ acn ] = ( ac[ acn ] & ( ~mask ) ) & W36_MASK; pc = ( t != 0 ) ? ( pc + 1 ) : pc; }
insn tlzn : encode #i36 ( op:9 = OP_TLZN, ac:4 -> acn, i:1 -> i, x:4 -> x, y:18 -> y ),
    disasm ( mnemonic : "tlzn", operands : acn, i, x, y )
    { #i36 mask = @mask_left  ( @ea ( i, x, y ) ); #i36 t = ac[ acn ] & mask; ac[ acn ] = ( ac[ acn ] & ( ~mask ) ) & W36_MASK; pc = ( t != 0 ) ? ( pc + 1 ) : pc; }

