// Synthetic test for engine extension E5 -- MIDDLE-ENDIAN IMMEDIATE addrmode term.
//
// One addrmode `g ( x )` whose rule for selector value 1 yields a 4-byte MIDDLE-ENDIAN
// immediate (`x == 1 => #i32:me imm ;`). Middle-endian is the PDP-11 32-bit word order:
// the two 16-bit halves are big-endian-ordered, each half is little-endian internally --
// byte order 2-3-0-1.  For stream bytes b0 b1 b2 b3:
//   value = (b1 << 24) | (b0 << 16) | (b3 << 8) | b2
//
// Encoding (8-bit): op(4)=0, x(4) selects the addrmode.  Byte 0x01 selects x=1 (the
// immediate rule); the following FOUR bytes are the middle-endian immediate.  Stream:
//   01 12 34 56 78  =>  src = 0x34127856, instruction length = 5 bytes
//
// Derivation: b0=0x12, b1=0x34, b2=0x56, b3=0x78
//   value = (0x34 << 24) | (0x12 << 16) | (0x78 << 8) | 0x56  =  0x34127856
//
// For comparison, the same bytes little-endian would be 0x78563412 (wrong), and big-endian
// 0x12345678 (also wrong) -- the middle-endian result 0x34127856 proves neither path.

arch "targ" {

    name "E5 middle-endian immediate test";

    endian little;
    byte_size 8;
    word_size 32;
    address_size 32;

    register_file {
        group R {
            [ 8 ** #i32 r?:0 ]
        }
    }

}

addrmode g ( x ) {
    // `#i32:me` pins the immediate's byte order to middle-endian (PDP-11 word order).
    x == 0x01 => #i32:me imm ;
    x < 0x08  => #i32 reg [ r0, r1, r2, r3, r4, r5, r6, r7 ] ;
}

insn ld : encode #i8 ( op:4 = 0x0, x:4 -> src @g(x) ),
    disasm ( mnemonic : "ld", operands : src )
    { r0 = r0; }
