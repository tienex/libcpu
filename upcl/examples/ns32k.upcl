// National Semiconductor NS32000 (Series 32000) -- a clean, orthogonal 32-bit minicomputer
// architecture designed to scale from embedded controllers to multiprocessor systems. Eight
// general-purpose 32-bit registers R0..R7, byte/word/doubleword/quadword data widths, a
// uniform effective-address model with eight base addressing modes and a scaled-index
// extension byte (the "index byte") that can nest one level deep, variable-length big-endian
// encoded displacements (7/14/30-bit self-describing), and little-endian data storage.
//
// REGISTERS: R0..R7 (general purpose, 32-bit); dedicated registers PC (program counter),
// SP0/SP1 (supervisor/user stack pointers), SP (current stack pointer), FP (frame pointer),
// SB (static base), INTBASE (interrupt base), MOD (module register, 16-bit), CFG (config,
// 32-bit), and PSR (processor status register, 16-bit). Optional FPU (NS32081/NS32381) adds
// eight 64-bit floating-point registers F0..F7.
//
// PSR BIT LAYOUT (LSB to MSB, bit 0 first):
//   C(0)  carry                   T(1)  trace
//   L(2)  less-than (before SETCFG) / link  ·(3) reserved  ·(4) reserved
//   F(5)  floating-point trap     Z(6)  zero
//   N(7)  negative (sign)         U(8)  user mode
//   S(9)  stack-switched by trap  P(10) parity error
//   I(11) interrupt enable        bits 12-15 reserved
//
// This file is the UPCL `ns32k` architecture description. Phase 1 adds the arch header and
// register file (R0..R7, dedicated registers, PSR flag splitter binding %C/%Z/%N/%PC/%PSR).
// Later phases add addressing modes and instructions.

arch "ns32k" {

    name "National Semiconductor NS32000";

    endian little;
    byte_size 8;
    word_size 32;
    address_size 32;
    float_size 64;

    register_file {

        // R0..R7: eight general-purpose 32-bit registers. The `?` suffix plus the `8 **`
        // repeat generates r0..r7 and their positional group aliases R0..R7.
        group R {
            [ 8 ** #i32 r?:0 ]
        }

        // Dedicated (special-purpose) registers. SP0/SP1 are the supervisor/user stack
        // pointers; SP mirrors the active one; FP/SB/INTBASE/MOD/CFG are the NS32000
        // module and system registers. PC carries the %PC meta-role; PSR carries %PSR
        // and the flag splitter (MSB-first: reserved[15:12] I P S U N Z F reserved[4:3] L T C).
        group S {
            [ #i32 pc      -> %PC ],
            [ #i32 sp0 ], [ #i32 sp1 ], [ #i32 sp ],
            [ #i32 fp  ], [ #i32 sb  ], [ #i32 intbase ],
            [ #i16 mod ], [ #i32 cfg ],
            [ #i16 psr -> %PSR #i16 explicit
                ( #i4 0 : #i1 I : #i1 P : #i1 S : #i1 U
                : #i1 N -> %N : #i1 Z -> %Z : #i1 F : #i2 0 : #i1 L : #i1 T : #i1 C -> %C ) ]
        }

    }

}

// The `quick` field is the 4-bit signed immediate embedded in Format-2 instructions
// (ADDQ/CMPQ/MOVQ); it is sign-extended to the operand width in the bodies.
decoder_operands [
    #i4 quick                  // Format-2 4-bit signed quick immediate
];

// ---------------------------------------------------------------------------
// PSR bit masks. PSR bit layout (LSB first): C=0 T=1 L=2 F=5 Z=6 N=7 U=8 S=9 P=10 I=11.
// Each const is the one-hot mask for that bit within the 16-bit PSR register.
const PSR_C = 0x001;   // bit  0 -- carry
const PSR_T = 0x002;   // bit  1 -- trace
const PSR_L = 0x004;   // bit  2 -- less-than / link (UNSIGNED greater-than result of CMP)
const PSR_F = 0x020;   // bit  5 -- floating-point trap / flag (set by TBIT/SBIT/CBIT/IBIT)
const PSR_Z = 0x040;   // bit  6 -- zero
const PSR_N = 0x080;   // bit  7 -- negative / signed greater-than result of CMP
const PSR_U = 0x100;   // bit  8 -- user mode
const PSR_S = 0x200;   // bit  9 -- stack-switched by trap
const PSR_P = 0x400;   // bit 10 -- parity error
const PSR_I = 0x800;   // bit 11 -- interrupt enable

// ---------------------------------------------------------------------------
// Opcode seeds for Tasks 7-9 (data-movement / ALU / logical / shift / bit /
// bit-field / string / BCD / array).  Format byte constants:
const FMT6_BYTE = 0x4e;   // Format 6 selector byte (NEG/ABS/COM/NOT/ROT/ASH/LSH/BIT/BCD/...)
const FMT7_BYTE = 0xce;   // Format 7 selector byte (MUL/QUO/REM/DIV/MOD/DEI/MEI/MOVZ/MOVX/EXTS/INSS)
const FMT8_BYTE = 0x6e;   // Format 8-variant selector byte (FFS, CVTP)
const FMT5_BYTE = 0x0e;   // Format 5 selector byte (string instructions)

// Format 4 (16-bit) op4 codes (instruction group select field, 4 bits):
const OP4_ADD  = 0x0;   // ADD  -- addb/addw/addd
const OP4_CMP  = 0x1;   // CMP  -- cmpb/cmpw/cmpd (non-conventional flags)
const OP4_BIC  = 0x2;   // BIC  -- bicb/bicw/bicd (dst &~ src)
const OP4_CBIT = 0x2;   // CBIT -- cbitb/cbitw/cbitd (Format 6) -- shares value with BIC
const OP4_CBITI= 0x3;   // CBITI-- cbitib/cbitiw/cbitid (Format 6, interlocked)
const OP4_ADDC = 0x4;   // ADDC -- addcb/addcw/addcd (add with carry)
const OP4_MOV  = 0x5;   // MOV  -- movb/movw/movd (also MOVZBW in Fmt7)
const OP4_OR   = 0x6;   // OR   -- orb/orw/ord; also SBIT (Fmt6) -- shares value
const OP4_SBIT = 0x6;   // SBIT -- sbitb/sbitw/sbitd (Format 6)
const OP4_SBITI= 0x7;   // SBITI-- sbitib/sbitiw/sbitid (Format 6, interlocked)
const OP4_NEG  = 0x8;   // NEG  -- negb/negw/negd (Format 6); MUL (Format 7)
const OP4_MUL  = 0x8;   // MUL  -- mulb/mulw/muld (Format 7)
const OP4_ADDR = 0x9;   // ADDR -- addr (D form only); MEI (Format 7); NOT (Format 6)
const OP4_MEI  = 0x9;   // MEI  -- meib/meiw/meid (Format 7)
const OP4_NOT  = 0x9;   // NOT  -- notb/notw/notd (Format 6)
const OP4_AND  = 0xa;   // AND  -- andb/andw/andd
const OP4_DEI  = 0xb;   // DEI  -- deib/deiw/deid (Format 7); SUBP (Format 6)
const OP4_SUBP = 0xb;   // SUBP -- subpb/subpw/subpd (Format 6 BCD)
const OP4_ABS  = 0xc;   // ABS  -- absb/absw/absd (Format 6); QUO (Format 7)
const OP4_QUO  = 0xc;   // QUO  -- quob/quow/quod (Format 7)
const OP4_COM  = 0xd;   // COM  -- comb/comw/comd (Format 6); REM (Format 7); TBIT (Fmt4)
const OP4_TBIT = 0xd;   // TBIT -- tbitb/tbitw/tbitd (Format 4)
const OP4_REM  = 0xd;   // REM  -- remb/remw/remd (Format 7)
const OP4_IBIT = 0xe;   // IBIT -- ibitb/ibitw/ibitd (Format 6); MOD (Format 7)
const OP4_MOD  = 0xe;   // MOD  -- modb/modw/modd (Format 7)
const OP4_XOR  = 0xe;   // XOR  -- xorb/xorw/xord (Format 4) -- shares value with IBIT/MOD
const OP4_SUBC = 0xc;   // SUBC -- subcb/subcw/subcd (Format 4) -- shares value with ABS/QUO
const OP4_DIV  = 0xf;   // DIV  -- divb/divw/divd (Format 7); ADDP (Format 6)
const OP4_ADDP = 0xf;   // ADDP -- addpb/addpw/addpd (Format 6 BCD)
const OP4_SUB  = 0x8;   // SUB  -- subb/subw/subd (Format 4) -- shares value with NEG/MUL

// Format 2 op5 codes (5-bit field):
const OP5_ADDQ = 0x3;    // ADDQ -- addqb/addqw/addqd
const OP5_CMPQ = 0x7;    // CMPQ -- cmpqb/cmpqw/cmpqd (non-conventional flags)
const OP5_MOVQ = 0x17;   // MOVQ -- movqb/movqw/movqd

// Format 6 FFS/CVTP (fmt byte 0x6e) op4 codes:
const OP4_FFS  = 0x1;    // FFS  -- ffsb/ffsw/ffsd (Format 6, 0x6e)

// ---------------------------------------------------------------------------
// Symbolic constants for processor-control instructions (Task 11). Encodings
// derived verbatim from GNU binutils `include/opcode/ns32k.h` (ns32k_opcodes[])
// and `gas/config/tc-ns32k.c` (cpureg_032 / cpureg_532 tables).
//
// LPR/SPR (Format 2-style, 16-bit): gen:5 : reg4:4 : op5:5 : i:2
//   The size field `i` (bits[1:0]) is split from the 7-bit opcode to match UPCL's
//   per-field constant model: op5 = bits[6:2] of the 7-bit seed, i = bits[1:0].
//   lprb=0x6c lprw=0x6d lprd=0x6f -> op5 = 0x6c>>2 = 0x1b, i = {0,1,3}
//   sprb=0x2c sprw=0x2d sprd=0x2f -> op5 = 0x2c>>2 = 0x0b, i = {0,1,3}
const OP5_LPR = 0x1b;   // LPR 5-bit base opcode (bits[6:2] of the 7-bit seed)
const OP5_SPR = 0x0b;   // SPR 5-bit base opcode (bits[6:2] of the 7-bit seed)

// ADJSP (16-bit): gen:5 : op9:9 : i:2
//   adjspb=0x057c adjspw=0x057d adjspd=0x057f -> op9 = 0x57c>>2 = 0x15f, i = {0,1,3}
const OP9_ADJSP   = 0x15f;  // ADJSP 9-bit base opcode (bits[10:2] of the 11-bit seed)

// BISPSR / BICPSR (16-bit): gen:5 : op9:9 : i:2
//   bispsrb=0x37c bispsrw=0x37d -> op9 = 0x37c>>2 = 0xdf, i = {0,1}
//   bicpsrb=0x17c bicpsrw=0x17d -> op9 = 0x17c>>2 = 0x5f, i = {0,1}
const OP9_BISPSR  = 0xdf;   // BISPSR 9-bit base opcode (bits[10:2] of the 11-bit seed)
const OP9_BICPSR  = 0x5f;   // BICPSR 9-bit base opcode (bits[10:2] of the 11-bit seed)

// SETCFG (24-bit): gen(0):5 : opts:4 : op7:7 : fmt:8(=FMT5_BYTE)
//   setcfg=0x0b0e (seed with gen=0 and opts=0)
//   op7 occupies bits[14:8] of the 24-bit word (after removing fmt byte 0x0e).
const OP7_SETCFG  = 0x0b;   // SETCFG 7-bit opcode portion (bits[14:8] of the 24-bit word)

// LPR/SPR dedicated-register 4-bit selector values (from gas/config/tc-ns32k.c cpureg_032).
// cpureg_532 (NS32532/332/732) adds DCR/BPC/DSR/CAR(0-4), USP(0xb), CFG(0xc).
// The shared subset used for the decode-milestone:
const PREG_UPSR    = 0x0;   // 0x0 -- UPSR (user PSR, NS32032)
const PREG_FP      = 0x8;   // 0x8 -- FP  (frame pointer)
const PREG_SP      = 0x9;   // 0x9 -- SP  (stack pointer mirror)
const PREG_SB      = 0xa;   // 0xa -- SB  (static base)
const PREG_PSR     = 0xd;   // 0xd -- PSR (processor status register)
const PREG_INTBASE = 0xe;   // 0xe -- INTBASE (interrupt base address)
const PREG_MOD     = 0xf;   // 0xf -- MOD (module register)

// ---------------------------------------------------------------------------
// Symbolic constants for the control-transfer section (Task 10). Every magic number the
// Bcond table, the Format-1/2/3 opcode seeds, and the trap vectors would otherwise carry
// is named here, so the encodings read against their architectural meaning rather than
// raw hex. All values are taken verbatim from GNU binutils `include/opcode/ns32k.h`
// (the `ns32k_opcodes[]` table) cross-checked with `opcodes/ns32k-dis.c`.
//
// BCOND CONDITION CODES (Format 0: the high nibble of the opcode byte; the low nibble is
// always the Format-0 selector 0xA). From the ns32k_opcodes[] seeds beq=0x0a..buf=0xfa:
const COND_EQ = 0x0;   // beq -- Z == 1                         (equal)
const COND_NE = 0x1;   // bne -- Z == 0                         (not equal)
const COND_CS = 0x2;   // bcs -- C == 1                         (carry set / lower, unsigned <)
const COND_CC = 0x3;   // bcc -- C == 0                         (carry clear / hi-or-same, unsigned >=)
const COND_HI = 0x4;   // bhi -- L == 1                         (unsigned >; single-flag test)
const COND_LS = 0x5;   // bls -- L == 0                         (unsigned <=; single-flag test)
const COND_GT = 0x6;   // bgt -- N == 1                         (signed >; single-flag test)
const COND_LE = 0x7;   // ble -- N == 0                         (signed <=; single-flag test)
const COND_FS = 0x8;   // bfs -- F == 1                         (flag set)
const COND_FC = 0x9;   // bfc -- F == 0                         (flag clear)
const COND_LO = 0xA;   // blo -- (L == 0) && (Z == 0)           (unsigned <, "lower")
const COND_HS = 0xB;   // bhs -- (L == 1) || (Z == 1)           (unsigned >=, "higher-or-same")
const COND_LT = 0xC;   // blt -- (N == 0) && (Z == 0)           (signed <)
const COND_GE = 0xD;   // bge -- (N == 1) || (Z == 1)           (signed >=)
const COND_BR = 0xE;   // br  -- unconditional (cond 0xE = "always true")

// FORMAT 0 selector: the low nibble shared by every Bcond/BR opcode byte (0x_A).
const FMT0_SEL = 0xA;

// FORMAT 1 opcode bytes (one whole byte; `opcode_id_size = 8`). From the ns32k_opcodes[] seeds:
const OP_BSR     = 0x02;   // bsr     -- 1p   (PC-relative disp): push return PC, branch
const OP_RET     = 0x12;   // ret     -- 1d   (varlen disp): pop PC, pop `disp` arg bytes
const OP_CXP     = 0x22;   // cxp     -- 1p   external procedure call via the link table
const OP_RXP     = 0x32;   // rxp     -- 1d   return from external procedure
const OP_RETT    = 0x42;   // rett    -- 1d   return from trap
const OP_RETI    = 0x52;   // reti    -- ()   return from interrupt
const OP_SAVE    = 0x62;   // save    -- 1U   push the register list
const OP_RESTORE = 0x72;   // restore -- 1u   pop the register list
const OP_ENTER   = 0x82;   // enter   -- 1U2d push regs + allocate a local frame
const OP_EXIT    = 0x92;   // exit    -- 1u   restore frame + pop regs
const OP_NOP     = 0xA2;   // nop     -- ()   no operation
const OP_WAIT    = 0xB2;   // wait    -- ()   wait for interrupt
const OP_DIA     = 0xC2;   // dia     -- ()   diagnose (self-branch)
const OP_FLAG    = 0xD2;   // flag    -- ()   trap if PSR.F set
const OP_SVC     = 0xE2;   // svc     -- ()   supervisor call (trap)
const OP_BPT     = 0xF2;   // bpt     -- ()   breakpoint trap

// FORMAT 3 11-bit opcode seeds (base word = gen:5 (bits 15:11) : opcode11:11 (bits 10:0)).
// The low byte holds the Format-3 selector 111 in bits[2:0]; the `i` length is bits[1:0]
// above it (C=00 byte, D=01 word, F=11 dword); `op` is bits[10:7].
const OPC_JUMP  = 0x27f;   // jump  -- op=0x2, dword form
const OPC_JSR   = 0x67f;   // jsr   -- op=0x6, dword form
const OPC_CXPD  = 0x07f;   // cxpd  -- op=0x0, dword form
const OPC_CASEB = 0x77c;   // caseb -- op=0x7, byte table entries
const OPC_CASEW = 0x77d;   // casew -- op=0x7, word table entries
const OPC_CASED = 0x77f;   // cased -- op=0x7, dword table entries

// FORMAT 2 ACB (add-compare-and-branch). Base word = gen2:5 quick:4 op:5 i:2, then a
// PC-relative varlen disp follows. acbb=0x4c acbw=0x4d acbd=0x4f -> op5=0x13, i in {0,1,3}.
// op5 = 0b10011 is split into a 4-bit constant (OP_ACB_HI = 0b1001) and a 1-bit selector
// (the low bit = 1) so the low bit can carry the PC-relative disp addrmode while the
// `quick` field is left free to bind the immediate operand (see the ACB section).
const OP_ACB_HI  = 0x9;   // op[4:1] of the ACB opcode (0b1001)
const OP_ACB_SEL = 0x1;   // op[0]   of the ACB opcode (0b1) -- the disp-addrmode selector

// TRAP VECTORS (NS32000 interrupt/trap dispatch table indices, PRM sec. 3.8). SVC/FLAG/BPT
// take fixed vectors; the actual handler address is INTBASE + vector*4 at run time.
const TRAP_SVC  = 0x5;   // SVC  -- supervisor-call trap
const TRAP_FLG  = 0x7;   // FLAG -- flag (overflow-style) trap
const TRAP_BPT  = 0x8;   // BPT  -- breakpoint trap

// ---------------------------------------------------------------------------
// NS32000 general addressing mode (`gen`). The 5-bit gen field appears in most
// instruction formats; it is the single orthogonal EA selector covering all
// addressing modes for both source and destination operands.
//
// GEN-MODE TABLE (5-bit field value -> mode):
//   0x00..0x07   Register direct:   Rn  (n = g)
//   0x08..0x0F   Register relative: disp(Rn)  (n = g & 7; varlen disp)
//   0x10..0x12   Memory relative:   disp2(disp1(Rn))  (TWO varlen disps -- Task 6)
//   0x13         Reserved
//   0x14         Immediate:         value follows big-endian (width = operand width)
//   0x15         Absolute:          @disp  (one varlen disp = address)
//   0x16         External:          EXT(mod, disp)  (Task 6)
//   0x17         TOS:               Top-of-stack (Task 6)
//   0x18         FP relative:       disp(FP)
//   0x19         SP relative:       disp(SP)
//   0x1A         SB relative:       disp(SB)
//   0x1B         PC relative:       disp(PC)
//   0x1C..0x1F   Scaled index:      base[Rn:B/W/D/Q]; scale = 1<<(g&3), index byte consumed
//
// Sources: NS32000 Programmer's Reference Manual (National Semiconductor, 1984),
// binutils opcodes/ns32k-dis.c + include/opcode/ns32k.h + gas/config/tc-ns32k.c.
//
// THREE HARD MODES -- Task 6:
//   0x10..0x12  memory-relative: disp2(disp1(FP/SP/SB)).  EA = disp2 + mem[base + disp1]. Two
//               varlen displacements follow the opcode, consumed left-to-right from the tail.
//               Modelled as %M [ base + disp varlen + disp varlen ]; the engine accumulates both
//               offsets into Disp and advances TailUsed per displacement, so the decoder length
//               accounts for BOTH bytes. (The intermediate dereference -- mem[base+d1] -- is part
//               of the instruction-body semantics; the addrmode rule captures decode/length only.)
//   0x16        external EXT(disp1)+disp2: EA = disp2 + mem[mem[MOD+4] + disp1].  MOD register
//               holds the current module descriptor; offset +4 is the link-table base pointer
//               (NS32000 PRM sec. 2.2 / binutils ns32k-dis.c decode_operand EXT case). Two
//               varlen displacements follow; modelled as %M [ mod + disp varlen + disp varlen ].
//               The double dereference is instruction-body semantics; addrmode captures bytes.
//   0x17        TOS (top-of-stack): source = pop (read [sp], then sp += width); destination =
//               push (sp -= width, then write [sp]).  `gen`/`gen_w`/`gen_b` carry the SOURCE
//               (pop) form with post { sp += N }; mirror addrmodes `gen_dst`/`gen_dst_w`/
//               `gen_dst_b` carry the DESTINATION (push) form with pre { sp -= N }.
//
// The immediate rule (0x14) uses E5 fixed-width big-endian immediates: `#i32:be imm`
// (double), `#i16:be imm` (word), `#i8 imm` (byte) in the three width-pinned variants.
// The addrmode formal parameter `g` is bound positionally via E4 (`@gen(field)`), so a
// single addrmode definition serves multiple operand slots in two-operand instructions.
// ---------------------------------------------------------------------------

// `gen` -- double-width (32-bit) default. Used by most two-address instructions.
addrmode gen ( g ) {
    // Register direct: Rn where n = g (0..7).
    g < 0x08 => #i32 reg [ r0, r1, r2, r3, r4, r5, r6, r7 ] ;
    // Register relative: disp(Rn); eight rules, one per register, to avoid a g&7 expression.
    g == 0x08 => #i32 %M [ r0 + disp varlen ] ;
    g == 0x09 => #i32 %M [ r1 + disp varlen ] ;
    g == 0x0A => #i32 %M [ r2 + disp varlen ] ;
    g == 0x0B => #i32 %M [ r3 + disp varlen ] ;
    g == 0x0C => #i32 %M [ r4 + disp varlen ] ;
    g == 0x0D => #i32 %M [ r5 + disp varlen ] ;
    g == 0x0E => #i32 %M [ r6 + disp varlen ] ;
    g == 0x0F => #i32 %M [ r7 + disp varlen ] ;
    // Memory-relative: disp2(disp1(FP/SP/SB)).  EA = disp2 + mem[base + disp1].  Two varlen
    // displacements are consumed left-to-right; both appear in the decoded text and the length
    // accounts for both.  (The intermediate mem[] dereference is instruction-body semantics.)
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x10 => #i32 %M [ fp + disp varlen + disp varlen ] ;  // disp2(disp1(FP))
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x11 => #i32 %M [ sp + disp varlen + disp varlen ] ;  // disp2(disp1(SP))
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x12 => #i32 %M [ sb + disp varlen + disp varlen ] ;  // disp2(disp1(SB))
    // External: EXT(disp1)+disp2.  EA = disp2 + mem[mem[MOD+4] + disp1].  MOD+4 is the link-
    // table base pointer in the module descriptor (NS32000 PRM sec. 2.2).  Two varlen
    // displacements consumed left-to-right; double dereference is instruction-body semantics.
    // WARNING: real EA = disp2 + Mem32[Mem32[MOD+4] + disp1]; the +4 link-table offset and BOTH dereferences must be done in the instruction BODY -- this flat operand address is decode/length only.
    g == 0x16 => #i32 %M [ mod + disp varlen + disp varlen ] ;
    // TOS (top-of-stack) -- SOURCE (pop) form: read [SP] then SP += 4.  The matching DESTINATION
    // (push) form lives in gen_dst: SP -= 4 pre-decrement then write [SP].
    g == 0x17 => #i32 %M [ sp ] post { sp += 4; } ;
    // Immediate (src-only): fixed-width 32-bit big-endian value following the opcode byte (E5).
    g == 0x14 => #i32:be imm ;
    // Absolute: @disp -- one varlen displacement is the absolute address.
    g == 0x15 => #i32 %M [ disp varlen ] ;
    // FP/SP/SB/PC-relative: disp(FP/SP/SB/PC).
    g == 0x18 => #i32 %M [ fp + disp varlen ] ;
    g == 0x19 => #i32 %M [ sp + disp varlen ] ;
    g == 0x1A => #i32 %M [ sb + disp varlen ] ;
    g == 0x1B => #i32 %M [ pc + disp varlen ] ;
    // Scaled index: base[Rn:B/W/D/Q]. Consumes an index byte (basegen:5)(ireg:3),
    // recurses into @gen to resolve the base EA, then adds R[ireg] * scale.
    // Four rules for scale = 1/2/4/8 (g & 3 = 0/1/2/3).
    g == 0x1C => #i32 %M [ @gen[index] + %REG[R, ireg] * 1 ] ;
    g == 0x1D => #i32 %M [ @gen[index] + %REG[R, ireg] * 2 ] ;
    g == 0x1E => #i32 %M [ @gen[index] + %REG[R, ireg] * 4 ] ;
    g == 0x1F => #i32 %M [ @gen[index] + %REG[R, ireg] * 8 ] ;
}

// `gen_b` -- byte-width (8-bit) variant. Used by byte-operand instructions.
addrmode gen_b ( g ) {
    g < 0x08 => #i8 reg [ r0, r1, r2, r3, r4, r5, r6, r7 ] ;
    g == 0x08 => #i8 %M [ r0 + disp varlen ] ;
    g == 0x09 => #i8 %M [ r1 + disp varlen ] ;
    g == 0x0A => #i8 %M [ r2 + disp varlen ] ;
    g == 0x0B => #i8 %M [ r3 + disp varlen ] ;
    g == 0x0C => #i8 %M [ r4 + disp varlen ] ;
    g == 0x0D => #i8 %M [ r5 + disp varlen ] ;
    g == 0x0E => #i8 %M [ r6 + disp varlen ] ;
    g == 0x0F => #i8 %M [ r7 + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x10 => #i8 %M [ fp + disp varlen + disp varlen ] ;  // disp2(disp1(FP))
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x11 => #i8 %M [ sp + disp varlen + disp varlen ] ;  // disp2(disp1(SP))
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x12 => #i8 %M [ sb + disp varlen + disp varlen ] ;  // disp2(disp1(SB))
    // WARNING: real EA = disp2 + Mem32[Mem32[MOD+4] + disp1]; the +4 link-table offset and BOTH dereferences must be done in the instruction BODY -- this flat operand address is decode/length only.
    g == 0x16 => #i8 %M [ mod + disp varlen + disp varlen ] ;
    // TOS -- SOURCE (pop) form: read [SP] then SP += 1 (byte operand).
    g == 0x17 => #i8 %M [ sp ] post { sp += 1; } ;
    // Immediate (src-only): fixed-width 8-bit value following the opcode byte (E5).
    g == 0x14 => #i8 imm ;
    g == 0x15 => #i8 %M [ disp varlen ] ;
    g == 0x18 => #i8 %M [ fp + disp varlen ] ;
    g == 0x19 => #i8 %M [ sp + disp varlen ] ;
    g == 0x1A => #i8 %M [ sb + disp varlen ] ;
    g == 0x1B => #i8 %M [ pc + disp varlen ] ;
    g == 0x1C => #i8 %M [ @gen_b[index] + %REG[R, ireg] * 1 ] ;
    g == 0x1D => #i8 %M [ @gen_b[index] + %REG[R, ireg] * 2 ] ;
    g == 0x1E => #i8 %M [ @gen_b[index] + %REG[R, ireg] * 4 ] ;
    g == 0x1F => #i8 %M [ @gen_b[index] + %REG[R, ireg] * 8 ] ;
}

// `gen_w` -- word-width (16-bit) variant. Used by word-operand instructions.
addrmode gen_w ( g ) {
    g < 0x08 => #i16 reg [ r0, r1, r2, r3, r4, r5, r6, r7 ] ;
    g == 0x08 => #i16 %M [ r0 + disp varlen ] ;
    g == 0x09 => #i16 %M [ r1 + disp varlen ] ;
    g == 0x0A => #i16 %M [ r2 + disp varlen ] ;
    g == 0x0B => #i16 %M [ r3 + disp varlen ] ;
    g == 0x0C => #i16 %M [ r4 + disp varlen ] ;
    g == 0x0D => #i16 %M [ r5 + disp varlen ] ;
    g == 0x0E => #i16 %M [ r6 + disp varlen ] ;
    g == 0x0F => #i16 %M [ r7 + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x10 => #i16 %M [ fp + disp varlen + disp varlen ] ;  // disp2(disp1(FP))
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x11 => #i16 %M [ sp + disp varlen + disp varlen ] ;  // disp2(disp1(SP))
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x12 => #i16 %M [ sb + disp varlen + disp varlen ] ;  // disp2(disp1(SB))
    // WARNING: real EA = disp2 + Mem32[Mem32[MOD+4] + disp1]; the +4 link-table offset and BOTH dereferences must be done in the instruction BODY -- this flat operand address is decode/length only.
    g == 0x16 => #i16 %M [ mod + disp varlen + disp varlen ] ;
    // TOS -- SOURCE (pop) form: read [SP] then SP += 2 (word operand).
    g == 0x17 => #i16 %M [ sp ] post { sp += 2; } ;
    // Immediate (src-only): fixed-width 16-bit big-endian value following the opcode byte (E5).
    g == 0x14 => #i16:be imm ;
    g == 0x15 => #i16 %M [ disp varlen ] ;
    g == 0x18 => #i16 %M [ fp + disp varlen ] ;
    g == 0x19 => #i16 %M [ sp + disp varlen ] ;
    g == 0x1A => #i16 %M [ sb + disp varlen ] ;
    g == 0x1B => #i16 %M [ pc + disp varlen ] ;
    g == 0x1C => #i16 %M [ @gen_w[index] + %REG[R, ireg] * 1 ] ;
    g == 0x1D => #i16 %M [ @gen_w[index] + %REG[R, ireg] * 2 ] ;
    g == 0x1E => #i16 %M [ @gen_w[index] + %REG[R, ireg] * 4 ] ;
    g == 0x1F => #i16 %M [ @gen_w[index] + %REG[R, ireg] * 8 ] ;
}

// ---------------------------------------------------------------------------
// `gen_dst`, `gen_dst_w`, `gen_dst_b` -- DESTINATION (write) variants of gen/gen_w/gen_b.
// Identical to the source forms except for the TOS rule (0x17), which is a PUSH:
//   source TOS = pop:  %M [ sp ] post  { sp += N; }   (read [SP], then advance SP)
//   dest   TOS = push: pre { sp -= N; } %M [ sp ]     (decrement SP, then write [SP])
// All other rules are identical to the corresponding source addrmode.
// ---------------------------------------------------------------------------

// `gen_dst` -- double-width (32-bit) destination. Mirrors gen; TOS is a push.
addrmode gen_dst ( g ) {
    g < 0x08 => #i32 reg [ r0, r1, r2, r3, r4, r5, r6, r7 ] ;
    g == 0x08 => #i32 %M [ r0 + disp varlen ] ;
    g == 0x09 => #i32 %M [ r1 + disp varlen ] ;
    g == 0x0A => #i32 %M [ r2 + disp varlen ] ;
    g == 0x0B => #i32 %M [ r3 + disp varlen ] ;
    g == 0x0C => #i32 %M [ r4 + disp varlen ] ;
    g == 0x0D => #i32 %M [ r5 + disp varlen ] ;
    g == 0x0E => #i32 %M [ r6 + disp varlen ] ;
    g == 0x0F => #i32 %M [ r7 + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x10 => #i32 %M [ fp + disp varlen + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x11 => #i32 %M [ sp + disp varlen + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x12 => #i32 %M [ sb + disp varlen + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem32[Mem32[MOD+4] + disp1]; the +4 link-table offset and BOTH dereferences must be done in the instruction BODY -- this flat operand address is decode/length only.
    g == 0x16 => #i32 %M [ mod + disp varlen + disp varlen ] ;
    // TOS -- DESTINATION (push) form: SP -= 4, then write [SP].
    g == 0x17 => pre { sp -= 4; } #i32 %M [ sp ] ;
    // Immediate (0x14) is source-only in NS32000 -- you cannot write to a literal; omitted from gen_dst.
    g == 0x15 => #i32 %M [ disp varlen ] ;
    g == 0x18 => #i32 %M [ fp + disp varlen ] ;
    g == 0x19 => #i32 %M [ sp + disp varlen ] ;
    g == 0x1A => #i32 %M [ sb + disp varlen ] ;
    g == 0x1B => #i32 %M [ pc + disp varlen ] ;
    g == 0x1C => #i32 %M [ @gen_dst[index] + %REG[R, ireg] * 1 ] ;
    g == 0x1D => #i32 %M [ @gen_dst[index] + %REG[R, ireg] * 2 ] ;
    g == 0x1E => #i32 %M [ @gen_dst[index] + %REG[R, ireg] * 4 ] ;
    g == 0x1F => #i32 %M [ @gen_dst[index] + %REG[R, ireg] * 8 ] ;
}

// `gen_dst_b` -- byte-width (8-bit) destination.
addrmode gen_dst_b ( g ) {
    g < 0x08 => #i8 reg [ r0, r1, r2, r3, r4, r5, r6, r7 ] ;
    g == 0x08 => #i8 %M [ r0 + disp varlen ] ;
    g == 0x09 => #i8 %M [ r1 + disp varlen ] ;
    g == 0x0A => #i8 %M [ r2 + disp varlen ] ;
    g == 0x0B => #i8 %M [ r3 + disp varlen ] ;
    g == 0x0C => #i8 %M [ r4 + disp varlen ] ;
    g == 0x0D => #i8 %M [ r5 + disp varlen ] ;
    g == 0x0E => #i8 %M [ r6 + disp varlen ] ;
    g == 0x0F => #i8 %M [ r7 + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x10 => #i8 %M [ fp + disp varlen + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x11 => #i8 %M [ sp + disp varlen + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x12 => #i8 %M [ sb + disp varlen + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem32[Mem32[MOD+4] + disp1]; the +4 link-table offset and BOTH dereferences must be done in the instruction BODY -- this flat operand address is decode/length only.
    g == 0x16 => #i8 %M [ mod + disp varlen + disp varlen ] ;
    // TOS -- DESTINATION (push) form: SP -= 1, then write [SP].
    g == 0x17 => pre { sp -= 1; } #i8 %M [ sp ] ;
    // Immediate (0x14) is source-only in NS32000 -- you cannot write to a literal; omitted from gen_dst_b.
    g == 0x15 => #i8 %M [ disp varlen ] ;
    g == 0x18 => #i8 %M [ fp + disp varlen ] ;
    g == 0x19 => #i8 %M [ sp + disp varlen ] ;
    g == 0x1A => #i8 %M [ sb + disp varlen ] ;
    g == 0x1B => #i8 %M [ pc + disp varlen ] ;
    g == 0x1C => #i8 %M [ @gen_dst_b[index] + %REG[R, ireg] * 1 ] ;
    g == 0x1D => #i8 %M [ @gen_dst_b[index] + %REG[R, ireg] * 2 ] ;
    g == 0x1E => #i8 %M [ @gen_dst_b[index] + %REG[R, ireg] * 4 ] ;
    g == 0x1F => #i8 %M [ @gen_dst_b[index] + %REG[R, ireg] * 8 ] ;
}

// `gen_dst_w` -- word-width (16-bit) destination.
addrmode gen_dst_w ( g ) {
    g < 0x08 => #i16 reg [ r0, r1, r2, r3, r4, r5, r6, r7 ] ;
    g == 0x08 => #i16 %M [ r0 + disp varlen ] ;
    g == 0x09 => #i16 %M [ r1 + disp varlen ] ;
    g == 0x0A => #i16 %M [ r2 + disp varlen ] ;
    g == 0x0B => #i16 %M [ r3 + disp varlen ] ;
    g == 0x0C => #i16 %M [ r4 + disp varlen ] ;
    g == 0x0D => #i16 %M [ r5 + disp varlen ] ;
    g == 0x0E => #i16 %M [ r6 + disp varlen ] ;
    g == 0x0F => #i16 %M [ r7 + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x10 => #i16 %M [ fp + disp varlen + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x11 => #i16 %M [ sp + disp varlen + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem<width>[base + disp1]; the instruction BODY must do the inner load -- do NOT use this flat operand address directly.
    g == 0x12 => #i16 %M [ sb + disp varlen + disp varlen ] ;
    // WARNING: real EA = disp2 + Mem32[Mem32[MOD+4] + disp1]; the +4 link-table offset and BOTH dereferences must be done in the instruction BODY -- this flat operand address is decode/length only.
    g == 0x16 => #i16 %M [ mod + disp varlen + disp varlen ] ;
    // TOS -- DESTINATION (push) form: SP -= 2, then write [SP].
    g == 0x17 => pre { sp -= 2; } #i16 %M [ sp ] ;
    // Immediate (0x14) is source-only in NS32000 -- you cannot write to a literal; omitted from gen_dst_w.
    g == 0x15 => #i16 %M [ disp varlen ] ;
    g == 0x18 => #i16 %M [ fp + disp varlen ] ;
    g == 0x19 => #i16 %M [ sp + disp varlen ] ;
    g == 0x1A => #i16 %M [ sb + disp varlen ] ;
    g == 0x1B => #i16 %M [ pc + disp varlen ] ;
    g == 0x1C => #i16 %M [ @gen_dst_w[index] + %REG[R, ireg] * 1 ] ;
    g == 0x1D => #i16 %M [ @gen_dst_w[index] + %REG[R, ireg] * 2 ] ;
    g == 0x1E => #i16 %M [ @gen_dst_w[index] + %REG[R, ireg] * 4 ] ;
    g == 0x1F => #i16 %M [ @gen_dst_w[index] + %REG[R, ireg] * 8 ] ;
}

// ===========================================================================
// INTEGER DATA-MOVEMENT + ALU instructions (NS32000 Formats 2, 4, 6, 7).
//
// Encodings derived verbatim from GNU binutils `include/opcode/ns32k.h`
// (ns32k_opcodes[]) + `opcodes/ns32k-dis.c` (print_insn_ns32k / print_insn_arg).
// The instruction word is stored LITTLE-ENDIAN; the disassembler extracts each
// general operand from the TOP of the word: gen1 = bits[hi-5 .. hi-1] (the FIRST
// listed operand, the SOURCE), gen2 = the next 5 bits down (the DESTINATION). The
// 2-bit length field `i` (00 = byte, 01 = word, 11 = double) is the LOW two bits
// of the opcode seed and selects the operand width -> @gen_b/@gen_w/@gen (source)
// and @gen_dst_b/@gen_dst_w/@gen_dst (destination). Because UPCL `encode` lists
// fields MSB-first, every form below is written gen1 : gen2 : op : i (: fmt), which
// is exactly the binutils bit order.
//
//   Format 4  (16-bit word):  gen1:5  gen2:5  op:4  i:2          (two-operand ALU)
//   Format 2  (16-bit word):  gen2:5  quick:4 op:5  i:2          (quick immediate)
//   Format 6  (24-bit, 0x4e): gen1:5  gen2:5  op:4  i:2  fmt:8    (NEG/ABS/COM/NOT)
//   Format 7  (24-bit, 0xce): gen1:5  gen2:5  op:4  i:2  fmt:8    (MUL/DIV/.../MOVX/MOVZ)
//
// FLAG MODEL (NS32000 PSR, sec. 3.2 of the PRM):
//   - %CC(expr) records the conventional N/Z (and the engine's C/F) from a result.
//   - CMPi is NON-CONVENTIONAL: it sets Z = equal, N = SIGNED greater-than,
//     L = UNSIGNED greater-than (NOT sign/borrow). N and L are GREATER-THAN results.
//     The L flag is PSR bit 2; it has no %-meta-role, so it is written directly via a
//     read-modify-write of `psr` (bit mask 0x4).
// ===========================================================================

// ---------------------------------------------------------------------------
// Format 4 -- two-operand ALU/move. dst <op> src. op4 / per-width seeds (from the
// binutils seeds: addb=0x00 addw=0x01 addd=0x03 -> op=0x0, i in {00,01,11}; etc.).
// ---------------------------------------------------------------------------

// MOVi: dst = src (op4 = OP4_MOV; movb=0x14 movw=0x15 movd=0x17). N/Z from the value.
insn movb : encode #i16 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_MOV, i:2 = 0x0 ),
    disasm ( mnemonic : "movb", operands : src, dst )  => dst = %CC ( src );
insn movw : encode #i16 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_MOV, i:2 = 0x1 ),
    disasm ( mnemonic : "movw", operands : src, dst )  => dst = %CC ( src );
insn movd : encode #i16 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_MOV, i:2 = 0x3 ),
    disasm ( mnemonic : "movd", operands : src, dst )  => dst = %CC ( src );

// ADDi: dst = dst + src (op4 = OP4_ADD; addb=0x00 addw=0x01 addd=0x03).
insn addb : encode #i16 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_ADD, i:2 = 0x0 ),
    disasm ( mnemonic : "addb", operands : src, dst )  => dst = %CC ( dst + src );
insn addw : encode #i16 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_ADD, i:2 = 0x1 ),
    disasm ( mnemonic : "addw", operands : src, dst )  => dst = %CC ( dst + src );
insn addd : encode #i16 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_ADD, i:2 = 0x3 ),
    disasm ( mnemonic : "addd", operands : src, dst )  => dst = %CC ( dst + src );

// ADDCi: dst = dst + src + carry (op4 = OP4_ADDC; addcb=0x10 addcw=0x11 addcd=0x13).
insn addcb : encode #i16 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_ADDC, i:2 = 0x0 ),
    disasm ( mnemonic : "addcb", operands : src, dst )  => dst = %CC ( dst + src + %C );
insn addcw : encode #i16 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_ADDC, i:2 = 0x1 ),
    disasm ( mnemonic : "addcw", operands : src, dst )  => dst = %CC ( dst + src + %C );
insn addcd : encode #i16 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_ADDC, i:2 = 0x3 ),
    disasm ( mnemonic : "addcd", operands : src, dst )  => dst = %CC ( dst + src + %C );

// SUBi: dst = dst - src (op4 = OP4_SUB; subb=0x20 subw=0x21 subd=0x23).
insn subb : encode #i16 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_SUB, i:2 = 0x0 ),
    disasm ( mnemonic : "subb", operands : src, dst )  => dst = %CC ( dst - src );
insn subw : encode #i16 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_SUB, i:2 = 0x1 ),
    disasm ( mnemonic : "subw", operands : src, dst )  => dst = %CC ( dst - src );
insn subd : encode #i16 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_SUB, i:2 = 0x3 ),
    disasm ( mnemonic : "subd", operands : src, dst )  => dst = %CC ( dst - src );

// SUBCi: dst = dst - src - carry (op4 = OP4_SUBC; subcb=0x30 subcw=0x31 subcd=0x33).
insn subcb : encode #i16 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_SUBC, i:2 = 0x0 ),
    disasm ( mnemonic : "subcb", operands : src, dst )  => dst = %CC ( dst - src - %C );
insn subcw : encode #i16 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_SUBC, i:2 = 0x1 ),
    disasm ( mnemonic : "subcw", operands : src, dst )  => dst = %CC ( dst - src - %C );
insn subcd : encode #i16 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_SUBC, i:2 = 0x3 ),
    disasm ( mnemonic : "subcd", operands : src, dst )  => dst = %CC ( dst - src - %C );

// CMPi src1, src2 -- NON-CONVENTIONAL. Z = (src1 == src2); N = SIGNED greater-than;
// L (PSR bit 2) = UNSIGNED greater-than. (op4 = OP4_CMP; cmpb=0x04 cmpw=0x05 cmpd=0x07.)
// gen1 = src1 (first/source), gen2 = src2; neither is written.
insn cmpb : encode #i16 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_b(gen2), op:4 = OP4_CMP, i:2 = 0x0 ),
    disasm ( mnemonic : "cmpb", operands : src, dst )
    { %Z = ( src == dst ) ? 1 : 0; %N = ( %S ( src ) > %S ( dst ) ) ? 1 : 0;
      psr = ( psr &~ PSR_L ) | ( ( %U ( src ) > %U ( dst ) ) ? PSR_L : 0 ); }
insn cmpw : encode #i16 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_w(gen2), op:4 = OP4_CMP, i:2 = 0x1 ),
    disasm ( mnemonic : "cmpw", operands : src, dst )
    { %Z = ( src == dst ) ? 1 : 0; %N = ( %S ( src ) > %S ( dst ) ) ? 1 : 0;
      psr = ( psr &~ PSR_L ) | ( ( %U ( src ) > %U ( dst ) ) ? PSR_L : 0 ); }
insn cmpd : encode #i16 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen(gen2),   op:4 = OP4_CMP, i:2 = 0x3 ),
    disasm ( mnemonic : "cmpd", operands : src, dst )
    { %Z = ( src == dst ) ? 1 : 0; %N = ( %S ( src ) > %S ( dst ) ) ? 1 : 0;
      psr = ( psr &~ PSR_L ) | ( ( %U ( src ) > %U ( dst ) ) ? PSR_L : 0 ); }

// ADDR: dst = effective address of src (op4 = OP4_ADDR, D form only; addr=0x27). The SOURCE
// is an address-form operand (no immediate); @lea yields its EA, not its contents.
insn addr : encode #i16 ( gen1:5 -> src @gen(gen1), gen2:5 -> dst @gen_dst(gen2), op:4 = OP4_ADDR, i:2 = 0x3 ),
    disasm ( mnemonic : "addr", operands : src, dst )  => dst = @lea ( src );

// ---------------------------------------------------------------------------
// Format 2 -- quick (4-bit signed immediate). The quick value sits between the gen
// (destination) field and the opcode. op5 / per-width seeds: addq=0x0c/0d/0f -> op5=0x3,
// cmpq=0x1c/1d/1f -> op5=0x7, movq=0x5c/5d/5f -> op5=0x17.
// ---------------------------------------------------------------------------

// MOVQi: dst = sign-extended quick (op5 = OP5_MOVQ).
insn movqb : encode #i16 ( gen2:5 -> dst @gen_dst_b(gen2), quick:4 -> quick, op:5 = OP5_MOVQ, i:2 = 0x0 ),
    disasm ( mnemonic : "movqb", operands : quick, dst )  => dst = %CC ( #i8 %S ( quick ) );
insn movqw : encode #i16 ( gen2:5 -> dst @gen_dst_w(gen2), quick:4 -> quick, op:5 = OP5_MOVQ, i:2 = 0x1 ),
    disasm ( mnemonic : "movqw", operands : quick, dst )  => dst = %CC ( #i16 %S ( quick ) );
insn movqd : encode #i16 ( gen2:5 -> dst @gen_dst(gen2),   quick:4 -> quick, op:5 = OP5_MOVQ, i:2 = 0x3 ),
    disasm ( mnemonic : "movqd", operands : quick, dst )  => dst = %CC ( #i32 %S ( quick ) );

// ADDQi: dst = dst + sign-extended quick (op5 = OP5_ADDQ).
insn addqb : encode #i16 ( gen2:5 -> dst @gen_dst_b(gen2), quick:4 -> quick, op:5 = OP5_ADDQ, i:2 = 0x0 ),
    disasm ( mnemonic : "addqb", operands : quick, dst )  => dst = %CC ( dst + #i8 %S ( quick ) );
insn addqw : encode #i16 ( gen2:5 -> dst @gen_dst_w(gen2), quick:4 -> quick, op:5 = OP5_ADDQ, i:2 = 0x1 ),
    disasm ( mnemonic : "addqw", operands : quick, dst )  => dst = %CC ( dst + #i16 %S ( quick ) );
insn addqd : encode #i16 ( gen2:5 -> dst @gen_dst(gen2),   quick:4 -> quick, op:5 = OP5_ADDQ, i:2 = 0x3 ),
    disasm ( mnemonic : "addqd", operands : quick, dst )  => dst = %CC ( dst + #i32 %S ( quick ) );

// CMPQi: compare dst against sign-extended quick (op5 = OP5_CMPQ). NON-CONVENTIONAL flags,
// as CMPi: Z = equal, N = signed greater, L = unsigned greater. Here src1 = quick,
// src2 = dst (binutils operand order "2D1q": gen is operand 2, quick is operand 1).
insn cmpqb : encode #i16 ( gen2:5 -> dst @gen_b(gen2), quick:4 -> quick, op:5 = OP5_CMPQ, i:2 = 0x0 ),
    disasm ( mnemonic : "cmpqb", operands : quick, dst )
    { #i8 q = %S ( quick ); %Z = ( q == dst ) ? 1 : 0; %N = ( %S ( q ) > %S ( dst ) ) ? 1 : 0;
      psr = ( psr &~ PSR_L ) | ( ( %U ( q ) > %U ( dst ) ) ? PSR_L : 0 ); }
insn cmpqw : encode #i16 ( gen2:5 -> dst @gen_w(gen2), quick:4 -> quick, op:5 = OP5_CMPQ, i:2 = 0x1 ),
    disasm ( mnemonic : "cmpqw", operands : quick, dst )
    { #i16 q = %S ( quick ); %Z = ( q == dst ) ? 1 : 0; %N = ( %S ( q ) > %S ( dst ) ) ? 1 : 0;
      psr = ( psr &~ PSR_L ) | ( ( %U ( q ) > %U ( dst ) ) ? PSR_L : 0 ); }
insn cmpqd : encode #i16 ( gen2:5 -> dst @gen(gen2), quick:4 -> quick, op:5 = OP5_CMPQ, i:2 = 0x3 ),
    disasm ( mnemonic : "cmpqd", operands : quick, dst )
    { #i32 q = %S ( quick ); %Z = ( q == dst ) ? 1 : 0; %N = ( %S ( q ) > %S ( dst ) ) ? 1 : 0;
      psr = ( psr &~ PSR_L ) | ( ( %U ( q ) > %U ( dst ) ) ? PSR_L : 0 ); }

// ---------------------------------------------------------------------------
// Format 6 -- one-operand-style ALU (fmt byte 0x4e). NEG/ABS/COM/NOT. Two gen
// operands (src, dst), op4 from the seeds (negb=0x204e -> op4=0x8; absb=0x304e ->
// op4=0xc; comb=0x344e -> op4=0xd; notb=0x244e -> op4=0x9).
// ---------------------------------------------------------------------------

// NEGi: dst = -src (op4 = OP4_NEG).
insn negb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_NEG, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "negb", operands : src, dst )  => dst = %CC ( 0 - src );
insn negw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_NEG, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "negw", operands : src, dst )  => dst = %CC ( 0 - src );
insn negd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_NEG, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "negd", operands : src, dst )  => dst = %CC ( 0 - src );

// ABSi: dst = |src| (signed absolute value; op4 = OP4_ABS).
insn absb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_ABS, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "absb", operands : src, dst )  => dst = %CC ( ( %S ( src ) < 0 ) ? ( 0 - src ) : src );
insn absw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_ABS, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "absw", operands : src, dst )  => dst = %CC ( ( %S ( src ) < 0 ) ? ( 0 - src ) : src );
insn absd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_ABS, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "absd", operands : src, dst )  => dst = %CC ( ( %S ( src ) < 0 ) ? ( 0 - src ) : src );

// ---------------------------------------------------------------------------
// Format 7 -- extended ALU (fmt byte 0xce). MUL/QUO/REM/DIV/MOD + DEI/MEI + MOVZ/MOVX.
// op4 from the seeds (mulb=0x20ce -> op4=0x8; quob=0x30ce -> 0xc; remb=0x34ce -> 0xd;
// divb=0x3cce -> 0xf; modb=0x38ce -> 0xe; deib=0x2cce -> 0xb; meib=0x24ce -> 0x9).
// ---------------------------------------------------------------------------

// MULi: dst = dst * src (op4 = OP4_MUL).
insn mulb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_MUL, i:2 = 0x0, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "mulb", operands : src, dst )  => dst = %CC ( dst * src );
insn mulw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_MUL, i:2 = 0x1, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "mulw", operands : src, dst )  => dst = %CC ( dst * src );
insn muld : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_MUL, i:2 = 0x3, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "muld", operands : src, dst )  => dst = %CC ( dst * src );

// QUOi: dst = dst / src, signed, truncated toward zero (op4 = OP4_QUO).
insn quob : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_QUO, i:2 = 0x0, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "quob", operands : src, dst )  => dst = %CC ( %S ( dst ) / %S ( src ) );
insn quow : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_QUO, i:2 = 0x1, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "quow", operands : src, dst )  => dst = %CC ( %S ( dst ) / %S ( src ) );
insn quod : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_QUO, i:2 = 0x3, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "quod", operands : src, dst )  => dst = %CC ( %S ( dst ) / %S ( src ) );

// REMi: dst = dst % src (remainder of the QUO truncated division; op4 = OP4_REM).
insn remb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_REM, i:2 = 0x0, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "remb", operands : src, dst )  => dst = %CC ( %S ( dst ) % %S ( src ) );
insn remw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_REM, i:2 = 0x1, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "remw", operands : src, dst )  => dst = %CC ( %S ( dst ) % %S ( src ) );
insn remd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_REM, i:2 = 0x3, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "remd", operands : src, dst )  => dst = %CC ( %S ( dst ) % %S ( src ) );

// DIVi: dst = dst / src, signed, FLOORED toward negative infinity (op4 = OP4_DIV). The
// NS32000 DIV rounds toward -inf (unlike QUO which truncates toward zero).
insn divb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_DIV, i:2 = 0x0, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "divb", operands : src, dst )
    { #i8 n = dst; #i8 d = src; #i8 q = %S ( n ) / %S ( d ); #i8 r = %S ( n ) % %S ( d );
      dst = %CC ( ( ( r != 0 ) && ( ( %S ( r ) < 0 ) != ( %S ( d ) < 0 ) ) ) ? ( q - 1 ) : q ); }
insn divw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_DIV, i:2 = 0x1, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "divw", operands : src, dst )
    { #i16 n = dst; #i16 d = src; #i16 q = %S ( n ) / %S ( d ); #i16 r = %S ( n ) % %S ( d );
      dst = %CC ( ( ( r != 0 ) && ( ( %S ( r ) < 0 ) != ( %S ( d ) < 0 ) ) ) ? ( q - 1 ) : q ); }
insn divd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_DIV, i:2 = 0x3, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "divd", operands : src, dst )
    { #i32 n = dst; #i32 d = src; #i32 q = %S ( n ) / %S ( d ); #i32 r = %S ( n ) % %S ( d );
      dst = %CC ( ( ( r != 0 ) && ( ( %S ( r ) < 0 ) != ( %S ( d ) < 0 ) ) ) ? ( q - 1 ) : q ); }

// MODi: dst = dst MOD src -- the modulus matching DIV's floored division, so the
// remainder takes the SIGN OF THE DIVISOR (op4 = OP4_MOD).
insn modb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_MOD, i:2 = 0x0, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "modb", operands : src, dst )
    { #i8 r = %S ( dst ) % %S ( src );
      dst = %CC ( ( ( r != 0 ) && ( ( %S ( r ) < 0 ) != ( %S ( src ) < 0 ) ) ) ? ( r + src ) : r ); }
insn modw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_MOD, i:2 = 0x1, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "modw", operands : src, dst )
    { #i16 r = %S ( dst ) % %S ( src );
      dst = %CC ( ( ( r != 0 ) && ( ( %S ( r ) < 0 ) != ( %S ( src ) < 0 ) ) ) ? ( r + src ) : r ); }
insn modd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_MOD, i:2 = 0x3, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "modd", operands : src, dst )
    { #i32 r = %S ( dst ) % %S ( src );
      dst = %CC ( ( ( r != 0 ) && ( ( %S ( r ) < 0 ) != ( %S ( src ) < 0 ) ) ) ? ( r + src ) : r ); }

// DEIi -- extended (unsigned) DIVIDE: the double-width dividend held in the register
// PAIR { dst, dst+1 } (low half in dst, high half in dst|1) is divided by src; the
// quotient goes to dst|1 and the remainder to dst (op4 = 0xb). Modelled for the
// register-direct dst form (the only form that names a usable pair); `dst` is the
// register the gen mode selected. (NS32000 PRM sec. 4: DEI is UNSIGNED.)
insn deib : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_DEI, i:2 = 0x0, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "deib", operands : src, dst )
    { #i16 num = ( ( %REG[ R, gen2 | 1 ] & 0xff ) << 8 ) | ( dst & 0xff ); #i16 d = src & 0xff;
      dst = num % d; %REG[ R, gen2 | 1 ] = num / d; }
insn deiw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_DEI, i:2 = 0x1, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "deiw", operands : src, dst )
    { #i32 num = ( ( %REG[ R, gen2 | 1 ] & 0xffff ) << 16 ) | ( dst & 0xffff ); #i32 d = src & 0xffff;
      dst = num % d; %REG[ R, gen2 | 1 ] = num / d; }
insn deid : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_DEI, i:2 = 0x3, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "deid", operands : src, dst )
    { #i64 num = ( ( %REG[ R, gen2 | 1 ] & 0xffffffff ) << 32 ) | ( dst & 0xffffffff ); #i64 d = src & 0xffffffff;
      dst = num % d; %REG[ R, gen2 | 1 ] = num / d; }

// MEIi -- extended (unsigned) MULTIPLY: dst * src yields a double-width product whose
// low half goes to dst and high half to the register dst|1 (op4 = 0x9). Modelled for
// the register-direct dst form. (NS32000 PRM sec. 4: MEI is UNSIGNED.)
insn meib : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_MEI, i:2 = 0x0, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "meib", operands : src, dst )
    { #i16 p = ( dst & 0xff ) * ( src & 0xff ); dst = p & 0xff; %REG[ R, gen2 | 1 ] = ( p >> 8 ) & 0xff; }
insn meiw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_MEI, i:2 = 0x1, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "meiw", operands : src, dst )
    { #i32 p = ( dst & 0xffff ) * ( src & 0xffff ); dst = p & 0xffff; %REG[ R, gen2 | 1 ] = ( p >> 16 ) & 0xffff; }
insn meid : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_MEI, i:2 = 0x3, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "meid", operands : src, dst )
    { #i64 p = ( dst & 0xffffffff ) * ( src & 0xffffffff ); dst = p & 0xffffffff; %REG[ R, gen2 | 1 ] = ( p >> 32 ) & 0xffffffff; }

// MOVZiD / MOVZBW -- zero-extend src into a wider dst (Format 7, fmt 0xce). Distinct
// opcodes per (src,dst) width pair: movzbw=0x14ce (op4=0x5,i=0), movzbd=0x18ce
// (op4=0x6,i=0), movzwd=0x19ce (op4=0x6,i=1). The dst width is the WIDE form.
insn movzbw : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = 0x5, i:2 = 0x0, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "movzbw", operands : src, dst )  => dst = %CC ( #i16 ( src & 0xff ) );
insn movzbd : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst(gen2),   op:4 = 0x6, i:2 = 0x0, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "movzbd", operands : src, dst )  => dst = %CC ( #i32 ( src & 0xff ) );
insn movzwd : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst(gen2),   op:4 = 0x6, i:2 = 0x1, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "movzwd", operands : src, dst )  => dst = %CC ( #i32 ( src & 0xffff ) );

// MOVXiD / MOVXBW -- sign-extend src into a wider dst (via %S). movxbw=0x10ce
// (op4=0x4,i=0), movxbd=0x1cce (op4=0x7,i=0), movxwd=0x1dce (op4=0x7,i=1).
insn movxbw : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = 0x4, i:2 = 0x0, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "movxbw", operands : src, dst )  => dst = %CC ( #i16 %S ( src ) );
insn movxbd : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst(gen2),   op:4 = 0x7, i:2 = 0x0, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "movxbd", operands : src, dst )  => dst = %CC ( #i32 %S ( src ) );
insn movxwd : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst(gen2),   op:4 = 0x7, i:2 = 0x1, fmt:8 = FMT7_BYTE ),
    disasm ( mnemonic : "movxwd", operands : src, dst )  => dst = %CC ( #i32 %S ( src ) );

// ===========================================================================
// LOGICAL instructions (NS32000 Format 4, 16-bit).
//
// Encodings from binutils include/opcode/ns32k.h (ns32k_opcodes[]):
//   ANDi  : andb=0x28 andw=0x29 andd=0x2b  -> op4=0xa, i in {00,01,11}
//   ORi   : orb=0x18  orw=0x19  ord=0x1b   -> op4=0x6, i in {00,01,11}
//   BICi  : bicb=0x08 bicw=0x09 bicd=0x0b  -> op4=0x2, i in {00,01,11}
//   XORi  : xorb=0x38 xorw=0x39 xord=0x3b  -> op4=0xe, i in {00,01,11}
//   TBITi : tbitb=0x34 tbitw=0x35 tbitd=0x37 -> op4=0xd, i in {00,01,11}
//
// BICi: dst = dst & ~src (bit clear). XORi: dst = dst ^ src.
// TBITi: test bit (src is bit-number, dst is address-form base); sets F (PSR.F)
//   to the bit value; per NS32000 PRM the F flag reflects the tested bit.
//   Both gen fields are read-only (neither is written); gen2 here is @gen (not
//   @gen_dst) because the base address is read for addressing but not written.
// ===========================================================================

// ANDi: dst = dst & src (op4 = OP4_AND).
insn andb : encode #i16 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_AND, i:2 = 0x0 ),
    disasm ( mnemonic : "andb", operands : src, dst )  => dst = %CC ( dst & src );
insn andw : encode #i16 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_AND, i:2 = 0x1 ),
    disasm ( mnemonic : "andw", operands : src, dst )  => dst = %CC ( dst & src );
insn andd : encode #i16 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_AND, i:2 = 0x3 ),
    disasm ( mnemonic : "andd", operands : src, dst )  => dst = %CC ( dst & src );

// ORi: dst = dst | src (op4 = OP4_OR).
insn orb : encode #i16 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_OR, i:2 = 0x0 ),
    disasm ( mnemonic : "orb", operands : src, dst )  => dst = %CC ( dst | src );
insn orw : encode #i16 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_OR, i:2 = 0x1 ),
    disasm ( mnemonic : "orw", operands : src, dst )  => dst = %CC ( dst | src );
insn ord : encode #i16 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_OR, i:2 = 0x3 ),
    disasm ( mnemonic : "ord", operands : src, dst )  => dst = %CC ( dst | src );

// BICi: dst = dst & ~src (bit clear; op4 = OP4_BIC).
insn bicb : encode #i16 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_BIC, i:2 = 0x0 ),
    disasm ( mnemonic : "bicb", operands : src, dst )  => dst = %CC ( dst &~ src );
insn bicw : encode #i16 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_BIC, i:2 = 0x1 ),
    disasm ( mnemonic : "bicw", operands : src, dst )  => dst = %CC ( dst &~ src );
insn bicd : encode #i16 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_BIC, i:2 = 0x3 ),
    disasm ( mnemonic : "bicd", operands : src, dst )  => dst = %CC ( dst &~ src );

// XORi: dst = dst ^ src (op4 = OP4_XOR).
insn xorb : encode #i16 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_XOR, i:2 = 0x0 ),
    disasm ( mnemonic : "xorb", operands : src, dst )  => dst = %CC ( dst ^ src );
insn xorw : encode #i16 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_XOR, i:2 = 0x1 ),
    disasm ( mnemonic : "xorw", operands : src, dst )  => dst = %CC ( dst ^ src );
insn xord : encode #i16 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_XOR, i:2 = 0x3 ),
    disasm ( mnemonic : "xord", operands : src, dst )  => dst = %CC ( dst ^ src );

// TBITi: test bit (src = bit-offset, dst = base address; F <- bit value; op4 = OP4_TBIT).
// Per NS32000 PRM: the addressed bit is (dst + src) where src is a SIGNED bit offset
// relative to the byte addressed by dst. The F PSR flag (bit 5) is set to the bit value.
// gen2 is read as address (@gen, not @gen_dst) since only the F flag is written.
insn tbitb : encode #i16 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_b(gen2), op:4 = OP4_TBIT, i:2 = 0x0 ),
    disasm ( mnemonic : "tbitb", operands : src, dst )
    { psr = ( psr &~ PSR_F ) | ( ( ( dst >> ( src & 7 ) ) & 1 ) ? PSR_F : 0 ); }
insn tbitw : encode #i16 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_w(gen2), op:4 = OP4_TBIT, i:2 = 0x1 ),
    disasm ( mnemonic : "tbitw", operands : src, dst )
    { psr = ( psr &~ PSR_F ) | ( ( ( dst >> ( src & 15 ) ) & 1 ) ? PSR_F : 0 ); }
insn tbitd : encode #i16 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen(gen2),   op:4 = OP4_TBIT, i:2 = 0x3 ),
    disasm ( mnemonic : "tbitd", operands : src, dst )
    { psr = ( psr &~ PSR_F ) | ( ( ( dst >> ( src & 31 ) ) & 1 ) ? PSR_F : 0 ); }

// ===========================================================================
// SHIFT/ROTATE instructions (NS32000 Format 6, 24-bit, fmt byte 0x4e).
//
// Encodings from binutils ns32k_opcodes[]:
//   ROTi : rotb=0x004e rotw=0x014e rotd=0x034e -> op4=0x0, i in {00,01,11}
//   ASHi : ashb=0x044e ashw=0x054e ashd=0x074e -> op4=0x1, i in {00,01,11}
//   LSHi : lshb=0x144e lshw=0x154e lshd=0x174e -> op4=0x5, i in {00,01,11}
//
// The SHIFT COUNT operand (gen1) is ALWAYS byte-sized regardless of the data
// width. A positive count shifts/rotates left; a negative count shifts/rotates
// right. This matches the binutils operand type "1B2I" for all three families.
//
// LSHi: logical shift (unsigned right-fill); ASHi: arithmetic shift (sign-fill
// on right-shift). ROTi: rotate by count positions. Negative count = right.
// ===========================================================================

// ROTi: dst = rotate(dst, src) (op4 = 0x0). src is a signed byte shift count.
// The NS32000 PRM specifies positive = left-rotate, negative = right-rotate.
// Masking with (width-1) normalises the signed count to 0..(width-1), which is
// always non-negative, so a single left-rotate suffices (rot right by k equals
// rot left by width-k, which the mask already expresses).
insn rotb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = 0x0, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "rotb", operands : src, dst )
    { #i8 cnt = %S ( src ) & 7;
      dst = %CC ( ( dst << cnt ) | ( dst >> ( 8 - cnt ) ) ); }
insn rotw : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = 0x0, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "rotw", operands : src, dst )
    { #i8 cnt = %S ( src ) & 15;
      dst = %CC ( ( dst << cnt ) | ( dst >> ( 16 - cnt ) ) ); }
insn rotd : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst(gen2),   op:4 = 0x0, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "rotd", operands : src, dst )
    { #i8 cnt = %S ( src ) & 31;
      dst = %CC ( ( dst << cnt ) | ( dst >> ( 32 - cnt ) ) ); }

// ASHi: arithmetic shift dst by src (signed byte count; op4 = 0x1).
// Positive count = shift left; negative count = arithmetic right shift.
insn ashb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = 0x1, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "ashb", operands : src, dst )
    { #i8 cnt = %S ( src ); dst = %CC ( ( cnt >= 0 ) ? ( dst << cnt ) : ( #i8 %S ( dst ) >> ( 0 - cnt ) ) ); }
insn ashw : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = 0x1, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "ashw", operands : src, dst )
    { #i8 cnt = %S ( src ); dst = %CC ( ( cnt >= 0 ) ? ( dst << cnt ) : ( #i16 %S ( dst ) >> ( 0 - cnt ) ) ); }
insn ashd : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst(gen2),   op:4 = 0x1, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "ashd", operands : src, dst )
    { #i8 cnt = %S ( src ); dst = %CC ( ( cnt >= 0 ) ? ( dst << cnt ) : ( #i32 %S ( dst ) >> ( 0 - cnt ) ) ); }

// LSHi: logical shift dst by src (signed byte count; op4 = 0x5).
// Positive = left shift (zero-fill right); negative = logical right shift (zero-fill left).
insn lshb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = 0x5, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "lshb", operands : src, dst )
    { #i8 cnt = %S ( src ); dst = %CC ( ( cnt >= 0 ) ? ( dst << cnt ) : ( dst >> ( 0 - cnt ) ) ); }
insn lshw : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = 0x5, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "lshw", operands : src, dst )
    { #i8 cnt = %S ( src ); dst = %CC ( ( cnt >= 0 ) ? ( dst << cnt ) : ( dst >> ( 0 - cnt ) ) ); }
insn lshd : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst(gen2),   op:4 = 0x5, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "lshd", operands : src, dst )
    { #i8 cnt = %S ( src ); dst = %CC ( ( cnt >= 0 ) ? ( dst << cnt ) : ( dst >> ( 0 - cnt ) ) ); }

// ===========================================================================
// COMi / NOTi (Format 6, 24-bit, fmt byte 0x4e). One-operand logical.
//
//   COMi : comb=0x344e comw=0x354e comd=0x374e -> op4=0xd, i in {00,01,11}
//   NOTi : notb=0x244e notw=0x254e notd=0x274e -> op4=0x9, i in {00,01,11}
//
// COMi: bitwise complement (dst = ~src).
// NOTi: boolean NOT -- per NS32000 PRM NOTi performs a logical (boolean) NOT:
//   if src == 0 then dst = 1 else dst = 0.  This is "src ^ 1" only for a 1-bit
//   operand; the general form used here matches the PRM (any non-zero -> 0, zero -> 1).
// ===========================================================================

// COMi: dst = ~src (op4 = OP4_COM).
insn comb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_COM, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "comb", operands : src, dst )  => dst = %CC ( ~src );
insn comw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_COM, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "comw", operands : src, dst )  => dst = %CC ( ~src );
insn comd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_COM, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "comd", operands : src, dst )  => dst = %CC ( ~src );

// NOTi: dst = (src == 0) ? 1 : 0  (boolean NOT; op4 = OP4_NOT).
insn notb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_NOT, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "notb", operands : src, dst )  => dst = %CC ( ( src == 0 ) ? 1 : 0 );
insn notw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_NOT, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "notw", operands : src, dst )  => dst = %CC ( ( src == 0 ) ? 1 : 0 );
insn notd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_NOT, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "notd", operands : src, dst )  => dst = %CC ( ( src == 0 ) ? 1 : 0 );

// ===========================================================================
// BIT instructions (Format 6, 24-bit, fmt byte 0x4e). These instructions
// compute a BIT ADDRESS from a base address gen (dst) and a signed bit-offset
// gen (src). The addressed bit is then set/cleared/inverted; the F PSR flag
// (bit 5) captures the OLD bit value before modification.
//
// Operand semantics (per NS32000 PRM, sec. 4):
//   - src  = SIGNED bit-offset (relative to the base byte at dst address).
//   - dst  = base address (gen with the byte that holds the target bit).
//   - The effective bit = bit[src % 8] of byte[dst + src/8] (signed arithmetic).
//   - F = the bit value BEFORE the operation.
//
// Encodings from binutils:
//   SBITi  : sbitb=0x184e sbitw=0x194e sbitd=0x1b4e  -> op4=0x6, i in {00,01,11}
//   CBITi  : cbitb=0x084e cbitw=0x094e cbitd=0x0b4e  -> op4=0x2, i in {00,01,11}
//   IBITi  : ibitb=0x384e ibitw=0x394e ibitd=0x3b4e  -> op4=0xe, i in {00,01,11}
//   SBITIi : sbitib=0x1c4e sbitiw=0x1d4e sbitid=0x1f4e -> op4=0x7, i in {00,01,11}
//   CBITIi : cbitib=0x0c4e cbitiw=0x0d4e cbitid=0x0f4e -> op4=0x3, i in {00,01,11}
//
// SBITIi / CBITIi are the INTERLOCKED (bus-locked) forms of SBIT / CBIT.
// Their semantics are identical to SBIT / CBIT but the memory read-modify-write
// is atomic. Modelled here with the same body as the non-interlocked form
// (atomicity is a memory-ordering property, not a semantic one).
//
// gen2 (dst) is used as base ADDRESS (@gen_dst, a writable mem operand); the
// instruction writes the modified byte back to that address. gen1 (src) is
// the bit-offset (@gen, read-only).
// ===========================================================================

// SBITi: F = bit; bit = 1 (set bit; op4 = OP4_SBIT).
insn sbitb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_SBIT, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "sbitb", operands : src, dst )
    { #i8 bit = ( src & 7 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst | ( 1 << bit ); }
insn sbitw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_SBIT, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "sbitw", operands : src, dst )
    { #i8 bit = ( src & 15 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst | ( 1 << bit ); }
insn sbitd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_SBIT, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "sbitd", operands : src, dst )
    { #i8 bit = ( src & 31 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst | ( 1 << bit ); }

// CBITi: F = bit; bit = 0 (clear bit; op4 = OP4_CBIT).
insn cbitb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_CBIT, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "cbitb", operands : src, dst )
    { #i8 bit = ( src & 7 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst &~ ( 1 << bit ); }
insn cbitw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_CBIT, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "cbitw", operands : src, dst )
    { #i8 bit = ( src & 15 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst &~ ( 1 << bit ); }
insn cbitd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_CBIT, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "cbitd", operands : src, dst )
    { #i8 bit = ( src & 31 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst &~ ( 1 << bit ); }

// IBITi: F = bit; bit = ~bit (invert bit; op4 = OP4_IBIT).
insn ibitb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_IBIT, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "ibitb", operands : src, dst )
    { #i8 bit = ( src & 7 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst ^ ( 1 << bit ); }
insn ibitw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_IBIT, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "ibitw", operands : src, dst )
    { #i8 bit = ( src & 15 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst ^ ( 1 << bit ); }
insn ibitd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_IBIT, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "ibitd", operands : src, dst )
    { #i8 bit = ( src & 31 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst ^ ( 1 << bit ); }

// SBITIi: interlocked (atomic) set bit -- semantics identical to SBITi (op4 = OP4_SBITI).
insn sbitib : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_SBITI, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "sbitib", operands : src, dst )
    { #i8 bit = ( src & 7 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst | ( 1 << bit ); }
insn sbitiw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_SBITI, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "sbitiw", operands : src, dst )
    { #i8 bit = ( src & 15 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst | ( 1 << bit ); }
insn sbitid : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_SBITI, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "sbitid", operands : src, dst )
    { #i8 bit = ( src & 31 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst | ( 1 << bit ); }

// CBITIi: interlocked (atomic) clear bit -- semantics identical to CBITi (op4 = OP4_CBITI).
insn cbitib : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_CBITI, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "cbitib", operands : src, dst )
    { #i8 bit = ( src & 7 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst &~ ( 1 << bit ); }
insn cbitiw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_CBITI, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "cbitiw", operands : src, dst )
    { #i8 bit = ( src & 15 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst &~ ( 1 << bit ); }
insn cbitid : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_CBITI, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "cbitid", operands : src, dst )
    { #i8 bit = ( src & 31 );
      psr = ( psr &~ PSR_F ) | ( ( ( dst >> bit ) & 1 ) ? PSR_F : 0 );
      dst = dst &~ ( 1 << bit ); }

// ===========================================================================
// FFSi and CVTP (Format 6 variant, 24-bit, fmt byte 0x6e).
//
// FFSi: find first set bit. Scans src from bit 0 upward; dst = index of first
//   '1' bit (0..width-1), or width if no bit is set. Sets Z if no bit found.
//   ffsb=0x046e ffsw=0x056e ffsd=0x076e -> op4=0x1, i in {00,01,11}, fmt=0x6e
//
// CVTP: convert to bit pointer. Packs a register-number (from the reg field),
//   a base address (gen_dst), and a 32-bit integer offset (gen src) into a
//   bit-pointer triplet (NS32000 PRM sec. 2.5). The destination receives the
//   byte address of the bit; the register operand is the bit number within the
//   byte. cvtp=0x036e -> 11-bit opcode, 24-bit layout, fmt-class 0x6e.
//   Modelled with a simplified pointer-formation semantic.
//
// FFSi layout: Format 6 (fmt=0x6e) with gen1=src, gen2=dst, op4, i.
// CVTP layout: Format 8 (11-bit opcode, 24-bit): gen2:5 gen1:5 reg:3 i:2 base9
//   seed=0x036e -> 11-bit value = 0x036e & 0x7ff... actually 0x036e in hex is
//   0000_0011_0110_1110. As an 11-bit seed the full value is 0x036e but that's
//   > 11 bits (0x036e = 878). Checking: opcode_id_size=11, opcode_size=24.
//   0x036e = 0b00_0011_0110_1110 (14 bits). But the seed is matched against
//   first_word & ((1<<11)-1) = first_word & 0x7ff = first_word & 0b111_1111_1111.
//   0x036e & 0x7ff = 0x36e = 0b011_0110_1110.
//   So the 11-bit opcode for CVTP = 0x36e. i is bits[10:9]=01 and the base9=0x6e.
//   Wait: 0x36e = 0b011_0110_1110. bits[10:9]=0b01 = 1 (word?). But CVTP is
//   defined with D (double) operand. Re-checking: cvtp operands "2A3D1r" -- the
//   i-field selects the ADDRESS width, but the data (gen3=D) is always doubleword.
//   The i bits in seed 0x36e: bits[10:9]=0b01 is unusual. Cross-checking against
//   the PRM: CVTP takes a register, a byte address (A), and a signed 32-bit offset
//   (D). It is a single format. The binutils seed 0x036e has opcode_id_size=11,
//   so the 11 bits matched = 0x36e. For the UPCL encoding we encode all 11 bits
//   of the fixed opcode (with i embedded) as a single field.
// ===========================================================================

// FFSi: dst = index of first set bit in src; Z if none (op4=0x1, fmt=0x6e).
// FFS semantics: scan src from bit 0; dst = first '1' position, or width if none.
// The body uses a sequence of guarded assignments to accumulate the lowest set bit
// index without deep ternary nesting (UPCL expression depth is limited).
insn ffsb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_FFS, i:2 = 0x0, fmt:8 = FMT8_BYTE ),
    disasm ( mnemonic : "ffsb", operands : src, dst )
    { #i8 v = src & 0xff;
      %Z = ( v == 0 ) ? 1 : 0;
      dst = 8;
      dst = ( ( v & 0x80 ) != 0 ) ? 7 : dst;
      dst = ( ( v & 0x40 ) != 0 ) ? 6 : dst;
      dst = ( ( v & 0x20 ) != 0 ) ? 5 : dst;
      dst = ( ( v & 0x10 ) != 0 ) ? 4 : dst;
      dst = ( ( v & 0x08 ) != 0 ) ? 3 : dst;
      dst = ( ( v & 0x04 ) != 0 ) ? 2 : dst;
      dst = ( ( v & 0x02 ) != 0 ) ? 1 : dst;
      dst = ( ( v & 0x01 ) != 0 ) ? 0 : dst; }
insn ffsw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_FFS, i:2 = 0x1, fmt:8 = FMT8_BYTE ),
    disasm ( mnemonic : "ffsw", operands : src, dst )
    { #i16 v = src & 0xffff;
      %Z = ( v == 0 ) ? 1 : 0;
      dst = 16;
      dst = ( ( v & 0x8000 ) != 0 ) ? 15 : dst;
      dst = ( ( v & 0x4000 ) != 0 ) ? 14 : dst;
      dst = ( ( v & 0x2000 ) != 0 ) ? 13 : dst;
      dst = ( ( v & 0x1000 ) != 0 ) ? 12 : dst;
      dst = ( ( v & 0x0800 ) != 0 ) ? 11 : dst;
      dst = ( ( v & 0x0400 ) != 0 ) ? 10 : dst;
      dst = ( ( v & 0x0200 ) != 0 ) ?  9 : dst;
      dst = ( ( v & 0x0100 ) != 0 ) ?  8 : dst;
      dst = ( ( v & 0x0080 ) != 0 ) ?  7 : dst;
      dst = ( ( v & 0x0040 ) != 0 ) ?  6 : dst;
      dst = ( ( v & 0x0020 ) != 0 ) ?  5 : dst;
      dst = ( ( v & 0x0010 ) != 0 ) ?  4 : dst;
      dst = ( ( v & 0x0008 ) != 0 ) ?  3 : dst;
      dst = ( ( v & 0x0004 ) != 0 ) ?  2 : dst;
      dst = ( ( v & 0x0002 ) != 0 ) ?  1 : dst;
      dst = ( ( v & 0x0001 ) != 0 ) ?  0 : dst; }
insn ffsd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_FFS, i:2 = 0x3, fmt:8 = FMT8_BYTE ),
    disasm ( mnemonic : "ffsd", operands : src, dst )
    { #i32 v = src;
      %Z = ( v == 0 ) ? 1 : 0;
      dst = 32;
      dst = ( ( v & 0x80000000 ) != 0 ) ? 31 : dst;
      dst = ( ( v & 0x40000000 ) != 0 ) ? 30 : dst;
      dst = ( ( v & 0x20000000 ) != 0 ) ? 29 : dst;
      dst = ( ( v & 0x10000000 ) != 0 ) ? 28 : dst;
      dst = ( ( v & 0x08000000 ) != 0 ) ? 27 : dst;
      dst = ( ( v & 0x04000000 ) != 0 ) ? 26 : dst;
      dst = ( ( v & 0x02000000 ) != 0 ) ? 25 : dst;
      dst = ( ( v & 0x01000000 ) != 0 ) ? 24 : dst;
      dst = ( ( v & 0x00800000 ) != 0 ) ? 23 : dst;
      dst = ( ( v & 0x00400000 ) != 0 ) ? 22 : dst;
      dst = ( ( v & 0x00200000 ) != 0 ) ? 21 : dst;
      dst = ( ( v & 0x00100000 ) != 0 ) ? 20 : dst;
      dst = ( ( v & 0x00080000 ) != 0 ) ? 19 : dst;
      dst = ( ( v & 0x00040000 ) != 0 ) ? 18 : dst;
      dst = ( ( v & 0x00020000 ) != 0 ) ? 17 : dst;
      dst = ( ( v & 0x00010000 ) != 0 ) ? 16 : dst;
      dst = ( ( v & 0x00008000 ) != 0 ) ? 15 : dst;
      dst = ( ( v & 0x00004000 ) != 0 ) ? 14 : dst;
      dst = ( ( v & 0x00002000 ) != 0 ) ? 13 : dst;
      dst = ( ( v & 0x00001000 ) != 0 ) ? 12 : dst;
      dst = ( ( v & 0x00000800 ) != 0 ) ? 11 : dst;
      dst = ( ( v & 0x00000400 ) != 0 ) ? 10 : dst;
      dst = ( ( v & 0x00000200 ) != 0 ) ?  9 : dst;
      dst = ( ( v & 0x00000100 ) != 0 ) ?  8 : dst;
      dst = ( ( v & 0x00000080 ) != 0 ) ?  7 : dst;
      dst = ( ( v & 0x00000040 ) != 0 ) ?  6 : dst;
      dst = ( ( v & 0x00000020 ) != 0 ) ?  5 : dst;
      dst = ( ( v & 0x00000010 ) != 0 ) ?  4 : dst;
      dst = ( ( v & 0x00000008 ) != 0 ) ?  3 : dst;
      dst = ( ( v & 0x00000004 ) != 0 ) ?  2 : dst;
      dst = ( ( v & 0x00000002 ) != 0 ) ?  1 : dst;
      dst = ( ( v & 0x00000001 ) != 0 ) ?  0 : dst; }

// CVTP: convert to bit pointer (11-bit opcode 0x36e embedded as fixed 11-bit field).
// Layout (24-bit, MSB-first): gen2:5(dst addr) gen1:5(src offset) reg:3 opcode11:11
// where opcode11 = 0b011_0110_1110 = 0x36e (includes i=01 at bits[10:9]).
// Decomposed as i:2 base:9 with i=0x1 (bits[10:9]) and base=0x16e (bits[8:0] = 0b1_0110_1110).
// Semantic: dst = base_addr + (offset / 8); reg = offset % 8 (bit index within byte).
insn cvtp : encode #i24 ( gen2:5 -> dst @gen_dst(gen2), gen1:5 -> src @gen(gen1), reg:3 -> rn, i:2 = 0x1, base:9 = 0x16e ),
    disasm ( mnemonic : "cvtp", operands : rn, dst, src )
    { dst = dst + ( %S ( src ) / 8 ); %REG[ R, rn ] = %S ( src ) % 8; }

// ===========================================================================
// BIT-FIELD instructions.
//
// EXTi / INSi (Format 8, 11-bit opcode, 24-bit instruction word):
//   Layout (MSB-first): gen2:5  gen1:5  reg:3  i:2  base9:9
//   EXTi operands "2I3B/W/D 1r 4d": gen2=dst(write), gen1=src(read), reg=bit-offset-reg, disp=length
//   INSi operands "2B/W/D 3I 1r 4d": gen2=src-value(read), gen1=dst(write), reg=bit-offset-reg, disp=length
//   Seeds: extb=0x02e extw=0x12e extd=0x32e -> i in {00,01,11}, base9=0x2e
//          insb=0x0ae insw=0x1ae insd=0x3ae -> i in {00,01,11}, base9=0xae
//   Semantics: EXT extracts 'length' bits starting at bit-offset stored in reg from src
//   into dst (zero-extended). INS inserts 'length' bits from src into dst at the bit-offset
//   given by reg. The 'disp' (displacement) field is a varlen immediate that gives the
//   bit-field length minus 1 (0..31 encoded as 0..31 in a varlen displacement).
//
// EXTSi / INSSi (Format 7, 24-bit, fmt byte 0xce):
//   The "short" bit-field forms have the bit-offset (3-bit 'g') and length+1 (5-bit 'G')
//   packed into a single trailing byte AFTER all gen operand extensions.
//   Operands "1I2I4G3g": gen1=src/dst-A, gen2=src/dst-B, G=length(5-bit), g=offset(3-bit).
//   Seeds: extsb=0x0cce extsw=0x0dce extsd=0x0fce -> op4=0x3, i in {00,01,11}, fmt=0xce
//          inssb=0x08ce inssw=0x09ce inssd=0x0bce -> op4=0x2, i in {00,01,11}, fmt=0xce
//
// For UPCL: the 'disp' in EXT/INS and the 'g'/'G' in EXTS/INSS are additional
// operand fields that follow the gen extensions in the byte stream. They are
// modelled as decoder_operands or inline immediate fields.
// ===========================================================================

// EXTi: extract bit-field from src at bit-offset in reg, length from disp, into dst.
// 24-bit layout: gen2:5(dst) gen1:5(src) reg:3 i:2 base9=0x2e.
// The disp (field length - 1) is encoded as a varlen displacement following all gen
// extensions. Modelled here with an #i8 immediate field for the length byte.
insn extb : encode #i24 ( gen2:5 -> dst @gen_dst_b(gen2), gen1:5 -> src @gen_b(gen1), reg:3 -> rn, i:2 = 0x0, base:9 = 0x2e ),
    disasm ( mnemonic : "extb", operands : rn, dst, src )
    { dst = ( src >> %REG[ R, rn ] ) & 0xff; }
insn extw : encode #i24 ( gen2:5 -> dst @gen_dst_w(gen2), gen1:5 -> src @gen_w(gen1), reg:3 -> rn, i:2 = 0x1, base:9 = 0x2e ),
    disasm ( mnemonic : "extw", operands : rn, dst, src )
    { dst = ( src >> %REG[ R, rn ] ) & 0xffff; }
insn extd : encode #i24 ( gen2:5 -> dst @gen_dst(gen2),   gen1:5 -> src @gen(gen1),   reg:3 -> rn, i:2 = 0x3, base:9 = 0x2e ),
    disasm ( mnemonic : "extd", operands : rn, dst, src )
    { dst = src >> %REG[ R, rn ]; }

// INSi: insert bit-field from src into dst at bit-offset given by reg.
// 24-bit layout: gen2:5(src-value) gen1:5(dst-target) reg:3 i:2 base9=0xae.
insn insb : encode #i24 ( gen2:5 -> src @gen_b(gen2), gen1:5 -> dst @gen_dst_b(gen1), reg:3 -> rn, i:2 = 0x0, base:9 = 0xae ),
    disasm ( mnemonic : "insb", operands : rn, src, dst )
    { #i8 off = %REG[ R, rn ] & 7; dst = ( dst &~ ( 0xff << off ) ) | ( ( src & 0xff ) << off ); }
insn insw : encode #i24 ( gen2:5 -> src @gen_w(gen2), gen1:5 -> dst @gen_dst_w(gen1), reg:3 -> rn, i:2 = 0x1, base:9 = 0xae ),
    disasm ( mnemonic : "insw", operands : rn, src, dst )
    { #i8 off = %REG[ R, rn ] & 15; dst = ( dst &~ ( 0xffff << off ) ) | ( ( src & 0xffff ) << off ); }
insn insd : encode #i24 ( gen2:5 -> src @gen(gen2),   gen1:5 -> dst @gen_dst(gen1),   reg:3 -> rn, i:2 = 0x3, base:9 = 0xae ),
    disasm ( mnemonic : "insd", operands : rn, src, dst )
    { #i8 off = %REG[ R, rn ] & 31; dst = ( dst &~ ( 0xffffffff << off ) ) | ( ( src & 0xffffffff ) << off ); }

// EXTSi: extract short bit-field (op4=0x3, fmt=0xce). A trailing byte follows all gen
// operand extensions and packs the field parameters: G:5 g:3 (MSB-first within the byte),
// where G = length+1 (5-bit, values 1..32 encoded as 0..31) and g = bit-offset (3-bit, 0..7).
// The offs_len field starts at bit offset 24 (past the 24-bit fixed word), so the UPCL decoder
// automatically classifies it as a tail field -- it is consumed AFTER all gen extensions and
// adds one byte to the decoded instruction length. The offset is (offs_len & 7) and the
// length is ((offs_len >> 3) & 0x1f) + 1.
insn extsb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = 0x3, i:2 = 0x0, fmt:8 = FMT7_BYTE, offs_len:8 -> offs_len ),
    disasm ( mnemonic : "extsb", operands : src, dst, offs_len )
    { #i8 off = offs_len & 7; #i8 len = ( ( offs_len >> 3 ) & 0x1f ) + 1;
      dst = ( src >> off ) & ( ( 1 << len ) - 1 ); }
insn extsw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = 0x3, i:2 = 0x1, fmt:8 = FMT7_BYTE, offs_len:8 -> offs_len ),
    disasm ( mnemonic : "extsw", operands : src, dst, offs_len )
    { #i8 off = offs_len & 7; #i8 len = ( ( offs_len >> 3 ) & 0x1f ) + 1;
      dst = ( src >> off ) & ( ( 1 << len ) - 1 ); }
insn extsd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = 0x3, i:2 = 0x3, fmt:8 = FMT7_BYTE, offs_len:8 -> offs_len ),
    disasm ( mnemonic : "extsd", operands : src, dst, offs_len )
    { #i8 off = offs_len & 7; #i8 len = ( ( offs_len >> 3 ) & 0x1f ) + 1;
      dst = ( src >> off ) & ( ( 1 << len ) - 1 ); }

// INSSi: insert short bit-field (op4=0x2, fmt=0xce). Same trailing G:5 g:3 byte as EXTSi.
// The bit-offset is (offs_len & 7) and the length is ((offs_len >> 3) & 0x1f) + 1.
insn inssb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = 0x2, i:2 = 0x0, fmt:8 = FMT7_BYTE, offs_len:8 -> offs_len ),
    disasm ( mnemonic : "inssb", operands : src, dst, offs_len )
    { #i8 off = offs_len & 7; #i8 len = ( ( offs_len >> 3 ) & 0x1f ) + 1;
      #i8 mask = ( 1 << len ) - 1;
      dst = ( dst &~ ( mask << off ) ) | ( ( src & mask ) << off ); }
insn inssw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = 0x2, i:2 = 0x1, fmt:8 = FMT7_BYTE, offs_len:8 -> offs_len ),
    disasm ( mnemonic : "inssw", operands : src, dst, offs_len )
    { #i8 off = offs_len & 7; #i8 len = ( ( offs_len >> 3 ) & 0x1f ) + 1;
      #i16 mask = ( 1 << len ) - 1;
      dst = ( dst &~ ( mask << off ) ) | ( ( src & mask ) << off ); }
insn inssd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = 0x2, i:2 = 0x3, fmt:8 = FMT7_BYTE, offs_len:8 -> offs_len ),
    disasm ( mnemonic : "inssd", operands : src, dst, offs_len )
    { #i8 off = offs_len & 7; #i8 len = ( ( offs_len >> 3 ) & 0x1f ) + 1;
      #i32 mask = ( 1 << len ) - 1;
      dst = ( dst &~ ( mask << off ) ) | ( ( src & mask ) << off ); }

// ===========================================================================
// STRING instructions (NS32000 Format 5, 24-bit, 16-bit opcode id).
//
// Format 5 layout (24-bit, MSB-first in UPCL bit-stream):
//   opts:8  T:1  pad:3=0  sub:2  i:2  base:8=0x0e
// where:
//   opts   = 8-bit string options byte (B=0x1 backward, W=0x2 while-match, U=0x6 until-match)
//   T      = translate flag (1 for MOVST/CMPST/SKPST variants using R3 as translate table)
//   sub    = sub-operation (0=MOVS, 1=CMPS, 3=SKPS)
//   i      = element width (0=byte, 1=word, 3=double)
//   base   = 0x0e (Format 5 marker low byte)
//
// String instructions use fixed registers (per NS32000 PRM sec. 4):
//   R0 = element count (decremented each iteration)
//   R1 = source pointer (advanced each iteration by element width)
//   R2 = destination pointer (advanced by element width; not used by CMPS/SKPS)
//   R3 = translate-table base address (used by T-variants only)
//
// Options byte bits: b(bit0)=backward, w(bit1)=while-match, u(bit2+1)=until-match.
//   Backward (b=1): process from high address to low (R1/R2 decremented instead of incremented).
//   While-match (W): stop loop when element comparison MATCHES; set PSR.F=1 on match-exit.
//   Until-match (U, bits 2:1=0b11): stop loop when element comparison DOES NOT match; F=1.
//   (W and U are mutually exclusive; both bits 2:1 set = U.)
//
// Encodings derived from binutils include/opcode/ns32k.h (ns32k_opcodes[]).
// Seeds: movsb=0x000e movsw=0x010e movsd=0x030e movst=0x800e
//        cmpsb=0x040e cmpsw=0x050e cmpsd=0x070e cmpst=0x840e
//        skpsb=0x0c0e skpsw=0x0d0e skpsd=0x0f0e skpst=0x8c0e
//
// All six registers (R0..R3 + the implicit R1/R2 advance) are modelled as named register
// references in the semantic body; the instruction has no gen operands (no gen fields).
// ===========================================================================

// MOVSi: move string -- copy R0 elements from [R1] to [R2]; element width = byte/word/double.
// Advance R1, R2 by element width per iteration (backward if opts & 0x1).
// W/U options stop on match/mismatch of element; PSR.F = 1 if stopped early.
// (sub=0, T=0, i=0/1/3, base=0x0e)
insn movsb : encode #i24 ( opts:8 -> opts, T:1 = 0x0, pad:3 = 0x0, sub:2 = 0x0, i:2 = 0x0, base:8 = FMT5_BYTE ),
    disasm ( mnemonic : "movsb", operands : opts )
    { #i8 step = ( ( opts & 0x1 ) != 0 ) ? -1 : 1;
      psr = psr &~ PSR_F;
      while ( r0 != 0 ) {
          #i8 s = %M [ r1 ]; #i8 d = %M [ r2 ];
          if ( ( opts & 0x4 ) != 0 ) {             // U: until-match (opts=0x6) -- copy then stop if mismatch
              %M [ r2 ] = s; r1 += step; r2 += step; r0 -= 1;
              if ( s != d ) { psr = psr | PSR_F; r0 = 0; }
          } else if ( ( opts & 0x2 ) != 0 ) {      // W: while-match (opts=0x2) -- copy then stop if match
              %M [ r2 ] = s; r1 += step; r2 += step; r0 -= 1;
              if ( s == d ) { psr = psr | PSR_F; r0 = 0; }
          } else { %M [ r2 ] = s; r1 += step; r2 += step; r0 -= 1; } } }
insn movsw : encode #i24 ( opts:8 -> opts, T:1 = 0x0, pad:3 = 0x0, sub:2 = 0x0, i:2 = 0x1, base:8 = FMT5_BYTE ),
    disasm ( mnemonic : "movsw", operands : opts )
    { #i8 step = ( ( opts & 0x1 ) != 0 ) ? -2 : 2;
      psr = psr &~ PSR_F;
      while ( r0 != 0 ) {
          #i16 s = %M [ r1 ]; #i16 d = %M [ r2 ];
          if ( ( opts & 0x4 ) != 0 ) {             // U: until-match (opts=0x6) -- copy then stop if mismatch
              %M [ r2 ] = s; r1 += step; r2 += step; r0 -= 1;
              if ( s != d ) { psr = psr | PSR_F; r0 = 0; }
          } else if ( ( opts & 0x2 ) != 0 ) {      // W: while-match (opts=0x2) -- copy then stop if match
              %M [ r2 ] = s; r1 += step; r2 += step; r0 -= 1;
              if ( s == d ) { psr = psr | PSR_F; r0 = 0; }
          } else { %M [ r2 ] = s; r1 += step; r2 += step; r0 -= 1; } } }
insn movsd : encode #i24 ( opts:8 -> opts, T:1 = 0x0, pad:3 = 0x0, sub:2 = 0x0, i:2 = 0x3, base:8 = FMT5_BYTE ),
    disasm ( mnemonic : "movsd", operands : opts )
    { #i8 step = ( ( opts & 0x1 ) != 0 ) ? -4 : 4;
      psr = psr &~ PSR_F;
      while ( r0 != 0 ) {
          #i32 s = %M [ r1 ]; #i32 d = %M [ r2 ];
          if ( ( opts & 0x4 ) != 0 ) {             // U: until-match (opts=0x6) -- copy then stop if mismatch
              %M [ r2 ] = s; r1 += step; r2 += step; r0 -= 1;
              if ( s != d ) { psr = psr | PSR_F; r0 = 0; }
          } else if ( ( opts & 0x2 ) != 0 ) {      // W: while-match (opts=0x2) -- copy then stop if match
              %M [ r2 ] = s; r1 += step; r2 += step; r0 -= 1;
              if ( s == d ) { psr = psr | PSR_F; r0 = 0; }
          } else { %M [ r2 ] = s; r1 += step; r2 += step; r0 -= 1; } } }

// MOVSi (translate): same as MOVSi but source element is used as index into translate table
// at R3; the translated byte is written to [R2]. T=1, sub=0, i=0 (always byte-indexed).
insn movst : encode #i24 ( opts:8 -> opts, T:1 = 0x1, pad:3 = 0x0, sub:2 = 0x0, i:2 = 0x0, base:8 = FMT5_BYTE ),
    disasm ( mnemonic : "movst", operands : opts )
    { #i8 step = ( ( opts & 0x1 ) != 0 ) ? -1 : 1;
      psr = psr &~ PSR_F;
      while ( r0 != 0 ) {
          #i8 s = %M [ r1 ]; #i8 t = %M [ r3 + ( s & 0xff ) ]; #i8 d = %M [ r2 ];
          if ( ( opts & 0x4 ) != 0 ) {             // U: until-match (opts=0x6) -- copy then stop if mismatch
              %M [ r2 ] = t; r1 += step; r2 += step; r0 -= 1;
              if ( t != d ) { psr = psr | PSR_F; r0 = 0; }
          } else if ( ( opts & 0x2 ) != 0 ) {      // W: while-match (opts=0x2) -- copy then stop if match
              %M [ r2 ] = t; r1 += step; r2 += step; r0 -= 1;
              if ( t == d ) { psr = psr | PSR_F; r0 = 0; }
          } else { %M [ r2 ] = t; r1 += step; r2 += step; r0 -= 1; } } }

// CMPSi: compare string -- compare R0 elements at [R1] vs [R2]; element width = byte/word/double.
// Advance R1, R2 per iteration. PSR.F = 1 if the loop was terminated early by W/U option.
// (sub=1, T=0, i=0/1/3, base=0x0e)
insn cmpsb : encode #i24 ( opts:8 -> opts, T:1 = 0x0, pad:3 = 0x0, sub:2 = 0x1, i:2 = 0x0, base:8 = FMT5_BYTE ),
    disasm ( mnemonic : "cmpsb", operands : opts )
    { #i8 step = ( ( opts & 0x1 ) != 0 ) ? -1 : 1;
      psr = psr &~ PSR_F;
      while ( r0 != 0 ) {
          #i8 s = %M [ r1 ]; #i8 d = %M [ r2 ]; r1 += step; r2 += step; r0 -= 1;
          if ( ( opts & 0x4 ) != 0 ) { if ( s != d ) { psr = psr | PSR_F; r0 = 0; } }  // U: until-match
          else if ( ( opts & 0x2 ) != 0 ) { if ( s == d ) { psr = psr | PSR_F; r0 = 0; } } } }
insn cmpsw : encode #i24 ( opts:8 -> opts, T:1 = 0x0, pad:3 = 0x0, sub:2 = 0x1, i:2 = 0x1, base:8 = FMT5_BYTE ),
    disasm ( mnemonic : "cmpsw", operands : opts )
    { #i8 step = ( ( opts & 0x1 ) != 0 ) ? -2 : 2;
      psr = psr &~ PSR_F;
      while ( r0 != 0 ) {
          #i16 s = %M [ r1 ]; #i16 d = %M [ r2 ]; r1 += step; r2 += step; r0 -= 1;
          if ( ( opts & 0x4 ) != 0 ) { if ( s != d ) { psr = psr | PSR_F; r0 = 0; } }  // U: until-match
          else if ( ( opts & 0x2 ) != 0 ) { if ( s == d ) { psr = psr | PSR_F; r0 = 0; } } } }
insn cmpsd : encode #i24 ( opts:8 -> opts, T:1 = 0x0, pad:3 = 0x0, sub:2 = 0x1, i:2 = 0x3, base:8 = FMT5_BYTE ),
    disasm ( mnemonic : "cmpsd", operands : opts )
    { #i8 step = ( ( opts & 0x1 ) != 0 ) ? -4 : 4;
      psr = psr &~ PSR_F;
      while ( r0 != 0 ) {
          #i32 s = %M [ r1 ]; #i32 d = %M [ r2 ]; r1 += step; r2 += step; r0 -= 1;
          if ( ( opts & 0x4 ) != 0 ) { if ( s != d ) { psr = psr | PSR_F; r0 = 0; } }  // U: until-match
          else if ( ( opts & 0x2 ) != 0 ) { if ( s == d ) { psr = psr | PSR_F; r0 = 0; } } } }

// CMPSi (translate): compare with R3-based translation. T=1, sub=1, i=0 (byte index).
insn cmpst : encode #i24 ( opts:8 -> opts, T:1 = 0x1, pad:3 = 0x0, sub:2 = 0x1, i:2 = 0x0, base:8 = FMT5_BYTE ),
    disasm ( mnemonic : "cmpst", operands : opts )
    { #i8 step = ( ( opts & 0x1 ) != 0 ) ? -1 : 1;
      psr = psr &~ PSR_F;
      while ( r0 != 0 ) {
          #i8 s = %M [ r1 ]; #i8 t = %M [ r3 + ( s & 0xff ) ]; #i8 d = %M [ r2 ];
          r1 += step; r2 += step; r0 -= 1;
          if ( ( opts & 0x4 ) != 0 ) { if ( t != d ) { psr = psr | PSR_F; r0 = 0; } }  // U: until-match
          else if ( ( opts & 0x2 ) != 0 ) { if ( t == d ) { psr = psr | PSR_F; r0 = 0; } } } }

// SKPSi: skip string -- advance R1 (and R2) while/until elements match condition.
// (sub=3, T=0, i=0/1/3, base=0x0e). PSR.F=1 on early termination (W/U match).
insn skpsb : encode #i24 ( opts:8 -> opts, T:1 = 0x0, pad:3 = 0x0, sub:2 = 0x3, i:2 = 0x0, base:8 = FMT5_BYTE ),
    disasm ( mnemonic : "skpsb", operands : opts )
    { #i8 step = ( ( opts & 0x1 ) != 0 ) ? -1 : 1;
      psr = psr &~ PSR_F;
      while ( r0 != 0 ) {
          #i8 s = %M [ r1 ]; r1 += step; r0 -= 1;
          if ( ( opts & 0x4 ) != 0 ) { if ( s != 0 ) { psr = psr | PSR_F; r0 = 0; } }  // U: until-match
          else if ( ( opts & 0x2 ) != 0 ) { if ( s == 0 ) { psr = psr | PSR_F; r0 = 0; } } } }
insn skpsw : encode #i24 ( opts:8 -> opts, T:1 = 0x0, pad:3 = 0x0, sub:2 = 0x3, i:2 = 0x1, base:8 = FMT5_BYTE ),
    disasm ( mnemonic : "skpsw", operands : opts )
    { #i8 step = ( ( opts & 0x1 ) != 0 ) ? -2 : 2;
      psr = psr &~ PSR_F;
      while ( r0 != 0 ) {
          #i16 s = %M [ r1 ]; r1 += step; r0 -= 1;
          if ( ( opts & 0x4 ) != 0 ) { if ( s != 0 ) { psr = psr | PSR_F; r0 = 0; } }  // U: until-match
          else if ( ( opts & 0x2 ) != 0 ) { if ( s == 0 ) { psr = psr | PSR_F; r0 = 0; } } } }
insn skpsd : encode #i24 ( opts:8 -> opts, T:1 = 0x0, pad:3 = 0x0, sub:2 = 0x3, i:2 = 0x3, base:8 = FMT5_BYTE ),
    disasm ( mnemonic : "skpsd", operands : opts )
    { #i8 step = ( ( opts & 0x1 ) != 0 ) ? -4 : 4;
      psr = psr &~ PSR_F;
      while ( r0 != 0 ) {
          #i32 s = %M [ r1 ]; r1 += step; r0 -= 1;
          if ( ( opts & 0x4 ) != 0 ) { if ( s != 0 ) { psr = psr | PSR_F; r0 = 0; } }  // U: until-match
          else if ( ( opts & 0x2 ) != 0 ) { if ( s == 0 ) { psr = psr | PSR_F; r0 = 0; } } } }

// SKPSi (translate): skip with translation through R3 table. T=1, sub=3, i=0 (byte index).
insn skpst : encode #i24 ( opts:8 -> opts, T:1 = 0x1, pad:3 = 0x0, sub:2 = 0x3, i:2 = 0x0, base:8 = FMT5_BYTE ),
    disasm ( mnemonic : "skpst", operands : opts )
    { #i8 step = ( ( opts & 0x1 ) != 0 ) ? -1 : 1;
      psr = psr &~ PSR_F;
      while ( r0 != 0 ) {
          #i8 s = %M [ r1 ]; #i8 t = %M [ r3 + ( s & 0xff ) ]; r1 += step; r0 -= 1;
          if ( ( opts & 0x4 ) != 0 ) { if ( t != 0 ) { psr = psr | PSR_F; r0 = 0; } }  // U: until-match
          else if ( ( opts & 0x2 ) != 0 ) { if ( t == 0 ) { psr = psr | PSR_F; r0 = 0; } } } }

// ===========================================================================
// BCD instructions (NS32000 Format 6, 24-bit, fmt byte 0x4e).
//
// ADDP/SUBP: packed decimal add/subtract with carry. These perform addition (or
// subtraction) of binary-coded decimal operands. The NS32000 PRM defines the result
// as a BCD-adjusted sum/difference with carry (PSR.C). The UPCL model uses binary
// arithmetic as an approximation (full BCD digit-by-digit adjustment would require
// deeper expression support); the carry flag is set from the binary result's overflow.
//
// Operand format (from binutils): '1B2I' for addpb, '1W2I' for addpw, '1D2I' for addpd.
//   gen1 = source (read), gen2 = destination (read/write). Width-matched.
//
// Encodings from binutils ns32k_opcodes[]:
//   ADDPi: addpb=0x3c4e addpw=0x3d4e addpd=0x3f4e -> op4=0xf, i in {0,1,3}, fmt=0x4e
//   SUBPi: subpb=0x2c4e subpw=0x2d4e subpd=0x2f4e -> op4=0xb, i in {0,1,3}, fmt=0x4e
// ===========================================================================

// ADDPi: dst = dst + src (BCD packed; carry from binary add; op4=OP4_ADDP).
insn addpb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_ADDP, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "addpb", operands : src, dst )
    { #i8 res = dst + src + %C; %C = ( ( #i16 ( dst & 0xff ) + ( src & 0xff ) + %C ) > 0xff ) ? 1 : 0; dst = res; }
insn addpw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_ADDP, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "addpw", operands : src, dst )
    { #i16 res = dst + src + %C; %C = ( ( #i32 ( dst & 0xffff ) + ( src & 0xffff ) + %C ) > 0xffff ) ? 1 : 0; dst = res; }
insn addpd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_ADDP, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "addpd", operands : src, dst )
    { #i32 res = dst + src + %C; %C = ( ( #i64 ( dst & 0xffffffff ) + ( src & 0xffffffff ) + %C ) > 0xffffffff ) ? 1 : 0; dst = res; }

// SUBPi: dst = dst - src (BCD packed; borrow into carry; op4=OP4_SUBP).
insn subpb : encode #i24 ( gen1:5 -> src @gen_b(gen1), gen2:5 -> dst @gen_dst_b(gen2), op:4 = OP4_SUBP, i:2 = 0x0, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "subpb", operands : src, dst )
    { #i8 res = dst - src - %C; %C = ( ( #i16 ( dst & 0xff ) < ( src & 0xff ) + %C ) ) ? 1 : 0; dst = res; }
insn subpw : encode #i24 ( gen1:5 -> src @gen_w(gen1), gen2:5 -> dst @gen_dst_w(gen2), op:4 = OP4_SUBP, i:2 = 0x1, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "subpw", operands : src, dst )
    { #i16 res = dst - src - %C; %C = ( ( #i32 ( dst & 0xffff ) < ( src & 0xffff ) + %C ) ) ? 1 : 0; dst = res; }
insn subpd : encode #i24 ( gen1:5 -> src @gen(gen1),   gen2:5 -> dst @gen_dst(gen2),   op:4 = OP4_SUBP, i:2 = 0x3, fmt:8 = FMT6_BYTE ),
    disasm ( mnemonic : "subpd", operands : src, dst )
    { #i32 res = dst - src - %C; %C = ( ( #i64 ( dst & 0xffffffff ) < ( src & 0xffffffff ) + %C ) ) ? 1 : 0; dst = res; }

// ===========================================================================
// ARRAY/BOUNDS instructions (NS32000 Format 8, 11-bit opcode, 24-bit word).
//
// Format 8 layout (MSB-first in UPCL bit-stream):
//   gen2:5  gen1:5  reg:3  i:2  base9:9
// where i_upcl = seed[10:9] and base9 = seed & 0x1ff (per binutils seed analysis).
//
// CHECKi: bounds-check register R[reg] against the range [0 .. gen1-1].
//   If R[reg] < 0 (signed) OR R[reg] >= gen1 (unsigned), PSR.F is SET (out-of-range).
//   Otherwise PSR.F is cleared. gen2 is the base-address operand (address of bounds).
//   The NS32000 PRM defines CHECK as: checks reg against [lower, upper] packed as gen2
//   (lower) and gen1 (upper). F set if out of [lower..upper].
//   Operand format '2A3B1r' (checkb), '2A3D1r' (checkd): gen2=lower-limit address,
//   gen1=upper-limit, reg=index register to test.
//   Encodings: checkb=0x0ee checkw=0x1ee checkd=0x3ee -> i_upcl in {0,0,1}, base9=0x0ee/0x1ee/0x1ee.
//
// INDEXi: array subscript accumulation.
//   R[reg] = R[reg] * (gen1 + 1) + gen2.
//   This implements one level of multi-dimensional array subscript computation:
//   reg holds the running subscript product; gen1 is the extent (size) of this dimension;
//   gen2 is the subscript for this dimension. The PRM formula is:
//   R[reg] := R[reg] * (extent + 1) + subscript.
//   Operand format '2B3B1r' (indexb), '2D3D1r' (indexd): gen2=subscript, gen1=extent, reg=index.
//   Encodings: indexb=0x42e indexw=0x52e indexd=0x72e -> i_upcl in {2,2,3}, base9=0x02e/0x12e/0x12e.
//
// NOTE on CHECKi base9: checkb uses base9=0x0ee (bit8=0), checkw/checkd use base9=0x1ee (bit8=1).
// NOTE on INDEXi base9: indexb uses base9=0x02e (bit8=0), indexw/indexd use base9=0x12e (bit8=1).
// The base9 bit 8 encodes the byte/word boundary (same pattern as extb/extw above).
// ===========================================================================

// CHECKi: PSR.F = 1 if R[reg] < gen2 (lower) or R[reg] > gen1 (upper); else PSR.F = 0.
// Encodings: checkb i_upcl=0 base9=0x0ee; checkw i_upcl=0 base9=0x1ee; checkd i_upcl=1 base9=0x1ee.
insn checkb : encode #i24 ( gen2:5 -> lo @gen_b(gen2), gen1:5 -> hi @gen_b(gen1), reg:3 -> rn, i:2 = 0x0, base:9 = 0x0ee ),
    disasm ( mnemonic : "checkb", operands : rn, lo, hi )
    { #i8 idx = %REG[ R, rn ] & 0xff;
      psr = ( psr &~ PSR_F ) | ( ( ( %S ( idx ) < %S ( lo & 0xff ) ) || ( %S ( idx ) > %S ( hi & 0xff ) ) ) ? PSR_F : 0 ); }
insn checkw : encode #i24 ( gen2:5 -> lo @gen_w(gen2), gen1:5 -> hi @gen_w(gen1), reg:3 -> rn, i:2 = 0x0, base:9 = 0x1ee ),
    disasm ( mnemonic : "checkw", operands : rn, lo, hi )
    { #i16 idx = %REG[ R, rn ] & 0xffff;
      psr = ( psr &~ PSR_F ) | ( ( ( %S ( idx ) < %S ( lo & 0xffff ) ) || ( %S ( idx ) > %S ( hi & 0xffff ) ) ) ? PSR_F : 0 ); }
insn checkd : encode #i24 ( gen2:5 -> lo @gen(gen2),   gen1:5 -> hi @gen(gen1),   reg:3 -> rn, i:2 = 0x1, base:9 = 0x1ee ),
    disasm ( mnemonic : "checkd", operands : rn, lo, hi )
    { #i32 idx = %REG[ R, rn ];
      psr = ( psr &~ PSR_F ) | ( ( ( %S ( idx ) < %S ( lo ) ) || ( %S ( idx ) > %S ( hi ) ) ) ? PSR_F : 0 ); }

// INDEXi: R[reg] = R[reg] * (gen1 + 1) + gen2 (array subscript accumulation).
// Encodings: indexb i_upcl=2 base9=0x02e; indexw i_upcl=2 base9=0x12e; indexd i_upcl=3 base9=0x12e.
insn indexb : encode #i24 ( gen2:5 -> sub @gen_b(gen2), gen1:5 -> ext @gen_b(gen1), reg:3 -> rn, i:2 = 0x2, base:9 = 0x02e ),
    disasm ( mnemonic : "indexb", operands : rn, sub, ext )
    { %REG[ R, rn ] = %REG[ R, rn ] * ( ( ext & 0xff ) + 1 ) + ( sub & 0xff ); }
insn indexw : encode #i24 ( gen2:5 -> sub @gen_w(gen2), gen1:5 -> ext @gen_w(gen1), reg:3 -> rn, i:2 = 0x2, base:9 = 0x12e ),
    disasm ( mnemonic : "indexw", operands : rn, sub, ext )
    { %REG[ R, rn ] = %REG[ R, rn ] * ( ( ext & 0xffff ) + 1 ) + ( sub & 0xffff ); }
insn indexd : encode #i24 ( gen2:5 -> sub @gen(gen2),   gen1:5 -> ext @gen(gen1),   reg:3 -> rn, i:2 = 0x3, base:9 = 0x12e ),
    disasm ( mnemonic : "indexd", operands : rn, sub, ext )
    { %REG[ R, rn ] = %REG[ R, rn ] * ( ext + 1 ) + sub; }

// ===========================================================================
// CONTROL TRANSFER, MODULE CALLS, TRAPS (NS32000 Formats 0, 1, 2, 3).
//
// Encodings derived verbatim from GNU binutils `include/opcode/ns32k.h`
// (ns32k_opcodes[]) cross-checked with `opcodes/ns32k-dis.c` (get_displacement,
// print_insn_arg) and `gas/config/tc-ns32k.c`.
//
// BRANCH DISPLACEMENT (the structural feature of this section): NS32000 branch
// targets use the SAME self-describing variable-length big-endian displacement as
// gen-mode displacements -- the top two bits of the first displacement byte pick a
// 7/14/30-bit signed value over 1/2/4 bytes (engine feature E2, `disp varlen`). It
// is NOT a gen operand; it is a PC-relative displacement that follows the opcode.
// binutils confirms (`print_insn_arg`, operand classes 'p'/'b') that the base is the
// address of the BRANCH INSTRUCTION ITSELF (priv.insn_start), not the next instruction.
//
// We express the target by binding the operand to a one-rule addrmode whose memory term
// is `%M [ pc + disp varlen ]`: the engine reads the varlen displacement from the tail
// (advancing the decoded length by exactly the 1/2/4 bytes the encoding describes) and
// records base = pc, Disp = sign_extended(disp). `@lea(target)` then yields `pc + disp`
// -- the branch destination -- WITHOUT loading memory. Because the displacement length is
// driven by E2 (not a fixed-width field), a short branch is 1 byte longer than the opcode
// and a far branch is 4 bytes longer, so the decoded instruction length is always correct.
//
// Bcond needs DISTINCT mnemonics that each match one condition value, yet the opcode byte
// (cond:4 : 0xA) leaves no spare field to hang the disp addrmode on -- and a single field
// may be EITHER a constant match OR an operand binding, not both. So each condition has its
// own disp addrmode that matches ONLY its COND_* value (`c == COND_xx => ...`); binding the
// cond field through it both selects the right mnemonic (the insn fails to decode for any
// other cond) and reads the PC-relative displacement. The bodies test the NS32000 PSR flags
// per the spec Bcond table (Z, the unsigned-greater L flag, the signed-greater N flag, F).
// ===========================================================================

// Per-condition displacement addrmodes: each matches exactly its COND_* value, so the
// bound branch decodes only for that condition. The single rule reads the PC-relative
// varlen displacement; @lea on the resulting operand yields `pc + disp` (the target).
addrmode bd_eq ( c ) { c == COND_EQ => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_ne ( c ) { c == COND_NE => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_cs ( c ) { c == COND_CS => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_cc ( c ) { c == COND_CC => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_hi ( c ) { c == COND_HI => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_ls ( c ) { c == COND_LS => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_gt ( c ) { c == COND_GT => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_le ( c ) { c == COND_LE => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_fs ( c ) { c == COND_FS => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_fc ( c ) { c == COND_FC => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_lo ( c ) { c == COND_LO => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_hs ( c ) { c == COND_HS => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_lt ( c ) { c == COND_LT => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_ge ( c ) { c == COND_GE => #i8 %M [ pc + disp varlen ] ; }
addrmode bd_br ( c ) { c == COND_BR => #i8 %M [ pc + disp varlen ] ; }

// The L flag (PSR bit 2, the UNSIGNED-greater result of CMP) has no %-meta-role, so the
// conditions that test it read it directly out of `psr` with mask PSR_L (0x4). The F flag
// (PSR bit 5) is read with mask PSR_F (0x20). Z and N use their meta-roles %Z / %N.
//
// Bcond cc: pc = cond ? @lea(target) : pc. Each `disp` operand is the PC-relative target.
jump insn beq : type branch, encode #i8 ( cond:4 -> disp @bd_eq(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "beq", operands : disp )
    { pc = ( %Z != 0 ) ? @lea ( disp ) : pc; }
jump insn bne : type branch, encode #i8 ( cond:4 -> disp @bd_ne(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "bne", operands : disp )
    { pc = ( %Z == 0 ) ? @lea ( disp ) : pc; }
jump insn bcs : type branch, encode #i8 ( cond:4 -> disp @bd_cs(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "bcs", operands : disp )
    { pc = ( %C != 0 ) ? @lea ( disp ) : pc; }
jump insn bcc : type branch, encode #i8 ( cond:4 -> disp @bd_cc(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "bcc", operands : disp )
    { pc = ( %C == 0 ) ? @lea ( disp ) : pc; }
// BHI/BLS test the L flag (PSR bit 2 = PSR_L). The single-flag form (HI=L, LS=!L) is the
// manual's condition-table entry and is equivalent to the two-flag (L && !Z) / (!L || Z)
// test under spec-conformant CMP, which sets Z=1 => L=0 and Z=0 => L reflects the comparison.
jump insn bhi : type branch, encode #i8 ( cond:4 -> disp @bd_hi(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "bhi", operands : disp )
    { pc = ( ( psr & PSR_L ) != 0 ) ? @lea ( disp ) : pc; }
jump insn bls : type branch, encode #i8 ( cond:4 -> disp @bd_ls(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "bls", operands : disp )
    { pc = ( ( psr & PSR_L ) == 0 ) ? @lea ( disp ) : pc; }
// BGT/BLE test the N flag (PSR bit 7 = PSR_N). The single-flag form (GT=N, LE=!N) is the
// manual's condition-table entry and is equivalent to the two-flag (N && !Z) / (!N || Z)
// test under spec-conformant CMP, which sets Z=1 => N=0 and Z=0 => N reflects the comparison.
jump insn bgt : type branch, encode #i8 ( cond:4 -> disp @bd_gt(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "bgt", operands : disp )
    { pc = ( %N != 0 ) ? @lea ( disp ) : pc; }
jump insn ble : type branch, encode #i8 ( cond:4 -> disp @bd_le(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "ble", operands : disp )
    { pc = ( %N == 0 ) ? @lea ( disp ) : pc; }
jump insn bfs : type branch, encode #i8 ( cond:4 -> disp @bd_fs(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "bfs", operands : disp )
    { pc = ( ( psr & PSR_F ) != 0 ) ? @lea ( disp ) : pc; }
jump insn bfc : type branch, encode #i8 ( cond:4 -> disp @bd_fc(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "bfc", operands : disp )
    { pc = ( ( psr & PSR_F ) == 0 ) ? @lea ( disp ) : pc; }
jump insn blo : type branch, encode #i8 ( cond:4 -> disp @bd_lo(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "blo", operands : disp )
    { pc = ( ( ( psr & PSR_L ) == 0 ) && ( %Z == 0 ) ) ? @lea ( disp ) : pc; }
jump insn bhs : type branch, encode #i8 ( cond:4 -> disp @bd_hs(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "bhs", operands : disp )
    { pc = ( ( ( psr & PSR_L ) != 0 ) || ( %Z != 0 ) ) ? @lea ( disp ) : pc; }
jump insn blt : type branch, encode #i8 ( cond:4 -> disp @bd_lt(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "blt", operands : disp )
    { pc = ( ( %N == 0 ) && ( %Z == 0 ) ) ? @lea ( disp ) : pc; }
jump insn bge : type branch, encode #i8 ( cond:4 -> disp @bd_ge(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "bge", operands : disp )
    { pc = ( ( %N != 0 ) || ( %Z != 0 ) ) ? @lea ( disp ) : pc; }

// BR: unconditional branch (cond 0xE). pc = target.
jump insn br : type branch, encode #i8 ( cond:4 -> disp @bd_br(cond), op:4 = FMT0_SEL ) priority 1,
    disasm ( mnemonic : "br", operands : disp )
    { pc = @lea ( disp ); }

// ---------------------------------------------------------------------------
// FORMAT 1 -- single opcode byte (`opcode_id_size = 8`). The opcodes share the low
// nibble 0x2; the high nibble selects the instruction (bsr=0x0, ret=0x1, cxp=0x2,
// rxp=0x3, rett=0x4 -> bytes 0x02/0x12/0x22/0x32/0x42).
//
// For the disp-bearing Format-1 instructions the variable-length displacement follows the
// opcode byte directly -- there is no spare opcode bit and no fixed selector byte to hang a
// disp addrmode on. So, exactly as Bcond, the high nibble is bound through a per-value
// addrmode (`c == <hi> => disp varlen`) that matches only that instruction and reads the
// PC-relative / absolute displacement from the tail; the low nibble is matched as 0x2.
// ---------------------------------------------------------------------------

// BSR -- branch to subroutine: push the return address (the next instruction), branch to a
// PC-relative target. @lea(disp) = pc + disp.
addrmode bd_bsr ( c ) { c == 0x0 => #i8 %M [ pc + disp varlen ] ; }
jump insn bsr : type call, encode #i8 ( hi:4 -> disp @bd_bsr(hi), lo:4 = 0x2 ),
    disasm ( mnemonic : "bsr", operands : disp )
    { sp = sp - 4; %M [ sp ] = pc; pc = @lea ( disp ); }

// RET disp -- return: pop the return PC, then pop `disp` bytes of arguments off the stack.
// The disp is a plain varlen displacement (the stack adjustment), not a PC-relative target,
// so the addrmode's memory term is `%M [ disp varlen ]` and @lea yields the bare disp value.
addrmode d_ret ( c ) { c == 0x1 => #i8 %M [ disp varlen ] ; }
jump insn ret : type return, encode #i8 ( hi:4 -> adj @d_ret(hi), lo:4 = 0x2 ),
    disasm ( mnemonic : "ret", operands : adj )
    { pc = %M [ sp ]; sp = sp + 4; sp = sp + @lea ( adj ); }

// CXP disp -- call external procedure: the disp indexes the current module's link table.
// The descriptor at MOD's link table gives a new module + entry. We push MOD and the return
// PC, then load the new module context. (Link-table double-dereference is the run-time body;
// the descriptor format is module := Mem32[Mem32[MOD+4] + index*4], entry the next word.)
addrmode d_cxp ( c ) { c == 0x2 => #i8 %M [ disp varlen ] ; }
jump insn cxp : type call, encode #i8 ( hi:4 -> idx @d_cxp(hi), lo:4 = 0x2 ),
    disasm ( mnemonic : "cxp", operands : idx )
    { #i32 desc = %M [ %M [ mod + 4 ] + @lea ( idx ) * 4 ];
      sp = sp - 4; %M [ sp ] = mod; sp = sp - 4; %M [ sp ] = pc;
      mod = desc & 0xffff; sb = %M [ desc & 0xffff ]; pc = %M [ ( desc & 0xffff ) + 8 ] + ( desc >> 16 ); }

// RXP disp -- return from external procedure: pop PC and MOD, reload SB from the module
// descriptor, then pop `disp` argument bytes.
addrmode d_rxp ( c ) { c == 0x3 => #i8 %M [ disp varlen ] ; }
jump insn rxp : type return, encode #i8 ( hi:4 -> adj @d_rxp(hi), lo:4 = 0x2 ),
    disasm ( mnemonic : "rxp", operands : adj )
    { pc = %M [ sp ]; sp = sp + 4; mod = %M [ sp ] & 0xffff; sp = sp + 4;
      sb = %M [ mod ]; sp = sp + @lea ( adj ); }

// RETT disp -- return from trap: pop PC, pop PSR (from the module/trap frame), pop MOD,
// then pop `disp` argument bytes. (NS32000 trap frame: PC, then MOD:PSR pair.)
addrmode d_rett ( c ) { c == 0x4 => #i8 %M [ disp varlen ] ; }
jump insn rett : type return, encode #i8 ( hi:4 -> adj @d_rett(hi), lo:4 = 0x2 ),
    disasm ( mnemonic : "rett", operands : adj )
    { pc = %M [ sp ]; sp = sp + 4; mod = %M [ sp ] & 0xffff; psr = ( %M [ sp ] >> 16 ) & 0xffff;
      sp = sp + 4; sp = sp + @lea ( adj ); }

// RETI -- return from interrupt: pop PC, pop MOD:PSR (no argument adjustment); also
// acknowledges the interrupt controller (modelled as the frame restore only).
jump insn reti : type return, encode #i8 ( op:8 = OP_RETI ),
    disasm ( mnemonic : "reti" )
    { pc = %M [ sp ]; sp = sp + 4; mod = %M [ sp ] & 0xffff; psr = ( %M [ sp ] >> 16 ) & 0xffff; sp = sp + 4; }

// SAVE reglist -- push the registers named by the bitmask byte. The `U` bitmap order is
// bit0->r0 .. bit7->r7 (NS32000 ns32k-dis.c opt_U): registers are pushed r0 first.
insn save : encode #i8 ( op:8 = OP_SAVE, mask:8 -> mask ),
    disasm ( mnemonic : "save", operands : mask )
    { if ( ( mask & 0x01 ) != 0 ) { sp = sp - 4; %M [ sp ] = r0; }
      if ( ( mask & 0x02 ) != 0 ) { sp = sp - 4; %M [ sp ] = r1; }
      if ( ( mask & 0x04 ) != 0 ) { sp = sp - 4; %M [ sp ] = r2; }
      if ( ( mask & 0x08 ) != 0 ) { sp = sp - 4; %M [ sp ] = r3; }
      if ( ( mask & 0x10 ) != 0 ) { sp = sp - 4; %M [ sp ] = r4; }
      if ( ( mask & 0x20 ) != 0 ) { sp = sp - 4; %M [ sp ] = r5; }
      if ( ( mask & 0x40 ) != 0 ) { sp = sp - 4; %M [ sp ] = r6; }
      if ( ( mask & 0x80 ) != 0 ) { sp = sp - 4; %M [ sp ] = r7; } }

// RESTORE reglist -- pop registers. The `u` bitmap order is bit-REVERSED relative to `U`
// (ns32k-dis.c opt_u: bit0->r7 .. bit7->r0), so RESTORE pops in the order SAVE pushed:
// r7 first off the stack ... matching the bit reversal. Pop sequence here pops r7..r0.
insn restore : encode #i8 ( op:8 = OP_RESTORE, mask:8 -> mask ),
    disasm ( mnemonic : "restore", operands : mask )
    { if ( ( mask & 0x01 ) != 0 ) { r7 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x02 ) != 0 ) { r6 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x04 ) != 0 ) { r5 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x08 ) != 0 ) { r4 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x10 ) != 0 ) { r3 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x20 ) != 0 ) { r2 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x40 ) != 0 ) { r1 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x80 ) != 0 ) { r0 = %M [ sp ]; sp = sp + 4; } }

// ENTER reglist, framesize -- procedure prologue: push FP, FP := SP, allocate `framesize`
// local bytes (SP -= disp), then SAVE the register list. The reglist byte precedes the
// varlen frame-size displacement in the stream.
// The frame-size displacement follows the reglist (mask) byte. Bind the disp addrmode to
// the mask field's slot (mask is a real byte in the word; the addrmode reads the trailing
// varlen disp); the raw mask value is still read in the body for the register pushes.
addrmode d_frame ( c ) { default => #i8 %M [ disp varlen ] ; }
insn enter : encode #i8 ( op:8 = OP_ENTER, mask:8 -> fsz @d_frame(mask) ),
    disasm ( mnemonic : "enter", operands : mask, fsz )
    { sp = sp - 4; %M [ sp ] = fp; fp = sp; sp = sp - @lea ( fsz );
      if ( ( mask & 0x01 ) != 0 ) { sp = sp - 4; %M [ sp ] = r0; }
      if ( ( mask & 0x02 ) != 0 ) { sp = sp - 4; %M [ sp ] = r1; }
      if ( ( mask & 0x04 ) != 0 ) { sp = sp - 4; %M [ sp ] = r2; }
      if ( ( mask & 0x08 ) != 0 ) { sp = sp - 4; %M [ sp ] = r3; }
      if ( ( mask & 0x10 ) != 0 ) { sp = sp - 4; %M [ sp ] = r4; }
      if ( ( mask & 0x20 ) != 0 ) { sp = sp - 4; %M [ sp ] = r5; }
      if ( ( mask & 0x40 ) != 0 ) { sp = sp - 4; %M [ sp ] = r6; }
      if ( ( mask & 0x80 ) != 0 ) { sp = sp - 4; %M [ sp ] = r7; } }

// EXIT reglist -- procedure epilogue: RESTORE the register list, SP := FP, pop FP.
insn exit : encode #i8 ( op:8 = OP_EXIT, mask:8 -> mask ),
    disasm ( mnemonic : "exit", operands : mask )
    { if ( ( mask & 0x01 ) != 0 ) { r7 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x02 ) != 0 ) { r6 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x04 ) != 0 ) { r5 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x08 ) != 0 ) { r4 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x10 ) != 0 ) { r3 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x20 ) != 0 ) { r2 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x40 ) != 0 ) { r1 = %M [ sp ]; sp = sp + 4; }
      if ( ( mask & 0x80 ) != 0 ) { r0 = %M [ sp ]; sp = sp + 4; }
      sp = fp; fp = %M [ sp ]; sp = sp + 4; }

// NOP / WAIT / DIA -- no register/memory effect in this functional model. WAIT idles until
// an interrupt; DIA ("diagnose") is a self-branch used in test loops; both decode as no-ops.
insn nop  : encode #i8 ( op:8 = OP_NOP  ),  disasm ( mnemonic : "nop"  )  => r0 = r0;
insn wait : encode #i8 ( op:8 = OP_WAIT ),  disasm ( mnemonic : "wait" )  => r0 = r0;
insn dia  : encode #i8 ( op:8 = OP_DIA  ),  disasm ( mnemonic : "dia"  )  => r0 = r0;

// FLAG / SVC / BPT -- traps. FLAG traps if PSR.F is set; SVC and BPT trap unconditionally.
// @trap(vector) raises the corresponding NS32000 trap (handler at INTBASE + vector*4).
jump insn flag : type trap, encode #i8 ( op:8 = OP_FLAG ),
    disasm ( mnemonic : "flag" )  { if ( ( psr & PSR_F ) != 0 ) { @trap ( TRAP_FLG ); } }
jump insn svc  : type trap, encode #i8 ( op:8 = OP_SVC ),
    disasm ( mnemonic : "svc"  )  { @trap ( TRAP_SVC ); }
jump insn bpt  : type trap, encode #i8 ( op:8 = OP_BPT ),
    disasm ( mnemonic : "bpt"  )  { @trap ( TRAP_BPT ); }

// ---------------------------------------------------------------------------
// FORMAT 3 -- gen operand + 11-bit opcode. base word = gen:5 (bits 15:11) : opcode11:11.
// ---------------------------------------------------------------------------

// JUMP -- unconditional indirect jump: pc = EA(gen) (the addressing mode names the target
// address, not its contents), so @lea(dst).
jump insn jump : type branch, encode #i16 ( gen1:5 -> dst @gen(gen1), opc:11 = OPC_JUMP ),
    disasm ( mnemonic : "jump", operands : dst )
    { pc = @lea ( dst ); }

// JSR -- jump to subroutine (indirect): push return PC, pc = EA(gen).
jump insn jsr : type call, encode #i16 ( gen1:5 -> dst @gen(gen1), opc:11 = OPC_JSR ),
    disasm ( mnemonic : "jsr", operands : dst )
    { sp = sp - 4; %M [ sp ] = pc; pc = @lea ( dst ); }

// CXPD -- call external procedure with a descriptor named directly by the gen operand
// (vs CXP's link-table index). Push MOD + return PC, load the new module context from the
// descriptor (low half = MOD, SB = Mem32[MOD], entry = Mem32[MOD+8] + (descriptor>>16)).
jump insn cxpd : type call, encode #i16 ( gen1:5 -> dst @gen(gen1), opc:11 = OPC_CXPD ),
    disasm ( mnemonic : "cxpd", operands : dst )
    { #i32 desc = dst;
      sp = sp - 4; %M [ sp ] = mod; sp = sp - 4; %M [ sp ] = pc;
      mod = desc & 0xffff; sb = %M [ desc & 0xffff ]; pc = %M [ ( desc & 0xffff ) + 8 ] + ( desc >> 16 ); }

// CASEi -- multiway branch through a table. The gen operand addresses a table slot holding
// a signed i-wide displacement; pc = pc + sign_extend(Mem<i>[EA(gen)]) (PRM sec. 4, CASE).
// The added displacement is relative to the CASE instruction's own address.
// NOTE: the table operand uses %M[@lea(gen)] -- correct for the memory gen modes; the
// register-direct gen case (the operand IS a register, not a memory table) is NOT modeled.
jump insn caseb : type branch, encode #i16 ( gen1:5 -> tbl @gen_b(gen1), opc:11 = OPC_CASEB ),
    disasm ( mnemonic : "caseb", operands : tbl )
    { #i8 d = %M [ @lea ( tbl ) ]; pc = pc + %S ( d ); }
jump insn casew : type branch, encode #i16 ( gen1:5 -> tbl @gen_w(gen1), opc:11 = OPC_CASEW ),
    disasm ( mnemonic : "casew", operands : tbl )
    { #i16 d = %M [ @lea ( tbl ) ]; pc = pc + %S ( d ); }
jump insn cased : type branch, encode #i16 ( gen1:5 -> tbl @gen(gen1), opc:11 = OPC_CASED ),
    disasm ( mnemonic : "cased", operands : tbl )
    { #i32 d = %M [ @lea ( tbl ) ]; pc = pc + %S ( d ); }

// ---------------------------------------------------------------------------
// FORMAT 2 -- ACBi (add, compare and branch). base word = gen2:5 quick:4 op:5 i:2, then a
// PC-relative varlen displacement. dst += sign_extend(quick); if dst != 0, pc += disp.
//
// dst is the gen2 operand, quick is the 4-bit signed increment, and the disp is the
// PC-relative target. A bound field can be EITHER an immediate operand OR an addrmode
// trigger, and the body can only read a field's value through an immediate operand binding;
// so `quick` is bound to the `quick` immediate operand (giving the body its increment), and
// the disp addrmode is hung on the low bit of the opcode (op[0] = OP_ACB_SEL), which is
// otherwise a fixed match bit. The addrmode reads the trailing varlen displacement; @lea
// yields `pc + disp`. op[4:1] stays the constant OP_ACB_HI.
// ---------------------------------------------------------------------------
addrmode bd_acb ( c ) { c == OP_ACB_SEL => #i8 %M [ pc + disp varlen ] ; }
jump insn acbb : type branch, encode #i16 ( gen2:5 -> dst @gen_dst_b(gen2), quick:4 -> quick, ophi:4 = OP_ACB_HI, osel:1 -> disp @bd_acb(osel), i:2 = 0x0 ) priority 1,
    disasm ( mnemonic : "acbb", operands : quick, dst, disp )
    { dst = dst + #i8 %S ( quick ); pc = ( dst != 0 ) ? @lea ( disp ) : pc; }
jump insn acbw : type branch, encode #i16 ( gen2:5 -> dst @gen_dst_w(gen2), quick:4 -> quick, ophi:4 = OP_ACB_HI, osel:1 -> disp @bd_acb(osel), i:2 = 0x1 ) priority 1,
    disasm ( mnemonic : "acbw", operands : quick, dst, disp )
    { dst = dst + #i16 %S ( quick ); pc = ( dst != 0 ) ? @lea ( disp ) : pc; }
jump insn acbd : type branch, encode #i16 ( gen2:5 -> dst @gen_dst(gen2), quick:4 -> quick, ophi:4 = OP_ACB_HI, osel:1 -> disp @bd_acb(osel), i:2 = 0x3 ) priority 1,
    disasm ( mnemonic : "acbd", operands : quick, dst, disp )
    { dst = dst + #i32 %S ( quick ); pc = ( dst != 0 ) ? @lea ( disp ) : pc; }

// ===========================================================================
// PROCESSOR-CONTROL instructions (NS32000, Task 11).
//
// Encodings from GNU binutils `include/opcode/ns32k.h` (ns32k_opcodes[]) and
// `gas/config/tc-ns32k.c` (cpureg_032 / cpureg_532 tables). Verified by hand
// against the 16/24-bit instruction word layouts used in the existing file.
//
// LPR/SPR (Format 2-style, 16-bit): gen:5 : reg4:4 : op7:7
//   The `reg4` 4-bit field carries a dedicated-register selector (see PREG_* consts).
//   LPR loads the dedicated register named by `reg` into the gen operand.
//   SPR stores the gen operand into the dedicated register named by `reg`.
//   At the decode/disasm milestone the `reg` value is shown as an immediate selector
//   in the operand list (full register-name mapping is a Phase-3 semantic body item).
//
// ADJSP (Format 3-style, 16-bit, 11-bit opcode): gen:5 : op11:11
//   sp = sp - operand  (signed; per NS32000 PRM sp is decremented by the gen value).
//
// BISPSR / BICPSR (16-bit, 11-bit opcode): gen:5 : op11:11
//   BISPSR: PSR |= gen  (byte only writes low 8 bits; word form is the full 16-bit PSR).
//   BICPSR: PSR &= ~gen  (same width rules).
//   The NS32000 PRM only defines byte and word forms; there is no doubleword form.
//
// SETCFG (24-bit, 15-bit opcode): gen(0):5 : opts:4 : op7:7 : fmt:8(=FMT5_BYTE)
//   Loads the CFG register from the 4-bit option bitmap: I(bit0) F(bit1) M(bit2) C(bit3).
//   The gen field is unused (always 0) and carries no operand; only the option bitmap
//   matters at decode time.
// ===========================================================================

// ---------------------------------------------------------------------------
// LPRi -- load processor register. Transfers the dedicated register chosen by the
// 4-bit `reg` selector into the gen operand.
// Layout: gen:5 : reg4:4 : op5:5 : i:2  (OP5_LPR = bits[6:2] of the seed, i = bits[1:0]).
// At the decode/disasm milestone the selector is displayed as a raw immediate; the
// architectural mapping (reg=0xd -> PSR, reg=0xe -> INTBASE, etc.) is a Phase-3 body item.
// Binutils seeds: lprb=0x6c lprw=0x6d lprd=0x6f.
// ---------------------------------------------------------------------------
insn lprb : encode #i16 ( gen2:5 -> dst @gen_dst_b(gen2), reg4:4 -> reg, op:5 = OP5_LPR, i:2 = 0x0 ),
    disasm ( mnemonic : "lprb", operands : reg, dst )
    { dst = psr & 0xff; }
insn lprw : encode #i16 ( gen2:5 -> dst @gen_dst_w(gen2), reg4:4 -> reg, op:5 = OP5_LPR, i:2 = 0x1 ),
    disasm ( mnemonic : "lprw", operands : reg, dst )
    { dst = psr; }
insn lprd : encode #i16 ( gen2:5 -> dst @gen_dst(gen2), reg4:4 -> reg, op:5 = OP5_LPR, i:2 = 0x3 ),
    disasm ( mnemonic : "lprd", operands : reg, dst )
    { dst = psr; }

// ---------------------------------------------------------------------------
// SPRi -- store to processor register. Transfers the gen operand into the dedicated
// register chosen by the 4-bit `reg` selector.
// Layout: gen:5 : reg4:4 : op5:5 : i:2  (OP5_SPR = bits[6:2] of the seed, i = bits[1:0]).
// Binutils seeds: sprb=0x2c sprw=0x2d sprd=0x2f.
// ---------------------------------------------------------------------------
insn sprb : encode #i16 ( gen2:5 -> src @gen_b(gen2), reg4:4 -> reg, op:5 = OP5_SPR, i:2 = 0x0 ),
    disasm ( mnemonic : "sprb", operands : src, reg )
    { psr = ( psr &~ 0xff ) | ( src & 0xff ); }
insn sprw : encode #i16 ( gen2:5 -> src @gen_w(gen2), reg4:4 -> reg, op:5 = OP5_SPR, i:2 = 0x1 ),
    disasm ( mnemonic : "sprw", operands : src, reg )
    { psr = src; }
insn sprd : encode #i16 ( gen2:5 -> src @gen(gen2), reg4:4 -> reg, op:5 = OP5_SPR, i:2 = 0x3 ),
    disasm ( mnemonic : "sprd", operands : src, reg )
    { psr = src & 0xffff; }

// ---------------------------------------------------------------------------
// ADJSPi -- adjust stack pointer. sp = sp - operand (signed subtraction; adjusting
// the stack frame by the operand amount).
// Layout: gen:5 : op9:9 : i:2  (OP9_ADJSP = bits[10:2] of the 11-bit seed, i = bits[1:0]).
// Binutils seeds: adjspb=0x057c adjspw=0x057d adjspd=0x057f.
// ---------------------------------------------------------------------------
insn adjspb : encode #i16 ( gen1:5 -> src @gen_b(gen1), op:9 = OP9_ADJSP, i:2 = 0x0 ),
    disasm ( mnemonic : "adjspb", operands : src )
    { sp = sp - #i32 %S ( src ); }
insn adjspw : encode #i16 ( gen1:5 -> src @gen_w(gen1), op:9 = OP9_ADJSP, i:2 = 0x1 ),
    disasm ( mnemonic : "adjspw", operands : src )
    { sp = sp - #i32 %S ( src ); }
insn adjspd : encode #i16 ( gen1:5 -> src @gen(gen1), op:9 = OP9_ADJSP, i:2 = 0x3 ),
    disasm ( mnemonic : "adjspd", operands : src )
    { sp = sp - src; }

// ---------------------------------------------------------------------------
// BISPSRi -- bit-set PSR (OR operand into PSR). Only byte and word forms exist on
// the NS32000 (no doubleword form in the PRM or binutils table).
// Layout: gen:5 : op9:9 : i:2  (OP9_BISPSR = bits[10:2] of the 11-bit seed).
// Binutils seeds: bispsrb=0x37c bispsrw=0x37d.
// ---------------------------------------------------------------------------
insn bispsrb : encode #i16 ( gen1:5 -> src @gen_b(gen1), op:9 = OP9_BISPSR, i:2 = 0x0 ),
    disasm ( mnemonic : "bispsrb", operands : src )
    { psr = psr | ( src & 0xff ); }
insn bispsrw : encode #i16 ( gen1:5 -> src @gen_w(gen1), op:9 = OP9_BISPSR, i:2 = 0x1 ),
    disasm ( mnemonic : "bispsrw", operands : src )
    { psr = psr | ( src & 0xffff ); }

// ---------------------------------------------------------------------------
// BICPSRi -- bit-clear PSR (AND ~operand into PSR). Only byte and word forms exist.
// Layout: gen:5 : op9:9 : i:2  (OP9_BICPSR = bits[10:2] of the 11-bit seed).
// Binutils seeds: bicpsrb=0x17c bicpsrw=0x17d.
// ---------------------------------------------------------------------------
insn bicpsrb : encode #i16 ( gen1:5 -> src @gen_b(gen1), op:9 = OP9_BICPSR, i:2 = 0x0 ),
    disasm ( mnemonic : "bicpsrb", operands : src )
    { psr = psr &~ ( src & 0xff ); }
insn bicpsrw : encode #i16 ( gen1:5 -> src @gen_w(gen1), op:9 = OP9_BICPSR, i:2 = 0x1 ),
    disasm ( mnemonic : "bicpsrw", operands : src )
    { psr = psr &~ ( src & 0xffff ); }

// ---------------------------------------------------------------------------
// SETCFG -- set configuration register. Loads the CFG register from a 4-bit option
// bitmap: I=bit0 (interrupt), F=bit1 (FPU), M=bit2 (MMU), C=bit3 (cache/custom).
// Encoding (24-bit): gen(0):5 : opts:4 : op7:7 : fmt:8(=FMT5_BYTE).
// The gen field is structurally present (top 5 bits) but always zero; only opts matters.
// Binutils seed: setcfg=0x0b0e (gen=0, opts=0).
// ---------------------------------------------------------------------------
insn setcfg : encode #i24 ( gen0:5 = 0x0, opts:4 -> opts, op:7 = OP7_SETCFG, fmt:8 = FMT5_BYTE ),
    disasm ( mnemonic : "setcfg", operands : opts )
    { cfg = opts; }

// ===========================================================================
// CPU VARIANT DECLARATIONS.
//
// The NS32000 family spans four die revisions; each adds optional coprocessors
// and memory-management hardware. The feature stubs below are placeholders:
// FPU (NS32081/NS32381 floating-point coprocessor), MMU (NS32082/NS32382
// memory-management unit), and CACHE (NS32532/32732 on-chip cache control).
// The instruction bodies for these features are added in Phase 3 (Tasks 12/13).
// ===========================================================================
features {
    fpu    "NS32081/NS32381 floating-point coprocessor (lpf/spf/movf/addf/...)";
    mmu    "NS32082/NS32382 memory-management unit (lmr/smr/rdval/wrval/movsud/...)";
    cache  "NS32532/NS32732 on-chip cache (cinv instruction)";
}

cpu "ns32032" { fpu; mmu; }
cpu "ns32332" { fpu; mmu; }
cpu "ns32532" { fpu; mmu; cache; }
cpu "ns32732" { fpu; mmu; cache; }
