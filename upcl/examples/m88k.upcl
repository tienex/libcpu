arch "m88k" {

	name "Motorola 88100";

	endian big;

	byte_size 8;
	word_size 32;
	address_size 32;
	psr_size 32;
	float_size 80;

	register_file {

		// General Purpose Register Group
		group R {
			// r0 is hardwired to zero.
			[ #i32 r0 <- 0 ],
			// define r1..r31 as 32bit registers.
			[ 31 ** #i32 r?:1 ]
		}

		// Extended Floating Register Group
		group F {

			[ #f80 x0 <- 0 ],
			[ 31 ** #f80 x?:1 ]

		}

		// Special Register Group
		group S {

			[ #i32 sxip -> %PC ],
			[ #i32 snip -> %NPC ],
			[ #i32 sfip <- ( snip + 8 ) ],
			// PSR: carry (C->%C) at bit 28 (the MC88100's C_SHIFT). A colon splitter with typed
			// per-field widths registers the C flag for read/write -- MSB-first: 3 high bits, C,
			// then the low 28 bits.
			[ #i32 psr -> %PSR #i32 explicit ( #i3 0 : #i1 C -> %C : #i28 0 ) ]

		}

		// Floating-point control registers fcr0..fcr63 (fldcr/fstcr/fxcr access them; fcr62=FPSR,
		// fcr63=FPCR on the MC88100). A flat bank addressed by the 6-bit control-register number.
		group FC : [ 64 ** #i32 fcr?:0 ];

		// Trap
		// trapno holds the trap vector (vec9 is 9-bit, up to 511) -- a 32-bit register so the
		// dispatcher reads the full number (the old #i5 truncated it).
		group T : [ #i32 trapno ];

	}

}

decoder_operands [ const #i9 vec9,
				 // Encoded immediate-form operands: 5-bit GPR selectors (rD[25:21], rS1[20:16])
				 // and the immediate, held in a 32-bit operand so it widens cleanly for shifts/
				 // arithmetic (the 16-bit imm16[15:0] field zero-extends into it). r[ idx ]
				 // selects the physical GPR. rs2 is the triadic third register (rS2[4:0]).
				 #i5 rd, #i5 rs1, #i5 rs2, #i32 imm,
				 // The raw 26-bit signed word offset for br/bsr (m88k scales it by 4).
				 #i26 off,
				 // tb0/tb1/bb0/bb1: the tested bit number (D[25:21]); bb0/bb1's 16-bit word offset.
				 #i5 bit, #i16 boff,
				 // bcnd: the 5-bit condition selector M[25:21].
				 #i5 mb,
				 // ldcr/stcr/xcr: the 5-bit control-register number CR[9:5].
				 #i5 cr,
				 // Bit-field immediate (clr/set/ext/extu/mak/rot): width W[9:5] and offset O[4:0].
				 #i5 bw, #i5 bo ];

// ---------------------------------------------------------------------------
// Immediate-form integer instructions (major opcode bits[31:26] = 0x10..0x1f):
//   <op:6> <rD:5> <rS1:5> <imm16:16>.  rD = rS1 <op> imm16.  Logical ops act on the low
//   16-bit half; the .u ("upper") variants act on the high half. Authoritative bit
//   assignments cross-checked against arch/m88k/m88k_insn.cpp's primary decode table.
// ---------------------------------------------------------------------------

insn and_imm   : encode #i32 ( op:6 = 0x10, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "and", operands : rd, rs1, imm )
	=> r[ rd ] = r[ rs1 ] & ( 0xffff0000 | imm );
insn and_u_imm : encode #i32 ( op:6 = 0x11, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "and.u", operands : rd, rs1, imm )
	=> r[ rd ] = r[ rs1 ] & ( ( imm << 16 ) | 0xffff );
insn mask_imm  : encode #i32 ( op:6 = 0x12, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "mask", operands : rd, rs1, imm )
	=> r[ rd ] = r[ rs1 ] & imm;
insn mask_u_imm: encode #i32 ( op:6 = 0x13, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "mask.u", operands : rd, rs1, imm )
	=> r[ rd ] = r[ rs1 ] & ( imm << 16 );
insn xor_imm   : encode #i32 ( op:6 = 0x14, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "xor", operands : rd, rs1, imm )
	=> r[ rd ] = r[ rs1 ] ^ imm;
insn xor_u_imm : encode #i32 ( op:6 = 0x15, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "xor.u", operands : rd, rs1, imm )
	=> r[ rd ] = r[ rs1 ] ^ ( imm << 16 );
insn or_imm    : encode #i32 ( op:6 = 0x16, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "or", operands : rd, rs1, imm )
	=> r[ rd ] = r[ rs1 ] | imm;
insn or_u_imm  : encode #i32 ( op:6 = 0x17, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "or.u", operands : rd, rs1, imm )
	=> r[ rd ] = r[ rs1 ] | ( imm << 16 );
insn addu_imm  : encode #i32 ( op:6 = 0x18, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "addu", operands : rd, rs1, imm )
	=> r[ rd ] = r[ rs1 ] + imm;
insn subu_imm  : encode #i32 ( op:6 = 0x19, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "subu", operands : rd, rs1, imm )
	=> r[ rd ] = r[ rs1 ] - imm;
insn mulu_imm  : encode #i32 ( op:6 = 0x1b, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "mulu", operands : rd, rs1, imm )
	=> r[ rd ] = %U ( r[ rs1 ] * imm );
insn add_imm   : encode #i32 ( op:6 = 0x1c, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "add", operands : rd, rs1, imm )
	=> r[ rd ] = %OFTRAP ( r[ rs1 ] + imm, 1 );
insn sub_imm   : encode #i32 ( op:6 = 0x1d, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "sub", operands : rd, rs1, imm )
	=> r[ rd ] = %OFTRAP ( r[ rs1 ] - imm, 1 );
// divu (major 0x1a) / div (major 0x1e, DIVS): unsigned / signed divide by the zero-extended imm16.
// A zero divisor raises the divide trap in hardware; modelled here as the backend's division.
insn divu_imm  : encode #i32 ( op:6 = 0x1a, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "divu", operands : rd, rs1, imm )
	=> r[ rd ] = %U ( r[ rs1 ] / imm );
insn div_imm   : encode #i32 ( op:6 = 0x1e, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "div", operands : rd, rs1, imm )
	=> r[ rd ] = %S ( r[ rs1 ] / imm );

// ---------------------------------------------------------------------------
// Triadic register-form integer instructions (major opcode 0x3d = EXT2):
//   <op:6=0x3d> <rD:5> <rS1:5> <mc:8> <0:3> <rS2:5>.  rD = rS1 <op> rS2.
//   mc:8 = bits[15:8] = (minor<<2) | carry, where minor is the old decoder's sub_opcode_1
//   (bits[15:10]) and carry (bits[9:8]) selects the .ci/.co/.cio variants of add/addu/sub/
//   subu. The two are merged into one 8-bit field so each variant is a distinct decode key
//   (the decoder splits on adjacent constant fields, not on a separate carry sub-field).
//   Cross-checked against arch/m88k/m88k_insn.cpp's desc_ext2 + carry()/has_carry().
//   Carry-in is the meta flag %C; carry-out variants update it via %CC(...).
// ---------------------------------------------------------------------------

// add (minor 0x1c -> mc 0x70..0x73): signed add with overflow trap.
insn add     : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x70, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "add", operands : rd, rs1, rs2 )    => r[ rd ] = %OFTRAP ( r[ rs1 ] + r[ rs2 ], 1 );
insn add_ci  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x71, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "add.ci", operands : rd, rs1, rs2 ) => r[ rd ] = %OFTRAP ( r[ rs1 ] + r[ rs2 ] + %C, 1 );
insn add_co  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x72, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "add.co", operands : rd, rs1, rs2 ) => r[ rd ] = %OFTRAP ( %CC ( r[ rs1 ] + r[ rs2 ] ), 1 );
insn add_cio : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x73, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "add.cio", operands : rd, rs1, rs2 ) => r[ rd ] = %OFTRAP ( %CC ( r[ rs1 ] + r[ rs2 ] + %C ), 1 );

// sub (minor 0x1d -> mc 0x74..0x77): signed subtract with overflow trap.
insn sub     : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x74, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "sub", operands : rd, rs1, rs2 )    => r[ rd ] = %OFTRAP ( r[ rs1 ] - r[ rs2 ], 1 );
insn sub_ci  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x75, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "sub.ci", operands : rd, rs1, rs2 ) => r[ rd ] = %OFTRAP ( r[ rs1 ] - r[ rs2 ] - %C, 1 );
insn sub_co  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x76, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "sub.co", operands : rd, rs1, rs2 ) => r[ rd ] = %OFTRAP ( %CC ( r[ rs1 ] - r[ rs2 ] ), 1 );
insn sub_cio : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x77, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "sub.cio", operands : rd, rs1, rs2 ) => r[ rd ] = %OFTRAP ( %CC ( r[ rs1 ] - r[ rs2 ] - %C ), 1 );

// addu (minor 0x18 -> mc 0x60..0x63): unsigned add, no trap.
insn addu     : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x60, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "addu", operands : rd, rs1, rs2 )    => r[ rd ] = r[ rs1 ] + r[ rs2 ];
insn addu_ci  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x61, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "addu.ci", operands : rd, rs1, rs2 ) => r[ rd ] = r[ rs1 ] + r[ rs2 ] + %C;
insn addu_co  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x62, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "addu.co", operands : rd, rs1, rs2 ) => r[ rd ] = %CC ( r[ rs1 ] + r[ rs2 ] );
insn addu_cio : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x63, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "addu.cio", operands : rd, rs1, rs2 ) => r[ rd ] = %CC ( r[ rs1 ] + r[ rs2 ] + %C );

// subu (minor 0x19 -> mc 0x64..0x67): unsigned subtract, no trap.
insn subu     : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x64, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "subu", operands : rd, rs1, rs2 )    => r[ rd ] = r[ rs1 ] - r[ rs2 ];
insn subu_ci  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x65, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "subu.ci", operands : rd, rs1, rs2 ) => r[ rd ] = r[ rs1 ] - r[ rs2 ] - %C;
insn subu_co  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x66, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "subu.co", operands : rd, rs1, rs2 ) => r[ rd ] = %CC ( r[ rs1 ] - r[ rs2 ] );
insn subu_cio : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x67, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "subu.cio", operands : rd, rs1, rs2 ) => r[ rd ] = %CC ( r[ rs1 ] - r[ rs2 ] - %C );

// mulu (minor 0x1b -> mc 0x6c): unsigned multiply.
insn mulu : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x6c, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "mulu", operands : rd, rs1, rs2 ) => r[ rd ] = %U ( r[ rs1 ] * r[ rs2 ] );

// divu (minor 0x1a -> mc 0x68) / div (minor 0x1e -> mc 0x78, DIVS): unsigned / signed divide.
insn divu : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x68, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "divu", operands : rd, rs1, rs2 ) => r[ rd ] = %U ( r[ rs1 ] / r[ rs2 ] );
insn divs : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x78, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "div", operands : rd, rs1, rs2 )  => r[ rd ] = %S ( r[ rs1 ] / r[ rs2 ] );

// Logical triadic forms (no carry; mc = minor<<2).
insn and   : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x40, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "and", operands : rd, rs1, rs2 )    => r[ rd ] = r[ rs1 ] & r[ rs2 ];
insn and_c : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x44, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "and.c", operands : rd, rs1, rs2 )  => r[ rd ] = r[ rs1 ] &~ r[ rs2 ];
insn xor   : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x50, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "xor", operands : rd, rs1, rs2 )    => r[ rd ] = r[ rs1 ] ^ r[ rs2 ];
insn xor_c : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x54, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "xor.c", operands : rd, rs1, rs2 )  => r[ rd ] = r[ rs1 ] ^~ r[ rs2 ];
insn or    : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x58, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "or", operands : rd, rs1, rs2 )     => r[ rd ] = r[ rs1 ] | r[ rs2 ];
insn or_c  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x5c, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "or.c", operands : rd, rs1, rs2 )   => r[ rd ] = r[ rs1 ] |~ r[ rs2 ];

// cmp: compare rS1 against rS2 (triadic, minor 0x1f -> mc 0x7c) or imm16 (immediate, major 0x1f),
// storing the m88k comparison bit-vector in rD: equal -> 0x5aa4 (eq/le/ge/ls/hs/...); else 0xa008
// (ne base) OR the unsigned relations (bits 8-11) and signed relations (bits 4-7), packed via the
// (((-cmp) ^ 6) & 0xf) << shift trick (faithful to the old arch_m88k_cmp). The result is what the
// cmp-and-branch idiom (cmp + bb1 <bit>) tests.
insn cmp     : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x7c, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "cmp", operands : rd, rs1, rs2 )
	=> r[ rd ] = ( r[ rs1 ] == r[ rs2 ] ) ? 0x5aa4 :
	   ( 0xa008
	   | ( ( ( ( ( %U ( r[ rs1 ] ) > %U ( r[ rs2 ] ) ) ? 0xffffffff : 0 ) ^ 6 ) & 0xf ) << 8 )
	   | ( ( ( ( ( %S ( r[ rs1 ] ) > %S ( r[ rs2 ] ) ) ? 0xffffffff : 0 ) ^ 6 ) & 0xf ) << 4 ) );
insn cmp_imm : encode #i32 ( op:6 = 0x1f, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "cmp", operands : rd, rs1, imm )
	=> r[ rd ] = ( r[ rs1 ] == imm ) ? 0x5aa4 :
	   ( 0xa008
	   | ( ( ( ( ( %U ( r[ rs1 ] ) > %U ( imm ) ) ? 0xffffffff : 0 ) ^ 6 ) & 0xf ) << 8 )
	   | ( ( ( ( ( %S ( r[ rs1 ] ) > %S ( imm ) ) ? 0xffffffff : 0 ) ^ 6 ) & 0xf ) << 4 ) );

// ff1/ff0 find the first set/clear bit of rS1 (EXT2, two-operand, rS2 unused; mc 0xe8/0xec).
insn ff1  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0xe8, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "ff1", operands : rd, rs1 )       => r[ rd ] = @ffs ( r[ rs1 ] );
insn ff0  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0xec, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "ff0", operands : rd, rs1 )       => r[ rd ] = @ffc ( r[ rs1 ] );

// ---------------------------------------------------------------------------
// Bit-field instructions, IMMEDIATE form (EXT2, op 0x3d): clr/set/ext/extu/mak/rot with an inline
// width W = bits[9:5] and offset O = bits[4:0] (written W<O>). sub_opcode = bits[15:10]: clr=0x20,
// set=0x22, ext=0x24, extu=0x26, mak=0x28, rot=0x2a. A width of 0 means 32 (the whole word). This is
// the canonical bit-field encoding the assembler emits; the W bits live in the operand fields, so the
// match key is the 6-bit sub (not the 8-bit mc) -- which is why a non-zero W now decodes.
//   clr  rD = rS1 with the W bits at O cleared       set  rD = rS1 with the W bits at O set
//   ext  signed extract of the W-bit field at O      extu unsigned extract of the W-bit field at O
//   mak  deposit rS1's low W bits at offset O         rot  rotate rS1 right by O (W ignored)
// ---------------------------------------------------------------------------
insn clr  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, sub:6 = 0x20, bw:5 -> bw, bo:5 -> bo ),
	disasm ( mnemonic : "clr", operands : rd, rs1, bw, bo )
	{ #i32 m = ( bw == 0 ) ? 0xffffffff : ( ( 1 << bw ) - 1 ); r[ rd ] = r[ rs1 ] & ~ ( m << bo ); }
insn set  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, sub:6 = 0x22, bw:5 -> bw, bo:5 -> bo ),
	disasm ( mnemonic : "set", operands : rd, rs1, bw, bo )
	{ #i32 m = ( bw == 0 ) ? 0xffffffff : ( ( 1 << bw ) - 1 ); r[ rd ] = r[ rs1 ] | ( m << bo ); }
insn ext  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, sub:6 = 0x24, bw:5 -> bw, bo:5 -> bo ),
	disasm ( mnemonic : "ext", operands : rd, rs1, bw, bo )
	{ #i32 m = ( bw == 0 ) ? 0xffffffff : ( ( 1 << bw ) - 1 ); #i32 sb = ( bw == 0 ) ? 31 : ( bw - 1 );
	  #i32 e = ( r[ rs1 ] >> bo ) & m; r[ rd ] = ( e & ( 1 << sb ) ) ? ( e | ~ m ) : e; }
insn extu : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, sub:6 = 0x26, bw:5 -> bw, bo:5 -> bo ),
	disasm ( mnemonic : "extu", operands : rd, rs1, bw, bo )
	{ #i32 m = ( bw == 0 ) ? 0xffffffff : ( ( 1 << bw ) - 1 ); r[ rd ] = ( r[ rs1 ] >> bo ) & m; }
insn mak  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, sub:6 = 0x28, bw:5 -> bw, bo:5 -> bo ),
	disasm ( mnemonic : "mak", operands : rd, rs1, bw, bo )
	{ #i32 m = ( bw == 0 ) ? 0xffffffff : ( ( 1 << bw ) - 1 ); r[ rd ] = ( r[ rs1 ] & m ) << bo; }
insn rot  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, sub:6 = 0x2a, bw:5 -> bw, bo:5 -> bo ),
	disasm ( mnemonic : "rot", operands : rd, rs1, bo )   => r[ rd ] = r[ rs1 ] >>< bo;

// ---------------------------------------------------------------------------
// Floating point (SFU1, major opcode 0x21). The MC88100 keeps single-precision FP operands in the
// general registers as IEEE-754 bit patterns, so %FLT reinterprets a GPR's bits as an f32, the
// operation runs in floating point, and %INT writes the resulting bits back. sub[15:11] selects the
// operation; the precision field [10:5] = (TD:T1:T2) is 0 here for single precision (.sss). The
// dyadic forms use rS1/rS2; the conversions use rS2 as the single source. flt converts an integer
// to float; int/nint/trnc convert float to integer (truncating toward zero for trnc/int).
// Authoritative sub-opcodes from arch/m88k/m88k_insn.cpp's SFU1 table.
// ---------------------------------------------------------------------------
insn fmul : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x00, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fmul.sss", operands : rd, rs1, rs2 )
	=> r[ rd ] = %INT ( %FLT ( r[ rs1 ] ) * %FLT ( r[ rs2 ] ) );
insn fadd : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x05, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fadd.sss", operands : rd, rs1, rs2 )
	=> r[ rd ] = %INT ( %FLT ( r[ rs1 ] ) + %FLT ( r[ rs2 ] ) );
insn fsub : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x06, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fsub.sss", operands : rd, rs1, rs2 )
	=> r[ rd ] = %INT ( %FLT ( r[ rs1 ] ) - %FLT ( r[ rs2 ] ) );
insn fdiv : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x0e, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fdiv.sss", operands : rd, rs1, rs2 )
	=> r[ rd ] = %INT ( %FLT ( r[ rs1 ] ) / %FLT ( r[ rs2 ] ) );

// flt: integer (rS2) -> single float (rD). int/nint/trnc: single float (rS2) -> integer (rD).
insn flt  : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x04, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "flt.ss", operands : rd, rs2 )    => r[ rd ] = %INT ( #f32 r[ rs2 ] );
// int: convert float->int using the CURRENT ROUNDING MODE held in FPCR (fcr63[15:14]): 0=nearest,
// 1=toward-zero, 2=toward +inf (ceil), 3=toward -inf (floor). This is what distinguishes `int` from
// the fixed-mode `nint` (always nearest) and `trnc` (always toward zero) -- and it genuinely reads
// the FP control register.
insn fint : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x09, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "int.ss", operands : rd, rs2 )
	{ #f32 f = %FLT ( r[ rs2 ] );
	  #i32 rm = ( fcr63 >> 14 ) & 3;
	  #i32 tz = #i32 f;                                        // toward zero
	  #i32 rn = #i32 ( f + ( ( f >= 0.0 ) ? 0.5 : -0.5 ) );   // nearest
	  #f32 ft = #f32 tz;
	  #i32 up = ( f > ft ) ? ( tz + 1 ) : tz;                 // ceil  (+inf)
	  #i32 dn = ( f < ft ) ? ( tz - 1 ) : tz;                 // floor (-inf)
	  r[ rd ] = ( rm == 1 ) ? tz : ( rm == 2 ) ? up : ( rm == 3 ) ? dn : rn; }
insn nint : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x0a, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "nint.ss", operands : rd, rs2 )
	{ #f32 f = %FLT ( r[ rs2 ] ); r[ rd ] = #i32 ( f + ( ( f >= 0.0 ) ? 0.5 : -0.5 ) ); }
insn trnc : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x0b, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "trnc.ss", operands : rd, rs2 )   => r[ rd ] = #i32 %FLT ( r[ rs2 ] );

// fcmp: compare the two single-precision operands, depositing the MC88100 relation bit-vector in rD
// (bit1=ne bit2=eq bit3=gt bit4=le bit5=lt bit6=ge): equal -> eq|le|ge (0x54), greater -> ne|gt|ge
// (0x4a), less -> ne|le|lt (0x32). The cmp-and-branch idiom (fcmp + bb1 <bit>) tests these.
insn fcmp : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x07, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fcmp.sss", operands : rd, rs1, rs2 )
	=> r[ rd ] = ( %FLT ( r[ rs1 ] ) == %FLT ( r[ rs2 ] ) ) ? 0x54 :
	             ( %FLT ( r[ rs1 ] ) >  %FLT ( r[ rs2 ] ) ) ? 0x4a : 0x32;

// ---- double precision (.ddd): operands are GPR PAIRS r[rD]:r[rD+1] (big-endian: high word first),
// assembled into a 64-bit value, reinterpreted as an IEEE double, and split back. precision[10:5] =
// (TD:T1:T2) = 01:01:01 = 0x15 selects double; the sub_opcode is the same as the single forms. ----
insn fadd_d : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x05, prec:6 = 0x15, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fadd.ddd", operands : rd, rs1, rs2 )
	{ #i64 a = ( [ #i64 r[ rs1 ] ] << 32 ) | [ #i64 r[ rs1 + 1 ] ];
	  #i64 b = ( [ #i64 r[ rs2 ] ] << 32 ) | [ #i64 r[ rs2 + 1 ] ];
	  #i64 z = %INT ( %FLT ( a ) + %FLT ( b ) ); r[ rd ] = z >> 32; r[ rd + 1 ] = z; }
insn fsub_d : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x06, prec:6 = 0x15, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fsub.ddd", operands : rd, rs1, rs2 )
	{ #i64 a = ( [ #i64 r[ rs1 ] ] << 32 ) | [ #i64 r[ rs1 + 1 ] ];
	  #i64 b = ( [ #i64 r[ rs2 ] ] << 32 ) | [ #i64 r[ rs2 + 1 ] ];
	  #i64 z = %INT ( %FLT ( a ) - %FLT ( b ) ); r[ rd ] = z >> 32; r[ rd + 1 ] = z; }
insn fmul_d : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x00, prec:6 = 0x15, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fmul.ddd", operands : rd, rs1, rs2 )
	{ #i64 a = ( [ #i64 r[ rs1 ] ] << 32 ) | [ #i64 r[ rs1 + 1 ] ];
	  #i64 b = ( [ #i64 r[ rs2 ] ] << 32 ) | [ #i64 r[ rs2 + 1 ] ];
	  #i64 z = %INT ( %FLT ( a ) * %FLT ( b ) ); r[ rd ] = z >> 32; r[ rd + 1 ] = z; }
insn fdiv_d : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x0e, prec:6 = 0x15, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fdiv.ddd", operands : rd, rs1, rs2 )
	{ #i64 a = ( [ #i64 r[ rs1 ] ] << 32 ) | [ #i64 r[ rs1 + 1 ] ];
	  #i64 b = ( [ #i64 r[ rs2 ] ] << 32 ) | [ #i64 r[ rs2 + 1 ] ];
	  #i64 z = %INT ( %FLT ( a ) / %FLT ( b ) ); r[ rd ] = z >> 32; r[ rd + 1 ] = z; }
insn fcmp_d : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x07, prec:6 = 0x15, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fcmp.ddd", operands : rd, rs1, rs2 )
	{ #i64 a = ( [ #i64 r[ rs1 ] ] << 32 ) | [ #i64 r[ rs1 + 1 ] ];
	  #i64 b = ( [ #i64 r[ rs2 ] ] << 32 ) | [ #i64 r[ rs2 + 1 ] ];
	  r[ rd ] = ( %FLT ( a ) == %FLT ( b ) ) ? 0x54 : ( %FLT ( a ) > %FLT ( b ) ) ? 0x4a : 0x32; }

// fcvt: re-round a single-precision value through the FP unit (sub 0x01). Present on the MC88100.
insn fcvt  : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x01, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fcvt.ss", operands : rd, rs2 )   => r[ rd ] = %INT ( %FLT ( r[ rs2 ] ) );

// ===========================================================================
// MC88110 EXTENSIONS (feature `m88110`). The base architecture above is the MC88100; the 88110 adds
// the extended-precision FPU over the x0..x31 registers, scalar fsqrt/mov, the 80-bit ld.x/st.x, and
// the graphics (SFU2) packed-SIMD unit. cpu "mc88110" enables this feature; "mc88100" does not.
// ===========================================================================
feature m88110 {

// extended precision (.xxx): operands are the 80-bit extended registers x0..x31. The x-register forms
// set bit 15 of the sub_opcode (sub | 0x10); arithmetic is direct on the #f80 register file.
insn fmul_x : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x10, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fmul.xxx", operands : rd, rs1, rs2 )  => x[ rd ] = x[ rs1 ] * x[ rs2 ];
insn fadd_x : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x15, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fadd.xxx", operands : rd, rs1, rs2 )  => x[ rd ] = x[ rs1 ] + x[ rs2 ];
insn fsub_x : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x16, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fsub.xxx", operands : rd, rs1, rs2 )  => x[ rd ] = x[ rs1 ] - x[ rs2 ];
insn fdiv_x : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x1e, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fdiv.xxx", operands : rd, rs1, rs2 )  => x[ rd ] = x[ rs1 ] / x[ rs2 ];
insn fcmp_x : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x17, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fcmp.xxx", operands : rd, rs1, rs2 )
	=> r[ rd ] = ( x[ rs1 ] == x[ rs2 ] ) ? 0x54 : ( x[ rs1 ] > x[ rs2 ] ) ? 0x4a : 0x32;

// fsqrt: single-precision square root (sub 0x0f). mov: copy a GPR single into an extended register
// (sub 0x08), widening to 80-bit.
insn fsqrt : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x0f, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "fsqrt.ss", operands : rd, rs2 )  => r[ rd ] = %INT ( @fsqrt ( %FLT ( r[ rs2 ] ) ) );
insn mov   : encode #i32 ( op:6 = 0x21, rd:5 -> rd, rs1:5 -> rs1, sub:5 = 0x08, prec:6 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "mov", operands : rd, rs2 )       => x[ rd ] = #f80 %FLT ( r[ rs2 ] );

// ld.x / st.x: 80-bit extended float load/store to/from an extended register (immediate form, major
// 0x0f / 0x0e). The 80-bit datum lives at the effective address; the F register file holds #f80.
insn ld_x : encode #i32 ( op:6 = 0x0f, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "ld.x", operands : rd, rs1, imm )  => x[ rd ] = #f80 %M[ r[ rs1 ] + imm ];
insn st_x : encode #i32 ( op:6 = 0x0e, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "st.x", operands : rd, rs1, imm )  => #f80 %M[ r[ rs1 ] + imm ] = x[ rd ];

// Graphics unit (SFU2, major opcode 0x22). Packed SIMD: pmul/padd/psub/pcmp arithmetic and compare,
// ppack/punpk pack/unpack, prot field rotate. sub5 = bits[15:11]. padd/psub/pcmp use UPCL's vector
// type (#v4:8) so the operation runs LANE-BY-LANE (a true packed byte add -- no carry across the four
// 8-bit lanes -- lowered to per-lane SWAR by the framework). Modelled on the 32-bit word with byte
// lanes; the 64-bit register-pair and the per-size .h/.n widths are a documented simplification.
insn pmul : encode #i32 ( op:6 = 0x22, rd:5 -> rd, rs1:5 -> rs1, sub5:5 = 0x00, sz:6 -> sz, rs2:5 -> rs2 ),
	disasm ( mnemonic : "pmul", operands : rd, rs1, rs2 )  => r[ rd ] = %U ( r[ rs1 ] * r[ rs2 ] );
insn padd : encode #i32 ( op:6 = 0x22, rd:5 -> rd, rs1:5 -> rs1, sub5:5 = 0x04, sz:6 -> sz, rs2:5 -> rs2 ),
	disasm ( mnemonic : "padd", operands : rd, rs1, rs2 )  => r[ rd ] = [ #v4:8 r[ rs1 ] ] + [ #v4:8 r[ rs2 ] ];
insn psub : encode #i32 ( op:6 = 0x22, rd:5 -> rd, rs1:5 -> rs1, sub5:5 = 0x06, sz:6 -> sz, rs2:5 -> rs2 ),
	disasm ( mnemonic : "psub", operands : rd, rs1, rs2 )  => r[ rd ] = [ #v4:8 r[ rs1 ] ] - [ #v4:8 r[ rs2 ] ];
insn pcmp : encode #i32 ( op:6 = 0x22, rd:5 -> rd, rs1:5 -> rs1, sub5:5 = 0x07, sz:6 -> sz, rs2:5 -> rs2 ),
	disasm ( mnemonic : "pcmp", operands : rd, rs1, rs2 )  => r[ rd ] = [ #v4:8 r[ rs1 ] ] == [ #v4:8 r[ rs2 ] ];
insn ppack : encode #i32 ( op:6 = 0x22, rd:5 -> rd, rs1:5 -> rs1, sub5:5 = 0x0c, sz:6 -> sz, rs2:5 -> rs2 ),
	disasm ( mnemonic : "ppack", operands : rd, rs1, rs2 )  => r[ rd ] = ( r[ rs1 ] << 16 ) | ( r[ rs2 ] & 0xffff );
insn punpk : encode #i32 ( op:6 = 0x22, rd:5 -> rd, rs1:5 -> rs1, sub5:5 = 0x0d, sz:6 -> sz, rs2:5 -> rs2 ),
	disasm ( mnemonic : "punpk", operands : rd, rs1 )       => r[ rd ] = r[ rs1 ] & 0xffff;
insn prot  : encode #i32 ( op:6 = 0x22, rd:5 -> rd, rs1:5 -> rs1, sub5:5 = 0x0f, sz:6 -> sz, rs2:5 -> rs2 ),
	disasm ( mnemonic : "prot", operands : rd, rs1, rs2 )   => r[ rd ] = r[ rs1 ] >>< ( ( r[ rs2 ] >> 5 ) & 0x1f );

}

// lda computes a SCALED effective address (no memory access): rD = rS1 + (rS2 << log2(size)). The
// register-indexed forms (EXT2, op 0x3d) carry the scale in the function byte: lda.d=0x32 (<<3),
// lda(word)=0x36 (<<2, defined as lda_r below), lda.h=0x3a (<<1), lda.x=0x3e (<<4).
insn lda_d : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x32, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "lda.d", operands : rd, rs1, rs2 )  => r[ rd ] = r[ rs1 ] + ( r[ rs2 ] << 3 );
insn lda_h : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x3a, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "lda.h", operands : rd, rs1, rs2 )  => r[ rd ] = r[ rs1 ] + ( r[ rs2 ] << 1 );
insn lda_x : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x3e, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "lda.x", operands : rd, rs1, rs2 )  => r[ rd ] = r[ rs1 ] + ( r[ rs2 ] << 4 );

// Scalar load/store, immediate form (major opcode bits[31:26]): rD = mem[rS1 + imm16] and stores.
// imm16 is zero-extended (the operand is #i32). Signed loads (ld.h/ld.b) sign-extend the fetched
// value to 32 bits; unsigned loads (ld.hu/ld.bu) zero-extend. Major opcodes from desc_major.
insn ld    : encode #i32 ( op:6 = 0x05, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "ld", operands : rd, rs1, imm )    => r[ rd ] = #i32 %M[ r[ rs1 ] + imm ];
insn ld_h  : encode #i32 ( op:6 = 0x06, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "ld.h", operands : rd, rs1, imm )  => r[ rd ] = %S ( [ #i32 #i16 %M[ r[ rs1 ] + imm ] ] );
insn ld_hu : encode #i32 ( op:6 = 0x02, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "ld.hu", operands : rd, rs1, imm ) => r[ rd ] = #i16 %M[ r[ rs1 ] + imm ];
insn ld_b  : encode #i32 ( op:6 = 0x07, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "ld.b", operands : rd, rs1, imm )  => r[ rd ] = %S ( [ #i32 #i8 %M[ r[ rs1 ] + imm ] ] );
insn ld_bu : encode #i32 ( op:6 = 0x03, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "ld.bu", operands : rd, rs1, imm ) => r[ rd ] = #i8 %M[ r[ rs1 ] + imm ];

insn st    : encode #i32 ( op:6 = 0x09, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "st", operands : rd, rs1, imm )    => #i32 %M[ r[ rs1 ] + imm ] = r[ rd ];
insn st_h  : encode #i32 ( op:6 = 0x0a, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "st.h", operands : rd, rs1, imm )  => #i16 %M[ r[ rs1 ] + imm ] = r[ rd ];
insn st_b  : encode #i32 ( op:6 = 0x0b, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "st.b", operands : rd, rs1, imm )  => #i8 %M[ r[ rs1 ] + imm ] = r[ rd ];

// ld.d/st.d: 64-bit doubleword to/from the register pair r[rD]:r[rD+1] (big-endian: the high word
// is at the lower address). Major 0x04/0x08, immediate-offset form. The ld.x/st.x 80-bit float
// forms still need the F register file and stay deferred.
insn ld_d  : encode #i32 ( op:6 = 0x04, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "ld.d", operands : rd, rs1, imm )
	{ r[ rd ] = #i32 %M[ r[ rs1 ] + imm ]; r[ rd + 1 ] = #i32 %M[ r[ rs1 ] + imm + 4 ]; }
insn st_d  : encode #i32 ( op:6 = 0x08, rd:5 -> rd, rs1:5 -> rs1, imm:16 -> imm ),
	disasm ( mnemonic : "st.d", operands : rd, rs1, imm )
	{ #i32 %M[ r[ rs1 ] + imm ] = r[ rd ]; #i32 %M[ r[ rs1 ] + imm + 4 ] = r[ rd + 1 ]; }

// Register-indexed memory (EXT2, major 0x3d). The same loads/stores as the immediate forms, but the
// effective address is r[rS1] + index, where index is r[rS2] or -- in the SCALED variants (bit 9 of
// the function byte set, e.g. 0x14 -> 0x16) -- r[rS2] scaled by the access size. The function byte
// (mc:8 = bits[15:8]) mirrors the immediate major opcodes: 0x05->ld, 0x07->ld.b, 0x03->ld.bu,
// 0x09->st, 0x0b->st.b, 0x04->ld.d, 0x08->st.d (each << 2 into mc, +2 for the scaled bit). lda
// computes the scaled address itself (no memory access) -- used for array indexing.
insn ld_r   : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x14, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "ld", operands : rd, rs1, rs2 )    => r[ rd ] = #i32 %M[ r[ rs1 ] + r[ rs2 ] ];
insn ld_rs  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x16, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "ld", operands : rd, rs1, rs2 )    => r[ rd ] = #i32 %M[ r[ rs1 ] + ( r[ rs2 ] << 2 ) ];
insn ld_b_r : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x1c, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "ld.b", operands : rd, rs1, rs2 )  => r[ rd ] = %S ( [ #i32 #i8 %M[ r[ rs1 ] + r[ rs2 ] ] ] );
insn ld_bu_r: encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x0c, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "ld.bu", operands : rd, rs1, rs2 ) => r[ rd ] = #i8 %M[ r[ rs1 ] + r[ rs2 ] ];
insn st_r   : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x24, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "st", operands : rd, rs1, rs2 )    => #i32 %M[ r[ rs1 ] + r[ rs2 ] ] = r[ rd ];
insn st_rs  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x26, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "st", operands : rd, rs1, rs2 )    => #i32 %M[ r[ rs1 ] + ( r[ rs2 ] << 2 ) ] = r[ rd ];
insn st_b_r : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x2c, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "st.b", operands : rd, rs1, rs2 )  => #i8 %M[ r[ rs1 ] + r[ rs2 ] ] = r[ rd ];
insn st_d_r : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x20, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "st.d", operands : rd, rs1, rs2 )
	{ #i32 %M[ r[ rs1 ] + r[ rs2 ] ] = r[ rd ]; #i32 %M[ r[ rs1 ] + r[ rs2 ] + 4 ] = r[ rd + 1 ]; }
insn lda_r  : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x36, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "lda", operands : rd, rs1, rs2 )   => r[ rd ] = r[ rs1 ] + ( r[ rs2 ] << 2 );

// xmem / xmem.bu: atomic exchange-register-with-memory (EXT2, op 0x3d; function byte 0x04 word /
// 0x00 byte-unsigned). The word/byte at r[rS1]+r[rS2] is swapped with r[rD] as an INDIVISIBLE,
// bus-locked read-modify-write -- the m88k's only atomic primitive (spinlocks are built on it). The
// read is an INTERLOCKED load (%LL: it takes the reservation, marking the access bus-locked) and the
// paired write completes the locked RMW, so the swap is represented as interlocked, not a plain pair.
insn xmem : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x04, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "xmem", operands : rd, rs1, rs2 )
	{ #i32 t = #i32 %LL[ r[ rs1 ] + r[ rs2 ] ]; #i32 %M[ r[ rs1 ] + r[ rs2 ] ] = r[ rd ]; r[ rd ] = t; }
insn xmem_bu : encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0x00, z:3 = 0, rs2:5 -> rs2 ),
	disasm ( mnemonic : "xmem.bu", operands : rd, rs1, rs2 )
	{ #i8 t = #i8 %LL[ r[ rs1 ] + r[ rs2 ] ]; #i8 %M[ r[ rs1 ] + r[ rs2 ] ] = r[ rd ]; r[ rd ] = #i8 t; }

// br: unconditional PC-relative branch (major 0x30), 26-bit SIGNED word offset. Real m88k target
// is branch_addr + (offset << 2); the PC reads here as the NEXT instruction (branch_addr + 4), so
// subtract 4. off is #i26 so %S sign-extends from bit 25 before the <<2 scale.
jump insn br : type branch, encode #i32 ( op:6 = 0x30, off:26 -> off ),
	disasm ( mnemonic : "br", operands : off )
	{ sxip = ( sxip - 4 ) + ( %S ( off ) << 2 ); }

// bsr: branch-to-subroutine (major 0x32). Like br, but link r1 = return address (the next
// instruction, which is what the PC reads as here).
jump insn bsr : type call, encode #i32 ( op:6 = 0x32, off:26 -> off ),
	disasm ( mnemonic : "bsr", operands : off )
	{ r1 = sxip; sxip = ( sxip - 4 ) + ( %S ( off ) << 2 ); }

// br.n/bsr.n: the delayed (.n) forms of br/bsr (major 0x31/0x33). The delay slot -- the instruction
// immediately following -- executes before the transfer, so bsr.n's return address (r1) is the
// instruction PAST the delay slot, i.e. sxip + 4 (sxip already reads as branch + 4).
jump insn br_n : type branch, delay 1, encode #i32 ( op:6 = 0x31, off:26 -> off ),
	disasm ( mnemonic : "br.n", operands : off )
	{ sxip = ( sxip - 4 ) + ( %S ( off ) << 2 ); }
jump insn bsr_n : type call, delay 1, encode #i32 ( op:6 = 0x33, off:26 -> off ),
	disasm ( mnemonic : "bsr.n", operands : off )
	{ r1 = sxip + 4; sxip = ( sxip - 4 ) + ( %S ( off ) << 2 ); }

// bb0/bb1: branch on bit clear/set (major 0x34/0x36). bit[25:21] selects the bit of rS1[20:16];
// the 16-bit signed word offset scales by 4 off the branch address. The target is computed as a
// SELECT (taken ? target : fall-through) so it becomes an indirect branch -- this gates correctly
// at runtime, unlike the static-condition path whose *pNewPc cannot express a scaled m88k offset.
jump insn bb0 : type branch,
				encode #i32 ( op:6 = 0x34, bit:5 -> bit, rs1:5 -> rs1, boff:16 -> boff ),
				disasm ( mnemonic : "bb0", operands : bit, rs1, boff )
				{ sxip = ( ( r[ rs1 ] & ( 1 << bit ) ) == 0 ) ? ( ( sxip - 4 ) + ( %S ( boff ) << 2 ) ) : sxip; }

jump insn bb1 : type branch,
				encode #i32 ( op:6 = 0x36, bit:5 -> bit, rs1:5 -> rs1, boff:16 -> boff ),
				disasm ( mnemonic : "bb1", operands : bit, rs1, boff )
				{ sxip = ( ( r[ rs1 ] & ( 1 << bit ) ) != 0 ) ? ( ( sxip - 4 ) + ( %S ( boff ) << 2 ) ) : sxip; }

// Delayed (.n) bit-test branches (major 0x35/0x37): the following instruction (delay slot) always
// executes before the transfer. The delay slot runs inline (emitted by TranslateInstr), so the
// NOT-taken path resumes PAST it (sxip + 4 = branch+8), while the taken path goes to branch+off<<2.
jump insn bb0_n : type branch, delay 1,
				encode #i32 ( op:6 = 0x35, bit:5 -> bit, rs1:5 -> rs1, boff:16 -> boff ),
				disasm ( mnemonic : "bb0.n", operands : bit, rs1, boff )
				{ sxip = ( ( r[ rs1 ] & ( 1 << bit ) ) == 0 ) ? ( ( sxip - 4 ) + ( %S ( boff ) << 2 ) ) : ( sxip + 4 ); }
jump insn bb1_n : type branch, delay 1,
				encode #i32 ( op:6 = 0x37, bit:5 -> bit, rs1:5 -> rs1, boff:16 -> boff ),
				disasm ( mnemonic : "bb1.n", operands : bit, rs1, boff )
				{ sxip = ( ( r[ rs1 ] & ( 1 << bit ) ) != 0 ) ? ( ( sxip - 4 ) + ( %S ( boff ) << 2 ) ) : ( sxip + 4 ); }

// bcnd/bcnd.n: conditional branch on rS1 versus zero (major 0x3a/0x3b). The 5-bit M selector picks
// the relation: 1=gt0 2=eq0 3=ge0 12=lt0 13=ne0 14=le0 15=always 0=never (signed compares against
// 0). The 16-bit signed word offset scales by 4 off the branch address; computed-target select so
// it gates at runtime. (The 0x80000000-edge codes 4-11 are rare and default to never for now.)
jump insn bcnd : type branch,
				encode #i32 ( op:6 = 0x3a, mb:5 -> mb, rs1:5 -> rs1, boff:16 -> boff ),
				disasm ( mnemonic : "bcnd", operands : mb, rs1, boff )
				{ sxip = ( ( mb == 15 ) ? 1 :
				           ( mb == 1 )  ? ( %S ( r[ rs1 ] ) >  0 ) :
				           ( mb == 2 )  ? ( r[ rs1 ] == 0 ) :
				           ( mb == 3 )  ? ( %S ( r[ rs1 ] ) >= 0 ) :
				           ( mb == 12 ) ? ( %S ( r[ rs1 ] ) <  0 ) :
				           ( mb == 13 ) ? ( r[ rs1 ] != 0 ) :
				           ( mb == 14 ) ? ( %S ( r[ rs1 ] ) <= 0 ) : 0 )
				         ? ( ( sxip - 4 ) + ( %S ( boff ) << 2 ) ) : sxip; }
jump insn bcnd_n : type branch, delay 1,
				encode #i32 ( op:6 = 0x3b, mb:5 -> mb, rs1:5 -> rs1, boff:16 -> boff ),
				disasm ( mnemonic : "bcnd.n", operands : mb, rs1, boff )
				{ sxip = ( ( mb == 15 ) ? 1 :
				           ( mb == 1 )  ? ( %S ( r[ rs1 ] ) >  0 ) :
				           ( mb == 2 )  ? ( r[ rs1 ] == 0 ) :
				           ( mb == 3 )  ? ( %S ( r[ rs1 ] ) >= 0 ) :
				           ( mb == 12 ) ? ( %S ( r[ rs1 ] ) <  0 ) :
				           ( mb == 13 ) ? ( r[ rs1 ] != 0 ) :
				           ( mb == 14 ) ? ( %S ( r[ rs1 ] ) <= 0 ) : 0 )
				         ? ( ( sxip - 4 ) + ( %S ( boff ) << 2 ) ) : ( sxip + 4 ); }

// jmp/jsr: register-indirect jump (EXT2 op 0x3d, minor 0x30/0x32 -> mc 0xc0/0xc8). The target is
// the runtime value r[rS2] (a computed jump, like a return); jsr links r1 = return address (the
// next instruction, which the PC reads as here). rD/rS1 are unused. The .n delayed variants and
// the EXT1 system forms are deferred.
jump insn jmp : type call,
				encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0xc0, z:3 = 0, rs2:5 -> rs2 ),
				disasm ( mnemonic : "jmp", operands : rs2 )
				{ sxip = r[ rs2 ]; }
jump insn jsr : type call,
				encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0xc8, z:3 = 0, rs2:5 -> rs2 ),
				disasm ( mnemonic : "jsr", operands : rs2 )
				{ r1 = sxip; sxip = r[ rs2 ]; }

// jmp.n/jsr.n: the delayed (.n) register-indirect forms (EXT2 mc 0xc4/0xcc). The delay slot runs
// before the transfer; jsr.n therefore links r1 to the instruction past it (sxip + 4). jmp.n is the
// canonical function return (`jmp.n r1`) once r1 has been restored.
jump insn jmp_n : type call, delay 1,
				encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0xc4, z:3 = 0, rs2:5 -> rs2 ),
				disasm ( mnemonic : "jmp.n", operands : rs2 )
				{ sxip = r[ rs2 ]; }
jump insn jsr_n : type call, delay 1,
				encode #i32 ( op:6 = 0x3d, rd:5 -> rd, rs1:5 -> rs1, mc:8 = 0xcc, z:3 = 0, rs2:5 -> rs2 ),
				disasm ( mnemonic : "jsr.n", operands : rs2 )
				{ r1 = sxip + 4; sxip = r[ rs2 ]; }

// tb0/tb1: trap on bit clear/set (EXT1 op 0x3c, minor 0x34/0x36). Tests bit D[25:21] of rS1; if
// clear (tb0) / set (tb1), trap to vector vec9[8:0]. This is the OpenBSD/m88k syscall gateway:
// `tb0 0, r0, <vec>` always traps (r0 bit 0 is clear). @trap records the vector + raises the host
// syscall trap; trapno also holds it for the dispatcher.
jump insn tb1 : type trap,
				encode #i32 ( op:6 = 0x3c, bit:5 -> bit, rs1:5 -> rs1, minor:6 = 0x36, z:1 = 0, vec9:9 -> vec9 ),
				condition ( ( r[ rs1 ] & ( 1 << bit ) ) != 0 ),
				disasm ( mnemonic : "tb1", operands : bit, rs1, vec9 )
				{ trapno = vec9; @trap ( vec9 ); }

jump insn tb0 : type trap,
				encode #i32 ( op:6 = 0x3c, bit:5 -> bit, rs1:5 -> rs1, minor:6 = 0x34, z:1 = 0, vec9:9 -> vec9 ),
				condition ( ( r[ rs1 ] & ( 1 << bit ) ) == 0 ),
				disasm ( mnemonic : "tb0", operands : bit, rs1, vec9 )
				{ trapno = vec9; @trap ( vec9 ); }

// ---------------------------------------------------------------------------
// Control-register access (EXT1, major opcode 0x3c, sub_opcode[15:10]): ldcr reads, stcr writes,
// xcr exchanges a control register; the 5-bit CR number is bits[9:5]. The modelled control registers
// are the four the register file declares: cr1=PSR, cr4=SXIP, cr5=SNIP, cr6=SFIP (others read 0).
// These are SUPERVISOR instructions -- user-space OpenBSD/m88k programs never issue them; they are
// here for decode completeness and best-effort execution of the modelled registers.
// ---------------------------------------------------------------------------
insn ldcr : encode #i32 ( op:6 = 0x3c, rd:5 -> rd, rs1:5 -> rs1, sub:6 = 0x10, cr:5 -> cr, z:5 = 0 ),
	disasm ( mnemonic : "ldcr", operands : rd, cr )
	=> r[ rd ] = ( cr == 1 ) ? psr : ( cr == 4 ) ? sxip : ( cr == 5 ) ? snip : ( cr == 6 ) ? sfip : 0;
insn stcr : encode #i32 ( op:6 = 0x3c, rd:5 -> rd, rs1:5 -> rs1, sub:6 = 0x20, cr:5 -> cr, z:5 = 0 ),
	disasm ( mnemonic : "stcr", operands : rs1, cr )
	{ psr  = ( cr == 1 ) ? r[ rs1 ] : psr;
	  sfip = ( cr == 6 ) ? r[ rs1 ] : sfip;
	  snip = ( cr == 5 ) ? r[ rs1 ] : snip;
	  sxip = ( cr == 4 ) ? r[ rs1 ] : sxip; }
insn xcr : encode #i32 ( op:6 = 0x3c, rd:5 -> rd, rs1:5 -> rs1, sub:6 = 0x30, cr:5 -> cr, z:5 = 0 ),
	disasm ( mnemonic : "xcr", operands : rd, rs1, cr )
	{ #i32 old = ( cr == 1 ) ? psr : ( cr == 4 ) ? sxip : ( cr == 5 ) ? snip : ( cr == 6 ) ? sfip : 0;
	  psr  = ( cr == 1 ) ? r[ rs1 ] : psr;
	  sfip = ( cr == 6 ) ? r[ rs1 ] : sfip;
	  snip = ( cr == 5 ) ? r[ rs1 ] : snip;
	  sxip = ( cr == 4 ) ? r[ rs1 ] : sxip;
	  r[ rd ] = old; }

// rte: return from exception (EXT1 sub 0x3f) -- resume the faulted instruction stream at the shadow
// next-instruction pointer (SNIP). The illop1/2/3 sub-encodings (low bits 1/2/3) are unsupervised.
jump insn rte : type return,
				encode #i32 ( op:6 = 0x3c, rd:5 = 0, rs1:5 = 0, sub:6 = 0x3f, z:10 = 0 ),
				disasm ( mnemonic : "rte" )  { sxip = snip; }

// FP control-register access (EXT1 sub 0x12/0x22/0x32): fldcr reads, fstcr writes, fxcr exchanges
// floating-point control register fcrN (N = bits[9:5]) from/to the fcr bank.
insn fldcr : encode #i32 ( op:6 = 0x3c, rd:5 -> rd, rs1:5 -> rs1, sub:6 = 0x12, cr:5 -> cr, z:5 = 0 ),
	disasm ( mnemonic : "fldcr", operands : rd, cr )       => r[ rd ] = fcr[ cr ];
insn fstcr : encode #i32 ( op:6 = 0x3c, rd:5 -> rd, rs1:5 -> rs1, sub:6 = 0x22, cr:5 -> cr, z:5 = 0 ),
	disasm ( mnemonic : "fstcr", operands : rs1, cr )      => fcr[ cr ] = r[ rs1 ];
insn fxcr : encode #i32 ( op:6 = 0x3c, rd:5 -> rd, rs1:5 -> rs1, sub:6 = 0x32, cr:5 -> cr, z:5 = 0 ),
	disasm ( mnemonic : "fxcr", operands : rd, rs1, cr )
	{ #i32 old = fcr[ cr ]; fcr[ cr ] = r[ rs1 ]; r[ rd ] = old; }

// tbnd: trap on bounds (major 0x3e, immediate form). Raises the bounds-check trap (vector 7) when
// r[rS1] lies outside [0, imm16] -- i.e. it is unsigned-greater-than the upper bound. The EXT1
// register form (bound in r[rS2]) is deferred.
jump insn tbnd : type trap,
				encode #i32 ( op:6 = 0x3e, z:5 = 0, rs1:5 -> rs1, imm:16 -> imm ),
				condition ( %U ( r[ rs1 ] ) > %U ( imm ) ),
				disasm ( mnemonic : "tbnd", operands : rs1, imm )
				{ trapno = 7; @trap ( 7 ); }

// ---------------------------------------------------------------------------
// ISA features + CPU models. The base description is the MC88100; the MC88110 adds the `m88110`
// feature (extended-precision FPU, fsqrt/mov, ld.x/st.x, graphics SIMD). Select with
// `--arch upcl:m88k.upcl@mc88110` (or @mc88100); the default decodes the full superset.
// ---------------------------------------------------------------------------
features {
	m88110 "MC88110 -- extended-precision FPU (x regs), fsqrt/mov, ld.x/st.x, graphics SIMD unit";
}

cpu "mc88100" { }
cpu "mc88110" { m88110; }

