// The Intel x86 instruction-set family, as a modular, extensible UPCL description.
//
// This top file declares the architecture core -- the register file, the decoder operands,
// the register-encoding orders -- and the shared semantic macros, then INCLUDES the syntax
// styles and the instruction sets. Each ISA generation / vendor extension lives in its own
// file under x86/, gated on a feature; a CPU model selects which features are active:
//
//     lcx run prog.bin --arch upcl:x86.upcl@v30
//
// It is built to grow toward the modern x86: add x86/<generation>.upcl with a `feature { }`
// block, declare the feature, and list it in the CPU models that have it.

arch "x86" {

	name "Intel x86 family";
	byte_size 8;
	word_size 16;
	address_size 16;
	default_endian little;

	register_file {

		group R {
			[ #i16 bx -> #i8 ( bh : bl ) ],
			[ #i16 ax -> #i8 ( ah : al ) ],
			[ #i16 cx -> #i8 ( ch : cl ) ],
			[ #i16 dx -> #i8 ( dh : dl ) ],
			[ #i16 sp ],
			[ #i16 bp ],
			[ #i16 si ],
			[ #i16 di ]
		}

		group SEG {
			[ #i16 cs ], [ #i16 ds ], [ #i16 ss ], [ #i16 es ]
		}

		group S {
			[ #i16 ip ],
			[ #i24 pc -> %PC #i16 explicit evaluate ( @ea ( seg, off ) ) ( seg <- cs : off <-> ip ) ],
			[ #i16 flags -> %PSR #i1 explicit ( 0:0:0:0:O->%V:D:I:T:S->%N:Z->%Z:0:A<-C:0:P->%P:0:C->%C ) ]
		}

		group INT : [ #i8 intno ];

		// The 8087 numeric coprocessor: eight 80-bit registers forming a stack, plus the status
		// and control words. The stack is TOP-relative -- ST(i) is the physical register
		// st[(ftop + i) & 7] -- so ftop holds the 3-bit stack-top pointer (in real hardware it
		// occupies bits 11..13 of fsw; kept as its own register here until fsw is fully modelled).
		group FPU {
			[ 8 ** #f80 st? ],
			[ #i16 fsw ], [ #i16 fcw ], [ #i16 ftop ]
		}
	}
}

decoder_operands [ #i16 src, #i16 dst, #i8 cnt, #i8 sti, ccflags #i16 cond, const #i1 rep ];

// Show code addresses as the real-mode CS:IP pair (segment << 4 + offset): the offset is the
// low 16 bits, the segment the rest divided by 16. (A flat 16/20-bit linear address otherwise.)
address_display segmented shift 4 offset 16;

regset gpr16 [ ax, cx, dx, bx, sp, bp, si, di ];
regset gpr8  [ al, cl, dl, bl, ah, ch, dh, bh ];

// The 16-bit ModR/M addressing modes: a register-direct operand (mod = 3) or a memory
// operand whose effective address is a base/index sum plus a displacement (8- or 16-bit,
// per the mod field). This is the variable-length-decode table; an `rm:3 -> op @modrm16`
// operand binding selects through it.
addrmode modrm16 ( mod, rm ) disp ( mod == 1 ? 8 : mod == 2 ? 16 : 0 ) {
	mod == 3            => reg [ ax, cx, dx, bx, sp, bp, si, di ] ;	// register-direct
	mod == 0 && rm == 6 => mem [ disp16 ] ;				// [disp16]
	rm == 0             => mem [ bx + si + disp ] ;
	rm == 1             => mem [ bx + di + disp ] ;
	rm == 2             => mem [ bp + si + disp ] ;
	rm == 3             => mem [ bp + di + disp ] ;
	rm == 4             => mem [ si + disp ] ;
	rm == 5             => mem [ di + disp ] ;
	rm == 6             => mem [ bp + disp ] ;
	rm == 7             => mem [ bx + disp ] ;
}

// The byte-width ModR/M: identical address computation, but mod = 3 selects an 8-bit register.
addrmode modrm8 ( mod, rm ) disp ( mod == 1 ? 8 : mod == 2 ? 16 : 0 ) {
	mod == 3            => reg [ al, cl, dl, bl, ah, ch, dh, bh ] ;	// register-direct (byte)
	mod == 0 && rm == 6 => mem [ disp16 ] ;				// [disp16]
	rm == 0             => mem [ bx + si + disp ] ;
	rm == 1             => mem [ bx + di + disp ] ;
	rm == 2             => mem [ bp + si + disp ] ;
	rm == 3             => mem [ bp + di + disp ] ;
	rm == 4             => mem [ si + disp ] ;
	rm == 5             => mem [ di + disp ] ;
	rm == 6             => mem [ bp + disp ] ;
	rm == 7             => mem [ bx + disp ] ;
}

// Shared semantics: effective address, near/far jump, push/pop on the stack.
macro ea ( seg, off ) : #i24 %result = ( [ #i16 seg ] << 4 ) + [ #i16 off ];

macro i8086_jump ( address ) {
	if ( address is #i16 )
		pc.off = address;
	else
		pc.[ off, seg ] = address;
}
macro i8086_jump ( seg, off ) : pc.[ seg, off ] = ( seg : off );

macro i8086_push ( value ) {
	sp -= 2;
	#i16 %M[ @ea ( ss, sp ) ] = value;
}
macro i8086_pop () {
	%result = #i16 %M[ @ea ( ss, sp ) ];
	sp += 2;
}

// Syntax styles (AT&T / Intel) and the instruction sets, oldest first.
include "x86/disasm.upcl";
include "x86/8086.upcl";
include "x86/80186.upcl";
include "x86/v20.upcl";
include "x86/8087.upcl";

// The ISA features a CPU model may include, then the models themselves.
features {
	ext_186 "80186 / 80188 additions";
	nec     "NEC V20 / V30 (8080 emulation, bit instructions)";
	fpu     "8087 numeric coprocessor (ESC group, 80-bit FP stack)";
}

cpu "8086"  { fpu; }                 // the base ISA, with an 8087 fitted
cpu "80186" { ext_186; fpu; }
cpu "v20"   { nec; fpu; }
cpu "v30"   { ext_186; nec; fpu; }   // V30 has the 80186 set plus the NEC additions
