// Runtime-indexed register access: an FP register ARRAY addressed by a value computed at run time
// (the mechanism the 8087 stack ST((TOP+i)&7) needs). f0..f3 are a #f80 array `f`; f[idx] reads or
// writes the element the integer register `idx` selects. The decisive program writes f[2]=7 then
// f[0]=99 and reads f[2]: a result of 7 (not 99) proves the index really selects element 2 at run
// time -- a broken indexer that always hit slot 0 would return 99.

arch "fparray" {
	name "Indexed FP register array test";
	byte_size 8;
	word_size 16;
	address_size 16;
	default_endian little;

	register_file {
		group F {
			[ 4 ** #f80 f? ]
		}
		group R {
			[ #i16 r0 ], [ #i16 idx ]
		}
		group S {
			[ #i16 pc -> %PC ]
		}
	}
}

decoder_operands [ #i16 imm ];

insn setidx : encode #i16 ( op:8 = 0x10, imm:8 -> imm ) => idx = imm;         // idx = imm
insn fstore : encode #i16 ( op:8 = 0x11, imm:8 -> imm ) => f[ idx ] = [ #f80 imm ];  // f[idx] = (float)imm
insn fload  : encode #i8  ( op:8 = 0x20 )               => r0 = [ #i16 f[ idx ] ];   // r0 = (int)f[idx]
insn hlt    : encode #i8  ( op:8 = 0xFF )               => @trap ( 0 );
