// A tiny fixed-width RISC (MIPS-like) -- the opposite of x86 in every way: 32 uniform
// registers, a single 32-bit big-endian instruction word, regular bit-fields. It exists
// to prove the `encode` bit-field syntax is ARCHITECTURE-NEUTRAL: the same mechanism that
// describes an x86 form describes an R-type / I-type word with no byte or ModR/M notion.

arch "trisc" {

	name "Tiny RISC";
	byte_size 8;
	word_size 32;
	address_size 32;
	default_endian big;

	register_file {

		group R {
			[ 32 ** #i32 r? ]
		}

		group S {
			[ #i32 pc -> %PC ]
		}
	}
}

decoder_operands [ #i32 rd, #i32 rs, #i32 rt, #i32 imm ];

// R-type: op(6) rs(5) rt(5) rd(5) shamt(5) funct(6).  add = funct 0x20, or = funct 0x25.
insn add : r[rd] = %CC ( r[rs] + r[rt] )
	encode #i32 ( op:6 = 0x00, rs:5 -> rs, rt:5 -> rt, rd:5 -> rd, shamt:5 = 0, funct:6 = 0x20 );

insn or  : r[rd] = r[rs] | r[rt]
	encode #i32 ( op:6 = 0x00, rs:5 -> rs, rt:5 -> rt, rd:5 -> rd, shamt:5 = 0, funct:6 = 0x25 );

// I-type: op(6) rs(5) rt(5) imm(16).  addi = op 0x08.
insn addi : r[rt] = %CC ( r[rs] + imm )
	encode #i32 ( op:6 = 0x08, rs:5 -> rs, rt:5 -> rt, imm:16 -> imm );
